# .gitignore for .NET

# Build outputs
**/bin/
**/obj/
**/publish/
**/deploy/
**/_temp_buildDebug/
**/_temp_build_verify/
**/_verify_build2/
**/_authfix_obj/
**/_authfix_out/

# IDE specific
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# System files
.DS_Store
Thumbs.db

# Deployment zips (Only v19 and v20 allowed)
MonsterASP_Deployment_v[0-9]*.zip
!MonsterASP_Deployment_v19.zip
!MonsterASP_Deployment_v20.zip

# Frontend dependencies and generated assets
**/node_modules/
**/frontend_publish/
**/blazor.boot.json

# Local logs and transient outputs
*.log
*_output.txt
build_errors.txt
error_lines.txt
seed_log.txt

# Local publish/build artifact directories
publish_output/
publish_v*/
artifacts/
