@inherits LayoutComponentBase
@implements IDisposable
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject ThemeService ThemeService

@if (AuthService.IsAuthenticated && AuthService.CurrentUser != null)
{
    <div class="erp-main-container flex h-screen bg-[#F3F4F6] overflow-hidden">
        <!-- Sidebar -->
        <aside class="erp-sidebar flex flex-col flex-shrink-0 h-full shadow-xl font-sans text-white border-r border-white/10
                      @(isSidebarExpanded ? "w-72" : "w-16") transition-[width] duration-300"
               style="background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);">
            
            <!-- Brand Header -->
            <div class="h-16 flex items-center px-4 border-b border-white/8 @(isSidebarExpanded ? "justify-between" : "justify-center") shrink-0 relative">
                <div class="absolute inset-0 bg-gradient-to-r from-indigo-900/10 to-transparent pointer-events-none"></div>
                @if (isSidebarExpanded)
                {
                    <div class="flex items-center gap-3 overflow-hidden min-w-0 relative z-10">
                        <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-indigo-500/25 to-blue-500/15 rounded-xl flex items-center justify-center border border-indigo-400/25 text-indigo-300 font-bold text-sm shadow-lg shadow-indigo-500/10">
                            CF
                        </div>
                        <div class="flex flex-col truncate">
                            <span class="font-bold text-white text-sm leading-tight truncate tracking-wide">ClassicFit</span>
                            @if (AuthService.CurrentUser.Role == UserRole.Agent) {
                                <span class="text-[10px] text-indigo-300/60 font-medium tracking-widest uppercase truncate mt-0.5">Agent Workspace</span>
                            } else if (AuthService.CurrentUser.Role == UserRole.Supervisor) {
                                <span class="text-[10px] text-indigo-300/60 font-medium tracking-widest uppercase truncate mt-0.5">Supervisor</span>
                            } else {
                                <span class="text-[10px] text-indigo-300/60 font-medium tracking-widest uppercase truncate mt-0.5">Admin Console</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Navigation Menu -->
            <nav class="flex-1 overflow-y-auto py-5 px-3 space-y-0.5 custom-scrollbar">
                
                @if (AuthService.CurrentUser.Role == UserRole.Admin || AuthService.CurrentUser.Role == UserRole.SuperAdmin)
                {
                    <!-- ADMIN SIDEBAR -->

                    <!-- Dashboard -->
                    <a href="/dashboard/admin" class="erp-nav-item @(IsActive("/dashboard/admin") ? "active" : "")">
                        <div class="erp-nav-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        </div>
                        @if (isSidebarExpanded) { <span class="erp-nav-label">Dashboard</span> }
                    </a>

                    <!-- Items / Products -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/products") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-products")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Items / Products</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-products") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-products"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/products/new" class="erp-sub-nav-item">Add New Item</a>
                                <a href="/admin/products" class="erp-sub-nav-item">Edit Items</a>
                            </div>
                        }
                    </div>

                    <!-- Orders -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/orders") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-orders")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Orders</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-orders") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-orders"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/orders" class="erp-sub-nav-item">View All Orders</a>
                                <a href="/admin/orders/track" class="erp-sub-nav-item">Track Status</a>
                                <a href="/admin/returns" class="erp-sub-nav-item">Manage Returns</a>
                            </div>
                        }
                    </div>

                    <!-- Tickets -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/tickets") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-tickets")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Tickets</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-tickets") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-tickets"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/tickets" class="erp-sub-nav-item">View All Tickets</a>
                                <a href="/admin/tickets/escalated" class="erp-sub-nav-item">Escalated Tickets</a>
                                <a href="/admin/tickets/assign" class="erp-sub-nav-item">Assign Tickets</a>
                            </div>
                        }
                    </div>

                    <!-- Customers -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/customers") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-customers")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Customers</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-customers") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-customers"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/customers" class="erp-sub-nav-item">Search Profiles</a>
                                <a href="/admin/customers/history" class="erp-sub-nav-item">History</a>
                            </div>
                        }
                    </div>

                    <!-- Users & Roles -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/users") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-users")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Users & Roles</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-users") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-users"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/users" class="erp-sub-nav-item">Manage Agents</a>
                                <a href="/admin/users/roles" class="erp-sub-nav-item">Assign Roles</a>
                                <a href="/admin/users/deactivate" class="erp-sub-nav-item">Deactivate</a>
                            </div>
                        }
                    </div>

                    <!-- Reports -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/admin/reports") ? "active-parent" : "")" @onclick='() => ToggleGroup("admin-reports")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Reports</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("admin-reports") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("admin-reports"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/admin/reports/sales" class="erp-sub-nav-item">Sales</a>
                                <a href="/admin/reports/tickets" class="erp-sub-nav-item">Tickets</a>
                                <a href="/admin/reports/inventory" class="erp-sub-nav-item">Inventory</a>
                            </div>
                        }
                    </div>

                    <!-- Notifications -->
                    <a href="/admin/notifications" class="erp-nav-item @(IsActive("/admin/notifications") ? "active" : "")">
                        <div class="erp-nav-icon">
                             <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                        </div>
                        @if (isSidebarExpanded) { <span class="erp-nav-label">Notifications</span> }
                    </a>

                    <!-- Settings -->
                    <a href="/admin/settings" class="erp-nav-item @(IsActive("/admin/settings") ? "active" : "")">
                         <div class="erp-nav-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        @if (isSidebarExpanded) { <span class="erp-nav-label">Settings</span> }
                    </a>

                    <!-- Help -->
                    <a href="/help" class="erp-nav-item @(IsActive("/help") ? "active" : "")">
                         <div class="erp-nav-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        </div>
                        @if (isSidebarExpanded) { <span class="erp-nav-label">Help / Support</span> }
                    </a>

                }
                else if (AuthService.CurrentUser.Role == UserRole.Supervisor)
                {
                    <!-- SUPERVISOR SIDEBAR -->

                    <!-- Dashboard -->
                    <a href="/supervisor/dashboard" class="erp-nav-item @(IsActive("/supervisor/dashboard") ? "active" : "")">
                        <div class="erp-nav-icon">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        </div>
                        @if (isSidebarExpanded) { <span class="erp-nav-label">Dashboard</span> }
                    </a>

                    <!-- Tickets Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/tickets") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-tickets")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Tickets</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("supervisor-tickets") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("supervisor-tickets"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/supervisor/tickets" class="erp-sub-nav-item">All Tickets</a>
                                <a href="/supervisor/tickets/escalated" class="erp-sub-nav-item">Escalated</a>
                                <a href="/supervisor/tickets/assign" class="erp-sub-nav-item">Assign Tickets</a>
                            </div>
                        }
                    </div>

                    <!-- Orders Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/orders") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-orders")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Orders</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("supervisor-orders") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("supervisor-orders"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/supervisor/orders" class="erp-sub-nav-item">View All Orders</a>
                                <a href="/supervisor/orders/tracking" class="erp-sub-nav-item">Track Status</a>
                                <a href="/supervisor/orders/returns" class="erp-sub-nav-item">Returns</a>
                            </div>
                        }
                    </div>

                    <!-- Call Logs Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/calls") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-calls")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Call Logs</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("supervisor-calls") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("supervisor-calls"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/supervisor/calls" class="erp-sub-nav-item">Call History</a>
                                <a href="/supervisor/calls/monitoring" class="erp-sub-nav-item">Monitor Agents</a>
                            </div>
                        }
                    </div>

                    <!-- Agents Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/agents") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-agents")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Agents</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("supervisor-agents") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("supervisor-agents"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/supervisor/agents" class="erp-sub-nav-item">Agent Profiles</a>
                                <a href="/supervisor/agents/performance" class="erp-sub-nav-item">Performance</a>
                                <a href="/supervisor/agents/workload" class="erp-sub-nav-item">Assign Workloads</a>
                            </div>
                        }
                    </div>

                    <!-- Customers Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/customers") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-customers")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
                            {
                                <span class="erp-nav-label">Customers</span>
                                <svg class="w-4 h-4 transition-transform @(expandedGroups.Contains("supervisor-customers") ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                            }
                        </div>
                        @if (isSidebarExpanded && expandedGroups.Contains("supervisor-customers"))
                        {
                            <div class="erp-sub-nav">
                                <a href="/supervisor/customers/search" class="erp-sub-nav-item">Search Profiles</a>
                                <a href="/supervisor/customers/history" class="erp-sub-nav-item">Interaction History</a>
                            </div>
                        }
                    </div>

                    <!-- Reports Dropdown -->
                    <div class="erp-nav-group">
                        <div class="erp-nav-item @(IsActive("/supervisor/reports") ? "active-parent" : "")" @onclick='() => ToggleGroup("supervisor-reports")'>
                            <div class="erp-nav-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                            </div>
                            @if (isSidebarExpanded)
