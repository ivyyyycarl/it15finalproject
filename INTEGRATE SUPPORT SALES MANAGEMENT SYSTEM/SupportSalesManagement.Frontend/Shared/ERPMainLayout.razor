@code {
    private bool isSidebarExpanded = true;
    private HashSet<string> expandedGroups = new HashSet<string>();

    private void ToggleSidebar() => isSidebarExpanded = !isSidebarExpanded;

    private void ToggleGroup(string groupName)
    {
        if (expandedGroups.Contains(groupName))
        {
            expandedGroups.Remove(groupName);
        }
        else
        {
            expandedGroups.Add(groupName);
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }
    
    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void GoToNotifications()
    {
        try
        {
            var role = AuthService.CurrentUser?.Role;
            var target = role switch
            {
                UserRole.Admin or UserRole.SuperAdmin => "/admin/notifications",
                UserRole.Supervisor => "/supervisor/notifications",
                UserRole.Agent => "/agent/notifications",
                _ => "/notifications"
            };

            NavigationManager.NavigateTo(target);
        }
        catch
        {
            NavigationManager.NavigateTo("/notifications");
        }
    }

    private void GoToSubscription()
    {
        NavigationManager.NavigateTo("/subscription/overview");
    }

    private bool IsAgentPage()
    {
        try
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var absolutePath = "/" + relativePath.Split('?')[0].Trim('/');
            return absolutePath.StartsWith("/agent", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        try
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var absolutePath = "/" + relativePath.Split('?')[0].Trim('/');
            var targetPath = "/" + path.Trim('/');

            return absolutePath.Equals(targetPath, StringComparison.OrdinalIgnoreCase) ||
            (targetPath != "/" && absolutePath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase));
        }
        catch { return false; }
    }

    protected override void OnInitialized()
    {
        AuthService.OnAuthenticationChanged += OnAuthChanged;
        ThemeService.OnThemeChanged += OnAuthChanged; // Re-render on theme change
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthService.OnAuthenticationChanged -= OnAuthChanged;
        ThemeService.OnThemeChanged -= OnAuthChanged;
    }
}

