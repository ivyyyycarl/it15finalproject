@inherits LayoutComponentBase
@implements IDisposable
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject ApiClient ApiClient

@if (AuthService.IsAuthenticated && AuthService.CurrentUser != null)
{
    <div class="erp-main-container flex h-screen bg-gray-50 overflow-hidden" style="font-family: 'Inter', sans-serif; font-size: 12px;">
        <!-- Sidebar -->
        <aside class="agent-sidebar flex flex-col flex-shrink-0 h-full shadow-2xl font-sans text-slate-300 border-r border-slate-800 bg-[#0f172a]
                      @GetSidebarClass()">
            <!-- Brand Header -->
            <div class="h-16 flex items-center px-4 border-b border-slate-800/50 @(isSidebarExpanded ? "justify-between" : "justify-center") shrink-0 relative">
                @if (isSidebarExpanded)
                {
                    <div class="flex items-center gap-3 overflow-hidden min-w-0 relative z-10">
                        <div class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-600 rounded-xl flex items-center justify-center text-white font-bold text-sm shadow-md">
                            CF
                        </div>
                        <div class="flex flex-col truncate">
                            <span class="font-bold text-white text-sm leading-tight truncate tracking-wide">ClassicFit</span>
                            <span class="text-[10px] text-blue-400 font-semibold tracking-widest uppercase truncate mt-0.5">Agent Workspace</span>
                        </div>
                    </div>
                }
                <button type="button" @onclick="ToggleSidebar"
                    class="agent-sidebar-toggle text-slate-500 hover:text-white transition-all p-2 rounded-lg hover:bg-white/5 focus:outline-none flex-shrink-0"
                    aria-label="@(isSidebarExpanded ? "Collapse sidebar" : "Expand sidebar")">
                    <svg class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>

            <!-- Navigation Menu -->
            <nav class="flex-1 overflow-y-auto py-6 px-3 space-y-1 custom-scrollbar">
                
                @if (IsModuleVisible("dashboard"))
                {
                <!-- Dashboard -->
                <a href="/agent/dashboard"
                    class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/agent/dashboard") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5 @(IsActive("/agent/dashboard") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded) { <span class="font-semibold truncate text-[13px]">Dashboard</span> }
                </a>
                }

                @if (IsModuleVisible("tickets"))
                {
                <!-- Tickets Dropdown -->
                <div class="space-y-1">
                    <button @onclick='() => ToggleGroup("agent-tickets")'
                        class="w-full flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/tickets") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                        <div class="flex-shrink-0">
                            <svg class="w-5 h-5 @(IsActive("/tickets") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                            </svg>
                        </div>
                        @if (isSidebarExpanded)
                        {
                            <span class="flex-1 text-left font-semibold truncate text-[13px]">Tickets</span>
                            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 @(expandedGroups.Contains("agent-tickets") ? "rotate-180" : "")"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        }
                    </button>
                    @if (isSidebarExpanded && expandedGroups.Contains("agent-tickets"))
                    {
                        <div class="pl-11 space-y-1">
                            <a href="/tickets/create" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Create Ticket</a>
                            <a href="/agent/tickets/assigned" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">View Assigned</a>
                        </div>
                    }
                </div>
                }

                @if (IsModuleVisible("orders"))
                {
                <!-- Orders Dropdown -->
                <div class="space-y-1">
                     <button @onclick='() => ToggleGroup("agent-orders")'
                        class="w-full flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/orders") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                        <div class="flex-shrink-0">
                            <svg class="w-5 h-5 @(IsActive("/orders") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                            </svg>
                        </div>
                        @if (isSidebarExpanded)
                        {
                            <span class="flex-1 text-left font-semibold truncate text-[13px]">Orders</span>
                            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 @(expandedGroups.Contains("agent-orders") ? "rotate-180" : "")"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        }
                    </button>
                    @if (isSidebarExpanded && expandedGroups.Contains("agent-orders"))
                    {
                        <div class="pl-11 space-y-1">
                            <a href="/agent/orders/history" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Order History</a>
                            <a href="/agent/orders/track" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Track Status</a>
                        </div>
                    }
                </div>
                }

                @if (IsModuleVisible("calls"))
                {
                 <!-- Call Logs Dropdown -->
                <div class="space-y-1">
                     <button @onclick='() => ToggleGroup("agent-calls")'
                        class="w-full flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/calls") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                        <div class="flex-shrink-0">
                             <svg class="w-5 h-5 @(IsActive("/calls") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                             </svg>
                        </div>
                         @if (isSidebarExpanded)
                        {
                            <span class="flex-1 text-left font-semibold truncate text-[13px]">Call Logs</span>
                            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 @(expandedGroups.Contains("agent-calls") ? "rotate-180" : "")"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        }
                    </button>
                    @if (isSidebarExpanded && expandedGroups.Contains("agent-calls"))
                    {
                        <div class="pl-11 space-y-1">
                            <a href="/agent/calls/log" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Log Call</a>
                            <a href="/agent/calls/history" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Call History</a>
                        </div>
                    }
                </div>
                }

                @if (IsModuleVisible("customers"))
                {
                <!-- Customers Call Dropdown -->
                <div class="space-y-1">
                     <button @onclick='() => ToggleGroup("agent-customers")'
                        class="w-full flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/customers") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                        <div class="flex-shrink-0">
                             <svg class="w-5 h-5 @(IsActive("/customers") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                             </svg>
                        </div>
                         @if (isSidebarExpanded)
                        {
                            <span class="flex-1 text-left font-semibold truncate text-[13px]">Customers</span>
                              <svg class="w-4 h-4 text-gray-400 transition-transform duration-200 @(expandedGroups.Contains("agent-customers") ? "rotate-180" : "")"
                                  fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                              </svg>
                        }
                    </button>
                     @if (isSidebarExpanded && expandedGroups.Contains("agent-customers"))
                    {
                        <div class="pl-11 space-y-1">
                            <a href="/agent/customers" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Search Profiles</a>
                            <a href="/agent/customers/timeline" class="block py-2 text-[13px] text-slate-400 hover:text-white transition-colors">Interaction Timeline</a>
                        </div>
                    }
                </div>
                }

                @if (IsModuleVisible("reports"))
                {
                <!-- Performance -->
                <a href="/agent/performance"
                    class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/agent/performance") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5 @(IsActive("/agent/performance") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded) { <span class="font-semibold truncate text-[13px]">Performance</span> }
                </a>
                }

                @if (IsModuleVisible("notifications"))
                {
                <!-- Notifications -->
                <a href="/agent/notifications"
                    class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/agent/notifications") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                    <div class="flex-shrink-0 relative">
                        <svg class="w-5 h-5 @(IsActive("/agent/notifications") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        @if (notificationCount > 0)
                        {
                            <span class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] flex items-center justify-center bg-red-500 text-white text-[10px] font-bold rounded-full px-1 shadow-sm">@(notificationCount > 99 ? "99+" : notificationCount.ToString())</span>
                        }
                    </div>
                    @if (isSidebarExpanded) { <span class="font-semibold truncate text-[13px]">Notifications</span> }
                </a>
                }

                @if (IsModuleVisible("notifications"))
                {
                 <!-- Help -->
                <a href="/agent/help"
                    class="flex items-center gap-3 px-3 py-3 rounded-xl transition-all group relative @(IsActive("/agent/help") ? "bg-blue-600 text-white shadow-lg shadow-blue-900/40" : "text-slate-400 hover:bg-white/5 hover:text-white")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5 @(IsActive("/agent/help") ? "text-white" : "text-slate-500 group-hover:text-blue-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded) { <span class="font-semibold truncate text-[13px]">Help/Support</span> }
                </a>
                }

            </nav>

            <!-- Profile Footer -->
            <div class="p-4 border-t border-slate-800 bg-white/5">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center flex-shrink-0 shadow-sm">
                         <span class="text-xs font-bold text-white">@(AuthService.CurrentUser.Username?.FirstOrDefault().ToString().ToUpper() ?? "A")</span>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <div class="flex-1 min-w-0">
                            <span class="text-[13px] font-bold text-white truncate block">@(AuthService.CurrentUser.Username ?? "Agent")</span>
                            <span class="text-[10px] text-slate-400 truncate block font-medium">Support Professional</span>
                            <span class="text-[10px] text-blue-400 truncate block font-semibold">@currentBranchLabel</span>
                        </div>
                        <button @onclick="Logout" class="text-slate-500 hover:text-red-400 transition-colors p-1.5 rounded-lg hover:bg-red-400/10">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <!-- Main Content Wrapper -->
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <!-- Top Bar -->
            <header class="agent-topbar h-16 shrink-0 flex items-center gap-4 px-4 lg:px-6 bg-white border-b border-gray-200 shadow-sm z-20">
                 <div class="flex-1 min-w-0">
                    <span class="text-sm font-bold text-gray-900 truncate">Agent Workspace</span>
                </div>
                <span class="hidden md:inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-100">
                    @currentBranchLabel
                </span>

                <div class="flex items-center gap-2 ml-auto">
                    <button class="p-2 text-gray-400 hover:text-blue-600 transition-colors rounded-xl hover:bg-gray-50 relative border border-transparent hover:border-blue-100" @onclick="GoToNotifications" title="View Notifications">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                        @if (notificationCount > 0)
                        {
                            <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] flex items-center justify-center bg-red-500 text-white text-[10px] font-bold rounded-full px-1 border-2 border-white shadow-sm">@(notificationCount > 99 ? "99+" : notificationCount.ToString())</span>
                        }
                    </button>
                </div>
            </header>

            <!-- Page Content -->
            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50">
                @Body
            </main>
        </div>
    </div>
}
else
{
    @Body
}

<style>
    /* Sidebar: desktop fixed width + smooth transition; mobile overlay */
    .erp-main-container {
        display: flex;
        height: 100vh;
        overflow: hidden;
        gap: 0;
    }

    .agent-sidebar {
        flex-shrink: 0;
        position: relative;
        z-index: 20;
        min-width: 18rem;
        max-width: 18rem;
    }

    .agent-sidebar.sidebar-expanded {
        width: 18rem;
        min-width: 18rem;
        max-width: 18rem;
    }

    .agent-sidebar.sidebar-collapsed {
        width: 4.5rem;
        min-width: 4.5rem;
        max-width: 4.5rem;
    }

    .agent-sidebar + .flex-1 {
        min-width: 0;
        overflow: hidden;
    }

    @@media (min-width: 1024px) {
        .agent-sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
    }

    @@media (max-width: 1023px) {
        .agent-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            z-index: 40;
            transition: transform 0.3s ease, width 0.3s ease;
        }

        .agent-sidebar.sidebar-collapsed {
            transform: translateX(-100%);
            width: 18rem;
        }

        .agent-sidebar.sidebar-expanded {
            transform: translateX(0);
        }
    }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, 0.05);
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background-color: rgba(0, 0, 0, 0.1);
    }
</style>

@code {
    private bool isSidebarExpanded = true;
    private HashSet<string> expandedGroups = new();
    private ModuleAccessConfig? moduleAccessConfig;
    private TenantSubscriptionModel? tenantSubscription;
    private string currentBranchLabel = "Branch: Unassigned";

    private string GetSidebarClass()
    {
        return isSidebarExpanded ? "sidebar-expanded" : "sidebar-collapsed";
    }

    private int notificationCount = 0;
    private System.Threading.Timer? notifTimer;

    private void ToggleSidebar() => isSidebarExpanded = !isSidebarExpanded;

    private void ToggleGroup(string groupName)
    {
        if (expandedGroups.Contains(groupName))
        {
            expandedGroups.Remove(groupName);
        }
        else
        {
            expandedGroups.Add(groupName);
        }
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private void GoToNotifications()
    {
        NavigationManager.NavigateTo("/agent/notifications");
    }

    private bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        try
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var absolutePath = "/" + relativePath.Split('?')[0].Trim('/');
            var targetPath = "/" + path.Trim('/');

            return absolutePath.Equals(targetPath, StringComparison.OrdinalIgnoreCase) ||
                   (targetPath != "/" && absolutePath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase));
        }
        catch
        {
            return false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthService.OnAuthenticationChanged += OnAuthChanged;
        await LoadModuleVisibilityPolicyAsync();
        await LoadBranchLabelAsync();
        await LoadNotificationCount();
        notifTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => { await LoadNotificationCount(); StateHasChanged(); });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadNotificationCount()
    {
        try
        {
            var orders = await ApiClient.GetOrdersAsync();
            var tickets = await ApiClient.GetTicketsAsync();
            var products = await ApiClient.GetProductsAsync();
            int count = 0;
            if (orders != null) count += orders.Count(o => o.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));
            if (tickets != null) count += tickets.Count(t => t.Status.Equals("Open", StringComparison.OrdinalIgnoreCase) || t.Status.Equals("New", StringComparison.OrdinalIgnoreCase));
            if (products != null) count += products.Count(p => p.StockQuantity <= 10);
            notificationCount = count;
        }
        catch { }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadBranchLabelAsync()
    {
        try
        {
            var user = await ApiClient.GetCurrentUserAsync();
            currentBranchLabel = await ResolveBranchLabelAsync(user);
        }
        catch
        {
            currentBranchLabel = await ResolveBranchLabelAsync(AuthService.CurrentUser);
        }
    }

    private async Task<string> ResolveBranchLabelAsync(User? user)
    {
        if (user is null || user.BranchId is null || user.BranchId <= 0)
        {
            return "Branch: Unassigned";
        }

        var branchName = string.IsNullOrWhiteSpace(user.BranchName) ? null : user.BranchName.Trim();
        if (branchName is null)
        {
            try
            {
                var users = await ApiClient.GetUsersAsync();
                branchName = users?.FirstOrDefault(u => u.Id == user.Id)?.BranchName?.Trim();
            }
            catch
            {
            }
        }

        if (branchName is null)
        {
            try
            {
                var branches = await ApiClient.GetBranchesAsync();
                branchName = branches?.FirstOrDefault(b => b.Id == user.BranchId.Value)?.Name?.Trim();
            }
            catch
            {
            }
        }

        return string.IsNullOrWhiteSpace(branchName) ? "Branch: Unassigned" : $"Branch: {branchName}";
    }

    private async Task LoadModuleVisibilityPolicyAsync()
    {
        try
        {
            moduleAccessConfig = await ApiClient.GetModuleAccessConfigAsync();
            tenantSubscription = await ApiClient.GetMySubscriptionAsync();
        }
        catch
        {
            moduleAccessConfig = null;
            tenantSubscription = null;
        }
    }

    private bool IsModuleVisible(string moduleKey)
    {
        return ModuleVisibilityHelper.IsModuleVisible(
            moduleKey,
            UserRole.Agent,
            moduleAccessConfig,
            tenantSubscription);
    }

    public void Dispose()
    {
        AuthService.OnAuthenticationChanged -= OnAuthChanged;
        notifTimer?.Dispose();
    }
}
