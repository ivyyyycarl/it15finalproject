@* NavMenuDropdown.razor - Dropdown navigation menu item *@
<div class="@(Collapsed ? "" : "mb-1")">
    <button @onclick="Toggle" class="@GetButtonClasses() w-full">
        <div class="flex items-center gap-3">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@Icon" />
                </svg>
            }
            @if (!Collapsed)
            {
                <span class="flex-1 text-left truncate">@Label</span>
                <div class="flex items-center gap-2">
                    @if (BadgeCount > 0)
                    {
                        <span class="bg-[#F59E0B] text-white px-2 py-0.5 text-[10px] font-bold rounded-full">
                            @BadgeCount
                        </span>
                    }
                    <svg class="@(isExpanded ? "rotate-180" : "") w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            }
            else if (BadgeCount > 0)
            {
                <span class="absolute top-2 right-2 w-2 h-2 bg-[#F59E0B] rounded-full"></span>
            }
        </div>
    </button>
    
    @if (isExpanded && !Collapsed)
    {
        <div class="mt-1 ml-8 space-y-0.5 border-l-2 border-white/10 pl-3">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public int BadgeCount { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool isExpanded;

    private void Toggle()
    {
        if (!Collapsed)
            isExpanded = !isExpanded;
    }

    private string GetButtonClasses()
    {
        var baseClasses = "flex items-center gap-3 px-3 py-3 rounded-lg transition-all duration-200 text-white/80 hover:bg-white/10 hover:text-white relative";
        
        if (Collapsed)
            baseClasses += " justify-center";
        
        return baseClasses;
    }
}
