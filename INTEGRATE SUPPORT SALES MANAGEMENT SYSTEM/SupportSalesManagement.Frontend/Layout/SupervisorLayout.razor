@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject SupportSalesManagement.Frontend.Services.ApiClient ApiClient
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IJSRuntime JSRuntime
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@using Microsoft.AspNetCore.Components.Routing

<div class="erp-main-container flex h-screen bg-[#F3F4F6] overflow-hidden" style="font-family: 'Inter', sans-serif;">
    <!-- Sidebar -->
    <aside id="supervisor-sidebar" class="supervisor-sidebar flex flex-col flex-shrink-0 h-full shadow-xl font-sans text-white border-r border-white/10
                  @GetSidebarClass()">
        <!-- Brand Header -->
        <div
            class="h-16 flex items-center px-4 border-b border-white/8 justify-between shrink-0 relative">
            <div class="absolute inset-0 bg-gradient-to-r from-teal-900/10 to-transparent pointer-events-none"></div>
            @if (isSidebarExpanded)
            {
                <div class="flex items-center gap-3 overflow-hidden min-w-0 relative z-10">
                    <div
                        class="flex-shrink-0 w-10 h-10 bg-gradient-to-br from-teal-500/25 to-indigo-500/15 rounded-xl flex items-center justify-center border border-teal-400/25 text-teal-300 font-bold text-sm shadow-lg shadow-teal-500/10">
                        CF
                    </div>
                    <div class="flex flex-col truncate">
                        <span class="font-bold text-white text-sm leading-tight truncate tracking-wide">ClassicFit</span>
                        <span
                            class="text-[10px] text-teal-300/60 font-medium tracking-widest uppercase truncate mt-0.5">Supervisor</span>
                    </div>
                </div>
            }
            <button type="button"
                @onclick="OnHamburgerClick"
                class="relative z-10 flex items-center justify-center w-9 h-9 rounded-lg text-gray-200 hover:text-white hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-teal-400/40"
                aria-controls="supervisor-sidebar"
                aria-expanded="@isSidebarExpanded"
                aria-label="@(isSidebarExpanded ? "Collapse sidebar" : "Expand sidebar")"
                title="@(isSidebarExpanded ? "Collapse sidebar" : "Expand sidebar")">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <!-- Navigation Menu -->
        <nav class="flex-1 overflow-y-auto py-6 px-3 space-y-1 custom-scrollbar">

            @if (IsModuleVisible("dashboard"))
            {
            <!-- Dashboard -->
            <a href="/supervisor/dashboard"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @((IsActive("/supervisor/dashboard") || IsActive("/dashboard/supervisor")) ? "bg-blue-600/10 text-blue-400 border-r-2 border-blue-500" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate text-sm">Dashboard</span>
                }
            </a>
            }

            @if (IsModuleVisible("tickets"))
            {
            <!-- Tickets Dropdown -->
            <div class="space-y-1">
                <button @onclick='() => ToggleGroup("supervisor-tickets")'
                    class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/tickets") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <span class="flex-1 text-left font-medium truncate text-sm">Tickets</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200 @(expandedGroups.Contains("supervisor-tickets") ? "rotate-180" : "")"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                </button>
                @if (isSidebarExpanded && expandedGroups.Contains("supervisor-tickets"))
                {
                    <div class="pl-11 space-y-1">
                        <a href="/supervisor/tickets"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">View All</a>
                        <a href="/supervisor/tickets/create"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Create New</a>
                    </div>
                }
            </div>
            }

            @if (IsModuleVisible("orders"))
            {
            <!-- Orders Dropdown -->
            <div class="space-y-1">
                <button @onclick='() => ToggleGroup("supervisor-orders")'
                    class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/orders") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <span class="flex-1 text-left font-medium truncate text-sm">Orders</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200 @(expandedGroups.Contains("supervisor-orders") ? "rotate-180" : "")"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                </button>
                @if (isSidebarExpanded && expandedGroups.Contains("supervisor-orders"))
                {
                    <div class="pl-11 space-y-1">
                        <a href="/supervisor/orders"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">View Orders</a>
                        <a href="/supervisor/orders/tracking"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Tracking</a>
                    </div>
                }
            </div>
            }

            @if (IsModuleVisible("calls"))
            {
            <!-- Call Logs -->
            <div class="space-y-1">
                <button @onclick='() => ToggleGroup("supervisor-calls")'
                    class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/calls") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <span class="flex-1 text-left font-medium truncate text-sm">Call Logs</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200 @(expandedGroups.Contains("supervisor-calls") ? "rotate-180" : "")"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                </button>
                @if (isSidebarExpanded && expandedGroups.Contains("supervisor-calls"))
                {
                    <div class="pl-11 space-y-1">
                        <a href="/supervisor/calls"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">History</a>
                    </div>
                }
            </div>
            }

            @if (IsModuleVisible("iam"))
            {
            <!-- Agents -->
            <div class="space-y-1">
                <button @onclick='() => ToggleGroup("supervisor-agents")'
                    class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/agents") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <span class="flex-1 text-left font-medium truncate text-sm">Agents</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200 @(expandedGroups.Contains("supervisor-agents") ? "rotate-180" : "")"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                </button>
                @if (isSidebarExpanded && expandedGroups.Contains("supervisor-agents"))
                {
                    <div class="pl-11 space-y-1">
                        <a href="/supervisor/agents"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Profiles</a>
                        <a href="/supervisor/agents/performance"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Performance</a>
                    </div>
                }
            </div>
            }

            @if (IsModuleVisible("customers"))
            {
            <!-- Customers -->
            <a href="/supervisor/customers/search"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/customers") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate text-sm">Customers</span>
                }
            </a>
            }

            @if (IsModuleVisible("catalog"))
            {
            <!-- Inventory -->
            <a href="/supervisor/inventory/stock"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/inventory") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate">Inventory</span>
                }
            </a>
            }

            @if (IsModuleVisible("reports"))
            {
            <!-- Financials -->
            <a href="/supervisor/financials/sales"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/financials") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate">Financials</span>
                }
            </a>
            }

            @if (IsModuleVisible("reports"))
            {
            <!-- Reports -->
            <div class="space-y-1">
                <button @onclick='() => ToggleGroup("supervisor-reports")'
                    class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/reports") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                    <div class="flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                    </div>
                    @if (isSidebarExpanded)
                    {
                        <span class="flex-1 text-left font-medium truncate text-sm">Reports</span>
                        <svg class="w-4 h-4 text-gray-500 transition-transform duration-200 @(expandedGroups.Contains("supervisor-reports") ? "rotate-180" : "")"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    }
                </button>
                @if (isSidebarExpanded && expandedGroups.Contains("supervisor-reports"))
                {
                    <div class="pl-11 space-y-1">
                        <a href="/supervisor/reports/tickets"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Tickets</a>
                        <a href="/supervisor/reports/performance"
                            class="block py-2 text-sm text-gray-400 hover:text-white transition-colors">Performance</a>
                    </div>
                }
            </div>
            }

            @if (IsModuleVisible("notifications"))
            {
            <!-- Notifications -->
            <a href="/supervisor/notifications"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/notifications") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate text-sm">Notifications</span>
                }
            </a>
            }

            @if (IsModuleVisible("notifications"))
            {
            <!-- Help & Support -->
            <a href="/supervisor/help"
                class="flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative @(IsActive("/supervisor/help") ? "bg-blue-600/10 text-blue-400" : "text-gray-400 hover:bg-gray-800/50 hover:text-gray-100")">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate text-sm">Help & Support</span>
                }
            </a>
            }

            <button @onclick="Logout"
                class="w-full flex items-center gap-3 px-3 py-3 rounded-lg transition-all group relative text-gray-400 hover:bg-gray-800/50 hover:text-gray-100">
                <div class="flex-shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                </div>
                @if (isSidebarExpanded)
                {
                    <span class="font-medium truncate text-sm">Logout</span>
                }
            </button>

        </nav>

        <!-- Profile Footer -->
        <div class="p-4 border-t border-white/5 bg-[#0B1120]">
            <div class="flex items-center gap-3">
                <div
                    class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-500/20 to-indigo-500/10 flex items-center justify-center flex-shrink-0 border border-teal-400/20 shadow-sm">
                    <!-- Initials Avatar -->
                    <span class="text-xs font-bold text-teal-300">@userInitials</span>
                </div>
                @if (isSidebarExpanded)
                {
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-white truncate">@userName</p>
                        <p class="text-[10px] text-gray-400 truncate">Supervisor</p>
                        <p class="text-[10px] text-teal-300/80 truncate">@currentBranchLabel</p>
                    </div>
                }
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="flex-1 flex flex-col min-w-0 transition-[margin] duration-300 @GetMainContentMarginClass()">
        <!-- Top bar -->
        <header
            class="supervisor-topbar h-16 shrink-0 flex items-center gap-4 px-4 lg:px-6 bg-white/95 backdrop-blur-sm border-b border-gray-200/60 shadow-sm z-10">
            <div class="flex-1 min-w-0">
                <p class="text-[22px] font-bold text-gray-900 leading-tight truncate">@topbarTitle</p>
                <p class="text-[12px] text-gray-500 truncate">@topbarSubtitle</p>
            </div>
            <div class="hidden md:flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">@currentBranchLabel</span>
                <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">@liveHeaderDateTime</span>
            </div>
        </header>
        <!-- Page Content -->
        <main class="supervisor-main flex-1 overflow-x-hidden overflow-y-auto bg-gradient-to-br from-[#F3F4F6] via-[#F3F4F6] to-teal-50/20" style="font-family: Inter, sans-serif; font-size: 12px;">
            @Body
        </main>
    </div>
</div>

<style>
    /* Sidebar: desktop fixed width + smooth transition; mobile overlay */
    .supervisor-sidebar {
        background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
    }

    .supervisor-sidebar.sidebar-expanded {
        width: 18rem;
        /* w-72 = 288px */
    }

    .supervisor-sidebar.sidebar-collapsed {
        width: 4rem;
        /* w-16 */
    }

    @@media (min-width: 1024px) {
        .supervisor-sidebar {
            transition: width 0.3s ease;
        }
    }

    @@media (max-width: 1023px) {
        .supervisor-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100%;
            z-index: 30;
            transition: transform 0.3s ease, width 0.3s ease;
        }

        .supervisor-sidebar.sidebar-collapsed {
            transform: translateX(-100%);
            width: 18rem;
        }

        .supervisor-sidebar.sidebar-expanded {
            transform: translateX(0);
        }
    }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background-color: rgba(255, 255, 255, 0.2);
    }

    /* Supervisor-wide visual baseline */
    .supervisor-main > .space-y-6,
    .supervisor-main > .space-y-4 {
        padding: 1.5rem;
    }

    .supervisor-main h1.text-2xl {
        font-size: 22px;
        line-height: 1.2;
    }

    .supervisor-main .grid.grid-cols-1.md\:grid-cols-4.gap-6.mb-6 > .bg-white.p-6.rounded-lg.shadow,
    .supervisor-main .grid.grid-cols-1.md\:grid-cols-3.gap-6.mb-6 > .bg-white.p-6.rounded-lg.shadow {
        background: linear-gradient(135deg, #f8fafc 0%, #ffffff 72%);
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
    }

    .supervisor-main .page-title-block {
        display: none;
    }

    /* Keep page action buttons, move title/subtitle responsibility to topbar */
    .supervisor-main > div > div:first-child h1,
    .supervisor-main > div > div:first-child p {
        display: none;
    }

    @@media (max-width: 767px) {
        /* Mobile resilience: prevent cramped/broken layouts on phones only */
        .supervisor-main .sv-panel,
        .supervisor-main .sv-sc-card,
        .supervisor-main .bg-white.rounded-xl,
        .supervisor-main .bg-white.rounded-lg,
        .supervisor-main .rounded-2xl,
        .supervisor-main .rounded-xl {
            max-width: 100%;
