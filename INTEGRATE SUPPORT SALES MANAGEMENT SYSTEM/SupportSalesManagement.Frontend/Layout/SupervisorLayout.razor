@code {
    private bool isSidebarExpanded = true;
    private HashSet<string> expandedGroups = new HashSet<string>();
    private string userName = "Supervisor";
    private string userInitials = "SV";
    private ModuleAccessConfig? moduleAccessConfig;
    private TenantSubscriptionModel? tenantSubscription;
    private string topbarTitle = "Supervisor Dashboard";
    private string topbarSubtitle = "Overview";
    private string liveHeaderDateTime = DateTime.Now.ToString("ddd, MMM dd • hh:mm tt");
    private string currentBranchLabel = "System Branch: Unassigned";
    private System.Timers.Timer? _topbarClockTimer;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        UpdateTopbarFromRoute(NavigationManager.Uri);
        StartTopbarClock();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadModuleVisibilityPolicyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var user = await LocalStorage.GetItemAsync<User>("user");
                if (user is not null)
                {
                    var first = (user.FirstName ?? "").Trim();
                    var last = (user.LastName ?? "").Trim();
                    var fullName = $"{first} {last}".Trim();

                    userName = string.IsNullOrEmpty(fullName) ? "Supervisor" : fullName;
                    userInitials = string.IsNullOrEmpty(fullName)
                        ? "SV"
                        : string.Concat(
                            string.IsNullOrEmpty(first) ? "" : first[..1],
                            string.IsNullOrEmpty(last) ? "" : last[..1]
                          ).ToUpperInvariant();

                    var branchName = string.IsNullOrWhiteSpace(user.BranchName) ? null : user.BranchName.Trim();
                    if (branchName is null && user.BranchId > 0)
                    {
                        try
                        {
                            var users = await ApiClient.GetUsersAsync();
                            branchName = users?.FirstOrDefault(u => u.Id == user.Id)?.BranchName?.Trim();
                        }
                        catch
                        {
                        }
                    }

                    if (branchName is null && user.BranchId > 0)
                    {
                        try
                        {
                            var branches = await ApiClient.GetBranchesAsync();
                            branchName = branches?.FirstOrDefault(b => b.Id == user.BranchId)?.Name?.Trim();
                        }
                        catch
                        {
                        }
                    }

                    currentBranchLabel = user.BranchId > 0
                        ? (branchName is not null
                            ? $"System Branch: {branchName}"
                            : "System Branch: Unassigned")
                        : "System Branch: Unassigned";
                }
            }
            catch { }

            StateHasChanged();
        }
    }

    private string GetSidebarClass()
    {
        return isSidebarExpanded ? "sidebar-expanded" : "sidebar-collapsed";
    }

    private string GetMainContentMarginClass() => "";

    private void OnHamburgerClick()
    {
        isSidebarExpanded = !isSidebarExpanded;
        StateHasChanged();
    }

    private void ToggleGroup(string groupName)
    {
        if (expandedGroups.Contains(groupName))
            expandedGroups.Remove(groupName);
        else
            expandedGroups.Add(groupName);
        StateHasChanged();
    }

    private async Task Logout()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Confirm logout?");
        if (!confirmed)
        {
            return;
        }

        await ApiClient.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    private bool IsActive(string path)
    {
        if (string.IsNullOrEmpty(path)) return false;
        try
        {
            var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            var absolutePath = "/" + relativePath.Split('?')[0].Trim('/');
            var targetPath = "/" + path.Trim('/');

            return absolutePath.Equals(targetPath, StringComparison.OrdinalIgnoreCase) ||
            (targetPath != "/" && absolutePath.StartsWith(targetPath + "/", StringComparison.OrdinalIgnoreCase));
        }
        catch { return false; }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        _topbarClockTimer?.Stop();
        _topbarClockTimer?.Dispose();
    }

    private void StartTopbarClock()
    {
        _topbarClockTimer = new System.Timers.Timer(30000);
        _topbarClockTimer.Elapsed += (_, _) =>
        {
            liveHeaderDateTime = DateTime.Now.ToString("ddd, MMM dd • hh:mm tt");
            InvokeAsync(StateHasChanged);
        };
        _topbarClockTimer.Start();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateTopbarFromRoute(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTopbarFromRoute(string absoluteUri)
    {
        var path = "/" + NavigationManager.ToBaseRelativePath(absoluteUri).Split('?')[0].Trim('/').ToLowerInvariant();

        if (path.StartsWith("/supervisor/customers/history", StringComparison.OrdinalIgnoreCase))
        {
            topbarTitle = "Customer Interaction History";
            topbarSubtitle = "Timeline of customer engagements";
            return;
        }

        (topbarTitle, topbarSubtitle) = path switch
        {
            "/supervisor/dashboard" => ("Supervisor Dashboard", "Overview of team performance and operations"),
            "/supervisor/agents" => ("Agent Management", "Manage agent profiles and status"),
            "/supervisor/agents/performance" => ("Agent Performance Reports", "Track team productivity and metrics"),
            "/supervisor/orders" => ("Order Management", "View and manage all customer orders"),
            "/supervisor/orders/tracking" => ("Order Tracking", "Track order and shipment progress"),
            "/supervisor/orders/returns" => ("Returns Management", "Manage returns and refund requests"),
            "/supervisor/tickets" => ("Tickets", "Manage and track support requests"),
            "/supervisor/tickets/create" => ("Create New Support Ticket", "Open a new case for a customer"),
            "/supervisor/calls" => ("Call Logs", "Review all call interactions"),
            "/supervisor/customers/search" => ("Customer Search", "Search and view customer profiles"),
            "/supervisor/customers/history" => ("Customer Interaction History", "Timeline of customer engagements"),
            "/supervisor/inventory/stock" => ("Stock Levels", "View inventory stock levels"),
            "/supervisor/inventory/availability" => ("Product Availability", "Check real-time product availability"),
            "/supervisor/inventory/alerts" => ("Low Stock Alerts", "Monitor low inventory notifications"),
            "/supervisor/financials/sales" => ("Sales Reports", "Sales performance and metrics"),
            "/supervisor/financials/revenue" => ("Revenue Trends", "Analyze revenue patterns"),
            "/supervisor/financials/refunds" => ("Refunds & Cancellations Summary", "Track refunds and cancellations"),
            "/supervisor/reports" => ("Performance Reports", "Combined operational insights"),
            "/supervisor/reports/tickets" => ("Ticket Resolution Reports", "Analyze ticket resolution performance"),
            "/supervisor/reports/performance" => ("Agent Performance Reports", "Detailed agent leaderboard and KPIs"),
            "/supervisor/reports/inventory-financial" => ("Inventory & Financial Reports", "Inventory and financial insights"),
            "/supervisor/notifications" => ("Notifications & Alerts", "Stay updated with latest activities"),
            "/supervisor/help" => ("Help & Support", "Guides and support resources"),
            "/supervisor/settings" => ("Settings", "Manage supervisor preferences"),
            "/supervisor/erp" => ("ERP Data Integration", "Connected service status and logs"),
            _ => ("Supervisor", "Operations workspace")
        };
    }

    private async Task LoadModuleVisibilityPolicyAsync()
    {
        try
        {
            moduleAccessConfig = await ApiClient.GetModuleAccessConfigAsync();
            tenantSubscription = await ApiClient.GetMySubscriptionAsync();
        }
        catch
        {
            moduleAccessConfig = null;
            tenantSubscription = null;
        }
    }

    private bool IsModuleVisible(string moduleKey)
    {
        return ModuleVisibilityHelper.IsModuleVisible(
            moduleKey,
            UserRole.Supervisor,
            moduleAccessConfig,
            tenantSubscription);
    }
}
