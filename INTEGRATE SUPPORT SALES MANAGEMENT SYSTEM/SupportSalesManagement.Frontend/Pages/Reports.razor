@page "/reports"
@layout ERPMainLayout
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@using System.Globalization

<PageTitle>Business Reports | ClassicFit</PageTitle>

<div class="space-y-6 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Performance Dashboard</h1>
            <p class="text-gray-500 text-sm">Real-time business metrics and operational insights</p>
        </div>
        <div class="flex items-center gap-2 bg-white px-4 py-2 rounded-xl shadow-sm border border-gray-100">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span class="text-sm font-medium text-gray-600">Live Data: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-3xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 border-4 border-[#80A1BA]/20 border-t-[#80A1BA] rounded-full animate-spin"></div>
            <p class="mt-4 text-gray-500 font-medium">Aggregating business metrics...</p>
        </div>
    }
    else
    {
        <!-- KPI Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Revenue Card -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-[#3B82F6]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.343-3 3s1.343 3 3 3 3-1.343 3-3-1.343-3-3-3zM12 2a10 10 0 100 20 10 10 0 000-20z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 12v.01M12 14v.01" />
                        </svg>
                    </div>
                </div>
                <h3 class="text-gray-500 text-sm font-medium">Total Revenue</h3>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-2xl font-bold text-gray-900">₱@totalRevenue.ToString("N2")</span>
                </div>
                
            </div>

            <!-- Support Card -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-teal-50 rounded-2xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-[#91C4C3]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                    </div>
                </div>
                <h3 class="text-gray-500 text-sm font-medium">Active Tickets</h3>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-2xl font-bold text-gray-900">@activeTicketsCount</span>
                </div>
                <div class="mt-4 flex items-center text-xs text-blue-600 font-medium">
                    <span class="px-2 py-0.5 bg-blue-50 rounded-full">@criticalTicketsCount Critical</span>
                </div>
            </div>

            <!-- Growth Card -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-purple-50 rounded-2xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                </div>
                <h3 class="text-gray-500 text-sm font-medium">Total Customers</h3>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-2xl font-bold text-gray-900">@customerCount</span>
                </div>
                
            </div>

            <!-- Inventory Card -->
            <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                <div class="flex items-center justify-between mb-4">
                    <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center">
                        <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                </div>
                <h3 class="text-gray-500 text-sm font-medium">Low Stock Items</h3>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-2xl font-bold text-gray-900">@lowStockCount</span>
                </div>
                <div class="mt-4 flex items-center text-xs @(lowStockCount > 10 ? "text-red-500" : "text-amber-500") font-medium">
                    @(lowStockCount > 0 ? "Action required" : "Inventory healthy")
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Sales Trends -->
            <div class="lg:col-span-2 bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-lg font-bold text-gray-900">Sales vs Target</h3>
                    <div class="flex items-center gap-4 text-sm font-medium">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-[#3B82F6]"></span>
                            <span class="text-gray-600">Actual</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-gray-200"></span>
                            <span class="text-gray-600">Target</span>
                        </div>
                    </div>
                </div>

                <div class="space-y-8">
                    @foreach (var category in categorySales)
                    {
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm">
                                <span class="font-bold text-gray-700">@category.Key</span>
                                <span class="text-gray-500">₱@category.Value.ToString("N0") / ₱@((category.Value * 1.2m).ToString("N0"))</span>
                            </div>
                            <div class="h-4 bg-gray-100 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-[#80A1BA] to-[#3B82F6] rounded-full transition-all duration-1000" 
                                     style="width: @(GetCategorySalesPercent(category.Value))%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Priority Tickets -->
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100">
                <h3 class="text-lg font-bold text-gray-900 mb-6">Urgent Tickets</h3>
                <div class="space-y-4">
                    @if (topTickets == null || !topTickets.Any())
                    {
                        <p class="text-sm text-gray-500 italic">No high-priority tickets found.</p>
                    }
                    else
                    {
                        @foreach (var ticket in topTickets)
                        {
                            <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-gray-50 transition-colors border border-transparent hover:border-gray-100 cursor-pointer"
                                 @onclick='() => NavigationManager.NavigateTo($"/tickets/{ticket.Id}")'>
                                <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                    </svg>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-bold text-gray-900 truncate">@ticket.Title</p>
                                    <p class="text-xs text-gray-500 mt-0.5">@ticket.CreatedAt.ToString("MMM dd, h:mm tt")</p>
                                </div>
                            </div>
                        }
                    }
                </div>
                
                <button class="w-full mt-6 py-3 bg-gray-50 hover:bg-gray-100 text-gray-600 font-bold text-sm rounded-2xl transition-colors"
                        @onclick='() => NavigationManager.NavigateTo("/tickets")'>
                    View All Tickets
                </button>
            </div>
        </div>

        <!-- Recent Activity Table -->
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
                <h3 class="text-lg font-bold text-gray-900">Recent Transactions</h3>
                <button class="text-[#3B82F6] font-bold text-sm hover:underline" @onclick='() => NavigationManager.NavigateTo("/orders")'>
                    View All Orders
                </button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-xs font-bold text-gray-400 uppercase tracking-wider">
                            <th class="px-8 py-4">Order ID</th>
                            <th class="px-8 py-4">Customer</th>
                            <th class="px-8 py-4">Date</th>
                            <th class="px-8 py-4 text-right">Amount</th>
                            <th class="px-8 py-4">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var order in pagedRecentOrders)
                        {
                            <tr class="hover:bg-gray-50/50 transition-colors cursor-pointer" @onclick='() => NavigationManager.NavigateTo($"/orders/{order.Id}")'>
                                <td class="px-8 py-4 text-sm font-bold text-gray-900">@order.OrderNumber</td>
                                <td class="px-8 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-600">
                                            @(order.Customer?.FirstName?.FirstOrDefault().ToString() ?? "C")
                                        </div>
                                        <span class="text-sm text-gray-600 font-medium">@order.Customer?.FirstName @order.Customer?.LastName</span>
                                    </div>
                                </td>
                                <td class="px-8 py-4 text-sm text-gray-500">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-8 py-4 text-sm font-bold text-gray-900 text-right">₱@order.TotalAmount.ToString("N2")</td>
                                <td class="px-8 py-4">
                                    <span class="px-3 py-1 bg-green-50 text-green-700 text-xs font-bold rounded-full">@order.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (recentOrders.Any())
            {
                <div class="px-8 py-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-sm text-gray-500">Showing @(((ordersCurrentPage - 1) * tablePageSize) + 1)-@Math.Min(ordersCurrentPage * tablePageSize, recentOrders.Count) of @recentOrders.Count · Page @ordersCurrentPage/@ordersTotalPages</span>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousOrdersPage" disabled="@(ordersCurrentPage <= 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextOrdersPage" disabled="@(ordersCurrentPage >= ordersTotalPages)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private decimal totalRevenue = 0;
    private int activeTicketsCount = 0;
    private int criticalTicketsCount = 0;
    private int customerCount = 0;
    private int lowStockCount = 0;
    private List<Order> recentOrders = new();
    private List<Ticket> topTickets = new();
    private Dictionary<string, decimal> categorySales = new();
    private int ordersCurrentPage = 1;
    private const int tablePageSize = 5;
    private int ordersTotalPages => Math.Max(1, (int)Math.Ceiling(recentOrders.Count / (double)tablePageSize));
    private List<Order> pagedRecentOrders => recentOrders.Skip((ordersCurrentPage - 1) * tablePageSize).Take(tablePageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private async Task LoadReportData()
    {
        isLoading = true;
        try
        {
            // Fetch concurrent data
            var ticketsTask = ApiClient.GetTicketsAsync();
            var customersTask = ApiClient.GetCustomersAsync();
            var ordersTask = ApiClient.GetOrdersAsync();
            var financialTask = ApiClient.GetErpFinancialSummaryAsync();
            var lowStockTask = ApiClient.GetErpLowStockItemsAsync();

            await Task.WhenAll(ticketsTask, customersTask, ordersTask, financialTask, lowStockTask);

            var tickets = ticketsTask.Result ?? new();
            var orders = ordersTask.Result ?? new();
            var customers = customersTask.Result ?? new();
            var financial = financialTask.Result;
            var lowStock = lowStockTask.Result ?? new();

            // Aggregate metrics
            activeTicketsCount = tickets.Count(t => t.Status != "Resolved" && t.Status != "Closed");
            criticalTicketsCount = tickets.Count(t => t.Priority == "Critical");
            customerCount = customers.Count;
            lowStockCount = lowStock.Count;
            
            totalRevenue = financial?.TotalRevenue ?? orders.Sum(o => o.TotalAmount);
            
            topTickets = tickets.Where(t => t.Priority == "Critical" || t.Priority == "High")
                               .OrderByDescending(t => t.CreatedAt)
                               .Take(4).ToList();

            recentOrders = orders.OrderByDescending(o => o.OrderDate).ToList();
            ordersCurrentPage = 1;

            categorySales = new Dictionary<string, decimal>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetCategorySalesPercent(decimal actual)
    {
        var target = actual * 1.2m;
        if (target == 0) return 0;
        var pct = (int)Math.Round(actual / target * 100);
        return Math.Clamp(pct, 0, 100);
    }

    private void PreviousOrdersPage()
    {
        if (ordersCurrentPage <= 1) return;
        ordersCurrentPage--;
    }

    private void NextOrdersPage()
    {
        if (ordersCurrentPage >= ordersTotalPages) return;
        ordersCurrentPage++;
    }

}

<style>
    .animate-fade-in {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Custom scrollbar for better UX */
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
</style>
