@page "/tickets/create"
@layout AgentLayout
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@using SupportSalesManagement.Frontend.Models
@using CustomerModel = SupportSalesManagement.Frontend.Models.Customer
@using SupportSalesManagement.Frontend.Services

<PageTitle>Create New Ticket | Support System</PageTitle>

<div class="w-full max-w-6xl mx-auto px-4 md:px-6 py-6" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="mb-6 flex items-center gap-4">
        <button @onclick='() => NavigationManager.NavigateTo("/agent/dashboard")'
            class="p-2 rounded-lg hover:bg-gray-100 text-gray-500 transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
        </button>
        <div>
            <h1 class="text-[21px] font-bold text-[#1E1E2D]">Create New Support Ticket</h1>
            <p class="text-[12px] text-gray-500">Fill in the details below to open a new case.</p>
        </div>
    </div>

    <div
        class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-7">
        @if (isLoading)
        {
            <div class="flex justify-center py-12">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--color-primary)]"></div>
            </div>
        }
        else
        {
            <form @onsubmit="SaveTicket" class="space-y-6">
                <!-- Linked Call Indicator -->
                @if (linkedCallId.HasValue)
                {
                    <div class="flex items-center gap-3 bg-blue-50 border border-blue-200 rounded-xl px-4 py-3">
                        <svg class="w-5 h-5 text-blue-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <div>
                            <span class="text-sm font-bold text-blue-800">Linked to Call #@linkedCallId</span>
                            <p class="text-xs text-blue-600">This ticket will be associated with the call record for traceability.</p>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(linkedCallValidationError))
                {
                    <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                        @linkedCallValidationError
                    </div>
                }

                <!-- Customer Selection -->
                <div>
                    <label class="block text-sm font-semibold text-[#1E1E2D] mb-2">Select
                        Customer</label>
                    <select @bind="ticketForm.CustomerId" required
                        class="block w-full px-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)] transition-all text-gray-900">
                        <option value="">-- Choose a Customer --</option>
                        @if (customers != null)
                        {
                            @foreach (var customer in customers)
                            {
                                <option value="@customer.Id">@customer.FirstName @customer.LastName (@customer.Email)</option>
                            }
                        }
                    </select>
                </div>

                <!-- Ticket Details -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-[#1E1E2D] mb-2">Priority</label>
                        <select @bind="ticketForm.Priority" required
                            class="block w-full px-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)] transition-all text-gray-900">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-[#1E1E2D] mb-2">Category</label>
                        <select @bind="ticketForm.Category" required
                            class="block w-full px-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)] transition-all text-gray-900">
                            <option value="General">General</option>
                            <option value="Technical">Technical</option>
                            <option value="Billing">Billing</option>
                            <option value="Sales">Sales</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-[#1E1E2D] mb-2">Subject /
                        Title</label>
                    <input type="text" @bind="ticketForm.Title" required placeholder="Brief summary of the issue..."
                        class="block w-full px-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)] transition-all text-gray-900 placeholder-gray-400" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-[#1E1E2D] mb-2">Description</label>
                    <textarea @bind="ticketForm.Description" rows="6" required
                        placeholder="Detailed explanation of the problem..."
                        class="block w-full px-4 py-3 bg-white border border-gray-300 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] focus:border-[var(--color-primary)] transition-all text-gray-900 placeholder-gray-400 resize-none"></textarea>
                </div>

                <!-- Actions -->
                <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
                    <button type="button" @onclick='() => NavigationManager.NavigateTo("/tickets")'
                        class="px-6 py-2.5 rounded-xl font-bold text-gray-500 hover:bg-gray-100 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" disabled="@isSaving"
                        class="px-6 py-2.5 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white rounded-xl font-bold shadow-lg shadow-blue-900/20 disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-2">
                        @if (isSaving)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                                </circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                            <span>Submitting...</span>
                        }
                        else
                        {
                            <span>Create Ticket</span>
                        }
                    </button>
                </div>
            </form>
        }
    </div>
</div>

@code {
    private CreateTicketRequest ticketForm = new();
    private List<CustomerModel> customers = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private int? linkedCallId = null;
    private int currentAgentId;
    private string linkedCallValidationError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Parse query parameters for pre-fill from call
        var uri = new Uri(NavigationManager.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var queryParams = uri.Query.TrimStart('?').Split('&')
                .Select(p => p.Split('='))
                .Where(p => p.Length == 2)
                .ToDictionary(p => p[0], p => Uri.UnescapeDataString(p[1]));

            if (queryParams.TryGetValue("customerId", out var custIdStr) && int.TryParse(custIdStr, out var custId))
            {
                ticketForm.CustomerId = custId;
            }

            if (queryParams.TryGetValue("callId", out var callIdStr) && int.TryParse(callIdStr, out var callId))
            {
                linkedCallId = callId;
                ticketForm.RelatedCallId = callId;
            }
        }

        // Auto-assign to current agent
        var user = await ApiClient.GetCurrentUserAsync();
        if (user != null)
        {
            currentAgentId = user.Id;
            ticketForm.AssignedAgentId = user.Id;
        }

        if (linkedCallId.HasValue)
        {
            await ValidateLinkedCallAsync();
        }

        await LoadCustomers();
    }

    private async Task ValidateLinkedCallAsync()
    {
        linkedCallValidationError = string.Empty;
        if (!linkedCallId.HasValue)
        {
            return;
        }

        var call = await ApiClient.GetCallAsync(linkedCallId.Value);
        if (call == null)
        {
            linkedCallValidationError = $"Linked call #{linkedCallId.Value} was not found.";
            return;
        }

        if (currentAgentId > 0 && call.AgentId != currentAgentId)
        {
            linkedCallValidationError = $"Linked call #{linkedCallId.Value} is not assigned to your account.";
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            customers = (await ApiClient.GetCustomersAsync()) ?? new List<CustomerModel>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveTicket()
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Confirm create this ticket?");
        if (!confirm) return;

        if (!string.IsNullOrWhiteSpace(linkedCallValidationError))
        {
            await JSRuntime.InvokeVoidAsync("alert", linkedCallValidationError);
            return;
        }

        isSaving = true;
        try
        {
            var created = await ApiClient.CreateTicketAsync(ticketForm);
            if (created != null)
            {
                // Navigate back to the agent tickets page
                NavigationManager.NavigateTo("/agent/tickets");
            }
            else
            {
                NavigationManager.NavigateTo("/agent/tickets");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving ticket: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }
}
