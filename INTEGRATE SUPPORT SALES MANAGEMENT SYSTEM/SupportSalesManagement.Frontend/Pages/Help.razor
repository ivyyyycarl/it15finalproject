@page "/help"
@layout ERPMainLayout
@inject NavigationManager NavigationManager

<PageTitle>Help & Support | ClassicFit</PageTitle>

<div class="h-[calc(100vh-theme(spacing.16))] flex flex-col bg-gray-50 dark:bg-[#151521] overflow-hidden">
    <!-- Header -->
    <div
        class="bg-white dark:bg-[#1E1E2D] border-b border-gray-200 dark:border-gray-700 px-6 py-4 flex items-center justify-between shrink-0">
        <div>
            <h1 class="text-xl font-bold text-[#1E1E2D] dark:text-white">Help & Support</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">Resources and guides for using the workspace</p>
        </div>
        <button
            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold py-2 px-4 rounded-lg shadow-lg shadow-blue-500/20 transition-all">
            Contact Admin
        </button>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-y-auto p-6">
        <div class="max-w-4xl mx-auto space-y-6">

            <!-- Quick Links -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div
                    class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow cursor-pointer">
                    <div
                        class="w-12 h-12 bg-blue-50 dark:bg-blue-900/20 rounded-lg flex items-center justify-center text-blue-600 dark:text-blue-400 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-2">User Guide</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Comprehensive documentation on how to use the
                        Agent Workspace.</p>
                </div>

                <div
                    class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow cursor-pointer">
                    <div
                        class="w-12 h-12 bg-purple-50 dark:bg-purple-900/20 rounded-lg flex items-center justify-center text-purple-600 dark:text-purple-400 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-2">FAQs</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Answers to common questions about workflows and
                        features.</p>
                </div>

                <div
                    class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 hover:shadow-md transition-shadow cursor-pointer">
                    <div
                        class="w-12 h-12 bg-green-50 dark:bg-green-900/20 rounded-lg flex items-center justify-center text-green-600 dark:text-green-400 mb-4">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-2">System Status</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400">Check the current status of ERP integrations and
                        servers.</p>
                </div>
            </div>

            <!-- FAQ Accordion -->
            <div
                class="bg-white dark:bg-[#1E1E2D] rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
                <h2 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-6">Common Questions</h2>
                <div class="space-y-4">
                    <div class="border-b border-gray-100 dark:border-gray-700 pb-4">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white text-sm mb-2">How do I reset my password?
                        </h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">You can reset your password from the login
                            screen by clicking "Forgot Password" or by contacting your system administrator.</p>
                    </div>
                    <div class="border-b border-gray-100 dark:border-gray-700 pb-4">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white text-sm mb-2">How do I escalate a ticket?
                        </h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Open the ticket you wish to escalate, change
                            the status to "Escalated", and assign it to the appropriate supervisor from the dropdown
                            menu.</p>
                    </div>
                    <div class="pb-2">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white text-sm mb-2">Where can I find order
                            history?</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Navigate to the "Orders" section in the
                            sidebar and select "Order History" or search for a specific order number.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {

}
