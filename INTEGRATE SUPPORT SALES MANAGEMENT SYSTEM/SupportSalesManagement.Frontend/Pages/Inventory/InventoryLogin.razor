@page "/inventory/login"
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient

<PageTitle>Inventory Management Login - SupportFlow ERP</PageTitle>

<div class="min-h-screen bg-slate-100 flex items-center justify-center p-4">
    <div class="max-w-md w-full bg-white rounded-lg shadow-xl overflow-hidden border border-slate-200">
        <!-- Header -->
        <div class="bg-slate-800 p-8 text-center">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-slate-700 rounded-xl mb-4 shadow-lg border border-slate-600">
                <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-white tracking-wide">Inventory Management</h1>
            <p class="text-slate-400 text-sm mt-2">Authorized Personnel Only</p>
        </div>

        <!-- Login Form -->
        <div class="p-8">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-6 p-4 bg-red-50 border-l-4 border-red-500 rounded-r-sm flex items-start gap-3 animate-pulse">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <div>
                        <p class="text-sm font-bold text-red-800">Access Denied</p>
                        <p class="text-xs text-red-700 mt-1">@errorMessage</p>
                    </div>
                </div>
            }

            <form @onsubmit="HandleLogin">
                <div class="space-y-6">
                    <!-- Admin ID -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                            Admin ID / Username
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-slate-400 group-focus-within:text-blue-600 transition-colors"
                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <input type="text" @bind="adminId"
                                class="block w-full pl-10 pr-3 py-3 border-2 border-slate-200 rounded-md leading-5 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-0 transition-colors duration-200 sm:text-sm"
                                placeholder="e.g. ADM-8821" required />
                        </div>
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
                            Password
                        </label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="w-5 h-5 text-slate-400 group-focus-within:text-blue-600 transition-colors"
                                    fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="password" @bind="password"
                                class="block w-full pl-10 pr-3 py-3 border-2 border-slate-200 rounded-md leading-5 bg-slate-50 text-slate-900 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-0 transition-colors duration-200 sm:text-sm"
                                placeholder="••••••••••••" required />
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="flex items-center justify-between">
                        <div class="flex items-center">
                            <input id="remember-me" name="remember-me" type="checkbox"
                                class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer">
                            <label for="remember-me" class="ml-2 block text-sm text-slate-600 cursor-pointer">
                                Keep session active
                            </label>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" disabled="@isLoading"
                        class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-bold text-white bg-slate-800 hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 transform hover:-translate-y-0.5">
                        @if (isLoading)
                        {
                            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                                </circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                            <span>Authenticating...</span>
                        }
                        else
                        {
                            <span>Sign In to Console</span>
                        }
                    </button>
                </div>
            </form>
        </div>

        <!-- Footer -->
        <div class="bg-gray-50 px-8 py-4 border-t border-gray-200">
            <p class="text-xs text-center text-gray-500">
                Restricted System - ERP Inventory Module v2.4<br>
                Integrated Support Sales Management System
            </p>
        </div>
    </div>
</div>

@code {
    private string adminId = "";
    private string password = "";
    private bool isLoading = false;
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        try
        {
            var loginRequest = new LoginRequest
            {
                Email = adminId,
                Password = password
            };

            var response = await ApiClient.LoginAsync(loginRequest);
            if (response != null)
            {
                NavigationManager.NavigateTo("/inventory/dashboard");
            }
            else
            {
                errorMessage = "Invalid credentials or insufficient privileges.";
            }
        }
        catch (Exception)
        {
            errorMessage = "An error occurred during authentication. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
