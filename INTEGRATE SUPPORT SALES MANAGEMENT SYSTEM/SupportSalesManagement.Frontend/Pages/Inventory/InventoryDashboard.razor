@page "/inventory/dashboard"
@using SupportSalesManagement.Frontend.Shared
@using Microsoft.AspNetCore.Components.Web
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@layout ERPMainLayout
@inject NavigationManager NavigationManager
@inject IInventoryService InventoryService
@inject IFinanceService FinanceService
@inject AuthenticationService AuthService

<PageTitle>Inventory Dashboard - SupportFlow ERP</PageTitle>

<div class="space-y-6 animate-fade-in">
    <!-- Page Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Inventory Management</h1>
            <p class="text-slate-500">Real-time stock tracking and product catalog</p>
        </div>
        <div class="flex items-center gap-3">
            <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export Report
            </button>
            @if (CanManageInventory)
            {
                <button @onclick="OpenAddModal" class="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors shadow-sm hover:shadow-md">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Add New Product
                </button>
            }
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Total Products -->
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
                <span class="flex items-center gap-1 text-xs font-semibold text-green-600 bg-green-50 px-2.5 py-1 rounded-full">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                    +4.5%
                </span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-800">@stats.TotalItems</h3>
                <p class="text-sm text-slate-500">Total Items in Stock</p>
            </div>
        </div>

        <!-- Inventory Value (ERP Finance) -->
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2.5 py-1 rounded-full">
                    Finance API
                </span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-800">@totalInventoryValue.ToString("C0")</h3>
                <p class="text-sm text-slate-500">Total Inventory Value</p>
            </div>
        </div>

        <!-- Low Stock Alerts -->
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <span class="text-xs font-semibold text-orange-600 bg-orange-50 px-2.5 py-1 rounded-full">
                    Action Needed
                </span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-800">@stats.LowStockCount</h3>
                <p class="text-sm text-slate-500">Low Stock Items</p>
            </div>
        </div>

        <!-- In-Transit -->
        <div class="bg-white rounded-xl p-6 border border-slate-200 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <span class="text-xs font-semibold text-purple-600 bg-purple-50 px-2.5 py-1 rounded-full">
                    Incoming
                </span>
            </div>
            <div class="space-y-1">
                <h3 class="text-2xl font-bold text-slate-800">@stats.IncomingUnits</h3>
                <p class="text-sm text-slate-500">Units Arriving Today</p>
            </div>
        </div>
    </div>

    <!-- Inventory Filter & Search -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
        <div class="flex flex-col md:flex-row gap-4">
            <div class="flex-1 relative">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" placeholder="Search by product name, SKU, or tag..." 
                       class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
                       @bind="searchQuery" @bind:event="oninput" @onkeyup="FilterProducts" />
            </div>
            <div class="flex gap-4">
                <select class="px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                        @bind="selectedSize" @onclick="FilterProducts">
                    <option value="">All Sizes</option>
                    @foreach (var size in sizes)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
                <select class="px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                        @bind="selectedColor" @onclick="FilterProducts">
                    <option value="">All Colors</option>
                    @foreach (var color in colors)
                    {
                        <option value="@color">@color</option>
                    }
                </select>
                <select class="px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
                        @bind="selectedStatus" @onclick="FilterProducts">
                    <option value="">All Statuses</option>
                    <option value="In Stock">In Stock</option>
                    <option value="Low Stock">Low Stock</option>
                    <option value="Out of Stock">Out of Stock</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-200">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Product Info</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Attributes</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Price</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Stock</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">@(CanManageInventory ? "Actions" : "Access")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    @foreach (var product in pagedFilteredProducts)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-16 h-16 rounded-lg overflow-hidden bg-slate-100 flex items-center justify-center">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" class="w-full h-full object-cover" />
                                        }
                                        else
                                        {
                                            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                            </svg>
                                        }
                                    </div>
                                    <div>
                                        <div class="font-medium text-slate-900">@product.Name</div>
                                        <div class="text-xs text-slate-500">ID: @product.Id</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="space-y-1">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
                                        Size: @product.Size
                                    </span>
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-800">
                                        Color: @product.Color
                                    </span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm text-slate-600">
                                ₱@product.Price.ToString("F2")
                            </td>
                            <td class="px-6 py-4">
                                <span class="font-medium text-slate-900">@product.Stock</span>
                                <span class="text-xs text-slate-500 ml-1">units</span>
                            </td>
                            <td class="px-6 py-4">
                                @if (product.Stock > 20)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                        In Stock
                                    </span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                                        Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                        Out of Stock
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (CanManageInventory)
                                {
                                    <button @onclick="() => OpenEditModal(product)" class="text-blue-600 hover:text-blue-900 text-sm font-medium mr-3">Edit</button>
                                    <button class="text-slate-400 hover:text-red-600 transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                        </svg>
                                    </button>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">Read-only</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination -->
        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
            <span class="text-sm text-slate-500">Showing @productsStartIndex-@productsEndIndex of @filteredProducts.Count results · Page @productsCurrentPage/@productsTotalPages</span>
            <div class="flex gap-2">
                <button type="button" @onclick="PreviousProductPage" class="px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-600 hover:bg-white disabled:opacity-50" disabled="@(productsCurrentPage <= 1)">Previous</button>
                <button type="button" @onclick="NextProductPage" class="px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-600 hover:bg-white disabled:opacity-50" disabled="@(productsCurrentPage >= productsTotalPages)">Next</button>
            </div>
        </div>
    </div>
    <!-- Transaction History Section -->
    <div class="mt-8 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-800">Recent Inventory Transactions</h3>
            <button class="text-blue-600 text-sm font-medium hover:text-blue-800">View All Logs</button>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-white border-b border-slate-200">
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Time</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">Description</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wider text-right">Change</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var txn in pagedTransactions)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-3 text-sm text-slate-600">@txn.Timestamp.ToString("HH:mm:ss")</td>
                            <td class="px-6 py-3">
                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium @GetTransactionBadgeClass(txn.Type)">
                                    @txn.Type
                                </span>
                            </td>
                            <td class="px-6 py-3 text-sm text-slate-800">@txn.Description</td>
                            <td class="px-6 py-3 text-sm text-slate-500">@txn.User</td>
                            <td class="px-6 py-3 text-right text-sm font-bold @(txn.QuantityChange > 0 ? "text-green-600" : (txn.QuantityChange < 0 ? "text-red-600" : "text-slate-500"))">
                                @(txn.QuantityChange > 0 ? "+" : "")@txn.QuantityChange
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (sortedTransactions.Any())
        {
            <div class="px-6 py-4 border-t border-slate-200 bg-slate-50 flex items-center justify-between">
                <span class="text-sm text-slate-500">Showing @transactionsStartIndex-@transactionsEndIndex of @sortedTransactions.Count logs · Page @transactionsCurrentPage/@transactionsTotalPages</span>
                <div class="flex gap-2">
                    <button type="button" @onclick="PreviousTransactionPage" class="px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-600 hover:bg-white disabled:opacity-50" disabled="@(transactionsCurrentPage <= 1)">Previous</button>
                    <button type="button" @onclick="NextTransactionPage" class="px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-600 hover:bg-white disabled:opacity-50" disabled="@(transactionsCurrentPage >= transactionsTotalPages)">Next</button>
                </div>
            </div>
        }
    </div>

    <!-- Add/Edit Product Modal -->
    @if (showModal && CanManageInventory)
    {
        <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm flex items-center justify-center z-50">
            <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg overflow-hidden transform transition-all animate-fade-in-up">
                <!-- Modal Header -->
                <div class="bg-slate-50 px-6 py-4 border-b border-slate-200 flex justify-between items-center">
                    <h3 class="text-lg font-bold text-slate-800">
                        @(isEditing ? "Edit Product & Stock" : "Add New Product")
                    </h3>
                    <button @onclick="CloseModal" class="text-slate-400 hover:text-slate-600 transition-colors">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>

                <!-- Modal Body -->
                <div class="p-6 space-y-4">
                    <!-- Product Name -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1">Product Name</label>
                        <input type="text" @bind="currentProduct.Name" 
                               class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all outline-none"
                               placeholder="e.g. Premium Cotton Shirt" />
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <!-- Size -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Size</label>
                            <select @bind="currentProduct.Size" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                @foreach (var size in sizes)
                                {
                                    <option value="@size">@size</option>
                                }
                            </select>
                        </div>
                        <!-- Color -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Color</label>
                            <select @bind="currentProduct.Color" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                @foreach (var color in colors)
                                {
                                    <option value="@color">@color</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <!-- Price -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Price ($)</label>
                            <input type="number" step="0.01" @bind="currentProduct.Price" 
                                   class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                        </div>
                        <!-- Stock -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 mb-1">Stock Quantity</label>
                            <div class="flex items-center gap-2">
                                <button type="button" @onclick="() => AdjustStock(-1)" class="w-8 h-8 rounded bg-slate-100 hover:bg-slate-200 flex items-center justify-center font-bold text-slate-600">-</button>
                                <input type="number" @bind="currentProduct.Stock" 
                                       class="w-full px-3 py-2 border border-slate-300 rounded-lg text-center focus:ring-2 focus:ring-blue-500 outline-none" />
                                <button type="button" @onclick="() => AdjustStock(1)" class="w-8 h-8 rounded bg-slate-100 hover:bg-slate-200 flex items-center justify-center font-bold text-slate-600">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="bg-gray-50 px-6 py-4 border-t border-slate-200 flex justify-end gap-3">
                    <button @onclick="CloseModal" class="px-4 py-2 text-slate-600 font-semibold hover:bg-slate-100 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button @onclick="SaveProduct" class="px-6 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 shadow-md transition-all">
                        @(isEditing ? "Update Stock" : "Create Product")
                    </button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string searchQuery = "";
    private string selectedSize = "";
    private string selectedColor = "";
    private string selectedStatus = "";
    
    // Modal State
    private bool showModal = false;
    private bool isEditing = false;
    private ProductDto currentProduct = new();

    private List<string> sizes = new() { "XS", "S", "M", "L", "XL", "XXL" };
    private List<string> colors = new() { "White", "Black", "Blue", "Red", "Navy", "Gray" };

    private List<ProductDto> products = new();
    private List<ProductDto> filteredProducts = new();
    private List<InventoryTransactionDto> transactions = new();
    private InventoryStatsDto stats = new();
    private decimal totalInventoryValue = 0;
    private bool CanManageInventory =>
        AuthService.CurrentUser?.Role == UserRole.Admin ||
        AuthService.CurrentUser?.Role == UserRole.SuperAdmin;
    private int productsCurrentPage = 1;
    private int transactionsCurrentPage = 1;
    private const int productsPageSize = 10;
    private const int transactionsPageSize = 5;
    private int productsTotalPages => Math.Max(1, (int)Math.Ceiling(filteredProducts.Count / (double)productsPageSize));
    private List<ProductDto> pagedFilteredProducts => filteredProducts
        .Skip((productsCurrentPage - 1) * productsPageSize)
        .Take(productsPageSize)
        .ToList();
    private int productsStartIndex => filteredProducts.Count == 0 ? 0 : ((productsCurrentPage - 1) * productsPageSize) + 1;
    private int productsEndIndex => filteredProducts.Count == 0 ? 0 : Math.Min(productsCurrentPage * productsPageSize, filteredProducts.Count);
    private List<InventoryTransactionDto> sortedTransactions => transactions.OrderByDescending(t => t.Timestamp).ToList();
    private int transactionsTotalPages => Math.Max(1, (int)Math.Ceiling(sortedTransactions.Count / (double)transactionsPageSize));
    private List<InventoryTransactionDto> pagedTransactions => sortedTransactions
        .Skip((transactionsCurrentPage - 1) * transactionsPageSize)
        .Take(transactionsPageSize)
        .ToList();
    private int transactionsStartIndex => sortedTransactions.Count == 0 ? 0 : ((transactionsCurrentPage - 1) * transactionsPageSize) + 1;
    private int transactionsEndIndex => sortedTransactions.Count == 0 ? 0 : Math.Min(transactionsCurrentPage * transactionsPageSize, sortedTransactions.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        products = await InventoryService.GetProductsAsync();
        transactions = await InventoryService.GetTransactionsAsync();
        stats = await InventoryService.GetStatsAsync();
        totalInventoryValue = await FinanceService.GetInventoryValuationAsync();
        
        FilterProducts();
        transactionsCurrentPage = 1;
    }

    private void FilterProducts()
    {
        filteredProducts = products.Where(p =>
            (string.IsNullOrEmpty(searchQuery) || 
             p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
             p.Id.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedSize) || p.Size == selectedSize) &&
            (string.IsNullOrEmpty(selectedColor) || p.Color == selectedColor) &&
            (string.IsNullOrEmpty(selectedStatus) || GetStatus(p) == selectedStatus)
        ).ToList();
        productsCurrentPage = 1;
    }

    private void OpenAddModal()
    {
        if (!CanManageInventory)
        {
            return;
        }

        currentProduct = new ProductDto { 
            Id = "",
            Size = "M", 
            Color = "White",
            ImageUrl = ""
        };
        isEditing = false;
        showModal = true;
    }

    private void OpenEditModal(ProductDto product)
    {
        if (!CanManageInventory)
        {
            return;
        }

        currentProduct = new ProductDto
        {
            Id = product.Id,
            Name = product.Name,
            Size = product.Size,
            Color = product.Color,
            Price = product.Price,
            Stock = product.Stock,
            ImageUrl = product.ImageUrl
        };
        isEditing = true;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void AdjustStock(int amount)
    {
        if (!CanManageInventory)
        {
            return;
        }

        currentProduct.Stock += amount;
        if (currentProduct.Stock < 0) currentProduct.Stock = 0;
    }

    private async Task SaveProduct()
    {
        if (!CanManageInventory)
        {
            return;
        }

        if (isEditing)
        {
            var index = products.FindIndex(p => p.Id == currentProduct.Id);
            if (index != -1)
            {
                // Calculate stock change for log inside service
                if (currentProduct.Stock != products[index].Stock)
                {
                   await InventoryService.UpdateStockAsync(currentProduct.Id, currentProduct.Stock, "Manual Edit via Dashboard");
                }
                // Update local list to reflect changes immediately (or reload)
                products[index] = currentProduct;
            }
        }
        else
        {
            await InventoryService.AddProductAsync(currentProduct);
            // Reload to get updated list
            products = await InventoryService.GetProductsAsync();
        }

        // Refresh all data to stay in sync
        await LoadData();
        
        showModal = false;
        StateHasChanged();
    }

    private string GetStatus(ProductDto p)
    {
        if (p.Stock == 0) return "Out of Stock";
        if (p.Stock <= 20) return "Low Stock";
        return "In Stock";
    }

    private string GetTransactionBadgeClass(string type)
    {
        return type switch
        {
            "Restock" => "bg-green-100 text-green-800",
            "Order Fulfillment" => "bg-blue-100 text-blue-800",
            "Stock Adjustment" => "bg-orange-100 text-orange-800",
            "New Product" => "bg-purple-100 text-purple-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private void PreviousProductPage()
    {
        if (productsCurrentPage <= 1) return;
        productsCurrentPage--;
    }

    private void NextProductPage()
    {
        if (productsCurrentPage >= productsTotalPages) return;
        productsCurrentPage++;
    }

    private void PreviousTransactionPage()
    {
        if (transactionsCurrentPage <= 1) return;
        transactionsCurrentPage--;
    }

    private void NextTransactionPage()
    {
        if (transactionsCurrentPage >= transactionsTotalPages) return;
        transactionsCurrentPage++;
    }
}
