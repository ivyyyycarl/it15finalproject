@code {
    private string activeSection = "home";
    private bool isMobileMenuOpen;
    
    private void SetActiveSection(string sectionId)
    {
        activeSection = sectionId;
    }

    private Task NavigateToSectionFromMobile(string sectionId)
    {
        isMobileMenuOpen = false;
        SetActiveSection(sectionId);
        return Task.CompletedTask;
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    private void NavigateToLoginFromMobile()
    {
        isMobileMenuOpen = false;
        NavigateToLogin();
    }

    private void NavigateToRegister()
    {
        NavigationManager.NavigateTo("/register");
    }

    private void NavigateToSubscribe()
    {
        NavigationManager.NavigateTo("/subscribe");
    }

    private void NavigateToSubscribeFromMobile()
    {
        isMobileMenuOpen = false;
        NavigateToSubscribe();
    }
}
