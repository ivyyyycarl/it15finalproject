@page "/landing"
@attribute [AllowAnonymous]
@layout LandingLayout
@inject NavigationManager NavigationManager

<PageTitle>ClassicFit Apparel Fashion - Sales &amp; Support Management</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');
    html { scroll-behavior: smooth; }

    * { box-sizing: border-box; }

    .lp-root {
        font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
        overflow-x: hidden;
        color: #111827;
        background: #f9fafb;
    }

    /* ===== NAVBAR ===== */
    .lp-nav {
        position: sticky;
        top: 0;
        z-index: 100;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid #f0f0f0;
        box-shadow: 0 1px 8px rgba(0,0,0,.05);
    }
    .lp-nav-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 1.5rem;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .lp-logo {
        display: flex;
        align-items: center;
        gap: .6rem;
        text-decoration: none;
    }
    .lp-logo-img-wrap {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #ffffff;
        padding: 3px;
        box-shadow: 0 2px 8px rgba(128,161,186,.35);
        border: 1px solid #d7e6ef;
    }
    .lp-logo-img-wrap img { width: 100%; height: 100%; object-fit: contain; }
    .lp-logo-text { font-size: 1.05rem; font-weight: 800; color: #111827; letter-spacing: -.02em; }
    .lp-logo-text span { color: #80A1BA; }
    .lp-nav-links { display: flex; align-items: center; gap: 1.75rem; }
    .lp-nav-links a,
    .lp-nav-links button {
        font-size: .85rem; font-weight: 500; color: #6b7280; text-decoration: none; transition: color .2s;
        background: none; border: none; cursor: pointer; padding: 0;
    }
    .lp-nav-links a:hover,
    .lp-nav-links button:hover { color: #111827; }
    .lp-nav-links button.lp-nav-active { color: #111827; font-weight: 700; }
    .lp-nav-ctas { display: flex; align-items: center; gap: .6rem; }
    .lp-mobile-toggle {
        display: none;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: .6rem;
        border: 1px solid #e5e7eb;
        background: #fff;
        color: #374151;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }
    .lp-mobile-toggle:hover { background: #f9fafb; }
    .lp-mobile-toggle svg { width: 1.1rem; height: 1.1rem; }

    .lp-mobile-menu {
        display: none;
        border-top: 1px solid #f0f0f0;
        background: rgba(255,255,255,0.97);
        backdrop-filter: blur(10px);
    }
    .lp-mobile-menu-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: .85rem 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }
    .lp-mobile-menu button {
        text-align: left;
        font-size: .9rem;
        font-weight: 600;
        color: #374151;
        background: transparent;
        border: none;
        padding: .55rem .25rem;
        cursor: pointer;
    }
    .lp-mobile-menu a {
        text-align: left;
        font-size: .9rem;
        font-weight: 600;
        color: #374151;
        text-decoration: none;
        background: transparent;
        border: none;
        padding: .55rem .25rem;
        cursor: pointer;
    }
    .lp-mobile-menu button:hover,
    .lp-mobile-menu a:hover { color: #111827; }
    .lp-mobile-ctas {
        display: flex;
        gap: .6rem;
        margin-top: .35rem;
    }
    .lp-mobile-ctas button { text-align: center; }
    .lp-btn-signin {
        font-size: .83rem; font-weight: 600; color: #374151;
        padding: .45rem .9rem; border-radius: .55rem;
        background: none; border: none; cursor: pointer;
        transition: color .2s;
    }
    .lp-btn-signin:hover { color: #80A1BA; }
    .lp-btn-cta {
        font-size: .83rem; font-weight: 700; color: #fff;
        padding: .5rem 1.1rem; border-radius: .65rem;
        background: #1B3A4B; border: none; cursor: pointer;
        transition: background .2s, transform .15s, box-shadow .2s;
        box-shadow: 0 2px 10px rgba(27,58,75,.25);
    }
    .lp-btn-cta:hover { background: #162e3c; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(27,58,75,.3); }
    @@media(max-width:900px){
        .lp-nav-links, .lp-nav-ctas { display: none !important; }
        .lp-mobile-toggle { display: inline-flex; }
    }

    /* ===== HERO ===== */
    .lp-hero {
        background: linear-gradient(155deg, #f0f7f7 0%, #eef4f8 40%, #f5f9f5 100%);
        padding: 5rem 1.5rem 4rem;
        position: relative;
        overflow: hidden;
    }
    .lp-hero::before {
        content: '';
        position: absolute;
        top: -120px; right: -120px;
        width: 420px; height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(145,196,195,.25) 0%, transparent 70%);
        pointer-events: none;
    }
    .lp-hero-inner {
        max-width: 1280px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
    }
    @@media(max-width:900px){ .lp-hero-inner { grid-template-columns:1fr; } .lp-hero-right { display:none; } }

    /* Hero badge */
    .lp-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        background: #fff;
        border: 1px solid #91C4C3;
        color: #2d7d79;
        font-size: .72rem;
        font-weight: 700;
        padding: .3rem .75rem;
        border-radius: 999px;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 4px rgba(145,196,195,.2);
    }
    .lp-badge-dot { width: .45rem; height: .45rem; border-radius: 50%; background: #91C4C3; animation: lp-pulse 2s infinite; }
    @@keyframes lp-pulse { 0%,100%{transform:scale(1); opacity:1;} 50%{transform:scale(1.4); opacity:.7;} }

    /* Hero heading */
    .lp-hero-h1 { font-size: clamp(2rem, 4vw, 3.25rem); font-weight: 900; line-height: 1.1; letter-spacing: -.03em; margin: 0 0 .65rem; }
    .lp-hero-h1 .hi1 { color: #91C4C3; }
    .lp-hero-h1 .hi2 { color: #80A1BA; }
    .lp-hero-h1 .hi3 { color: #111827; }
    .lp-hero-sub { font-size: 1rem; color: #6b7280; line-height: 1.6; max-width: 480px; margin: 0 0 1.75rem; }

    .lp-hero-btns { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 2.25rem; }
    .lp-hero-btn-primary {
        display: inline-flex; align-items: center; gap: .5rem;
        background: #1B3A4B; color: #fff;
        font-size: .9rem; font-weight: 700;
        padding: .8rem 1.6rem; border-radius: .75rem;
        border: none; cursor: pointer;
        box-shadow: 0 4px 14px rgba(27,58,75,.3);
        transition: all .2s;
    }
    .lp-hero-btn-primary:hover { background: #162e3c; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(27,58,75,.35); }
    .lp-hero-btn-secondary {
        display: inline-flex; align-items: center; gap: .5rem;
        background: #fff; color: #374151;
        font-size: .9rem; font-weight: 600;
        padding: .8rem 1.6rem; border-radius: .75rem;
        border: 1.5px solid #e5e7eb; cursor: pointer;
        transition: all .2s;
    }
    .lp-hero-btn-secondary:hover { border-color: #80A1BA; color: #80A1BA; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.06); }

    /* Hero trust strip */
    .lp-trust { display: flex; align-items: center; gap: .6rem; font-size: .78rem; color: #9ca3af; }
    .lp-trust-avs { display: flex; }
    .lp-trust-av {
        width: 28px; height: 28px; border-radius: 50%;
        border: 2px solid #fff;
        background: linear-gradient(135deg,#91C4C3,#80A1BA);
        margin-left: -8px;
        display: flex; align-items: center; justify-content: center;
        font-size: .6rem; font-weight: 700; color: #fff;
    }
    .lp-trust-av:first-child { margin-left: 0; }
    .lp-star { color: #f59e0b; font-size: .9rem; }

    /* ===== HERO Right Card ===== */
    .lp-hero-right { position: relative; display: flex; justify-content: center; }
    .lp-hero-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px -10px rgba(0,0,0,.12);
        border: 1px solid #f0f0f0;
        padding: 1.5rem;
        width: 340px;
        position: relative;
        z-index: 2;
    }
    .lp-hero-card-top {
        background: linear-gradient(135deg, #91C4C3, #80A1BA);
        border-radius: 1rem;
        height: 170px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        overflow: hidden;
        position: relative;
    }
    .lp-hero-card-top img { height: 112px; width: 112px; border-radius: 22px; object-fit: cover; border: 1px solid rgba(255,255,255,.35); filter: drop-shadow(0 4px 12px rgba(0,0,0,.18)); }
    .lp-hc-badge-top {
        position: absolute; top: .6rem; right: .6rem;
        background: #fff; border-radius: .65rem;
        padding: .4rem .7rem; display: flex; align-items: center; gap: .4rem;
        font-size: .7rem; font-weight: 700; color: #111827;
        box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    .lp-hc-badge-top svg { width: .9rem; height: .9rem; color: #10b981; }
    .lp-hc-tag { display: inline-block; background: #fef3c7; color: #92400e; font-size: .65rem; font-weight: 700; padding: .2rem .5rem; border-radius: .35rem; margin-bottom: .35rem; }
    .lp-hc-hours { font-size: .7rem; color: #9ca3af; margin-left: .4rem; }
    .lp-hc-title { font-size: .92rem; font-weight: 800; color: #111827; margin: .15rem 0 .5rem; }
    .lp-hc-meta { display: flex; align-items: center; justify-content: space-between; font-size: .72rem; color: #6b7280; }
    .lp-hc-rating { font-weight: 700; color: #111827; }

    /* Floating notification cards */
    .lp-float-card {
        position: absolute; background: #fff; border-radius: .85rem;
        padding: .55rem .85rem; display: flex; align-items: center; gap: .6rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.1); border: 1px solid #f0f0f0; z-index: 3;
        font-size: .72rem; font-weight: 700; white-space: nowrap;
    }
    .lp-float-icon { width: 2rem; height: 2rem; border-radius: .5rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .lp-float-icon svg { width: .85rem; height: .85rem; }
    .lp-float-card-tl { top: 1rem; left: -4.5rem; animation: lp-float1 4s ease-in-out infinite; }
    .lp-float-card-br { bottom: 1rem; left: -5rem; animation: lp-float2 5s ease-in-out infinite; }
    @@keyframes lp-float1 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-6px);} }
    @@keyframes lp-float2 { 0%,100%{transform:translateY(0);} 50%{transform:translateY(5px);} }
    .lp-float-sub { font-size: .64rem; color: #9ca3af; font-weight: 400; margin-top: .05rem; }

    /* ===== STATS BAR ===== */
    .lp-stats {
        background: #fff;
        border-top: 1px solid #f3f4f6;
        border-bottom: 1px solid #f3f4f6;
    }
    .lp-stats-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 1.75rem 1.5rem;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }
    @@media(max-width:640px){ .lp-stats-inner { grid-template-columns: repeat(2,1fr); } }
    .lp-stat-item { text-align: center; padding: .5rem; }
    .lp-stat-num { font-size: 1.6rem; font-weight: 900; color: #111827; }
    .lp-stat-label { font-size: .75rem; color: #9ca3af; margin-top: .15rem; }
    .lp-stat-divider { border-right: 1px solid #f3f4f6; }
    @@media(max-width:640px){ .lp-stat-divider { border-right:none; } }

    /* ===== FEATURES ===== */
    .lp-features {
        background: #f9fafb;
        padding: 5rem 1.5rem;
    }
    .lp-features-inner { max-width: 1280px; margin: 0 auto; }
    .lp-section-header { text-align: center; margin-bottom: 3rem; }
    .lp-section-label { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #80A1BA; margin-bottom: .5rem; }
    .lp-section-h2 { font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 900; color: #111827; letter-spacing: -.025em; margin: 0 0 .75rem; }
    .lp-section-sub { font-size: .95rem; color: #6b7280; max-width: 560px; margin: 0 auto; line-height: 1.6; }

    .lp-feat-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; }
    @@media(max-width:900px){ .lp-feat-grid { grid-template-columns: repeat(2,1fr); } }
    @@media(max-width:600px){ .lp-feat-grid { grid-template-columns: 1fr; } }

    .lp-feat-card {
        background: #fff;
        border-radius: 1.1rem;
        border: 1px solid #f0f0f0;
        padding: 1.75rem;
        transition: all .25s;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
    }
    .lp-feat-card:hover { transform: translateY(-5px); box-shadow: 0 16px 36px rgba(0,0,0,.08); border-color: #91C4C3; }
    .lp-feat-icon { width: 48px; height: 48px; border-radius: .85rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
    .lp-feat-icon svg { width: 1.25rem; height: 1.25rem; }
    .lp-feat-h3 { font-size: .95rem; font-weight: 800; color: #111827; margin: 0 0 .4rem; }
    .lp-feat-desc { font-size: .82rem; color: #6b7280; line-height: 1.6; margin: 0; }

    /* ===== HOW IT WORKS ===== */
    .lp-hiw {
        background: #fff;
        padding: 5rem 1.5rem;
    }
    .lp-hiw-inner { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
    @@media(max-width:900px){ .lp-hiw-inner { grid-template-columns: 1fr; } }
    .lp-hiw-steps { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 1.5rem; }
    .lp-hiw-step { display: flex; gap: 1rem; align-items: flex-start; }
    .lp-step-num { width: 38px; height: 38px; border-radius: .85rem; background: linear-gradient(135deg,#91C4C3,#80A1BA); display: flex; align-items: center; justify-content: center; font-size: .85rem; font-weight: 900; color: #fff; flex-shrink: 0; box-shadow: 0 4px 10px rgba(128,161,186,.35); }
    .lp-step-title { font-size: .9rem; font-weight: 800; color: #111827; margin: 0 0 .25rem; }
    .lp-step-desc { font-size: .8rem; color: #6b7280; margin: 0; line-height: 1.55; }

    .lp-hiw-card {
        background: linear-gradient(145deg,#f0f7f7,#eef4f8);
        border-radius: 1.5rem;
        padding: 2rem;
        border: 1px solid #e2eded;
    }
    .lp-hiw-logo { width: 90px; margin: 0 auto 1.25rem; display: block; }
    .lp-check-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .65rem; }
    .lp-check-list li { display: flex; align-items: center; gap: .65rem; font-size: .82rem; color: #374151; background: #fff; padding: .6rem .85rem; border-radius: .65rem; border: 1px solid #f0f0f0; }
    .lp-check-ico { width: 1.25rem; height: 1.25rem; color: #10b981; flex-shrink: 0; }

    /* ===== CTA BANNER ===== */
    .lp-cta {
        background: linear-gradient(135deg, #1B3A4B 0%, #2d6a6e 100%);
        padding: 5rem 1.5rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .lp-cta::before {
        content:'';
        position:absolute; top:-80px; left:-80px;
        width:300px; height:300px; border-radius:50%;
        background:rgba(255,255,255,.04);
        pointer-events:none;
    }
    .lp-cta-inner { max-width: 720px; margin: 0 auto; position: relative; z-index: 2; }
    .lp-cta h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 900; color: #fff; letter-spacing: -.025em; margin: 0 0 .75rem; }
    .lp-cta p { font-size: 1rem; color: rgba(255,255,255,.7); margin: 0 0 2rem; line-height: 1.6; }
    .lp-cta-btns { display: flex; justify-content: center; gap: .75rem; flex-wrap: wrap; }
    .lp-cta-btn-wh { background: #fff; color: #1B3A4B; font-size: .9rem; font-weight: 800; padding: .85rem 1.75rem; border-radius: .75rem; border: none; cursor: pointer; box-shadow: 0 4px 16px rgba(0,0,0,.2); transition: all .2s; }
    .lp-cta-btn-wh:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.25); }
    .lp-cta-btn-out { background: transparent; color: #fff; font-size: .9rem; font-weight: 700; padding: .85rem 1.75rem; border-radius: .75rem; border: 2px solid rgba(255,255,255,.4); cursor: pointer; transition: all .2s; }
    .lp-cta-btn-out:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.7); }

    /* ===== TESTIMONIALS ===== */
    .lp-testi {
        background: #f9fafb;
        padding: 5rem 1.5rem;
    }
    .lp-testi-grid { max-width: 1280px; margin: 0 auto; }
    .lp-testi-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.25rem; margin-top: 2rem; }
    @@media(max-width:900px){ .lp-testi-cards { grid-template-columns: 1fr; } }
    .lp-testi-card { background: #fff; border-radius: 1.1rem; padding: 1.5rem; border: 1px solid #f0f0f0; box-shadow: 0 1px 4px rgba(0,0,0,.04); }
    .lp-testi-stars { color: #f59e0b; font-size: .9rem; margin-bottom: .75rem; }
    .lp-testi-text { font-size: .83rem; color: #374151; line-height: 1.65; margin: 0 0 1rem; font-style: italic; }
    .lp-testi-author { display: flex; align-items: center; gap: .65rem; }
    .lp-testi-av { width: 36px; height: 36px; border-radius: 50%; background: linear-gradient(135deg,#91C4C3,#80A1BA); display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800; color: #fff; }
    .lp-testi-name { font-size: .8rem; font-weight: 700; color: #111827; }
    .lp-testi-role { font-size: .7rem; color: #9ca3af; }

    /* ===== FOOTER ===== */
    .lp-footer { background: #1B2A3D; color: #fff; padding: 3rem 1.5rem 2rem; }
    .lp-footer-inner { max-width: 1280px; margin: 0 auto; }
    .lp-footer-top { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 2rem; margin-bottom: 2rem; }
    .lp-footer-brand { max-width: 260px; }
    .lp-footer-logo { display: flex; align-items: center; gap: .6rem; margin-bottom: .75rem; }
    .lp-footer-logo-img { width: 32px; height: 32px; border-radius: .5rem; background: rgba(255,255,255,.1); padding: 3px; }
    .lp-footer-logo-img img { width: 100%; height: 100%; object-fit: contain; }
    .lp-footer-brand-name { font-size: .95rem; font-weight: 800; }
    .lp-footer-brand-name span { color: #91C4C3; }
    .lp-footer-brand-desc { font-size: .78rem; color: rgba(255,255,255,.5); line-height: 1.55; margin: 0; }
    .lp-footer-links-group h4 { font-size: .8rem; font-weight: 700; color: rgba(255,255,255,.9); margin: 0 0 .75rem; text-transform: uppercase; letter-spacing: .05em; }
    .lp-footer-links { display: flex; flex-direction: column; gap: .45rem; }
    .lp-footer-links a { font-size: .78rem; color: rgba(255,255,255,.5); text-decoration: none; transition: color .2s; }
    .lp-footer-links a:hover { color: #91C4C3; }
    .lp-footer-bottom { border-top: 1px solid rgba(255,255,255,.08); padding-top: 1.25rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .5rem; font-size: .73rem; color: rgba(255,255,255,.35); }
</style>

<div class="lp-root">

    <!-- ===== NAVBAR ===== -->
    <nav class="lp-nav">
        <div class="lp-nav-inner">
            <!-- Logo -->
            <a href="/landing" class="lp-logo">
                <div class="lp-logo-img-wrap">
                    <img src="/images/classicfit-logo-icon.png?v=20260308" alt="ClassicFit Logo" />
                </div>
                <span class="lp-logo-text">Classic<span>Fit</span></span>
            </a>

            <!-- Nav links (desktop) -->
            <div class="lp-nav-links" style="display:flex">
                <a href="#home" class="@(activeSection == "home" ? "lp-nav-active" : "")" @onclick='() => SetActiveSection("home")'>Home</a>
                <a href="#features" class="@(activeSection == "features" ? "lp-nav-active" : "")" @onclick='() => SetActiveSection("features")'>Features</a>
                <a href="#about" class="@(activeSection == "about" ? "lp-nav-active" : "")" @onclick='() => SetActiveSection("about")'>About</a>
                <a href="#contact" class="@(activeSection == "contact" ? "lp-nav-active" : "")" @onclick='() => SetActiveSection("contact")'>Contact</a>
            </div>

            <!-- CTA buttons -->
            <div class="lp-nav-ctas">
                <button class="lp-btn-signin" @onclick="NavigateToLogin">Sign In</button>
                <button class="lp-btn-cta" @onclick="NavigateToSubscribe">Subscribe</button>
            </div>

            <button type="button" class="lp-mobile-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle navigation menu">
                @if (isMobileMenuOpen)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
