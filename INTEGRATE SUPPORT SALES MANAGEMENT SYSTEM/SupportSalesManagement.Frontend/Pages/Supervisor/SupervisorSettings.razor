@page "/supervisor/settings"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]

<div class="max-w-4xl mx-auto p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <h1 class="text-[22px] font-bold text-gray-900">Settings</h1>

    <!-- Profile Card -->
    <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex items-start gap-6">
        <img class="h-20 w-20 rounded-full"
            src="https://ui-avatars.com/api/?name=Supervisor+User&background=9333ea&color=fff&size=128" alt="" />
        <div class="flex-1">
            <h2 class="text-xl font-bold text-gray-900">Supervisor User</h2>
            <p class="text-sm text-gray-500">super@classicfit.com</p>
            <div class="mt-4 flex gap-3">
                <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    Role: Supervisor
                </span>
                <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Team: Support A
                </span>
            </div>
        </div>
        <button class="text-purple-600 hover:text-purple-800 text-sm font-medium">Edit Profile</button>
    </div>

    <!-- Notification Settings -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-900">Notifications</h3>
            <p class="text-sm text-gray-500">Manage how you receive alerts.</p>
        </div>
        <div class="p-6 space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-900">Ticket Escalations</p>
                    <p class="text-xs text-gray-500">Get notified when a ticket is flagged as high priority.</p>
                </div>
                <!-- Toggle -->
                <button type="button"
                    class="bg-purple-600 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                    role="switch" aria-checked="true">
                    <span aria-hidden="true"
                        class="translate-x-5 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                </button>
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-900">Weekly Reports</p>
                    <p class="text-xs text-gray-500">Receive a summary of team performance every Monday.</p>
                </div>
                <button type="button"
                    class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2"
                    role="switch" aria-checked="false">
                    <span aria-hidden="true"
                        class="translate-x-0 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Security -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-900">Security</h3>
        </div>
        <div class="p-6">
            <button class="text-purple-600 hover:text-purple-800 text-sm font-medium">Change Password</button>
        </div>
    </div>
</div>

