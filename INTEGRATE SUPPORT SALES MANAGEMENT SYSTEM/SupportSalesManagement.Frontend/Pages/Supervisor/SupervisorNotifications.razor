@page "/supervisor/notifications"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin,SuperAdmin")]
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@implements IDisposable

<div class="space-y-4 p-6" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-[22px] font-bold text-gray-900">Notifications & Alerts</h1>
            <p class="text-sm text-gray-500">Stay updated with orders, tickets, and system activity</p>
        </div>
        <div class="flex gap-3">
            <button @onclick="RefreshNotifications"
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition flex items-center gap-2">
                <svg class="w-4 h-4 @(isRefreshing ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
            <button @onclick="MarkAllAsRead"
                class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition">
                Mark All as Read
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600"></div>
        </div>
    }
    else
    {
        <!-- Alert Category Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-red-50 border border-red-200 rounded-xl p-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-red-900">New Orders</h3>
                    <span class="px-3 py-1 bg-red-500 text-white text-sm font-bold rounded-full">@pendingOrderCount</span>
                </div>
                <p class="text-sm text-red-700">Pending orders requiring processing</p>
            </div>

            <div class="bg-orange-50 border border-orange-200 rounded-xl p-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-orange-900">Open Tickets</h3>
                    <span class="px-3 py-1 bg-orange-500 text-white text-sm font-bold rounded-full">@openTicketCount</span>
                </div>
                <p class="text-sm text-orange-700">Unresolved support tickets</p>
            </div>

            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-yellow-900">Low Stock</h3>
                    <span class="px-3 py-1 bg-yellow-500 text-white text-sm font-bold rounded-full">@lowStockCount</span>
                </div>
                <p class="text-sm text-yellow-700">Products with low inventory</p>
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-xl p-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-blue-900">Shipped</h3>
                    <span class="px-3 py-1 bg-blue-500 text-white text-sm font-bold rounded-full">@shippedOrderCount</span>
                </div>
                <p class="text-sm text-blue-700">Orders currently in transit</p>
            </div>
        </div>

        <!-- Auto-refresh Indicator -->
        <div class="flex items-center gap-2 text-xs text-gray-400">
            <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></div>
            <span>Auto-refreshing every 30 seconds | Last updated: @lastRefresh.ToString("HH:mm:ss")</span>
        </div>

        <!-- Notifications List -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b border-gray-100 flex items-center justify-between">
                <h2 class="text-lg font-semibold text-gray-900">Recent Activity</h2>
                <span class="text-sm text-gray-500">@notifications.Count notification(s)</span>
            </div>
            <div class="divide-y divide-gray-100">
                @if (notifications.Any())
                {
                    @foreach (var notification in pagedNotifications)
                    {
                        <div class="p-4 hover:bg-gray-50 transition-colors flex items-start gap-4 @(notification.IsRead ? "opacity-60" : "")">
                            <div class="w-10 h-10 @notification.IconBgColor rounded-full flex items-center justify-center flex-shrink-0">
                                @if (notification.Type == "Order")
                                {
                                    <svg class="w-5 h-5 @notification.IconColor" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                    </svg>
                                }
                                else if (notification.Type == "Ticket")
                                {
                                    <svg class="w-5 h-5 @notification.IconColor" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                                    </svg>
                                }
                                else if (notification.Type == "Stock")
                                {
                                    <svg class="w-5 h-5 @notification.IconColor" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5 @notification.IconColor" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                }
                            </div>
                            <div class="flex-1">
                                <h4 class="text-sm font-semibold text-gray-900">@notification.Title</h4>
                                <p class="text-sm text-gray-600 mt-1">@notification.Message</p>
                                <p class="text-xs text-gray-400 mt-2">@GetTimeAgo(notification.Timestamp)</p>
                            </div>
                            @if (!notification.IsRead)
                            {
                                <span class="w-2 h-2 bg-blue-500 rounded-full mt-2"></span>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="p-12 text-center">
                        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                        <h3 class="mt-2 text-sm font-medium text-gray-900">No notifications</h3>
                        <p class="mt-1 text-sm text-gray-500">Everything is up to date!</p>
                    </div>
                }
            </div>
            @if (notifications.Any())
            {
                <div class="p-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-sm text-gray-500">Showing @startIndex-@endIndex of @notifications.Count notification(s) · Page @currentPage/@totalPages</span>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private bool isRefreshing = false;
    private DateTime lastRefresh = DateTime.Now;
    private System.Threading.Timer? refreshTimer;

    private int pendingOrderCount = 0;
    private int openTicketCount = 0;
    private int lowStockCount = 0;
    private int shippedOrderCount = 0;

    private List<NotificationItem> notifications = new();
    private int currentPage = 1;
    private const int pageSize = 20;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(notifications.Count / (double)pageSize));
    private List<NotificationItem> pagedNotifications => notifications
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
    private int startIndex => notifications.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    private int endIndex => notifications.Count == 0 ? 0 : Math.Min(currentPage * pageSize, notifications.Count);

    private class NotificationItem
    {
        public string Type { get; set; } = "";
        public string Title { get; set; } = "";
        public string Message { get; set; } = "";
        public DateTime Timestamp { get; set; }
        public bool IsRead { get; set; }
        public string IconBgColor { get; set; } = "bg-gray-100";
        public string IconColor { get; set; } = "text-gray-600";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();

        // Auto-refresh every 30 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadNotifications(silent: true);
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadNotifications(bool silent = false)
    {
        if (!silent) isLoading = true;
        isRefreshing = true;

        try
        {
            var ordersTask = ApiClient.GetOrdersAsync();
            var ticketsTask = ApiClient.GetTicketsAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, ticketsTask, productsTask);

            var orders = await ordersTask ?? new List<Order>();
            var tickets = await ticketsTask ?? new List<Ticket>();
            var products = await productsTask ?? new List<Product>();

            // Calculate counts
            pendingOrderCount = orders.Count(o => o.Status == "Pending");
            openTicketCount = tickets.Count(t => t.Status != "Resolved" && t.Status != "Closed");
            lowStockCount = products.Count(p => p.IsActive && p.StockQuantity > 0 && p.StockQuantity <= 10);
            shippedOrderCount = orders.Count(o => o.Status == "Shipped");

            // Generate notifications from real data
            notifications.Clear();

            // Order notifications
            foreach (var order in orders.OrderByDescending(o => o.OrderDate).Take(20))
            {
                var (bgColor, iconColor) = order.Status switch
                {
                    "Pending" => ("bg-yellow-100", "text-yellow-600"),
                    "Processing" => ("bg-blue-100", "text-blue-600"),
                    "Shipped" => ("bg-purple-100", "text-purple-600"),
                    "Delivered" => ("bg-green-100", "text-green-600"),
                    "Cancelled" => ("bg-red-100", "text-red-600"),
                    _ => ("bg-gray-100", "text-gray-600")
                };

                notifications.Add(new NotificationItem
                {
                    Type = "Order",
                    Title = $"Order {order.OrderNumber} - {order.Status}",
                    Message = $"Customer: {(string.IsNullOrEmpty(order.CustomerName) ? $"#{order.CustomerId}" : order.CustomerName)} | Total: ₱{order.TotalAmount:N2}",
                    Timestamp = order.OrderDate,
                    IsRead = order.Status == "Delivered" || order.Status == "Cancelled",
                    IconBgColor = bgColor,
                    IconColor = iconColor
                });
            }

            // Ticket notifications
            foreach (var ticket in tickets.OrderByDescending(t => t.CreatedAt).Take(15))
            {
                var (bgColor, iconColor) = ticket.Priority switch
                {
                    "High" or "Critical" => ("bg-red-100", "text-red-600"),
                    "Medium" => ("bg-orange-100", "text-orange-600"),
                    _ => ("bg-blue-100", "text-blue-600")
                };

                notifications.Add(new NotificationItem
                {
                    Type = "Ticket",
                    Title = $"Ticket {ticket.TicketNumber} - {ticket.Status}",
                    Message = $"{ticket.Title} | Priority: {ticket.Priority} | Customer: {ticket.CustomerName}",
                    Timestamp = ticket.CreatedAt,
                    IsRead = ticket.Status == "Resolved" || ticket.Status == "Closed",
                    IconBgColor = bgColor,
                    IconColor = iconColor
                });
            }

            // Low stock notifications
            foreach (var product in products.Where(p => p.IsActive && p.StockQuantity <= 10).OrderBy(p => p.StockQuantity).Take(10))
            {
                notifications.Add(new NotificationItem
                {
                    Type = "Stock",
                    Title = product.StockQuantity == 0 ? $"{product.Name} - OUT OF STOCK" : $"{product.Name} - Low Stock Alert",
                    Message = $"Category: {product.Category} | Current Stock: {product.StockQuantity} units",
                    Timestamp = product.UpdatedAt ?? product.CreatedAt,
                    IsRead = false,
                    IconBgColor = product.StockQuantity == 0 ? "bg-red-100" : "bg-yellow-100",
                    IconColor = product.StockQuantity == 0 ? "text-red-600" : "text-yellow-600"
                });
            }

            // Sort all notifications by timestamp, newest first
            notifications = notifications.OrderByDescending(n => n.Timestamp).ToList();
            currentPage = 1;

            lastRefresh = DateTime.Now;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            isRefreshing = false;
        }
    }

    private async Task RefreshNotifications()
    {
        await LoadNotifications(silent: true);
    }

    private void MarkAllAsRead()
    {
        foreach (var n in notifications)
        {
            n.IsRead = true;
        }
    }

    private string GetTimeAgo(DateTime timestamp)
    {
        var diff = DateTime.Now - timestamp;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} minute(s) ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} hour(s) ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} day(s) ago";
        return timestamp.ToString("MMM dd, yyyy");
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}
