    .sv-order-date { color:#9ca3af; font-size:.72rem; }
    .sv-status-badge { font-size:.67rem; font-weight:700; padding:.2rem .55rem; border-radius:.35rem; }
    .sv-status-completed { background:#d1fae5; color:#065f46; }
    .sv-status-pending { background:#fef3c7; color:#92400e; }
    .sv-status-processing { background:#dbeafe; color:#1e40af; }
