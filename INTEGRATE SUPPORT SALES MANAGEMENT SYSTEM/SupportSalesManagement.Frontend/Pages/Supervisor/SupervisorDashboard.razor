    /* Ticket list */
    .sv-ticket-list { display:flex; flex-direction:column; gap:.5rem; }
    .sv-ticket-row { display:flex; align-items:center; gap:.75rem; padding:.6rem .75rem; border:1px solid #f3f4f6; border-radius:.65rem; transition:border-color .2s; }
    .sv-ticket-row:hover { border-color:#c7d2fe; }
    .sv-ticket-icon { width:2rem; height:2rem; border-radius:.45rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:.7rem; font-weight:700; }
