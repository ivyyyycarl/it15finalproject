    .sv-ticket-status { font-size:.7rem; font-weight:600; margin:.1rem 0 0; }
    .sv-ticket-time { font-size:.68rem; color:#d1d5db; white-space:nowrap; }

    /* Misc */
    .sv-empty-text { font-size:.8rem; color:#9ca3af; text-align:center; padding:.75rem 0; }
</style>

@code {
    private List<Ticket> allTickets = new();
    private List<Ticket> recentTickets = new();
    private List<Order> allOrders = new();
    private List<Order> recentOrders = new();
    private int openTicketCount;
    private int resolvedTicketCount;
    private int totalCallCount;
    private int inProgressCallCount;
    private int pendingOrderCount;
    private decimal totalRevenue;
    private decimal avgOrderValue;
    private int totalOrdersForDonut;
    private DateTime rangeFrom = DateTime.Today.AddDays(-13);
    private DateTime rangeTo = DateTime.Today;
    private string rangeFromInput = DateTime.Today.AddDays(-13).ToString("yyyy-MM-dd");
    private string rangeToInput = DateTime.Today.ToString("yyyy-MM-dd");
    private string liveDateTime = DateTime.Now.ToString("dddd, MMM dd yyyy • hh:mm:ss tt");
    private System.Timers.Timer? liveClockTimer;
    private int ordersCurrentPage = 1;
    private const int ordersPageSize = 6;
    private int ordersTotalPages => Math.Max(1, (int)Math.Ceiling(recentOrders.Count / (double)ordersPageSize));
    private List<Order> pagedRecentOrders => recentOrders.Skip((ordersCurrentPage - 1) * ordersPageSize).Take(ordersPageSize).ToList();

    // Chart data
    private record ChartPt(string Label, decimal RevValue, int OrdCount);
    private List<ChartPt> revenueChartPoints = new();

    private record BarPt(string Label, int Value);
    private List<BarPt> ticketGrowth = new();

    private record DonutSlice(string Label, int Value);
    private List<DonutSlice> orderStatusSlices = new();
    private readonly string[] donutColors = { "#10b981", "#6366f1", "#f59e0b", "#ef4444", "#8b5cf6" };

    private record ActivityItem(string Title, string IconSvg, string IconClass, DateTime Date);
    private List<ActivityItem> recentActivity = new();

    protected override async Task OnInitializedAsync()
    {
        var ticketsTask = ApiClient.GetTicketsAsync();
        var callsTask = ApiClient.GetCallsAsync();
        var ordersTask = ApiClient.GetOrdersAsync();

        allTickets = await ticketsTask ?? new();
        var allCalls = await callsTask ?? new();
        allOrders = await ordersTask ?? new();

        // Ticket metrics
        openTicketCount = allTickets.Count(t => t.Status != "Closed" && t.Status != "Resolved");
        resolvedTicketCount = allTickets.Count(t => t.Status == "Resolved" || t.Status == "Closed");
        totalCallCount = allCalls.Count;
        inProgressCallCount = allCalls.Count(c => string.Equals(c.Status, "InProgress", StringComparison.OrdinalIgnoreCase));
        recentTickets = allTickets.OrderByDescending(t => t.CreatedAt).Take(6).ToList();

        // Order metrics
        totalRevenue = allOrders.Sum(o => o.TotalAmount);
        pendingOrderCount = allOrders.Count(o => o.Status == "Pending");
        avgOrderValue = allOrders.Any() ? allOrders.Average(o => o.TotalAmount) : 0m;
        recentOrders = allOrders.OrderByDescending(o => o.OrderDate).ToList();
        ordersCurrentPage = 1;
        totalOrdersForDonut = allOrders.Count;

        BuildRevenueTrendData();

        // Ticket growth (last 7 days)
        var days7 = Enumerable.Range(0, 7).Select(i => DateTime.Today.AddDays(-6 + i)).ToList();
        ticketGrowth = days7.Select(d => new BarPt(
            "Day " + d.Day,
            allTickets.Count(t => t.CreatedAt.Date == d.Date)
        )).ToList();

        // Order status donut
        orderStatusSlices = allOrders
            .GroupBy(o => string.IsNullOrEmpty(o.Status) ? "Unknown" : o.Status)
            .Select(g => new DonutSlice(g.Key, g.Count()))
            .OrderByDescending(s => s.Value)
            .Take(5)
            .ToList();

        // Recent activity from tickets + orders
        var ticketActs = allTickets.OrderByDescending(t => t.CreatedAt).Take(4).Select(t => new ActivityItem(
            $"Ticket #{t.TicketNumber} — {t.Status}",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z\"/></svg>",
            "sv-act-blue",
            t.CreatedAt));

        var orderActs = allOrders.OrderByDescending(o => o.CreatedAt).Take(4).Select(o => new ActivityItem(
            $"Order #{o.OrderNumber} — {o.Status} (₱{o.TotalAmount:N0})",
            "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"/></svg>",
            "sv-act-green",
            o.CreatedAt));

        recentActivity = ticketActs.Concat(orderActs)
            .OrderByDescending(a => a.Date)
            .Take(7)
            .ToList();

        liveClockTimer = new System.Timers.Timer(1000);
        liveClockTimer.Elapsed += (_, _) =>
        {
            liveDateTime = DateTime.Now.ToString("dddd, MMM dd yyyy • hh:mm:ss tt");
            InvokeAsync(StateHasChanged);
        };
        liveClockTimer.Start();
    }

    private string DisplayRangeFrom => rangeFrom.ToString("MMM dd, yyyy");
    private string DisplayRangeTo => rangeTo.ToString("MMM dd, yyyy");

    private void OnRangeFromChanged(ChangeEventArgs e)
    {
        rangeFromInput = e.Value?.ToString() ?? rangeFromInput;
    }

    private void OnRangeToChanged(ChangeEventArgs e)
    {
        rangeToInput = e.Value?.ToString() ?? rangeToInput;
    }

    private void ApplyDateRange()
    {
        if (!DateTime.TryParse(rangeFromInput, out var parsedFrom) || !DateTime.TryParse(rangeToInput, out var parsedTo))
        {
            return;
        }

        if (parsedFrom > parsedTo)
        {
            var temp = parsedFrom;
            parsedFrom = parsedTo;
            parsedTo = temp;
            rangeFromInput = parsedFrom.ToString("yyyy-MM-dd");
            rangeToInput = parsedTo.ToString("yyyy-MM-dd");
        }

        rangeFrom = parsedFrom.Date;
        rangeTo = parsedTo.Date;
        BuildRevenueTrendData();
    }

    private void BuildRevenueTrendData()
    {
        if (rangeTo < rangeFrom)
        {
            var temp = rangeFrom;
            rangeFrom = rangeTo;
            rangeTo = temp;
        }

        var totalDays = Math.Max(1, (rangeTo - rangeFrom).Days + 1);
        var days = Enumerable
            .Range(0, totalDays)
            .Select(i => rangeFrom.AddDays(i))
            .ToList();

        revenueChartPoints = days.Select(d => new ChartPt(
            d.ToString("M/d"),
            allOrders.Where(o => o.OrderDate.Date == d.Date || o.CreatedAt.Date == d.Date).Sum(o => o.TotalAmount),
            allOrders.Count(o => o.OrderDate.Date == d.Date || o.CreatedAt.Date == d.Date)
        )).ToList();
    }

    private async Task ConfirmCreateTicketAsync()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Create a new support ticket?");
        if (!confirmed)
        {
            return;
        }

        Nav.NavigateTo("/supervisor/tickets/create");
    }

    // SVG line generation helpers
    private string BuildSvgLine(List<double> values, int w = 700, int h = 200)
    {
        if (!values.Any()) return "";
        var max = values.Max();
        var min = values.Min();
        var range = max - min <= 0 ? 1 : max - min;
        var pts = values.Select((v, i) =>
        {
            var x = i * (w - 20) / Math.Max(1, values.Count - 1) + 10;
            var y = h - 10 - (v - min) / range * (h - 20);
            return $"{x.ToString("F1")},{y.ToString("F1")}";
        }).ToList();
        return "M " + string.Join(" L ", pts);
    }

    private string BuildSvgArea(string linePath, int h = 200)
    {
        if (string.IsNullOrEmpty(linePath)) return "";
        return linePath + $" L 710,{h} L 0,{h} Z";
    }

    private string RevenueSvgLine => BuildSvgLine(revenueChartPoints.Select(p => (double)p.RevValue).ToList());
    private string RevenueSvgPath => BuildSvgArea(RevenueSvgLine);
    private string OrderSvgLine => BuildSvgLine(revenueChartPoints.Select(p => (double)p.OrdCount * (revenueChartPoints.Max(x => (double)x.RevValue) / Math.Max(1, revenueChartPoints.Max(x => x.OrdCount)))).ToList());
    private string OrderSvgPath => BuildSvgArea(OrderSvgLine);

    private static string FormatTimeAgo(DateTime d)
    {
        var s = DateTime.Now - d;
        if (s.TotalMinutes < 1) return "just now";
        if (s.TotalMinutes < 60) return $"{(int)s.TotalMinutes}m ago";
        if (s.TotalHours < 24) return $"{(int)s.TotalHours}h ago";
        if (s.TotalDays < 30) return $"{(int)s.TotalDays}d ago";
        return d.ToString("MMM dd, yyyy");
    }

    private static string GetStatusBgColor(string s) => s switch
    {
        "Open" => "sv-act-blue", "In Progress" => "sv-act-amber",
        "Resolved" => "sv-act-green", "Closed" => "sv-act-blue",
        "Escalated" => "sv-act-red", _ => "sv-act-violet"
    };

    private static string GetStatusLabelColor(string s) => s switch
    {
        "Open" => "text-blue-600", "In Progress" => "text-yellow-600",
        "Resolved" => "text-emerald-600", "Closed" => "text-gray-500",
        "Escalated" => "text-red-600", _ => "text-gray-700"
    };

    private static string GetOrderStatusClass(string s) => s?.ToLower() switch
    {
        "completed" or "delivered" => "sv-status-completed",
        "pending" => "sv-status-pending",
        "processing" => "sv-status-processing",
        "cancelled" or "canceled" => "sv-status-cancelled",
        _ => "sv-status-default"
    };

    private void PreviousOrdersPage()
    {
        if (ordersCurrentPage <= 1) return;
        ordersCurrentPage--;
    }

    private void NextOrdersPage()
    {
        if (ordersCurrentPage >= ordersTotalPages) return;
        ordersCurrentPage++;
    }

    public void Dispose()
    {
        liveClockTimer?.Stop();
        liveClockTimer?.Dispose();
    }
}
