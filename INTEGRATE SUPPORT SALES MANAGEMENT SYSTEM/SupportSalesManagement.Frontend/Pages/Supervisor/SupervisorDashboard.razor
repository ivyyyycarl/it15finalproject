@page "/supervisor/dashboard"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@using SupportSalesManagement.Frontend.Models
@implements IDisposable

<PageTitle>Supervisor Dashboard - ClassicFit</PageTitle>

<div class="sv-container">

    <!-- ===== HEADER ===== -->
    <div class="sv-header">
        <div>
            <h1 class="sv-title">Supervisor Dashboard</h1>
            <p class="sv-subtitle">Overview of your team's performance and operations</p>
            <div class="sv-live-time">
                <span class="sv-live-dot"></span>
                <span>@liveDateTime</span>
            </div>
        </div>
        <div class="sv-header-actions">
            <button class="sv-btn sv-btn-outline" @onclick="async () => { Nav.NavigateTo(Nav.Uri, forceLoad: true); }">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Refresh
            </button>
            <button class="sv-btn sv-btn-ghost" @onclick='() => Nav.NavigateTo("/supervisor/reports")'>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                Reports
            </button>
            <button class="sv-btn sv-btn-primary" @onclick="ConfirmCreateTicketAsync">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                New Ticket
            </button>
        </div>
    </div>

    <!-- ===== STAT CARDS ===== -->
    <div class="sv-sc-grid">

        <!-- Total Tickets -->
        <a href="/supervisor/tickets?filter=All" class="sv-sc-card sv-sc-card-link sv-tone-indigo">
            <div class="sv-sc-body">
                <div class="sv-sc-icon sv-sc-icon-indigo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                </div>
                <div>
                    <p class="sv-sc-label">Total Tickets</p>
                    <p class="sv-sc-value">@allTickets.Count.ToString("N0")</p>
                    <div class="sv-sc-change sv-change-up">
                        <svg viewBox="0 0 12 12" class="sv-arrow"><path d="M1 9 L6 3 L11 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                        <span>@openTicketCount open</span>
                    </div>
                </div>
            </div>
        </a>

        <!-- Revenue from Orders -->
        <a href="/supervisor/financials/revenue?range=30" class="sv-sc-card sv-sc-card-link sv-tone-emerald">
            <div class="sv-sc-body">
                <div class="sv-sc-icon sv-sc-icon-emerald">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                </div>
                <div>
                    <p class="sv-sc-label">Revenue</p>
                    <p class="sv-sc-value">₱@totalRevenue.ToString("N0")</p>
                    <div class="sv-sc-change sv-change-up">
                        <svg viewBox="0 0 12 12" class="sv-arrow"><path d="M1 9 L6 3 L11 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                        <span>from @allOrders.Count orders • avg ₱@avgOrderValue.ToString("N0")</span>
                    </div>
                </div>
            </div>
        </a>

        <!-- Orders -->
        <a href="/supervisor/orders?status=Pending" class="sv-sc-card sv-sc-card-link sv-tone-amber">
            <div class="sv-sc-body">
                <div class="sv-sc-icon sv-sc-icon-amber">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                </div>
                <div>
                    <p class="sv-sc-label">Orders</p>
                    <p class="sv-sc-value">@allOrders.Count.ToString("N0")</p>
                    <div class="sv-sc-change @(pendingOrderCount > 0 ? "sv-change-down" : "sv-change-up")">
                        @if (pendingOrderCount > 0)
                        {
                            <svg viewBox="0 0 12 12" class="sv-arrow"><path d="M1 3 L6 9 L11 3" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 12 12" class="sv-arrow"><path d="M1 9 L6 3 L11 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                        }
                        <span>@pendingOrderCount pending</span>
                    </div>
                </div>
            </div>
        </a>

        <!-- Calls / Avg Response -->
        <a href="/supervisor/calls?status=Completed" class="sv-sc-card sv-sc-card-link sv-tone-sky">
            <div class="sv-sc-body">
                <div class="sv-sc-icon sv-sc-icon-sky">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                    <p class="sv-sc-label">Total Calls</p>
                    <p class="sv-sc-value">@totalCallCount.ToString("N0")</p>
                    <div class="sv-sc-change sv-change-up">
                        <svg viewBox="0 0 12 12" class="sv-arrow"><path d="M1 9 L6 3 L11 9" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                        <span>@resolvedTicketCount resolved • @inProgressCallCount active</span>
                    </div>
                </div>
            </div>
        </a>

    </div>

    <!-- ===== REVENUE OVERVIEW + RECENT ACTIVITY ===== -->
    <div class="sv-main-row">

        <!-- Revenue / Ticket Trend Chart -->
        <div class="sv-panel sv-panel-chart">
            <div class="sv-panel-header">
                <div>
                    <h2 class="sv-panel-title">Revenue Overview</h2>
                    <p class="sv-panel-sub">Order value from @DisplayRangeFrom to @DisplayRangeTo</p>
                </div>
                <div class="sv-range-group">
                    <input type="date" value="@rangeFromInput" @onchange="OnRangeFromChanged" class="sv-date-input" />
                    <span class="sv-range-sep">to</span>
                    <input type="date" value="@rangeToInput" @onchange="OnRangeToChanged" class="sv-date-input" />
                    <button type="button" class="sv-tab sv-tab-active" @onclick="ApplyDateRange">Apply</button>
                </div>
            </div>
            <!-- SVG Line Chart built from real data -->
            <div class="sv-chart-wrap">
                @if (revenueChartPoints.Any())
                {
                    <svg class="sv-line-chart" viewBox="0 0 700 200" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="sv-rev-g" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#6366f1" stop-opacity="0.25"/>
                                <stop offset="100%" stop-color="#6366f1" stop-opacity="0"/>
                            </linearGradient>
                            <linearGradient id="sv-ord-g" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#10b981" stop-opacity="0.2"/>
                                <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
                            </linearGradient>
                        </defs>
                        <!-- Revenue area -->
                        <path d="@RevenueSvgPath" fill="url(#sv-rev-g)"/>
                        <path d="@RevenueSvgLine" fill="none" stroke="#6366f1" stroke-width="2.5"/>
                        <!-- Order count area -->
                        <path d="@OrderSvgPath" fill="url(#sv-ord-g)"/>
                        <path d="@OrderSvgLine" fill="none" stroke="#10b981" stroke-width="2" stroke-dasharray="5 3"/>
                    </svg>
                    <!-- X-axis labels -->
                    <div class="sv-chart-labels">
                        @foreach (var pt in revenueChartPoints.Where((_, i) => i % 2 == 0))
                        {
                            <span>@pt.Label</span>
                        }
                    </div>
                    <!-- Legend -->
                    <div class="sv-chart-legend">
                        <span class="sv-legend-dot" style="background:#6366f1"></span><span>Revenue</span>
                        <span class="sv-legend-dot" style="background:#10b981; margin-left:.75rem"></span><span>Order Count</span>
                    </div>
                }
                else
                {
                    <p class="sv-empty-text">No order data yet.</p>
                }
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="sv-panel">
            <div class="sv-panel-header">
                <h2 class="sv-panel-title">Recent Activity</h2>
            </div>
            <div class="sv-activity-list">
                @foreach (var item in recentActivity)
                {
                    <div class="sv-activity-item">
                        <div class="sv-activity-icon @item.IconClass">
                            @((MarkupString)item.IconSvg)
                        </div>
                        <div class="sv-activity-body">
                            <p class="sv-activity-desc">@item.Title</p>
                            <p class="sv-activity-time">@FormatTimeAgo(item.Date)</p>
                        </div>
                    </div>
                }
                @if (!recentActivity.Any())
                {
                    <p class="sv-empty-text">No recent activity.</p>
                }
            </div>
        </div>

    </div>

    <!-- ===== BOTTOM GRID ===== -->
    <div class="sv-bottom-grid">
        <!-- Order Status Donut -->
        <div class="sv-panel sv-donut-panel">
            <div class="sv-panel-header">
                <h2 class="sv-panel-title">Order Status Distribution</h2>
            </div>
            @if (orderStatusSlices.Any())
            {
                <div class="sv-donut-wrap">
                    <div class="sv-donut-ring">
                        <svg viewBox="0 0 100 100" class="sv-donut-svg">
                            @{ double svOffset = 0; }
                            @for (int i = 0; i < orderStatusSlices.Count; i++)
                            {
                                var slice = orderStatusSlices[i];
                                var pct = totalOrdersForDonut > 0 ? (double)slice.Value / totalOrdersForDonut : 0;
                                var dashLen = pct * 251.2;
                                var dashGap = 251.2 - dashLen;
                                var color = donutColors[i % donutColors.Length];
                                <circle class="sv-donut-seg"
                                        cx="50" cy="50" r="40"
                                        stroke="@color"
                                        stroke-dasharray="@dashLen.ToString("F1") @dashGap.ToString("F1")"
                                        stroke-dashoffset="@(-(svOffset * 251.2 / 100)).ToString("F1")"
                                        fill="none" stroke-width="18"/>
                                svOffset += pct * 100;
                            }
                        </svg>
                        <div class="sv-donut-center">
                            <span class="sv-donut-total">@allOrders.Count</span>
                            <span class="sv-donut-lab">Orders</span>
                        </div>
                    </div>
                    <div class="sv-donut-legend">
                        @for (int i = 0; i < orderStatusSlices.Count; i++)
                        {
                            var slice = orderStatusSlices[i];
                            var color = donutColors[i % donutColors.Length];
                            <div class="sv-donut-item">
                                <span class="sv-donut-dot" style="background:@color"></span>
                                <span class="sv-donut-name">@slice.Label</span>
                                <span class="sv-donut-count">@slice.Value</span>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <p class="sv-empty-text">No order data.</p>
            }
        </div>

    </div>

    <!-- ===== RECENT ORDERS TABLE + TICKET STATUS ===== -->
    <div class="sv-table-row">

        <!-- Recent Orders Table -->
        <div class="sv-panel sv-panel-table">
            <div class="sv-panel-header">
                <h2 class="sv-panel-title">Recent Orders</h2>
                <a href="/supervisor/orders" class="sv-view-all">View All →</a>
            </div>
            <div class="sv-table-wrap">
                <table class="sv-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in pagedRecentOrders)
                        {
                            <tr>
                                <td class="sv-order-id">#@order.OrderNumber</td>
                                <td>@(string.IsNullOrEmpty(order.CustomerName) ? $"Customer #{order.CustomerId}" : order.CustomerName)</td>
                                <td class="sv-order-amount">₱@order.TotalAmount.ToString("N2")</td>
                                <td><span class="sv-status-badge @GetOrderStatusClass(order.Status)">@order.Status</span></td>
                                <td class="sv-order-date">@order.OrderDate.ToString("M/d/yyyy")</td>
                            </tr>
                        }
                        @if (!recentOrders.Any())
                        {
                            <tr><td colspan="5" class="sv-empty-text" style="text-align:center; padding:1.5rem">No orders found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (recentOrders.Any())
            {
                <div style="margin-top:.75rem; display:flex; align-items:center; justify-content:space-between;">
                    <span style="font-size:.72rem; color:#9ca3af;">Showing @(((ordersCurrentPage - 1) * ordersPageSize) + 1)-@Math.Min(ordersCurrentPage * ordersPageSize, recentOrders.Count) of @recentOrders.Count · Page @ordersCurrentPage/@ordersTotalPages</span>
                    <div style="display:flex; align-items:center; gap:.5rem;">
                        <button type="button" @onclick="PreviousOrdersPage" disabled="@(ordersCurrentPage <= 1)" class="sv-btn sv-btn-outline">Previous</button>
                        <button type="button" @onclick="NextOrdersPage" disabled="@(ordersCurrentPage >= ordersTotalPages)" class="sv-btn sv-btn-outline">Next</button>
                    </div>
                </div>
            }
        </div>

        <!-- Ticket Status Summary + Recent Tickets -->
        <div class="sv-panel">
            <div class="sv-panel-header">
                <h2 class="sv-panel-title">Recent Tickets</h2>
                <a href="/supervisor/tickets" class="sv-view-all">View All →</a>
            </div>
            <div class="sv-ticket-list">
                @foreach (var ticket in recentTickets)
                {
                    <div class="sv-ticket-row">
                        <div class="sv-ticket-icon @GetStatusBgColor(ticket.Status)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                        </div>
                        <div class="sv-ticket-body">
                            <p class="sv-ticket-title"><span class="sv-ticket-num">#@ticket.TicketNumber</span> @ticket.Title</p>
                            <p class="sv-ticket-status @GetStatusLabelColor(ticket.Status)">@ticket.Status</p>
                        </div>
                        <span class="sv-ticket-time">@FormatTimeAgo(ticket.CreatedAt)</span>
                    </div>
                }
                @if (!recentTickets.Any())
                {
                    <p class="sv-empty-text">No recent tickets.</p>
                }
            </div>
        </div>

    </div>

</div>

<style>
    /* Layout */
    .sv-container { padding:1.5rem; max-width:1560px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem; }
    @@media(min-width:1024px){ .sv-container { padding:2rem; gap:1.75rem; } }

    /* Header */
    .sv-header { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:1rem; }
    .sv-title { font-size:22px; font-weight:800; color:#111827; letter-spacing:-.025em; margin:0; }
    .sv-subtitle { font-size:.85rem; color:#6b7280; margin:.2rem 0 0; }
    .sv-live-time { margin-top:.35rem; display:inline-flex; align-items:center; gap:.4rem; font-size:12px; color:#4b5563; font-weight:600; }
    .sv-live-dot { width:.5rem; height:.5rem; border-radius:9999px; background:#10b981; animation:svPulse 1.6s infinite; }
    @@keyframes svPulse { 0% { opacity:1; } 50% { opacity:.35; } 100% { opacity:1; } }
    .sv-header-actions { display:flex; gap:.6rem; flex-wrap:wrap; }
    .sv-btn { display:inline-flex; align-items:center; gap:.4rem; padding:.5rem .9rem; border-radius:.6rem; font-size:.8rem; font-weight:600; cursor:pointer; border:none; transition:all .15s; }
    .sv-btn svg { width:.9rem; height:.9rem; }
    .sv-btn-primary { background:#4f46e5; color:#fff; }
    .sv-btn-primary:hover { background:#4338ca; }
    .sv-btn-outline { background:#fff; border:1px solid #e5e7eb; color:#374151; }
    .sv-btn-outline:hover { background:#f9fafb; }
    .sv-btn-ghost { background:#eef2ff; border:1px solid #e0e7ff; color:#4f46e5; }
    .sv-btn-ghost:hover { background:#e0e7ff; }

    /* Stat Cards */
    .sv-sc-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; align-items:stretch; }
    @@media(min-width:1024px){ .sv-sc-grid { grid-template-columns:repeat(4,1fr); } }
    .sv-sc-grid > * { height:100%; }
    .sv-sc-card { background:#fff; border:1px solid var(--card-border-color, #e2e8f0); border-radius:var(--card-radius, 1rem); padding:1.25rem; box-shadow:var(--card-shadow, 0 1px 4px rgba(0,0,0,.05)); transition:box-shadow .2s; min-height:var(--card-min-height-sm, 170px); height:100%; }
    .sv-sc-card:hover { box-shadow:var(--card-shadow-hover, 0 8px 18px rgba(0,0,0,.09)); }
    .sv-sc-card-link { text-decoration:none; color:inherit; }
    .sv-tone-indigo { background:linear-gradient(135deg, #eef2ff 0%, #ffffff 70%); border-color:#c7d2fe; }
    .sv-tone-emerald { background:linear-gradient(135deg, #ecfdf5 0%, #ffffff 70%); border-color:#a7f3d0; }
    .sv-tone-amber { background:linear-gradient(135deg, #fffbeb 0%, #ffffff 70%); border-color:#fde68a; }
    .sv-tone-sky { background:linear-gradient(135deg, #f0f9ff 0%, #ffffff 70%); border-color:#bae6fd; }
    .sv-sc-body { display:flex; align-items:flex-start; gap:1rem; }
    .sv-sc-icon { width:2.75rem; height:2.75rem; border-radius:.75rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sv-sc-icon svg { width:1.25rem; height:1.25rem; }
    .sv-sc-icon-indigo { background:#eef2ff; color:#4f46e5; }
    .sv-sc-icon-emerald { background:#ecfdf5; color:#059669; }
    .sv-sc-icon-amber { background:#fffbeb; color:#d97706; }
    .sv-sc-icon-sky { background:#f0f9ff; color:#0284c7; }
    .sv-sc-label { font-size:.72rem; font-weight:600; color:#9ca3af; text-transform:uppercase; letter-spacing:.05em; margin:0 0 .2rem; }
    .sv-sc-value { font-size:1.6rem; font-weight:900; color:#111827; margin:0; line-height:1.1; }
    .sv-sc-change { display:flex; align-items:center; gap:.25rem; font-size:.72rem; font-weight:700; margin-top:.25rem; }
    .sv-change-up { color:#059669; }
    .sv-change-down { color:#dc2626; }
    .sv-arrow { width:.65rem; height:.65rem; }

    /* Panel */
    .sv-panel { background:#fff; border:1px solid var(--card-border-color, #e2e8f0); border-radius:var(--card-radius, 1rem); padding:1.25rem; box-shadow:var(--card-shadow, 0 1px 4px rgba(0,0,0,.05)); min-height:var(--card-min-height-md, 210px); height:100%; }
    .sv-panel-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; }
    .sv-panel-title { font-size:.95rem; font-weight:800; color:#111827; margin:0; }
    .sv-panel-sub { font-size:.72rem; color:#9ca3af; margin:.15rem 0 0; }
    .sv-view-all { font-size:.75rem; font-weight:700; color:#4f46e5; text-decoration:none; }
    .sv-view-all:hover { color:#3730a3; }

    /* Main row: chart + activity */
    .sv-main-row { display:grid; grid-template-columns:1fr; gap:1rem; align-items:stretch; }
    @@media(min-width:1024px){ .sv-main-row { grid-template-columns:2fr 1fr; } }
    .sv-panel-chart { display:flex; flex-direction:column; }

    /* Tab group */
    .sv-tab-group { display:flex; background:#f3f4f6; border-radius:.5rem; padding:.15rem; gap:.15rem; }
    .sv-tab { padding:.25rem .65rem; border-radius:.35rem; font-size:.72rem; font-weight:700; color:#6b7280; cursor:pointer; border:none; background:transparent; }
    .sv-tab-active { background:#fff; color:#4f46e5; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .sv-range-group { display:flex; align-items:center; gap:.35rem; flex-wrap:wrap; }
    .sv-date-input { border:1px solid #d1d5db; border-radius:.45rem; padding:.3rem .45rem; font-size:.72rem; color:#374151; background:#fff; }
    .sv-range-sep { font-size:.72rem; color:#6b7280; font-weight:600; }

    /* SVG Chart */
    .sv-chart-wrap { flex:1; display:flex; flex-direction:column; gap:.35rem; }
    .sv-line-chart { width:100%; height:11rem; display:block; }
    .sv-chart-labels { display:flex; justify-content:space-between; font-size:.65rem; color:#9ca3af; padding:0 .5rem; }
    .sv-chart-legend { display:flex; align-items:center; gap:.35rem; font-size:.72rem; color:#6b7280; margin-top:.25rem; }
    .sv-legend-dot { width:.6rem; height:.6rem; border-radius:50%; display:inline-block; }

    /* Activity */
    .sv-activity-list { display:flex; flex-direction:column; gap:.75rem; }
    .sv-activity-item { display:flex; align-items:center; gap:.75rem; padding:.65rem 0; border-bottom:1px solid #f9fafb; }
    .sv-activity-item:last-child { border-bottom:none; }
    .sv-activity-icon { width:2rem; height:2rem; border-radius:.5rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sv-activity-icon svg { width:.9rem; height:.9rem; }
    .sv-activity-body { flex:1; min-width:0; }
    .sv-activity-desc { font-size:.8rem; font-weight:700; color:#111827; margin:0; }
    .sv-activity-time { font-size:.7rem; color:#9ca3af; margin:.1rem 0 0; }
    .sv-act-blue { background:#dbeafe; color:#2563eb; }
    .sv-act-green { background:#d1fae5; color:#059669; }
    .sv-act-amber { background:#fef3c7; color:#d97706; }
    .sv-act-violet { background:#ede9fe; color:#7c3aed; }
