    .sv-donut-name { flex:1; color:#374151; }
    .sv-donut-count { font-weight:800; color:#111827; }
    .sv-donut-seg { transition:stroke-dasharray .6s ease; }

    /* Table row */
    .sv-table-row { display:grid; grid-template-columns:1fr; gap:1rem; align-items:stretch; }
    @@media(min-width:1024px){ .sv-table-row { grid-template-columns:1.6fr 1fr; } }
    .sv-panel-table {}
    .sv-table-wrap { overflow-x:auto; }
    .sv-table { width:100%; border-collapse:collapse; font-size:.8rem; }
    .sv-table th { padding:.6rem .75rem; text-align:left; font-size:.67rem; font-weight:700; color:#9ca3af; text-transform:uppercase; letter-spacing:.05em; border-bottom:1px solid #f3f4f6; }
