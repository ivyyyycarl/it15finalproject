@page "/supervisor/erp"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="flex items-center justify-between">
        <h1 class="text-[22px] font-bold text-gray-900">ERP Data Integration</h1>
        <button
            class="px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors shadow-sm flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15">
                </path>
            </svg>
            Sync Now
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Inventory Panel -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                    </svg>
                    Inventory Service
                </h3>
                <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Connected
                </span>
            </div>
            <div class="space-y-4">
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Last Synced</span>
                    <span class="text-gray-900 font-medium">2 mins ago</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Total SKUs</span>
                    <span class="text-gray-900 font-medium">1,245</span>
                </div>
                <div class="px-4 py-3 bg-gray-50 rounded-lg border border-gray-200 text-xs font-mono text-gray-600">
                    GET /api/inventory/status - 200 OK<br>
                    Latency: 45ms
                </div>
            </div>
        </div>

        <!-- Finance Panel -->
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                    <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                        </path>
                    </svg>
                    Finance Service
                </h3>
                <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Connected
                </span>
            </div>
            <div class="space-y-4">
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Last Synced</span>
                    <span class="text-gray-900 font-medium">5 mins ago</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-gray-500">Pending Validations</span>
                    <span class="text-gray-900 font-medium">3 Orders</span>
                </div>
                <div class="px-4 py-3 bg-gray-50 rounded-lg border border-gray-200 text-xs font-mono text-gray-600">
                    POST /api/finance/validate - 200 OK<br>
                    Latency: 120ms
                </div>
            </div>
        </div>
    </div>

    <!-- Sync Logs -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-6 border-b border-gray-100">
            <h3 class="text-lg font-bold text-gray-900">System Logs</h3>
        </div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Service
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Event
                    </th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                <tr>
                    <td class="px-6 py-4 text-sm text-gray-500">2024-02-04 14:30:22</td>
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">Inventory</td>
                    <td class="px-6 py-4 text-sm text-gray-500">Stock Update (Diff Sync)</td>
                    <td class="px-6 py-4 text-sm text-green-600">Success</td>
                </tr>
                <tr>
                    <td class="px-6 py-4 text-sm text-gray-500">2024-02-04 14:15:10</td>
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">Finance</td>
                    <td class="px-6 py-4 text-sm text-gray-500">Order Validation #ORD-992</td>
                    <td class="px-6 py-4 text-sm text-green-600">Success</td>
                </tr>
                <tr>
                    <td class="px-6 py-4 text-sm text-gray-500">2024-02-04 13:45:00</td>
                    <td class="px-6 py-4 text-sm font-medium text-gray-900">System</td>
                    <td class="px-6 py-4 text-sm text-gray-500">Daily Backup</td>
                    <td class="px-6 py-4 text-sm text-green-600">Completed</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code {

}
