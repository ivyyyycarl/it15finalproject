@page "/supervisor/calls"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services

@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-[22px] font-bold text-gray-900">Call Logs</h1>
            <p class="text-sm text-gray-500 mt-1">Review all call interactions across the team</p>
        </div>
        <div class="flex gap-3 items-center">
            <!-- Status Filter -->
            <select @bind="statusFilter" @bind:after="OnFilterSelectionChanged"
                class="rounded-lg border-gray-300 focus:ring-purple-500 focus:border-purple-500 text-sm">
                <option value="All">All Status</option>
                <option value="Completed">Completed</option>
                <option value="InProgress">In Progress</option>
                <option value="Missed">Missed</option>
                <option value="Cancelled">Cancelled</option>
            </select>

            <!-- Type Filter -->
            <select @bind="typeFilter" @bind:after="OnFilterSelectionChanged"
                class="rounded-lg border-gray-300 focus:ring-purple-500 focus:border-purple-500 text-sm">
                <option value="All">All Types</option>
                <option value="Inbound">Inbound</option>
                <option value="Outbound">Outbound</option>
                <option value="FollowUp">Follow-Up</option>
            </select>

            <button @onclick="LoadCalls"
                class="px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-medium text-gray-700 hover:bg-gray-50 shadow-sm flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="bg-gradient-to-br from-blue-50 to-white rounded-xl shadow-sm border border-blue-100 p-4">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500 font-semibold">Total Calls</div>
                <div class="w-9 h-9 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                </div>
            </div>
            <div class="text-2xl font-bold text-gray-900 mt-2">@allCalls.Count</div>
        </div>
        <div class="bg-gradient-to-br from-emerald-50 to-white rounded-xl shadow-sm border border-emerald-100 p-4">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500 font-semibold">Completed</div>
                <div class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                </div>
            </div>
            <div class="text-2xl font-bold text-emerald-700 mt-2">@allCalls.Count(c => c.Status == "Completed")</div>
        </div>
        <div class="bg-gradient-to-br from-rose-50 to-white rounded-xl shadow-sm border border-rose-100 p-4">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500 font-semibold">Missed</div>
                <div class="w-9 h-9 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                </div>
            </div>
            <div class="text-2xl font-bold text-rose-700 mt-2">@allCalls.Count(c => c.Status == "Missed")</div>
        </div>
        <div class="bg-gradient-to-br from-amber-50 to-white rounded-xl shadow-sm border border-amber-100 p-4">
            <div class="flex items-center justify-between">
                <div class="text-sm text-gray-500 font-semibold">Escalated</div>
                <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.062 19h13.876c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.33 16c-.77 1.333.192 3 1.732 3z" /></svg>
                </div>
            </div>
            <div class="text-2xl font-bold text-amber-700 mt-2">@allCalls.Count(c => c.IsEscalated)</div>
        </div>
    </div>

    <!-- Call Table -->
    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
        </div>
    }
    else if (!filteredCalls.Any())
    {
        <div class="text-center py-16 bg-white rounded-xl shadow-sm border border-gray-100">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <h3 class="text-lg font-bold text-gray-500">No Call Records Found</h3>
            <p class="text-sm text-gray-400 mt-1">Call logs will appear here when agents handle calls.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Agent</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duration</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Outcome</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Escalated</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var call in pagedFilteredCalls)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">#@call.Id</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @call.StartTime.ToLocalTime().ToString("MMM dd, yyyy")<br>
                                <span class="text-xs">@call.StartTime.ToLocalTime().ToString("hh:mm tt")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@call.AgentName</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@call.CustomerName</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @GetTypeClass(call.Type)">
                                    @call.Type
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">@call.DurationFormatted</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @GetStatusClass(call.Status)">
                                    @call.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(call.Outcome ?? "-")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                @if (call.IsEscalated)
                                {
                                    <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-800">Yes</span>
                                }
                                else
                                {
                                    <span class="text-gray-400 text-xs">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (filteredCalls.Any())
        {
            <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                <p class="text-sm text-gray-600">
                    Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, filteredCalls.Count) of @filteredCalls.Count · Page @currentPage/@totalPages
                </p>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                            class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                            class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                </div>
            </div>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "type")]
    public string? QueryType { get; set; }

    private List<Call> allCalls = new();
    private List<Call> filteredCalls = new();
    private bool isLoading = true;
    private string statusFilter = "All";
    private string typeFilter = "All";
    private int currentPage = 1;
    private const int pageSize = 25;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredCalls.Count / (double)pageSize));
    private List<Call> pagedFilteredCalls => filteredCalls
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCalls();
        ApplyDeepLinkFilters();
    }

    protected override void OnParametersSet()
    {
        ApplyDeepLinkFilters();
        ApplyFilters();
    }

    private async Task LoadCalls()
    {
        isLoading = true;
        try
        {
            allCalls = (await ApiClient.GetCallsAsync()) ?? new();
            allCalls = allCalls.OrderByDescending(c => c.StartTime).ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading calls: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredCalls = allCalls.Where(c =>
            (statusFilter == "All" || c.Status == statusFilter) &&
            (typeFilter == "All" || c.Type == typeFilter)
        ).ToList();
        currentPage = 1;
    }

    private void OnFilterSelectionChanged()
    {
        ApplyFilters();
        SyncUrlState();
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
    }

    private void ApplyDeepLinkFilters()
    {
        if (!string.IsNullOrWhiteSpace(QueryStatus))
        {
            var normalizedStatus = QueryStatus.Trim().ToLowerInvariant();
            statusFilter = normalizedStatus switch
            {
                "all" => "All",
                "completed" => "Completed",
                "inprogress" or "in-progress" or "in progress" => "InProgress",
                "missed" => "Missed",
                "cancelled" or "canceled" => "Cancelled",
                _ => statusFilter
            };
        }

        if (!string.IsNullOrWhiteSpace(QueryType))
        {
            var normalizedType = QueryType.Trim().ToLowerInvariant();
            typeFilter = normalizedType switch
            {
                "all" => "All",
                "inbound" => "Inbound",
                "outbound" => "Outbound",
                "followup" or "follow-up" or "follow up" => "FollowUp",
                _ => typeFilter
            };
        }
    }

    private void SyncUrlState()
    {
        var queryParts = new List<string>();

        if (!string.Equals(statusFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            queryParts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        }

        if (!string.Equals(typeFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            queryParts.Add($"type={Uri.EscapeDataString(typeFilter)}");
        }

        var target = queryParts.Count > 0
            ? $"/supervisor/calls?{string.Join("&", queryParts)}"
            : "/supervisor/calls";

        NavigationManager.NavigateTo(target, replace: true);
    }

    private string GetStatusClass(string status) => status switch
    {
        "Completed" => "bg-green-100 text-green-800",
        "InProgress" => "bg-blue-100 text-blue-800",
        "Missed" => "bg-red-100 text-red-800",
        "Cancelled" => "bg-gray-100 text-gray-800",
        "Scheduled" => "bg-purple-100 text-purple-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetTypeClass(string type) => type switch
    {
        "Inbound" => "bg-blue-100 text-blue-800",
        "Outbound" => "bg-indigo-100 text-indigo-800",
        "FollowUp" => "bg-amber-100 text-amber-800",
        _ => "bg-gray-100 text-gray-800"
    };
}
