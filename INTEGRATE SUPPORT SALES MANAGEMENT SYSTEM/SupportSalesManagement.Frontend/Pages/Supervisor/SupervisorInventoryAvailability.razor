@page "/supervisor/inventory/availability"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]
@inject SupportSalesManagement.Frontend.Services.ApiClient ApiClient
@inject NavigationManager NavigationManager

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-[22px] font-bold text-gray-900">Product Availability</h1>
                <p class="text-sm text-gray-500">Check real-time product availability (Read-Only Access)</p>
            </div>
            <div class="flex items-center gap-2 px-3 py-1 bg-yellow-50 border border-yellow-200 rounded-lg">
                <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-xs font-medium text-yellow-800">Read-Only Access</span>
            </div>
        </div>
    </div>

    <!-- Quick Search -->
    <div class="bg-gradient-to-r from-white to-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Quick Availability Check</h2>
        <div class="flex gap-4">
            <input @bind="searchSku" @bind:after="OnSearchChanged" type="text" placeholder="Enter SKU or product name..."
                class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            <button class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">
                Check Availability
            </button>
        </div>
    </div>

    <!-- Availability by Category -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var category in categories)
        {
            <div class="bg-gradient-to-br from-white to-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                    <h3 class="text-lg font-semibold text-gray-900">@category.Name</h3>
                    <span class="text-sm text-gray-500">@category.TotalProducts items</span>
                </div>
                
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-green-500 rounded-full"></div>
                            <span class="text-sm text-gray-600">Available</span>
                        </div>
                        <span class="text-sm font-semibold text-gray-900">@category.Available</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                            <span class="text-sm text-gray-600">Low Stock</span>
                        </div>
                        <span class="text-sm font-semibold text-gray-900">@category.LowStock</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                            <span class="text-sm text-gray-600">Out of Stock</span>
                        </div>
                        <span class="text-sm font-semibold text-gray-900">@category.OutOfStock</span>
                    </div>
                </div>

                <!-- Availability Percentage -->
                <div class="mt-4 pt-4 border-t border-gray-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs text-gray-600">Availability Rate</span>
                        <span class="text-xs font-semibold text-gray-900">@category.AvailabilityRate%</span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-green-600 h-2 rounded-full" style="width: @(category.AvailabilityRate)%"></div>
                    </div>
                </div>

                <button class="mt-4 w-full px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition text-sm">
                    View Details
                </button>
            </div>
        }
    </div>

    <!-- Recently Checked Products -->
    <div class="mt-6 bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Recently Checked Products</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">SKU</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Size/Variant</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Available Qty</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Checked</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var product in filteredRecentProducts)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@product.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@product.Sku</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@product.Variant</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">@product.Quantity</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (product.IsAvailable)
                                {
                                    <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                        Available
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                        </svg>
                                        Unavailable
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@product.LastChecked.ToString("MMM dd, HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearch { get; set; }

    private string searchSku = "";

    private IEnumerable<ProductCheck> filteredRecentProducts => string.IsNullOrWhiteSpace(searchSku)
        ? recentProducts
        : recentProducts.Where(p =>
            p.Name.Contains(searchSku, StringComparison.OrdinalIgnoreCase) ||
            p.Sku.Contains(searchSku, StringComparison.OrdinalIgnoreCase) ||
            p.Variant.Contains(searchSku, StringComparison.OrdinalIgnoreCase));

    private class CategoryAvailability
    {
        public string Name { get; set; } = "";
        public int TotalProducts { get; set; }
        public int Available { get; set; }
        public int LowStock { get; set; }
        public int OutOfStock { get; set; }
        public int AvailabilityRate => TotalProducts > 0 ? (Available * 100 / TotalProducts) : 0;
    }

    private class ProductCheck
    {
        public string Name { get; set; } = "";
        public string Sku { get; set; } = "";
        public string Variant { get; set; } = "";
        public int Quantity { get; set; }
        public bool IsAvailable { get; set; }
        public DateTime LastChecked { get; set; }
    }

    private List<CategoryAvailability> categories = new()
    {
        new CategoryAvailability { Name = "T-Shirts", TotalProducts = 15, Available = 12, LowStock = 2, OutOfStock = 1 },
        new CategoryAvailability { Name = "Pants", TotalProducts = 12, Available = 8, LowStock = 2, OutOfStock = 2 },
        new CategoryAvailability { Name = "Jackets", TotalProducts = 8, Available = 5, LowStock = 1, OutOfStock = 2 },
        new CategoryAvailability { Name = "Accessories", TotalProducts = 20, Available = 16, LowStock = 3, OutOfStock = 1 },
        new CategoryAvailability { Name = "Footwear", TotalProducts = 10, Available = 7, LowStock = 2, OutOfStock = 1 },
        new CategoryAvailability { Name = "Outerwear", TotalProducts = 6, Available = 4, LowStock = 1, OutOfStock = 1 }
    };

    private List<ProductCheck> recentProducts = new()
    {
        new ProductCheck { Name = "Classic Fit T-Shirt", Sku = "CF-TS-001", Variant = "White / L", Quantity = 45, IsAvailable = true, LastChecked = DateTime.Now.AddMinutes(-5) },
        new ProductCheck { Name = "Casual Pants", Sku = "CF-PN-001", Variant = "Navy / 32", Quantity = 15, IsAvailable = true, LastChecked = DateTime.Now.AddMinutes(-12) },
        new ProductCheck { Name = "Winter Jacket", Sku = "CF-JK-001", Variant = "Gray / M", Quantity = 0, IsAvailable = false, LastChecked = DateTime.Now.AddMinutes(-20) },
        new ProductCheck { Name = "Baseball Cap", Sku = "CF-AC-002", Variant = "Black / OS", Quantity = 3, IsAvailable = true, LastChecked = DateTime.Now.AddMinutes(-35) }
    };

    protected override void OnParametersSet()
    {
        ApplyDeepLinkFilters();
    }

    private void OnSearchChanged()
    {
        SyncUrlState();
    }

    private void ApplyDeepLinkFilters()
    {
        if (QuerySearch is not null)
        {
            searchSku = QuerySearch;
        }
    }

    private void SyncUrlState()
    {
        var target = string.IsNullOrWhiteSpace(searchSku)
            ? "/supervisor/inventory/availability"
            : $"/supervisor/inventory/availability?q={Uri.EscapeDataString(searchSku)}";

        NavigationManager.NavigateTo(target, replace: true);
    }
}
