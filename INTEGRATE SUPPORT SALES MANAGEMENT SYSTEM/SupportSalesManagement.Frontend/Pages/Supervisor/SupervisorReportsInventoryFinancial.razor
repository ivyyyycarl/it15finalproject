@page "/supervisor/reports/inventory-financial"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]
@inject SupportSalesManagement.Frontend.Services.ApiClient ApiClient

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="mb-6">
        <h1 class="text-[22px] font-bold text-gray-900">Inventory & Financial Reports</h1>
        <p class="text-sm text-gray-500">Combined insights on inventory and financial performance</p>
    </div>

    <!-- Combined Metrics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-gradient-to-br from-blue-50 to-white p-5 rounded-xl border border-blue-100 shadow-sm">
            <p class="text-sm text-gray-600">Inventory Value</p>
            <p class="text-2xl font-bold text-blue-600">₱@inventoryValue.ToString("N0")</p>
            <p class="text-xs text-gray-500 mt-1">Current stock value</p>
        </div>
        <div class="bg-gradient-to-br from-emerald-50 to-white p-5 rounded-xl border border-emerald-100 shadow-sm">
            <p class="text-sm text-gray-600">Stock Turnover</p>
            <p class="text-2xl font-bold text-green-600">@stockTurnover</p>
            <p class="text-xs text-gray-500 mt-1">Times per month</p>
        </div>
        <div class="bg-gradient-to-br from-violet-50 to-white p-5 rounded-xl border border-violet-100 shadow-sm">
            <p class="text-sm text-gray-600">Profit Margin</p>
            <p class="text-2xl font-bold text-purple-600">@profitMargin%</p>
            <p class="text-xs text-gray-500 mt-1">Overall margin</p>
        </div>
        <div class="bg-gradient-to-br from-rose-50 to-white p-5 rounded-xl border border-rose-100 shadow-sm">
            <p class="text-sm text-gray-600">Out of Stock Cost</p>
            <p class="text-2xl font-bold text-red-600">₱@outOfStockCost.ToString("N0")</p>
            <p class="text-xs text-gray-500 mt-1">Lost revenue</p>
        </div>
    </div>

    <!-- Category Performance -->
    <div class="bg-white p-6 rounded-lg shadow mb-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Category Performance</h2>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Stock Value</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Revenue</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Units Sold</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Margin</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var category in categoryPerformance)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@category.Name</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                ₱@category.StockValue.ToString("N0")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                                ₱@category.Revenue.ToString("N0")</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@category.UnitsSold</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-green-600">@category.Margin%
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span
                                    class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-@category.StatusColor-100 text-@category.StatusColor-800">
                                    @category.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Insights -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Top Performing Products</h2>
            <div class="space-y-3">
                @foreach (var product in topProducts)
                {
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                        <div class="flex-1">
                            <p class="text-sm font-medium text-gray-900">@product.Name</p>
                            <p class="text-xs text-gray-500">Stock: @product.Stock units</p>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-semibold text-gray-900">₱@product.Revenue.ToString("N0")</p>
                            <p class="text-xs text-green-600">@product.Margin% margin</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Stock Alerts Impact</h2>
            <div class="space-y-3">
                <div class="p-4 bg-red-50 border border-red-200 rounded-lg">
                    <p class="text-sm font-semibold text-red-900">Critical: Out of Stock</p>
                    <p class="text-xs text-red-700 mt-1">5 products • Est. $12,500 lost revenue</p>
                </div>
                <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <p class="text-sm font-semibold text-yellow-900">Warning: Low Stock</p>
                    <p class="text-xs text-yellow-700 mt-1">8 products • Risk of stockout within 7 days</p>
                </div>
                <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                    <p class="text-sm font-semibold text-blue-900">Info: Slow Moving</p>
                    <p class="text-xs text-blue-700 mt-1">12 products • Consider promotional pricing</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private decimal inventoryValue = 285420m;
    private decimal stockTurnover = 3.5m;
    private decimal profitMargin = 42.8m;
    private decimal outOfStockCost = 12500m;

    private class CategoryPerformanceData
    {
        public string Name { get; set; } = "";
        public decimal StockValue { get; set; }
        public decimal Revenue { get; set; }
        public int UnitsSold { get; set; }
        public decimal Margin { get; set; }
        public string Status { get; set; } = "";
        public string StatusColor { get; set; } = "";
    }

    private class TopProductData
    {
        public string Name { get; set; } = "";
        public int Stock { get; set; }
        public decimal Revenue { get; set; }
        public decimal Margin { get; set; }
    }

    private List<CategoryPerformanceData> categoryPerformance = new()
{
new CategoryPerformanceData { Name = "T-Shirts", StockValue = 82500, Revenue = 45230, UnitsSold = 325, Margin = 45.2m,
Status = "Healthy", StatusColor = "green" },
new CategoryPerformanceData { Name = "Pants", StockValue = 95200, Revenue = 38650, UnitsSold = 245, Margin = 48.5m,
Status = "Healthy", StatusColor = "green" },
new CategoryPerformanceData { Name = "Jackets", StockValue = 68400, Revenue = 25180, UnitsSold = 145, Margin = 38.9m,
Status = "Warning", StatusColor = "yellow" },
new CategoryPerformanceData { Name = "Accessories", StockValue = 39320, Revenue = 16689, UnitsSold = 132, Margin =
52.1m, Status = "Healthy", StatusColor = "green" }
};

    private List<TopProductData> topProducts = new()
{
new TopProductData { Name = "Classic Fit T-Shirt - White", Stock = 125, Revenue = 6125, Margin = 48.5m },
new TopProductData { Name = "Denim Jacket - Blue", Stock = 22, Revenue = 15600, Margin = 42.8m },
new TopProductData { Name = "Casual Pants - Navy", Stock = 15, Revenue = 9450, Margin = 45.2m }
};
}
