@page "/supervisor/orders"
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin,SuperAdmin")]
@implements IDisposable

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="page-local-header mb-6 flex items-center justify-between">
        <div class="page-title-block">
            <h1 class="text-[22px] font-bold text-gray-900">Order Management</h1>
            <p class="text-[12px] text-gray-500">View and manage all customer orders</p>
        </div>
        <button @onclick="ExportToPdf" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            Export to PDF
        </button>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600"></div>
        </div>
    }
    else
    {
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-gradient-to-br from-blue-50 to-white p-5 rounded-xl border border-blue-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Total Orders</p>
                        <p class="text-2xl font-bold text-gray-900">@allOrders.Count</p>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-amber-50 to-white p-5 rounded-xl border border-amber-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Pending</p>
                        <p class="text-2xl font-bold text-yellow-600">@allOrders.Count(o => o.Status == "Pending")</p>
                    </div>
                    <div class="p-3 bg-yellow-100 rounded-full">
                        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-indigo-50 to-white p-5 rounded-xl border border-indigo-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Processing</p>
                        <p class="text-2xl font-bold text-blue-600">@allOrders.Count(o => o.Status == "Processing")</p>
                    </div>
                    <div class="p-3 bg-blue-100 rounded-full">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-br from-emerald-50 to-white p-5 rounded-xl border border-emerald-100 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-600">Delivered</p>
                        <p class="text-2xl font-bold text-green-600">@allOrders.Count(o => o.Status == "Delivered")</p>
                    </div>
                    <div class="p-3 bg-green-100 rounded-full">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters and Search -->
        <div class="bg-gradient-to-r from-white to-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm mb-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Search Orders</label>
                    <input type="text" value="@searchInput" @oninput="OnSearchInput"
                        placeholder="Order ID, Customer..."
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                    <select @bind="selectedStatus" @bind:after="OnFilterSelectionChanged"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Processing">Processing</option>
                        <option value="Shipped">Shipped</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Payment Status</label>
                    <select @bind="selectedPaymentStatus" @bind:after="OnFilterSelectionChanged"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">All Payments</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button @onclick="LoadOrders" class="w-full bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                        Refresh
                    </button>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-lg shadow overflow-hidden">
            @if (!filteredOrders.Any())
            {
                <div class="p-12 text-center">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No orders found</h3>
                    <p class="mt-1 text-sm text-gray-500">
                        @(allOrders.Any() ? "Try adjusting your filters." : "No orders have been placed yet.")
                    </p>
                </div>
            }
            else
            {
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order #</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Payment</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var order in pagedFilteredOrders)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                    @(order.OrderNumber ?? $"ORD-{order.Id}")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @if (!string.IsNullOrEmpty(order.CustomerName))
                                    {
                                        <span>@order.CustomerName</span>
                                    }
                                    else
                                    {
                                        <span>Customer #@order.CustomerId</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @order.OrderDate.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">
                                    @($"₱{order.TotalAmount:N2}")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full @GetPaymentStatusColor(order.PaymentStatus ?? "Pending")">
                                        @(order.PaymentStatus ?? "Pending")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full @GetStatusColor(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @(order.OrderDetails?.Count ?? 0) item(s)
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    @if (order.Status == "Pending")
                                    {
                                        <button @onclick='() => UpdateStatus(order, "Processing")'
                                            class="text-blue-600 hover:text-blue-900 mr-2">Process</button>
                                    }
                                    @if (order.Status == "Processing")
                                    {
                                        <button @onclick='() => UpdateStatus(order, "Shipped")'
                                            class="text-purple-600 hover:text-purple-900 mr-2">Ship</button>
                                    }
                                    @if (order.Status == "Shipped")
                                    {
                                        <button @onclick='() => UpdateStatus(order, "Delivered")'
                                            class="text-green-600 hover:text-green-900 mr-2">Deliver</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Summary -->
        <div class="mt-6 flex items-center justify-between">
            <div class="text-sm text-gray-700">
                Showing <span class="font-medium">@(((currentPage - 1) * pageSize) + 1)</span>-
                <span class="font-medium">@Math.Min(currentPage * pageSize, filteredOrders.Count)</span> of
                <span class="font-medium">@allOrders.Count</span> orders
                @if (allOrders.Any())
                {
                    <span class="ml-4">|</span>
                    <span class="ml-4 font-medium text-green-600">
                        Total Revenue: @($"₱{allOrders.Sum(o => o.TotalAmount):N2}")
                    </span>
                }
                <span class="ml-4">·</span>
                <span class="ml-4">Page @currentPage/@totalPages</span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "payment")]
    public string? QueryPaymentStatus { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearch { get; set; }

    private List<Order> allOrders = new();
    private List<Order> filteredOrders = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private string searchInput = "";
    private string selectedStatus = "";
    private string selectedPaymentStatus = "";
    private CancellationTokenSource? _searchDebounceCts;
    private int currentPage = 1;
    private const int pageSize = 25;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredOrders.Count / (double)pageSize));
    private List<Order> pagedFilteredOrders => filteredOrders
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
        ApplyDeepLinkFilters();
    }

    protected override void OnParametersSet()
    {
        ApplyDeepLinkFilters();
        ApplyFilters();
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        try
        {
            var orders = await ApiClient.GetOrdersAsync();
            if (orders != null)
            {
                allOrders = orders.OrderByDescending(o => o.OrderDate).ToList();
            }
            else
            {
                allOrders = new();
            }
            ApplyFilters();
            currentPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading orders: {ex.Message}");
            allOrders = new();
            filteredOrders = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        filteredOrders = allOrders;

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.Trim().ToLowerInvariant();
            filteredOrders = filteredOrders.Where(o =>
                (o.OrderNumber ?? "").ToLowerInvariant().Contains(term) ||
                o.Id.ToString().Contains(term) ||
                (o.CustomerName ?? "").ToLowerInvariant().Contains(term)
            ).ToList();
        }

        if (!string.IsNullOrEmpty(selectedStatus))
        {
            filteredOrders = filteredOrders.Where(o => o.Status == selectedStatus).ToList();
        }

        if (!string.IsNullOrEmpty(selectedPaymentStatus))
        {
            filteredOrders = filteredOrders.Where(o => (o.PaymentStatus ?? "Pending") == selectedPaymentStatus).ToList();
        }
        currentPage = 1;
    }

    private void ApplyDeepLinkFilters()
    {
        if (!string.IsNullOrWhiteSpace(QueryStatus))
        {
            var status = QueryStatus.Trim();
            var allowedStatuses = new[] { "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
            if (allowedStatuses.Contains(status, StringComparer.OrdinalIgnoreCase))
            {
                selectedStatus = allowedStatuses.First(s => s.Equals(status, StringComparison.OrdinalIgnoreCase));
            }
        }

        if (!string.IsNullOrWhiteSpace(QueryPaymentStatus))
        {
            var payment = QueryPaymentStatus.Trim();
            var allowedPayments = new[] { "Paid", "Pending" };
            if (allowedPayments.Contains(payment, StringComparer.OrdinalIgnoreCase))
            {
                selectedPaymentStatus = allowedPayments.First(s => s.Equals(payment, StringComparison.OrdinalIgnoreCase));
            }
        }

        if (QuerySearch is not null)
        {
            searchInput = QuerySearch;
            searchTerm = QuerySearch;
        }
    }

    private void OnFilterSelectionChanged()
    {
        ApplyFilters();
        SyncUrlState();
    }

    private void SyncUrlState()
    {
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(selectedStatus))
        {
            queryParts.Add($"status={Uri.EscapeDataString(selectedStatus)}");
        }

        if (!string.IsNullOrWhiteSpace(selectedPaymentStatus))
        {
            queryParts.Add($"payment={Uri.EscapeDataString(selectedPaymentStatus)}");
        }

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            queryParts.Add($"q={Uri.EscapeDataString(searchTerm)}");
        }

        var target = queryParts.Count > 0
            ? $"/supervisor/orders?{string.Join("&", queryParts)}"
            : "/supervisor/orders";

        NavigationManager.NavigateTo(target, replace: true);
    }

    private async Task UpdateStatus(Order order, string newStatus)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Confirm update order {(order.OrderNumber ?? $"#{order.Id}")} to {newStatus}?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            var request = new UpdateOrderRequest
            {
                Status = newStatus,
                Notes = order.Notes ?? ""
            };
            var result = await ApiClient.UpdateOrderAsync(order.Id, request);
            if (result != null)
            {
                await LoadOrders();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating order: {ex.Message}");
        }
    }

    private string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "bg-yellow-100 text-yellow-800",
            "Processing" => "bg-blue-100 text-blue-800",
            "Shipped" => "bg-purple-100 text-purple-800",
            "Delivered" => "bg-green-100 text-green-800",
            "Cancelled" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private string GetPaymentStatusColor(string status)
    {
        return status switch
        {
            "Paid" => "bg-green-100 text-green-800",
            "Pending" => "bg-yellow-100 text-yellow-800",
            "Refunded" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private async Task ExportToPdf()
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Generate and export the order report PDF?");
        if (!confirmed)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("exportToPdf", "Order Management Report");
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await DebouncedApplyFiltersAsync();
    }

    private async Task DebouncedApplyFiltersAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            searchTerm = searchInput;
            ApplyFilters();
            SyncUrlState();
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
    }
}
