@page "/supervisor/customers/history"
@page "/supervisor/customers/history/{CustomerId:int}"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@implements IDisposable

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="mb-6">
        <h1 class="text-[22px] font-bold text-gray-900">Customer Interaction History</h1>
        <p class="text-sm text-gray-500">View customer interaction timeline and engagement history</p>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-20">
            <div class="flex flex-col items-center gap-3">
                <div class="w-10 h-10 border-4 border-blue-200 border-t-blue-600 rounded-full animate-spin"></div>
                <p class="text-gray-500">Loading...</p>
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-lg p-6 text-center">
            <svg class="w-12 h-12 text-red-400 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p class="text-red-700 font-medium">@errorMessage</p>
            <button @onclick="RetryLoad" class="mt-4 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition">
                Retry
            </button>
        </div>
    }
    else if (customer == null)
    {
        <!-- Customer Search / List Mode -->
        <div class="bg-gradient-to-r from-white to-slate-50 p-5 rounded-xl border border-slate-200 shadow-sm mb-6">
            <div class="flex gap-4">
                <input type="text" placeholder="Search customer by name, email, or company..."
                       value="@searchInput"
                       @oninput="OnSearchInput"
                       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
        </div>

        @if (filteredCustomers != null && filteredCustomers.Any())
        {
            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Company</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @foreach (var c in pagedFilteredCustomers)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 bg-blue-100 rounded-full flex items-center justify-center flex-shrink-0">
                                            <span class="text-sm font-bold text-blue-600">@GetInitials(c)</span>
                                        </div>
                                        <span class="font-medium text-gray-900">@c.FirstName @c.LastName</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-sm text-gray-600">@c.Email</td>
                                <td class="px-6 py-4 text-sm text-gray-600">@(string.IsNullOrEmpty(c.Company) ? "—" : c.Company)</td>
                                <td class="px-6 py-4">
                                    <span class="px-2 py-1 text-xs font-semibold rounded-full @GetTypeBadgeClass(c.CustomerType)">
                                        @(string.IsNullOrEmpty(c.CustomerType) ? "N/A" : c.CustomerType)
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (c.IsActive)
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-600">Inactive</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <button @onclick="() => ViewCustomerHistory(c.Id)"
                                            class="text-blue-600 hover:text-blue-800 text-sm font-medium transition">
                                        View History
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                    <p class="text-sm text-gray-600">
                        Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, filteredCustomersList.Count) of @filteredCustomersList.Count · Page @currentPage/@totalPages
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                                class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                                class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            </div>
        }
        else if (allCustomers != null)
        {
            <div class="bg-white rounded-lg shadow p-12 text-center">
                <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <p class="text-gray-500">No customers found matching your search.</p>
            </div>
        }
    }
    else
    {
        <!-- Customer Detail + History Mode -->
        <div class="mb-4">
            <button @onclick="BackToList" class="text-blue-600 hover:text-blue-800 text-sm font-medium flex items-center gap-1 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to Customer List
            </button>
        </div>

        <!-- Customer Info Card -->
        <div class="bg-white p-6 rounded-lg shadow mb-6">
            <div class="flex items-start justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center">
                        <span class="text-2xl font-bold text-blue-600">@GetInitials(customer)</span>
                    </div>
                    <div>
                        <h2 class="text-xl font-semibold text-gray-900">@customer.FirstName @customer.LastName</h2>
                        <p class="text-sm text-gray-500">
                            @customer.Email
                            @if (!string.IsNullOrEmpty(customer.Phone))
                            {
                                <span> &bull; @customer.Phone</span>
                            }
                        </p>
                        <div class="flex items-center gap-2 mt-2">
                            @if (!string.IsNullOrEmpty(customer.CustomerType))
                            {
                                <span class="px-2 py-1 text-xs font-semibold rounded-full @GetTypeBadgeClass(customer.CustomerType)">
                                    @customer.CustomerType
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(customer.Company))
                            {
                                <span class="text-sm text-gray-600">@customer.Company</span>
                            }
                            @if (customer.City is not null && customer.Country is not null
                                && (!string.IsNullOrEmpty(customer.City) || !string.IsNullOrEmpty(customer.Country)))
                            {
                                <span class="text-sm text-gray-400">|</span>
                                <span class="text-sm text-gray-600">
                                    @(string.Join(", ", new[] { customer.City, customer.Country }.Where(s => !string.IsNullOrEmpty(s))))
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="text-right space-y-1">
                    <p class="text-sm text-gray-500">Total Orders</p>
                    <p class="text-2xl font-bold text-gray-900">@(orders?.Count ?? 0)</p>
                    <p class="text-sm text-gray-500 mt-2">Total Spent</p>
                    <p class="text-xl font-bold text-green-600">@((orders?.Sum(o => o.TotalAmount) ?? 0).ToString("C"))</p>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white p-4 rounded-lg shadow">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Orders</p>
                        <p class="text-xl font-bold text-gray-900">@(orders?.Count ?? 0)</p>
                    </div>
                </div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Tickets</p>
                        <p class="text-xl font-bold text-gray-900">@(tickets?.Count ?? 0)</p>
                    </div>
                </div>
            </div>
            <div class="bg-white p-4 rounded-lg shadow">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                    </div>
                    <div>
                        <p class="text-sm text-gray-500">Calls</p>
                        <p class="text-xl font-bold text-gray-900">@(calls?.Count ?? 0)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interaction Timeline -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-lg font-semibold text-gray-900">Interaction Timeline</h2>
                <div class="flex gap-2">
                    <button @onclick='() => SetTimelineFilter("All")'
                            class="px-4 py-2 text-sm border rounded-lg transition @(activeFilter == "All" ? "bg-blue-600 text-white border-blue-600" : "border-gray-300 hover:bg-gray-50")">
                        All
                    </button>
                    <button @onclick='() => SetTimelineFilter("Order")'
                            class="px-4 py-2 text-sm border rounded-lg transition @(activeFilter == "Order" ? "bg-green-600 text-white border-green-600" : "border-gray-300 hover:bg-gray-50")">
                        Orders
                    </button>
                    <button @onclick='() => SetTimelineFilter("Ticket")'
                            class="px-4 py-2 text-sm border rounded-lg transition @(activeFilter == "Ticket" ? "bg-yellow-600 text-white border-yellow-600" : "border-gray-300 hover:bg-gray-50")">
                        Tickets
                    </button>
                    <button @onclick='() => SetTimelineFilter("Call")'
                            class="px-4 py-2 text-sm border rounded-lg transition @(activeFilter == "Call" ? "bg-blue-600 text-white border-blue-600" : "border-gray-300 hover:bg-gray-50")">
                        Calls
                    </button>
                </div>
            </div>

            @if (filteredTimeline != null && filteredTimeline.Any())
            {
                <div class="relative">
                    <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-200"></div>

                    <div class="space-y-6">
                        @foreach (var item in filteredTimeline)
                        {
                            <div class="relative flex items-start gap-4">
                                <div class="w-16 h-16 @item.BgColor rounded-full flex items-center justify-center z-10 flex-shrink-0">
                                    @((MarkupString)item.Icon)
                                </div>
                                <div class="flex-1">
                                    <div class="bg-gray-50 p-4 rounded-lg">
                                        <div class="flex items-center justify-between mb-2">
                                            <h3 class="font-semibold text-gray-900">@item.Title</h3>
                                            <span class="text-sm text-gray-500">@item.Date.ToString("MMM dd yyyy, HH:mm")</span>
                                        </div>
                                        <p class="text-sm text-gray-600">@item.Description</p>
                                        @if (!string.IsNullOrEmpty(item.Detail))
                                        {
                                            <p class="text-sm text-gray-500 mt-1">@item.Detail</p>
                                        }
                                        @if (!string.IsNullOrEmpty(item.StatusBadge))
                                        {
                                            <div class="mt-2">
                                                <span class="px-2 py-1 text-xs font-semibold rounded-full @item.StatusBadgeClass">
                                                    @item.StatusBadge
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-gray-500">No interactions found for this filter.</p>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int CustomerId { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QuerySearch { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? QueryFilter { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private string searchTerm = string.Empty;
    private string searchInput = string.Empty;
    private string activeFilter = "All";
    private CancellationTokenSource? _searchDebounceCts;
    private int currentPage = 1;
    private const int pageSize = 25;

    private Customer? customer;
    private List<Customer>? allCustomers;
    private List<Order>? orders;
    private List<Ticket>? tickets;
    private List<Call>? calls;
    private List<TimelineEntry>? timelineItems;

    private List<Customer>? filteredCustomers => string.IsNullOrWhiteSpace(searchTerm)
        ? allCustomers
        : allCustomers?.Where(c =>
            $"{c.FirstName} {c.LastName}".Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            c.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (c.Company ?? "").Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            c.Phone.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
        ).ToList();

    private List<TimelineEntry>? filteredTimeline => activeFilter == "All"
        ? timelineItems
        : timelineItems?.Where(t => t.Type == activeFilter).ToList();
    private List<Customer> filteredCustomersList => filteredCustomers ?? new List<Customer>();
    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredCustomersList.Count / (double)pageSize));
    private List<Customer> pagedFilteredCustomers => filteredCustomersList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        ApplyDeepLinkFilters();
    }

    protected override void OnParametersSet()
    {
        ApplyDeepLinkFilters();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            if (CustomerId > 0)
            {
                customer = await ApiClient.GetCustomerAsync(CustomerId);
                if (customer == null)
                {
                    errorMessage = $"Customer with ID {CustomerId} was not found.";
                    return;
                }

                var ordersTask = ApiClient.GetOrdersByCustomerAsync(CustomerId);
                var ticketsTask = ApiClient.GetTicketsByCustomerAsync(CustomerId);
                var callsTask = ApiClient.GetCallsByCustomerAsync(CustomerId);

                await Task.WhenAll(ordersTask, ticketsTask, callsTask);

                orders = await ordersTask;
                tickets = await ticketsTask;
                calls = await callsTask;

                BuildTimeline();
            }
            else
            {
                allCustomers = await ApiClient.GetCustomersAsync();
                currentPage = 1;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void BuildTimeline()
    {
        var items = new List<TimelineEntry>();

        if (orders != null)
        {
            foreach (var order in orders)
            {
                items.Add(new TimelineEntry
                {
                    Type = "Order",
                    Title = $"Order {order.OrderNumber}",
                    Description = $"Total: {order.TotalAmount:C}",
                    Detail = order.OrderDetails?.Count > 0
                        ? $"{order.OrderDetails.Count} item(s) &bull; Status: {order.Status}"
                        : $"Status: {order.Status}",
                    Date = order.OrderDate,
                    BgColor = "bg-green-100",
                    Icon = @"<svg class=""w-8 h-8 text-green-600"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"" /></svg>",
                    StatusBadge = order.Status,
                    StatusBadgeClass = GetOrderStatusClass(order.Status)
                });
            }
        }

        if (tickets != null)
        {
            foreach (var ticket in tickets)
            {
                items.Add(new TimelineEntry
                {
                    Type = "Ticket",
                    Title = $"Ticket {ticket.TicketNumber}",
                    Description = ticket.Title,
                    Detail = !string.IsNullOrEmpty(ticket.Category) ? $"Category: {ticket.Category}" : null,
                    Date = ticket.CreatedAt,
                    BgColor = "bg-yellow-100",
                    Icon = @"<svg class=""w-8 h-8 text-yellow-600"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"" /></svg>",
                    StatusBadge = $"{ticket.Status} &bull; {ticket.Priority}",
                    StatusBadgeClass = GetTicketStatusClass(ticket.Status)
                });
            }
        }

        if (calls != null)
        {
            foreach (var call in calls)
            {
                var duration = call.EndTime.HasValue
                    ? (call.EndTime.Value - call.StartTime).ToString(@"mm\:ss")
                    : "Ongoing";

                items.Add(new TimelineEntry
                {
                    Type = "Call",
                    Title = $"{call.Type} Call",
                    Description = call.Subject ?? "No subject",
                    Detail = $"Duration: {duration} &bull; Outcome: {call.Outcome ?? "N/A"}",
                    Date = call.StartTime,
                    BgColor = "bg-blue-100",
                    Icon = @"<svg class=""w-8 h-8 text-blue-600"" fill=""none"" stroke=""currentColor"" viewBox=""0 0 24 24""><path stroke-linecap=""round"" stroke-linejoin=""round"" stroke-width=""2"" d=""M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"" /></svg>",
                    StatusBadge = call.Status,
                    StatusBadgeClass = GetCallStatusClass(call.Status)
                });
            }
        }

        timelineItems = items.OrderByDescending(i => i.Date).ToList();
    }

    private void ViewCustomerHistory(int id)
    {
        var query = string.IsNullOrWhiteSpace(searchTerm)
            ? string.Empty
            : $"?q={Uri.EscapeDataString(searchTerm)}";
        Navigation.NavigateTo($"/supervisor/customers/history/{id}{query}");
    }

    private void BackToList()
    {
        var query = string.IsNullOrWhiteSpace(searchTerm)
            ? string.Empty
            : $"?q={Uri.EscapeDataString(searchTerm)}";
        Navigation.NavigateTo($"/supervisor/customers/history{query}");
    }

    private void SetTimelineFilter(string filter)
    {
        activeFilter = filter;
        SyncUrlState();
    }

    private void ApplyDeepLinkFilters()
    {
        if (QuerySearch is not null)
        {
            searchInput = QuerySearch;
            searchTerm = QuerySearch;
        }

        if (!string.IsNullOrWhiteSpace(QueryFilter))
        {
            var normalizedFilter = QueryFilter.Trim().ToLowerInvariant();
            activeFilter = normalizedFilter switch
            {
                "all" => "All",
                "order" or "orders" => "Order",
                "ticket" or "tickets" => "Ticket",
                "call" or "calls" => "Call",
                _ => activeFilter
            };
        }
    }

    private void SyncUrlState()
    {
        var basePath = CustomerId > 0
            ? $"/supervisor/customers/history/{CustomerId}"
            : "/supervisor/customers/history";

        var queryParts = new List<string>();
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            queryParts.Add($"q={Uri.EscapeDataString(searchTerm)}");
        }

        if (CustomerId > 0 && !string.Equals(activeFilter, "All", StringComparison.OrdinalIgnoreCase))
        {
            queryParts.Add($"filter={Uri.EscapeDataString(activeFilter.ToLowerInvariant())}");
        }

        var target = queryParts.Count > 0
            ? $"{basePath}?{string.Join("&", queryParts)}"
            : basePath;

        Navigation.NavigateTo(target, replace: true);
    }

    private async Task RetryLoad()
    {
        await LoadData();
    }

    private string GetInitials(Customer c)
    {
        var first = !string.IsNullOrEmpty(c.FirstName) ? c.FirstName[0].ToString().ToUpper() : "";
        var last = !string.IsNullOrEmpty(c.LastName) ? c.LastName[0].ToString().ToUpper() : "";
        return $"{first}{last}";
    }

    private string GetTypeBadgeClass(string? type) => (type ?? "").ToLower() switch
    {
        "vip" => "bg-yellow-100 text-yellow-800",
        "enterprise" or "business" => "bg-purple-100 text-purple-800",
        "individual" => "bg-blue-100 text-blue-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetOrderStatusClass(string? status) => (status ?? "").ToLower() switch
    {
        "completed" or "delivered" => "bg-green-100 text-green-800",
        "shipped" or "processing" => "bg-blue-100 text-blue-800",
        "pending" => "bg-yellow-100 text-yellow-800",
        "cancelled" or "refunded" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetTicketStatusClass(string? status) => (status ?? "").ToLower() switch
    {
        "resolved" or "closed" => "bg-green-100 text-green-800",
        "open" or "new" => "bg-yellow-100 text-yellow-800",
        "in progress" or "inprogress" => "bg-blue-100 text-blue-800",
        "escalated" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private string GetCallStatusClass(string? status) => (status ?? "").ToLower() switch
    {
        "completed" => "bg-green-100 text-green-800",
        "in progress" or "active" => "bg-blue-100 text-blue-800",
        "missed" => "bg-red-100 text-red-800",
        _ => "bg-gray-100 text-gray-800"
    };

    private class TimelineEntry
    {
        public string Type { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string? Detail { get; set; }
        public DateTime Date { get; set; }
        public string BgColor { get; set; } = string.Empty;
        public string Icon { get; set; } = string.Empty;
        public string? StatusBadge { get; set; }
        public string StatusBadgeClass { get; set; } = string.Empty;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await DebouncedApplySearchAsync();
    }

    private async Task DebouncedApplySearchAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            searchTerm = searchInput;
            currentPage = 1;
            SyncUrlState();
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
