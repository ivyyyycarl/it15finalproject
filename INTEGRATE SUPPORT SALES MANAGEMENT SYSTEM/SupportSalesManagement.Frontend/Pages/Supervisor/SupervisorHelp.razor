@page "/supervisor/help"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin,SuperAdmin")]

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div>
        <h1 class="text-[22px] font-bold text-gray-900">Help & Support</h1>
        <p class="text-sm text-gray-500">Resources, guides, and support for supervisors</p>
    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center text-blue-600 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Supervisor Guide</h3>
            <p class="text-sm text-gray-500">Learn how to manage your team, orders, and reports effectively.</p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-purple-50 rounded-lg flex items-center justify-center text-purple-600 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">FAQs</h3>
            <p class="text-sm text-gray-500">Answers to frequently asked questions about the system.</p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center text-green-600 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">System Status</h3>
            <p class="text-sm text-gray-500">All systems are running normally.</p>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
            <div class="w-12 h-12 bg-orange-50 rounded-lg flex items-center justify-center text-orange-600 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Contact Admin</h3>
            <p class="text-sm text-gray-500">Reach out for technical issues or account access.</p>
        </div>
    </div>

    <!-- Supervisor Functions Guide -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Supervisor Dashboard Guide</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-4">
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Dashboard</h4>
                        <p class="text-sm text-gray-500">View overall business metrics, sales trends, and team performance at a glance.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center text-green-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Order Management</h4>
                        <p class="text-sm text-gray-500">View and manage all customer orders. Update order statuses (Pending, Processing, Shipped, Delivered). Track shipments and monitor order progress.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-purple-100 rounded-lg flex items-center justify-center text-purple-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Ticket Management</h4>
                        <p class="text-sm text-gray-500">Handle customer support tickets. Assign tickets to agents, escalate priority issues, and track resolution times.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-yellow-100 rounded-lg flex items-center justify-center text-yellow-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Customer Management</h4>
                        <p class="text-sm text-gray-500">Search and view customer profiles, order history, and lifetime value. Identify VIP customers based on spending.</p>
                    </div>
                </div>
            </div>
            <div class="space-y-4">
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center text-red-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Inventory Management</h4>
                        <p class="text-sm text-gray-500">Monitor stock levels, track low stock items, and view product availability. Use search and filters to find products quickly.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center text-indigo-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Financial Reports</h4>
                        <p class="text-sm text-gray-500">View sales reports, revenue trends, and financial summaries. Filter by date range to analyze specific periods.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-teal-100 rounded-lg flex items-center justify-center text-teal-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Agent Performance</h4>
                        <p class="text-sm text-gray-500">Monitor agent productivity, view leaderboards, track ticket resolution rates and response times.</p>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-8 bg-pink-100 rounded-lg flex items-center justify-center text-pink-600 flex-shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-semibold text-gray-900">Export & Print</h4>
                        <p class="text-sm text-gray-500">Export data to PDF from any page. Use the "Export to PDF" button to generate printable reports for orders, sales, inventory, and performance.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
            @foreach (var faq in faqs)
            {
                <div class="border border-gray-100 rounded-lg">
                    <button @onclick="() => ToggleFaq(faq)" class="w-full flex items-center justify-between p-4 text-left hover:bg-gray-50 transition">
                        <h3 class="font-semibold text-gray-900 text-sm">@faq.Question</h3>
                        <svg class="w-5 h-5 text-gray-400 transition-transform @(faq.IsOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    @if (faq.IsOpen)
                    {
                        <div class="px-4 pb-4">
                            <p class="text-sm text-gray-600">@faq.Answer</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Contact Information -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Need More Help?</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-900">Email Support</p>
                    <p class="text-sm text-gray-500">support@classicfit.com</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-900">Phone Support</p>
                    <p class="text-sm text-gray-500">Available during business hours</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div>
                    <p class="text-sm font-medium text-gray-900">Response Time</p>
                    <p class="text-sm text-gray-500">Within 24 business hours</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private class FaqItem
    {
        public string Question { get; set; } = "";
        public string Answer { get; set; } = "";
        public bool IsOpen { get; set; }
    }

    private List<FaqItem> faqs = new()
    {
        new FaqItem { Question = "How do I process a new order?", Answer = "Go to Orders > View Orders to see all pending orders. Click 'Process' on any pending order to update its status to Processing. Once the order is ready for shipment, click 'Ship' to change it to Shipped status, and finally 'Deliver' when the customer receives the order." },
        new FaqItem { Question = "How do I track order shipments?", Answer = "Navigate to Orders > Tracking to see all active shipments. You can search by order number and view the complete status timeline showing Order Placed, Processing, Shipped, and Delivered stages." },
        new FaqItem { Question = "How do I view agent performance?", Answer = "Go to Reports > Performance to see the agent leaderboard. This shows each agent's tickets resolved, average resolution time, and satisfaction scores calculated from real data." },
        new FaqItem { Question = "How do I search for customers?", Answer = "Navigate to Customers > Search to access the customer search page. You can search by name, email, phone, or customer ID. The page also shows customer statistics including order counts and lifetime value." },
        new FaqItem { Question = "How do I check inventory stock levels?", Answer = "Go to Inventory > Stock to view all product stock levels. Use the search bar to find specific products, filter by category (T-Shirt, Dress, Jacket, Sweater), or filter by stock status (In Stock, Low Stock, Out of Stock)." },
        new FaqItem { Question = "How do I export data to PDF?", Answer = "On any page that has an 'Export to PDF' button, click it to generate a printable PDF report. The system will open your browser's print dialog with a formatted version of the data, which you can save as PDF or print directly." },
        new FaqItem { Question = "How do I view financial reports?", Answer = "Navigate to Financials > Sales to view sales reports. You can filter by date range (Today, Week, Month, Quarter, Year) to analyze sales data for specific periods." },
        new FaqItem { Question = "What do the notification alerts mean?", Answer = "The Notifications page shows real-time data: New Orders (pending orders awaiting processing), Open Tickets (unresolved support tickets), Low Stock (products with 10 or fewer units), and Shipped (orders currently in transit). The page auto-refreshes every 30 seconds." },
        new FaqItem { Question = "How do I assign a ticket to an agent?", Answer = "Open the ticket from the Tickets page, then use the agent assignment dropdown to select the appropriate agent. You can also view all open tickets organized by priority to help with assignment decisions." },
        new FaqItem { Question = "What should I do if the system is slow or not loading?", Answer = "Try refreshing the page with Ctrl+Shift+R (hard refresh). If the issue persists, check the System Status section above. For ongoing issues, contact the system administrator via the contact information below." }
    };

    private void ToggleFaq(FaqItem faq)
    {
        faq.IsOpen = !faq.IsOpen;
    }
}
