@page "/supervisor/inventory/alerts"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]
@inject SupportSalesManagement.Frontend.Services.ApiClient ApiClient

<div class="p-6 space-y-4" style="font-family: Inter, sans-serif; font-size: 12px;">
    <div class="mb-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-[22px] font-bold text-gray-900">Low Stock Alerts</h1>
                <p class="text-sm text-gray-500">Monitor products with low inventory levels (Read-Only Access)</p>
            </div>
            <div class="flex items-center gap-2 px-3 py-1 bg-yellow-50 border border-yellow-200 rounded-lg">
                <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                <span class="text-xs font-medium text-yellow-800">Read-Only Access</span>
            </div>
        </div>
    </div>

    <!-- Alert Summary -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-gradient-to-br from-rose-50 to-white p-5 rounded-xl border border-rose-100 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Critical Alerts</p>
                    <p class="text-2xl font-bold text-red-600">@criticalAlerts</p>
                    <p class="text-xs text-gray-500 mt-1">Out of stock items</p>
                </div>
                <div class="p-3 bg-red-100 rounded-full">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-amber-50 to-white p-5 rounded-xl border border-amber-100 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Warning Alerts</p>
                    <p class="text-2xl font-bold text-yellow-600">@warningAlerts</p>
                    <p class="text-xs text-gray-500 mt-1">Low stock items</p>
                </div>
                <div class="p-3 bg-yellow-100 rounded-full">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-white p-5 rounded-xl border border-blue-100 shadow-sm">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm text-gray-600">Info Alerts</p>
                    <p class="text-2xl font-bold text-blue-600">@infoAlerts</p>
                    <p class="text-xs text-gray-500 mt-1">Approaching threshold</p>
                </div>
                <div class="p-3 bg-blue-100 rounded-full">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts List -->
    <div class="bg-white rounded-lg shadow">
        <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-semibold text-gray-900">Active Alerts</h2>
        </div>
        <div class="divide-y divide-gray-200">
            @foreach (var alert in alerts)
            {
                <div class="p-6 hover:bg-gray-50 transition">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0">
                            @if (alert.Severity == "Critical")
                            {
                                <div class="p-2 bg-red-100 rounded-full">
                                    <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                            }
                            else if (alert.Severity == "Warning")
                            {
                                <div class="p-2 bg-yellow-100 rounded-full">
                                    <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                    </svg>
                                </div>
                            }
                            else
                            {
                                <div class="p-2 bg-blue-100 rounded-full">
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <h3 class="text-sm font-semibold text-gray-900">@alert.ProductName</h3>
                                <span class="text-xs text-gray-500">@alert.Timestamp.ToString("MMM dd, HH:mm")</span>
                            </div>
                            <p class="text-sm text-gray-600 mt-1">@alert.Message</p>
                            <div class="flex items-center gap-4 mt-2 text-xs text-gray-500">
                                <span>SKU: @alert.Sku</span>
                                <span>•</span>
                                <span>Current Stock: <span class="font-semibold">@alert.CurrentStock</span></span>
                                <span>•</span>
                                <span>Min Required: <span class="font-semibold">@alert.MinStock</span></span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int criticalAlerts = 5;
    private int warningAlerts = 8;
    private int infoAlerts = 12;

    private class Alert
    {
        public string Severity { get; set; } = "";
        public string ProductName { get; set; } = "";
        public string Sku { get; set; } = "";
        public string Message { get; set; } = "";
        public int CurrentStock { get; set; }
        public int MinStock { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private List<Alert> alerts = new()
    {
        new Alert { Severity = "Critical", ProductName = "Winter Jacket - Gray", Sku = "CF-JK-001", Message = "Product is out of stock. Immediate restocking required.", CurrentStock = 0, MinStock = 10, Timestamp = DateTime.Now.AddHours(-2) },
        new Alert { Severity = "Critical", ProductName = "Slim Fit Jeans - Blue", Sku = "CF-PN-005", Message = "Product is out of stock. Immediate restocking required.", CurrentStock = 0, MinStock = 15, Timestamp = DateTime.Now.AddHours(-5) },
        new Alert { Severity = "Warning", ProductName = "Casual Pants - Navy", Sku = "CF-PN-001", Message = "Stock level has reached the minimum threshold. Consider restocking soon.", CurrentStock = 15, MinStock = 15, Timestamp = DateTime.Now.AddHours(-1) },
        new Alert { Severity = "Warning", ProductName = "Casual Pants - Khaki", Sku = "CF-PN-002", Message = "Stock level is below minimum threshold. Restocking recommended.", CurrentStock = 8, MinStock = 15, Timestamp = DateTime.Now.AddHours(-3) },
        new Alert { Severity = "Warning", ProductName = "Baseball Cap - Black", Sku = "CF-AC-002", Message = "Stock level is critically low. Urgent restocking needed.", CurrentStock = 3, MinStock = 20, Timestamp = DateTime.Now.AddHours(-4) },
        new Alert { Severity = "Info", ProductName = "Classic Fit T-Shirt - Navy", Sku = "CF-TS-003", Message = "Stock level is approaching minimum threshold.", CurrentStock = 25, MinStock = 20, Timestamp = DateTime.Now.AddHours(-6) },
        new Alert { Severity = "Info", ProductName = "Sports Sneakers - White", Sku = "CF-SH-001", Message = "Stock level is approaching minimum threshold.", CurrentStock = 18, MinStock = 15, Timestamp = DateTime.Now.AddHours(-12) }
    };
}
