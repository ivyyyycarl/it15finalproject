@page "/login"
@layout Shared.AuthLayout
@inject AuthenticationService AuthService
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services

<PageTitle>Login - ClassicFit: An Apparel Fashion Sales Support Workspace</PageTitle>

<div class="min-h-screen relative overflow-hidden font-sans bg-cover bg-center bg-no-repeat"
     style="background-image: linear-gradient(180deg, rgba(248,252,255,0.35) 0%, rgba(207,223,243,0.20) 55%, rgba(78,116,176,0.18) 100%), url('/images/auth-bg-cityline.png?v=20260309'); background-position: center bottom;">
    <div class="relative min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-md rounded-3xl border border-[#d7e6ef]/85 bg-white/35 backdrop-blur-xl shadow-2xl p-6 text-slate-900">
            <div class="flex justify-center mb-5">
                <img src="/images/classicfit-logo-icon.png?v=20260309" alt="ClassicFit Logo" class="h-16 w-16 rounded-2xl object-cover border border-white/30 shadow-lg" />
            </div>
            <h2 class="text-center text-3xl font-semibold tracking-wide mb-6">Welcome</h2>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-5 rounded-xl border border-red-200/70 bg-red-500/15 px-4 py-3 text-sm text-red-100">
                    @errorMessage
                </div>
            }

            <form class="space-y-4" @onsubmit="HandleLogin">
                <div class="relative">
                    <input type="email" required
                           class="w-full rounded-xl border border-slate-300 bg-white/90 px-4 py-2.5 text-slate-900 placeholder-slate-500 outline-none focus:border-[#5F9EA0] focus:bg-white"
                           placeholder="Email" @bind="loginRequest.Email" />
                </div>

                <div class="relative">
                    <input type="@(showPassword ? "text" : "password")" required
                           class="w-full rounded-xl border border-slate-300 bg-white/90 px-4 py-2.5 pr-11 text-slate-900 placeholder-slate-500 outline-none focus:border-[#5F9EA0] focus:bg-white"
                           placeholder="Password" @bind="loginRequest.Password" />
                    <button type="button"
                            @onclick="TogglePassword"
                            class="absolute right-2 top-1/2 -translate-y-1/2 h-8 w-8 rounded-full text-slate-700 hover:bg-slate-200/70 transition-colors flex items-center justify-center"
                            aria-label="@(showPassword ? "Hide password" : "Show password")">
                        @if (showPassword)
                        {
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3l18 18M10.58 10.59A2 2 0 0013.41 13.4M9.88 5.09A9.77 9.77 0 0112 4c5 0 9.27 3.11 11 8-1.01 2.86-2.92 4.98-5.35 6.16M6.7 6.72C4.53 8 2.84 9.84 2 12c1.73 4.89 6 8 10 8 1.51 0 2.96-.38 4.27-1.06" />
                            </svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2 12s3.5-8 10-8 10 8 10 8-3.5 8-10 8-10-8-10-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>

                <button type="submit" disabled="@isLoading"
                        class="w-full rounded-full bg-gradient-to-r from-[#4682B4] to-[#5F9EA0] hover:opacity-95 text-white py-3.5 font-semibold tracking-wide transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                    @(isLoading ? "LOGGING IN..." : "LOGIN")
                </button>

                <div class="flex items-center justify-between text-sm text-slate-700 px-1">
                    <button type="button" @onclick="OpenForgotPassword" class="hover:text-slate-900 transition-colors">
                        Forgot Password?
                    </button>
                    <a href="/register" class="hover:text-slate-900 transition-colors">Sign Up</a>
                </div>

                <div class="pt-3 border-t border-slate-300/80 text-center">
                    <p class="text-xs tracking-widest text-slate-600 mb-3">GMAIL SUPPORT</p>
                    <div class="flex items-center justify-center">
                        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=classicfitapparel.fashion%40gmail.com&su=ClassicFit%20Support"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="h-10 w-10 rounded-full bg-white border border-slate-300 flex items-center justify-center hover:bg-slate-50"
                           title="Open Gmail compose">
                            <svg viewBox="0 0 48 48" class="h-5 w-5" aria-hidden="true">
                                <path fill="#EA4335" d="M24 9.5c3.2 0 6.1 1.1 8.4 2.8l6.3-6.3C34.8 2.5 29.8 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.3 5.7C11.7 13.3 17.3 9.5 24 9.5z" />
                                <path fill="#4285F4" d="M46.1 24.5c0-1.7-.2-3.3-.5-4.8H24v9.2h12.4c-.5 3-2.2 5.5-4.7 7.2l7.2 5.6c4.2-3.8 6.6-9.5 6.6-17.2z" />
                                <path fill="#FBBC05" d="M9.9 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.3-5.7C.9 16.8 0 20.3 0 24s.9 7.2 2.6 10.3l7.3-5.7z" />
                                <path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.2-5.6c-2 1.4-4.6 2.3-8.7 2.3-6.7 0-12.3-3.8-14.1-9.5l-7.3 5.7C6.6 42.6 14.6 48 24 48z" />
                            </svg>
                        </a>
                    </div>
                </div>

                <div class="text-center pt-1">
                    <a href="/"
                       class="text-xs text-slate-600 hover:text-slate-900 transition-colors">Back to Home</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Forgot Password Modal -->
@if (showForgotPassword)
{
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4" @onclick="CloseForgotPassword">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900">Reset Password</h3>
                <button type="button" @onclick="CloseForgotPassword" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <p class="text-sm text-gray-500 mb-6">Enter your email address and we'll send a temporary password to your Gmail inbox.</p>

            @if (!string.IsNullOrEmpty(resetMessage))
            {
                <div class="mb-4 px-4 py-3 rounded-lg text-sm @(resetSuccess ? "bg-green-50 border border-green-200 text-green-700" : "bg-red-50 border border-red-200 text-red-700")">
                    @resetMessage
                </div>
            }

            <div class="space-y-4">
                <div class="space-y-2">
                    <label class="text-gray-600 font-medium text-sm">Email Address</label>
                    <div class="relative group">
                        <div class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 group-focus-within:text-[#80A1BA] transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <input type="email" @bind="resetEmail"
                            class="w-full pl-12 pr-4 py-3 bg-[#eff5f7] border-2 border-transparent focus:bg-white focus:border-[#91C4C3] rounded-xl outline-none transition-all text-gray-700 placeholder-gray-400"
                            placeholder="Enter your email address" />
                    </div>
                </div>

                <button type="button" @onclick="HandleForgotPassword" disabled="@isResetting"
                    class="w-full bg-[#80A1BA] hover:bg-[#6b8c9d] text-white py-3 rounded-xl font-bold transition-all shadow-lg disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2">
                    @if (isResetting)
                    {
                        <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <span>Sending...</span>
                    }
                    else
                    {
                        <span>Send Reset Link</span>
                    }
                </button>

                <button type="button" @onclick="CloseForgotPassword" class="w-full text-gray-500 hover:text-gray-700 py-2 text-sm font-medium transition-colors">
                    Back to Login
                </button>
            </div>
        </div>
    </div>
}

@code {
    private LoginRequest loginRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;
    private bool showPassword = false;

    // Forgot password state
    private bool showForgotPassword = false;
    private string resetEmail = "";
    private string resetMessage = "";
    private bool resetSuccess = false;
    private bool isResetting = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var success = await AuthService.LoginAsync(loginRequest);
            if (success)
            {
                var user = AuthService.CurrentUser;
                if (user != null)
                {
                    string target = user.Role switch
                    {
                        UserRole.SuperAdmin => "/superadmin/dashboard",
                        UserRole.Admin => "/dashboard/admin",
                        UserRole.Supervisor => "/supervisor/dashboard",
                        UserRole.Agent => "/agent/dashboard",
                        UserRole.Customer => "/customer/dashboard",
                        _ => "/dashboard"
                    };
                    NavigationManager.NavigateTo(target);
                }
                else
                {
                    NavigationManager.NavigateTo("/dashboard");
                }
            }
            else
            {
                errorMessage = AuthService.LastLoginError ?? "Invalid email or password. Please try again.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Unable to connect to the server. Please check your internet connection and try again.";
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong. Please try again later.";
            Console.WriteLine($"Login error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenForgotPassword()
    {
        showForgotPassword = true;
        resetEmail = loginRequest.Email ?? "";
        resetMessage = "";
        resetSuccess = false;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void CloseForgotPassword()
    {
        showForgotPassword = false;
        resetMessage = "";
    }

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(resetEmail))
        {
            resetMessage = "Please enter your email address.";
            resetSuccess = false;
            return;
        }

        isResetting = true;
        resetMessage = "";

        try
        {
            var (success, message) = await ApiClient.ResetPasswordAsync(resetEmail.Trim());
            resetSuccess = success;
            resetMessage = message;
        }
        catch
        {
            resetSuccess = false;
            resetMessage = "Unable to connect to the server. Please try again later.";
        }
        finally
        {
            isResetting = false;
        }
    }
}
