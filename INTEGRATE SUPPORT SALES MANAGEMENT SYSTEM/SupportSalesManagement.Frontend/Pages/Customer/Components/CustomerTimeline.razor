@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient

<div class="flow-root">
    <ul role="list" class="-mb-8">
        @if (Items == null || !Items.Any())
        {
            <li class="py-4 text-center text-gray-500 italic">No activity history found.</li>
        }
        else
        {
            @for (int i = 0; i < Items.Count; i++)
            {
                var item = Items[i];
                <li>
                    <div class="relative pb-8">
                        @if (i != Items.Count - 1)
                        {
                            <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                        }
                        <div class="relative flex space-x-3">
                            <div>
                                <span class="h-8 w-8 rounded-full @GetIconBg(item.Type) flex items-center justify-center ring-8 ring-white">
                                    @if (item.Type == "Call")
                                    {
                                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                    }
                                    else if (item.Type == "Ticket")
                                    {
                                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                                        </svg>
                                    }
                                </span>
                            </div>
                            <div class="flex min-w-0 flex-1 justify-between space-x-4 pt-1.5">
                                <div>
                                    <p class="text-sm text-gray-900 font-bold">@item.Title</p>
                                    <p class="text-xs text-gray-500 mt-0.5">@item.Description</p>
                                </div>
                                <div class="whitespace-nowrap text-right text-xs text-gray-400">
                                    <time datetime="@item.Timestamp.ToString("yyyy-MM-dd")">@item.Timestamp.ToString("MMM dd, HH:mm")</time>
                                    <span class="block font-medium @GetStatusColor(item.Status)">@item.Status</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            }
        }
    </ul>
</div>

@code {
    [Parameter] public List<TimelineItem> Items { get; set; } = new();

    private string GetIconBg(string type) => type switch
    {
        "Call" => "bg-blue-500",
        "Ticket" => "bg-yellow-500",
        "Order" => "bg-green-500",
        _ => "bg-gray-500"
    };

    private string GetStatusColor(string status) => status switch
    {
        "Completed" or "Resolved" or "Delivered" => "text-green-600",
        "Pending" or "Open" or "InProgress" => "text-blue-600",
        "Cancelled" or "Escalated" or "Overdue" => "text-red-600",
        _ => "text-gray-600"
    };
}

@code {
    public class TimelineItem
    {
        public int Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string? Description { get; set; }
        public DateTime Timestamp { get; set; }
        public string Status { get; set; } = string.Empty;
        public int AgentId { get; set; }
    }
}
