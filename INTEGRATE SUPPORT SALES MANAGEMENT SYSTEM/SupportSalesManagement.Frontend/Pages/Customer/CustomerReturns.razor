@page "/customer/returns"
@inject NavigationManager NavigationManager
@layout CustomerLayout

<PageTitle>Returns & Exchanges - SupportFlow</PageTitle>

<div class="customer-theme min-h-screen bg-gradient-to-br from-[#f8fbff] via-[#f4f8ff] to-[#eef5ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- Breadcrumb -->
        <div class="flex items-center text-sm text-gray-500 mb-6">
            <a href="/customer/dashboard" class="hover:text-gray-900">Home</a>
            <span class="mx-2">></span>
            <span class="text-gray-900 font-medium">Returns</span>
        </div>

        <div class="bg-white rounded-3xl p-8 shadow-sm border border-gray-100">
            <div class="max-w-3xl mx-auto text-center">
                <div class="w-20 h-20 bg-[#e8f3f3] rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-[#1B3A4B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                    </svg>
                </div>
                <h1 class="text-[21px] font-bold text-gray-900 mb-4">Returns & Exchanges</h1>
                <p class="text-lg text-gray-600 mb-8">Need to return an item? We've got you covered. Please select the
                    order you'd like to return to get started.</p>

                <div class="bg-[#e8f3f3] border border-[#c9dde4] rounded-2xl p-6 mb-8 text-left">
                    <h3 class="font-bold text-[#1B3A4B] mb-2">Our Return Policy</h3>
                    <ul class="text-[#1B3A4B] text-sm space-y-2 list-disc pl-5">
                        <li>30-day return window for all unworn items.</li>
                        <li>Items must have original tags attached.</li>
                        <li>Exchanges are subject to stock availability.</li>
                        <li>Refunds will be processed within 5-7 business days.</li>
                    </ul>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button @onclick='() => NavigationManager.NavigateTo("/customer/orders")'
                        class="bg-[#1B3A4B] text-white px-8 py-3 rounded-xl font-bold hover:bg-[#162e3c] transition-colors shadow-lg">
                        View My Orders to Return
                    </button>
                    <button @onclick='() => NavigationManager.NavigateTo("/customer/support")'
                        class="bg-white text-gray-700 border border-gray-200 px-8 py-3 rounded-xl font-bold hover:bg-gray-50 transition-colors">
                        Contact Support
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
