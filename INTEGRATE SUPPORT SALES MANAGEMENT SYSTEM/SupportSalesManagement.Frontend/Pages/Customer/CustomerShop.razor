@page "/customer/shop"
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient
@inject CartService CartService
@implements IDisposable

@layout CustomerLayout

<PageTitle>ClassicFit Shop</PageTitle>

<style>
    :root {
        --navy: #1B3A4B;
        --blue: #80A1BA;
        --light-blue: #91C4C3;
        --canvas: #f5f5f5;
    }

    body {
        background-color: var(--canvas);
    }

    .shopee-sort-bar {
        background: rgba(0, 0, 0, .03);
        padding: .8125rem 1.25rem;
        border-radius: 2px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sort-btn {
        box-shadow: 0 1px 1px 0 rgba(0, 0, 0, .02);
        height: 2.125rem;
        border-radius: 2px;
        border: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: capitalize;
        user-select: none;
        cursor: pointer;
        padding: 0 .9375rem;
        background: #fff;
        margin-left: .625rem;
        font-size: .875rem;
    }

    .sort-btn.active {
        background: var(--blue);
        color: #fff;
        font-weight: 500;
    }

    .product-card:hover {
        transform: translateY(-1px);
        box-shadow: 0 0.125rem 1.25rem rgba(0, 0, 0, .05);
        border: 1px solid var(--blue);
        z-index: 10;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<div class="customer-theme min-h-screen bg-gradient-to-br from-[#f8fbff] via-[#f4f8ff] to-[#eef4fb] pb-12 -mx-4 sm:-mx-6 lg:-mx-10">
    @if (!string.IsNullOrWhiteSpace(shopMessage))
    {
        <div class="fixed top-20 right-5 z-40 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-700 shadow-md">
            @shopMessage
        </div>
    }

    <!-- Header/Search Area -->
    <div class="bg-white shadow-sm sticky top-0 z-30 border-b border-gray-200">
        <div class="w-full mx-auto px-4 sm:px-6 lg:px-10 py-3 flex items-center justify-between gap-3">
            <h1 class="text-[21px] font-bold text-[#1e3a5f] flex items-center gap-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                ClassicFit Shop
            </h1>

            <div class="flex items-center gap-2 flex-1 justify-end max-w-2xl">
                <div class="flex-1 max-w-lg relative">
                    <input type="text" @bind="searchQuery" @bind:event="oninput" @onkeyup="ApplyFilters"
                        placeholder="Search in ClassicFit..."
                        class="w-full border-2 border-[#3b82f6] rounded-md py-2 px-4 pr-12 focus:outline-none focus:ring-0" />
                    <button @onclick="ApplyFilters"
                        class="absolute right-0 top-0 h-full px-5 bg-[#3b82f6] text-white rounded-r-sm hover:bg-blue-600">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                </div>

                <button @onclick='() => NavigationManager.NavigateTo("/customer/orders?tab=cart")'
                    class="relative p-2 text-[#1e3a5f] hover:text-[#3b82f6]">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                        </path>
                    </svg>
                    @if (cartCount > 0)
                    {
                        <span
                            class="absolute top-0 right-0 bg-[#3b82f6] text-white text-xs font-bold px-1.5 py-0.5 rounded-full border-2 border-white">@cartCount</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <div class="w-full mx-auto px-4 sm:px-6 lg:px-10 mt-6 grid grid-cols-12 gap-6">
        <!-- Sidebar Filters -->
        <div class="col-span-2 hidden lg:block">
            <div class="space-y-6">
                <!-- Categories -->
                <div>
                    <button @onclick="ToggleCategoryPanel" class="font-bold text-gray-800 flex items-center justify-between gap-2 mb-3 w-full">
                        <span class="inline-flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4 6h16M4 12h16M4 18h7"></path>
                            </svg>
                            All Categories
                        </span>
                        <svg class="w-4 h-4 transition-transform @(showCategoryPanel ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                    @if (showCategoryPanel)
                    {
                    <ul class="text-sm space-y-2 text-gray-600 pl-6">
                        <li @onclick='() => SetCategoryFilter("")'
                            class="@(selectedCategory == "" ? "font-semibold text-[#1B3A4B]" : "hover:text-[#1B3A4B]") cursor-pointer">All</li>
                        <li @onclick='() => SetCategoryFilter("TShirt")'
                            class="@(selectedCategory == "TShirt" ? "font-semibold text-[#1B3A4B]" : "hover:text-[#1B3A4B]") cursor-pointer">T-Shirts</li>
                        <li @onclick='() => SetCategoryFilter("Dress")'
                            class="@(selectedCategory == "Dress" ? "font-semibold text-[#1B3A4B]" : "hover:text-[#1B3A4B]") cursor-pointer">Dresses</li>
                        <li @onclick='() => SetCategoryFilter("Jacket")'
                            class="@(selectedCategory == "Jacket" ? "font-semibold text-[#1B3A4B]" : "hover:text-[#1B3A4B]") cursor-pointer">Jackets</li>
                        <li @onclick='() => SetCategoryFilter("Sweater")'
                            class="@(selectedCategory == "Sweater" ? "font-semibold text-[#1B3A4B]" : "hover:text-[#1B3A4B]") cursor-pointer">Sweaters</li>
                    </ul>
                    }
                </div>

                <!-- Price Range -->
                <div>
                    <h3 class="font-bold text-gray-800 mb-3">Price Range</h3>
                    <div class="flex items-center gap-2 mb-2">
                        <input type="number" @bind="minPrice"
                            class="w-full border border-gray-300 px-2 py-1 text-sm rounded-sm" placeholder="₱ MIN" />
                        <span class="text-gray-400">-</span>
                        <input type="number" @bind="maxPrice"
                            class="w-full border border-gray-300 px-2 py-1 text-sm rounded-sm" placeholder="₱ MAX" />
                    </div>
                    <button @onclick="ApplyFilters"
                        class="w-full bg-[#1B3A4B] text-white py-1.5 uppercase text-xs font-bold rounded-sm hover:bg-[#162e3c]">Apply</button>
                </div>


            </div>
        </div>

        <!-- Main Product Area -->
        <div class="col-span-12 lg:col-span-10">
            <!-- Shopee Style Sort Bar -->
            <div class="shopee-sort-bar mb-4">
                <span class="text-xs text-gray-500 mr-2">Available: @filteredProducts.Count products</span>
                <span class="text-gray-600 text-sm mr-2">Sort by</span>
                <button class="sort-btn @(sortBy == "featured" ? "active" : "")"
                    @onclick="@(() => SetSort("featured"))">Relevance</button>
                <button class="sort-btn @(sortBy == "newest" ? "active" : "")"
                    @onclick="@(() => SetSort("newest"))">Latest</button>
                <button class="sort-btn @(sortBy == "sales" ? "active" : "")" @onclick="@(() => SetSort("sales"))">Top
                    Sales</button>

                <div class="relative group ml-2">
                    <button class="sort-btn min-w-[200px] justify-between bg-white">
                        <span>Price</span>
                        <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7">
                            </path>
                        </svg>
                    </button>
                    <div
                        class="absolute top-full left-0 w-full bg-white shadow-md border border-gray-100 hidden group-hover:block z-20">
                        <button class="text-sm px-4 py-2 hover:bg-gray-50 w-full text-left"
                            @onclick="@(() => SetSort("price_asc"))">Price: Low to High</button>
                        <button class="text-sm px-4 py-2 hover:bg-gray-50 w-full text-left"
                            @onclick="@(() => SetSort("price_desc"))">Price: High to Low</button>
                    </div>
                </div>

                <div class="flex-1 flex justify-end items-center gap-4 px-4 text-sm">
                    <span class="text-gray-500"><span class="text-[#1B3A4B]">1</span>/1</span>
                    <div class="flex">
                        <button
                            class="w-9 h-9 border border-gray-200 bg-gray-50 flex items-center justify-center text-gray-300 cursor-not-allowed"><svg
                                class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M15 19l-7-7 7-7"></path>
                            </svg></button>
                        <button
                            class="w-9 h-9 border border-gray-200 bg-white flex items-center justify-center text-gray-600 shadow-sm"><svg
                                class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7">
                                </path>
                            </svg></button>
                    </div>
                </div>
            </div>

            <!-- Products Grid (5 cols density) -->
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-2.5">
                @foreach (var product in filteredProducts)
                {
                    <div
                        class="bg-white hover:border-[#1B3A4B] border border-transparent transition-all duration-100 cursor-pointer product-card relative group">
                        <!-- Image Area -->
                        <div class="relative aspect-square bg-gray-100">
                            <img src="@product.ImageUrl" class="w-full h-full object-cover" />

                            @if (product.StockQuantity == 0)
                            {
                                <div class="absolute inset-0 bg-black/50 flex items-center justify-center">
                                    <div class="bg-black/70 text-white text-xs px-2 py-1 rounded-full">SOLD OUT</div>
                                </div>
                            }
                        </div>

                        <!-- Content -->
                        <div class="p-2.5">
                            <div class="text-xs font-medium text-gray-800 line-clamp-2 min-h-[2.5em] mb-2 leading-snug">
                                <span
                                    class="bg-[#d91921] text-white text-[10px] px-1 rounded-[1px] mr-1 align-middle inline-block">Mall</span>
                                @product.Name
                            </div>

                            <div class="flex items-center justify-between mt-4">
                                <div>
                                    <div class="text-[#1B3A4B] text-base font-semibold">
                                        <span class="text-xs">₱</span>@product.Price.ToString("N0")
                                    </div>
                                </div>
                                <div class="text-[10px] text-gray-500">@product.StockQuantity available</div>
                            </div>

                            <!-- Action Button -->
                            <div class="grid grid-cols-2 gap-2 mt-2">
                                <button @onclick="() => AddToCart(product)"
                                    class="w-full bg-[#1B3A4B] text-white py-2 text-xs font-bold hover:bg-[#162e3c] transition-colors rounded-sm flex items-center justify-center gap-1">
                                    Add to Cart
                                </button>
                                <button @onclick="() => BuyNow(product)"
                                    class="w-full bg-[#3b82f6] text-white py-2 text-xs font-bold hover:bg-[#2563eb] transition-colors rounded-sm flex items-center justify-center gap-1">
                                    Buy Now
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (filteredProducts.Count == 0)
            {
                <div class=" py-12 flex flex-col items-center justify-center bg-white mt-4 border border-gray-100">
                    <img src="https://deo.shopeemobile.com/shopee/shopee-pcmall-live-sg/assets/a60759ad1dabe909c46a817ecbf71878.png"
                        class="w-32 h-32 opacity-50 mb-4" />
                    <p class="text-gray-500">No products found</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<string> availableSizes = new() { "XS", "S", "M", "L", "XL", "XXL" };
    private int minPrice = 0;
    private int maxPrice = int.MaxValue;
    private string searchQuery = "";
    private string sortBy = "featured";
    private string selectedCategory = "";

    private List<Product> products = new();
    private List<Product> filteredProducts = new();

    // Use CartService for state
    private int cartCount = 0;
    private string? shopMessage;

    protected override async Task OnInitializedAsync()
    {
        // Load active products from API
        try
        {
            var result = await ApiClient.GetActiveProductsAsync();
            if (result != null)
            {
                products = result;
                if (products.Count > 0)
                {
                    maxPrice = (int)Math.Ceiling(products.Max(p => p.Price));
                }
                ApplyFilters();
            }

            // Initialize cart
            await CartService.InitializeCartAsync();
            UpdateCartCount();

            CartService.OnChange += StateHasChanged;
            CartService.OnChange += UpdateCartCount;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
        CartService.OnChange -= UpdateCartCount;
    }

    private void UpdateCartCount()
    {
        cartCount = CartService.GetCartCount();
    }

    private void SetCategoryFilter(string category)
    {
        selectedCategory = category;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var query = products.AsQueryable();

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query = query.Where(p => p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(selectedCategory))
        {
            query = query.Where(p => p.Category.Equals(selectedCategory, StringComparison.OrdinalIgnoreCase));
        }

        query = query.Where(p => p.Price >= minPrice && p.Price <= maxPrice);

        // Sorting
        switch (sortBy)
        {
            case "price_asc": query = query.OrderBy(p => p.Price); break;
            case "price_desc": query = query.OrderByDescending(p => p.Price); break;
            case "newest": query = query.OrderByDescending(p => p.Id); break;
            case "sales": query = query.OrderByDescending(p => p.StockQuantity); break;
        }

        filteredProducts = query.ToList();
        StateHasChanged();
    }

    private void SetSort(string sort)
    {
        sortBy = sort;
        ApplyFilters();
    }

    private void ClearFilters()
    {
        minPrice = 0;
        maxPrice = products.Count > 0
            ? (int)Math.Ceiling(products.Max(p => p.Price))
            : int.MaxValue;
        searchQuery = "";
        sortBy = "featured";
        selectedCategory = "";
        ApplyFilters();
    }

    private async Task AddToCart(Product product)
    {
        await CartService.AddToCartAsync(product);
        shopMessage = $"{product.Name} added to cart.";
        StateHasChanged();
        await Task.Delay(1500);
        shopMessage = null;
    }

    private async Task BuyNow(Product product)
    {
        await CartService.ClearCartAsync();
        await CartService.AddToCartAsync(product);
        NavigationManager.NavigateTo("/customer/orders?tab=checkout");
    }

    private bool showCategoryPanel = true;
    private void ToggleCategoryPanel() => showCategoryPanel = !showCategoryPanel;
}
