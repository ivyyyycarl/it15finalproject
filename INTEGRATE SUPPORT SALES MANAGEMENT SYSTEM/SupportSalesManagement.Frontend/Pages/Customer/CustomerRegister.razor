@page "/customer/register"
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient

<PageTitle>Create Account - ClassicFit</PageTitle>

<div class="register-page">
    <!-- Floating Background Elements -->
    <div class="bg-decoration">
        <div class="bg-blob bg-blob-1"></div>
        <div class="bg-blob bg-blob-2"></div>
        <div class="bg-blob bg-blob-3"></div>
    </div>

    <div class="register-container">
        <!-- Left Panel - Branding -->
        <div class="brand-panel">
            <div class="brand-content">
                <div class="brand-logo">
                    <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                    </svg>
                </div>
                <h1 class="brand-title">ClassicFit</h1>
                <p class="brand-subtitle">Premium Shirts Collection</p>

                <div class="brand-features">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <span>Free shipping on first order</span>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <span>Exclusive member discounts</span>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <span>24/7 customer support</span>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <span>Easy returns within 30 days</span>
                    </div>
                </div>
            </div>

            <!-- Step Progress (visible on brand panel) -->
            <div class="brand-steps">
                <div class="step-line">
                    <div class="step-line-fill" style="height: @((currentStep - 1) * 50)%"></div>
                </div>
                <div class="step-marker @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "completed" : "")">
                    <div class="step-dot">
                        @if (currentStep > 1)
                        {
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                        }
                        else
                        {
                            <span>1</span>
                        }
                    </div>
                    <span class="step-label">Personal Info</span>
                </div>
                <div class="step-marker @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")">
                    <div class="step-dot">
                        @if (currentStep > 2)
                        {
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                        }
                        else
                        {
                            <span>2</span>
                        }
                    </div>
                    <span class="step-label">Address</span>
                </div>
                <div class="step-marker @(currentStep >= 3 ? "active" : "")">
                    <div class="step-dot">
                        <span>3</span>
                    </div>
                    <span class="step-label">Security</span>
                </div>
            </div>
        </div>

        <!-- Right Panel - Form -->
        <div class="form-panel">
            <!-- Mobile Step Indicator -->
            <div class="mobile-steps">
                <div class="mobile-step-bar">
                    <div class="mobile-step @(currentStep >= 1 ? "active" : "") @(currentStep > 1 ? "completed" : "")">
                        <div class="mobile-step-dot">
                            @if (currentStep > 1) { <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> } else { <span>1</span> }
                        </div>
                    </div>
                    <div class="mobile-step-connector @(currentStep > 1 ? "active" : "")"></div>
                    <div class="mobile-step @(currentStep >= 2 ? "active" : "") @(currentStep > 2 ? "completed" : "")">
                        <div class="mobile-step-dot">
                            @if (currentStep > 2) { <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg> } else { <span>2</span> }
                        </div>
                    </div>
                    <div class="mobile-step-connector @(currentStep > 2 ? "active" : "")"></div>
                    <div class="mobile-step @(currentStep >= 3 ? "active" : "")">
                        <div class="mobile-step-dot"><span>3</span></div>
                    </div>
                </div>
                <div class="mobile-step-labels">
                    <span class="@(currentStep == 1 ? "text-blue-600 font-semibold" : "text-gray-400")">Personal</span>
                    <span class="@(currentStep == 2 ? "text-blue-600 font-semibold" : "text-gray-400")">Address</span>
                    <span class="@(currentStep == 3 ? "text-blue-600 font-semibold" : "text-gray-400")">Security</span>
                </div>
            </div>

            <!-- Messages -->
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="message message-success animate-slideDown">
                    <div class="message-icon success">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <div>
                        <p class="message-title">Registration Successful!</p>
                        <p class="message-text">@successMessage</p>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="message message-error animate-slideDown">
                    <div class="message-icon error">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </div>
                    <div>
                        <p class="message-title">Registration Failed</p>
                        <p class="message-text">@errorMessage</p>
                    </div>
                </div>
            }

            <form @onsubmit="HandleRegistration">

                <!-- ===== STEP 1: Personal Information ===== -->
                <div class="form-step @(currentStep == 1 ? "step-active" : "step-hidden")">
                    <div class="step-header">
                        <h2 class="step-title">Personal Information</h2>
                        <p class="step-description">Tell us about yourself to create your account</p>
                    </div>

                    <!-- Full Name -->
                    <div class="form-group">
                        <label class="form-label">
                            Full Name <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <input type="text" @bind="fullName" @bind:event="oninput"
                                class="form-input @(!string.IsNullOrWhiteSpace(fullName) ? "has-value" : "")"
                                placeholder="e.g. Juan Dela Cruz" required />
                            @if (!string.IsNullOrWhiteSpace(fullName))
                            {
                                <div class="input-check">
                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label class="form-label">
                            Email Address <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                </svg>
                            </div>
                            <input type="email" @bind="email" @bind:event="oninput"
                                class="form-input @(email.Contains("@") && email.Contains(".") ? "has-value" : !string.IsNullOrEmpty(email) ? "has-error" : "")"
                                placeholder="your.email@example.com" required />
                            @if (email.Contains("@") && email.Contains("."))
                            {
                                <div class="input-check">
                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <p class="form-hint">This will be your unique login identifier</p>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-group">
                        <label class="form-label">
                            Phone Number <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                </svg>
                            </div>
                            <input type="tel" @bind="phoneNumber" @bind:event="oninput" maxlength="11"
                                class="form-input @(phoneNumber.Length == 11 && phoneNumber.All(char.IsDigit) ? "has-value" : phoneNumber.Length > 0 ? "has-warning" : "")"
                                placeholder="09XXXXXXXXX" required />
                            @if (phoneNumber.Length == 11 && phoneNumber.All(char.IsDigit))
                            {
                                <div class="input-check">
                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                    </svg>
                                </div>
                            }
                        </div>
                        <div class="form-hint-row">
                            <span>Must be exactly 11 digits</span>
                            <span class="phone-counter @(phoneNumber.Length == 11 ? "complete" : phoneNumber.Length > 0 ? "partial" : "")">
                                @phoneNumber.Length / 11
                            </span>
                        </div>
                    </div>

                    <!-- Next Button -->
                    <div class="form-actions single-right">
                        <button type="button" @onclick="GoToStep2"
                            class="btn btn-primary"
                            disabled="@(!IsStep1Valid())">
                            <span>Continue to Address</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- ===== STEP 2: Address ===== -->
                <div class="form-step @(currentStep == 2 ? "step-active" : "step-hidden")">
                    <div class="step-header">
                        <h2 class="step-title">Shipping Address</h2>
                        <p class="step-description">Where should we deliver your orders?</p>
                    </div>

                    <div class="form-grid">
                        <!-- Country -->
                        <div class="form-group">
                            <label class="form-label">
                                Country <span class="required">*</span>
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <div class="input-icon">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </div>
                                <select @bind="selectedCountry" @bind:after="OnCountryChanged"
                                    class="form-select @(!string.IsNullOrEmpty(selectedCountry) ? "has-value" : "")" required>
                                    <option value="">Select Country</option>
                                    @foreach (var country in countries)
                                    {
                                        <option value="@country">@country</option>
                                    }
                                </select>
                                <div class="select-arrow">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- City -->
                        <div class="form-group">
                            <label class="form-label">
                                City <span class="required">*</span>
                            </label>
                            <div class="input-wrapper select-wrapper">
                                <div class="input-icon">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                                    </svg>
                                </div>
                                <select @bind="selectedCity" @bind:after="OnCityChanged"
                                    class="form-select @(!string.IsNullOrEmpty(selectedCity) ? "has-value" : "")"
                                    disabled="@(string.IsNullOrEmpty(selectedCountry))" required>
                                    <option value="">@(string.IsNullOrEmpty(selectedCountry) ? "Select country first" : "Select City")</option>
                                    @foreach (var city in availableCities)
                                    {
                                        <option value="@city">@city</option>
                                    }
                                </select>
                                <div class="select-arrow">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Postal Code -->
                        <div class="form-group">
                            <label class="form-label">
                                Postal Code <span class="required">*</span>
                            </label>
                            <div class="input-wrapper">
                                <div class="input-icon">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                                <input type="text" @bind="postalCode" @bind:event="oninput"
                                    class="form-input @(!string.IsNullOrEmpty(postalCode) ? "has-value" : "")"
                                    placeholder="@(string.IsNullOrEmpty(selectedCity) ? "Auto-filled from city" : "Postal code")" required />
                            </div>
                            @if (!string.IsNullOrEmpty(selectedCity))
                            {
                                <p class="form-hint info">
                                    <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                    Auto-filled based on city. You can edit if needed.
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Street Address (full width) -->
                    <div class="form-group">
                        <label class="form-label">
                            Street Address <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon" style="top: 14px;">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                            </div>
                            <input type="text" @bind="streetAddress" @bind:event="oninput"
                                class="form-input @(!string.IsNullOrWhiteSpace(streetAddress) ? "has-value" : "")"
                                placeholder="House/Unit No., Street, Barangay, Building" required />
                        </div>
                    </div>

                    <!-- Navigation -->
                    <div class="form-actions">
                        <button type="button" @onclick="() => currentStep = 1" class="btn btn-outline">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                            </svg>
                            <span>Back</span>
                        </button>
                        <button type="button" @onclick="GoToStep3"
                            class="btn btn-primary"
                            disabled="@(!IsStep2Valid())">
                            <span>Continue to Security</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- ===== STEP 3: Security ===== -->
                <div class="form-step @(currentStep == 3 ? "step-active" : "step-hidden")">
                    <div class="step-header">
                        <h2 class="step-title">Security & Password</h2>
                        <p class="step-description">Create a strong password to protect your account</p>
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label class="form-label">
                            Password <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="@(showPassword ? "text" : "password")" @bind="password" @bind:event="oninput"
                                class="form-input password-input"
                                placeholder="Create a strong password" required minlength="8" />
                            <button type="button" @onclick="() => showPassword = !showPassword" class="toggle-password">
                                @if (showPassword)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                }
                            </button>
                        </div>

                        <!-- Password Strength -->
                        @if (!string.IsNullOrEmpty(password))
                        {
                            <div class="password-strength animate-slideDown">
                                <div class="strength-bars">
                                    <div class="strength-bar @(passwordStrength >= 1 ? GetStrengthBarClass() : "")"></div>
                                    <div class="strength-bar @(passwordStrength >= 2 ? GetStrengthBarClass() : "")"></div>
                                    <div class="strength-bar @(passwordStrength >= 3 ? GetStrengthBarClass() : "")"></div>
                                    <div class="strength-bar @(passwordStrength >= 4 ? GetStrengthBarClass() : "")"></div>
                                </div>
                                <span class="strength-text @GetStrengthTextClass()">@GetStrengthText()</span>

                                <div class="password-requirements">
                                    <div class="requirement @(password.Length >= 8 ? "met" : "")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(password.Length >= 8 ? "M5 13l4 4L19 7" : "M12 8v4m0 4h.01")" />
                                        </svg>
                                        <span>At least 8 characters</span>
                                    </div>
                                    <div class="requirement @(HasUppercase() ? "met" : "")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(HasUppercase() ? "M5 13l4 4L19 7" : "M12 8v4m0 4h.01")" />
                                        </svg>
                                        <span>Uppercase letter</span>
                                    </div>
                                    <div class="requirement @(HasLowercase() ? "met" : "")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(HasLowercase() ? "M5 13l4 4L19 7" : "M12 8v4m0 4h.01")" />
                                        </svg>
                                        <span>Lowercase letter</span>
                                    </div>
                                    <div class="requirement @(HasNumber() ? "met" : "")">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@(HasNumber() ? "M5 13l4 4L19 7" : "M12 8v4m0 4h.01")" />
                                        </svg>
                                        <span>Contains a number</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label class="form-label">
                            Confirm Password <span class="required">*</span>
                        </label>
                        <div class="input-wrapper">
                            <div class="input-icon">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                            </div>
                            <input type="@(showConfirmPassword ? "text" : "password")" @bind="confirmPassword" @bind:event="oninput"
                                class="form-input password-input @(confirmPassword.Length > 0 && confirmPassword == password ? "has-value" : confirmPassword.Length > 0 ? "has-error" : "")"
                                placeholder="Re-enter your password" required />
                            <button type="button" @onclick="() => showConfirmPassword = !showConfirmPassword" class="toggle-password">
                                @if (showConfirmPassword)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
