    .bottom-links {
        display: flex; align-items: center; justify-content: center;
        gap: 0.75rem; margin-top: 1.5rem; position: relative; z-index: 1;
    }
    .bottom-link {
        display: inline-flex; align-items: center; gap: 0.375rem;
        font-size: 0.8125rem; color: #6b7280;
        text-decoration: none; transition: color 0.2s ease;
    }
    .bottom-link:hover { color: #4338ca; }
    .bottom-divider { width: 4px; height: 4px; border-radius: 50%; background: #d1d5db; }

    /* ===== Animations ===== */
    .animate-slideDown {
        animation: slideDown 0.35s ease-out;
    }
    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes stepFadeIn {
        from { opacity: 0; transform: translateX(12px); }
        to { opacity: 1; transform: translateX(0); }
    }

    /* ===== Responsive ===== */
    @@media (max-width: 768px) {
        .register-page { padding: 1rem 0.75rem; }
        .brand-panel { display: none; }
        .mobile-steps { display: block; }
        .register-container {
            border-radius: 20px;
            flex-direction: column;
        }
        .form-panel { padding: 1.75rem 1.25rem; min-height: auto; }
        .form-grid { grid-template-columns: 1fr; }
        .password-requirements { grid-template-columns: 1fr; }
        .form-actions { flex-direction: column-reverse; gap: 0.75rem; }
        .form-actions .btn { width: 100%; justify-content: center; }
        .form-footer { flex-direction: column; gap: 0.5rem; text-align: center; }
        .step-title { font-size: 1.25rem; }
    }

    @@media (max-width: 480px) {
        .form-panel { padding: 1.5rem 1rem; }
        .btn { padding: 0.75rem 1rem; font-size: 0.875rem; }
    }
</style>

@code {
    // Form fields
    private string fullName = "";
    private string email = "";
    private string phoneNumber = "";
    private string password = "";
    private string confirmPassword = "";
    private string selectedCountry = "";
    private string selectedCity = "";
    private string postalCode = "";
    private string streetAddress = "";
    private bool acceptTerms = false;

    // UI state
    private int currentStep = 1;
    private bool isLoading = false;
    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private string errorMessage = "";
    private string successMessage = "";

    // Dynamic city list
    private List<string> availableCities = new();

    // ===== Country / City / Postal Code Data =====
    private readonly List<string> countries = new()
    {
        "Philippines", "United States", "Canada", "United Kingdom",
        "Australia", "Japan", "Singapore", "South Korea",
        "United Arab Emirates", "Germany"
    };

    private readonly Dictionary<string, List<(string City, string PostalCode)>> countryCityData = new()
    {
        ["Philippines"] = new()
        {
            ("Manila", "1000"), ("Quezon City", "1100"), ("Makati", "1200"),
            ("Taguig", "1630"), ("Pasig", "1600"), ("Cebu City", "6000"),
            ("Davao City", "8000"), ("Zamboanga City", "7000"), ("Cagayan de Oro", "9000"),
            ("Iloilo City", "5000"), ("Bacolod", "6100"), ("General Santos", "9500"),
            ("Caloocan", "1400"), ("Las Pinas", "1740"), ("Paranaque", "1700"),
            ("Mandaluyong", "1550"), ("Marikina", "1800"), ("Muntinlupa", "1770"),
            ("Pasay", "1300"), ("Valenzuela", "1440"), ("Angeles City", "2009"),
            ("Baguio", "2600"), ("Antipolo", "1870"), ("San Juan", "1500")
        },
        ["United States"] = new()
        {
            ("New York", "10001"), ("Los Angeles", "90001"), ("Chicago", "60601"),
            ("Houston", "77001"), ("Phoenix", "85001"), ("San Francisco", "94101"),
            ("Miami", "33101"), ("Seattle", "98101"), ("Dallas", "75201"),
            ("Boston", "02101"), ("Atlanta", "30301"), ("Denver", "80201")
        },
        ["Canada"] = new()
        {
            ("Toronto", "M5A"), ("Vancouver", "V5K"), ("Montreal", "H1A"),
            ("Calgary", "T1X"), ("Ottawa", "K1A"), ("Edmonton", "T5A"),
            ("Winnipeg", "R2C"), ("Quebec City", "G1A"), ("Halifax", "B3H")
        },
        ["United Kingdom"] = new()
        {
            ("London", "EC1A"), ("Manchester", "M1"), ("Birmingham", "B1"),
            ("Liverpool", "L1"), ("Leeds", "LS1"), ("Glasgow", "G1"),
            ("Edinburgh", "EH1"), ("Bristol", "BS1"), ("Cardiff", "CF10")
        },
        ["Australia"] = new()
        {
            ("Sydney", "2000"), ("Melbourne", "3000"), ("Brisbane", "4000"),
            ("Perth", "6000"), ("Adelaide", "5000"), ("Canberra", "2600"),
            ("Gold Coast", "4217"), ("Hobart", "7000"), ("Darwin", "0800")
        },
        ["Japan"] = new()
        {
            ("Tokyo", "100-0001"), ("Osaka", "530-0001"), ("Yokohama", "220-0001"),
            ("Nagoya", "450-0001"), ("Kyoto", "600-8001"), ("Fukuoka", "810-0001"),
            ("Sapporo", "060-0001"), ("Kobe", "650-0001"), ("Sendai", "980-0001")
        },
        ["Singapore"] = new()
        {
            ("Singapore Central", "018956"), ("Orchard", "238823"),
            ("Marina Bay", "018956"), ("Jurong East", "609731"),
            ("Tampines", "528523"), ("Woodlands", "738099")
        },
        ["South Korea"] = new()
        {
            ("Seoul", "04524"), ("Busan", "48058"), ("Incheon", "21554"),
            ("Daegu", "41585"), ("Daejeon", "34126"), ("Gwangju", "61469"),
            ("Jeju", "63122"), ("Suwon", "16499")
        },
        ["United Arab Emirates"] = new()
        {
            ("Dubai", "00000"), ("Abu Dhabi", "00000"), ("Sharjah", "00000"),
            ("Ajman", "00000"), ("Al Ain", "00000"), ("Fujairah", "00000")
        },
        ["Germany"] = new()
        {
            ("Berlin", "10115"), ("Munich", "80331"), ("Hamburg", "20095"),
            ("Frankfurt", "60311"), ("Cologne", "50667"), ("Stuttgart", "70173"),
            ("Dusseldorf", "40213"), ("Dresden", "01067")
        }
    };

    // ===== Event Handlers =====

    private void OnCountryChanged()
    {
        selectedCity = "";
        postalCode = "";
        availableCities = countryCityData.ContainsKey(selectedCountry)
            ? countryCityData[selectedCountry].Select(c => c.City).ToList()
            : new List<string>();
    }

    private void OnCityChanged()
    {
        if (!string.IsNullOrEmpty(selectedCountry) && !string.IsNullOrEmpty(selectedCity)
            && countryCityData.ContainsKey(selectedCountry))
        {
            var match = countryCityData[selectedCountry].FirstOrDefault(c => c.City == selectedCity);
            if (!string.IsNullOrEmpty(match.PostalCode))
            {
                postalCode = match.PostalCode;
            }
        }
    }

    // ===== Step Navigation =====

    private void GoToStep2()
    {
        if (IsStep1Valid()) currentStep = 2;
    }

    private void GoToStep3()
    {
        if (IsStep2Valid()) currentStep = 3;
    }

    // ===== Validation =====

    private bool IsStep1Valid()
    {
        return !string.IsNullOrWhiteSpace(fullName)
            && !string.IsNullOrWhiteSpace(email)
            && email.Contains("@")
            && phoneNumber.Length == 11
            && phoneNumber.All(char.IsDigit);
    }

    private bool IsStep2Valid()
    {
        return !string.IsNullOrWhiteSpace(selectedCountry)
            && !string.IsNullOrWhiteSpace(selectedCity)
            && !string.IsNullOrWhiteSpace(postalCode)
            && !string.IsNullOrWhiteSpace(streetAddress);
    }

    private bool IsStep3Valid()
    {
        return password.Length >= 8
            && password == confirmPassword
            && acceptTerms
            && passwordStrength >= 2;
    }

    // ===== Password Strength =====

    private int passwordStrength => CalculatePasswordStrength();

    private int CalculatePasswordStrength()
    {
        if (string.IsNullOrEmpty(password)) return 0;
        int score = 0;
        if (password.Length >= 8) score++;
        if (HasUppercase()) score++;
        if (HasLowercase()) score++;
        if (HasNumber()) score++;
        return score;
    }

    private bool HasUppercase() => password.Any(char.IsUpper);
    private bool HasLowercase() => password.Any(char.IsLower);
    private bool HasNumber() => password.Any(char.IsDigit);

    private string GetStrengthBarClass() => passwordStrength switch
    {
        1 => "weak",
        2 => "fair",
        3 => "good",
        4 => "strong",
        _ => ""
    };

    private string GetStrengthTextClass() => passwordStrength switch
    {
        1 => "text-weak",
        2 => "text-fair",
        3 => "text-good",
        4 => "text-strong",
        _ => ""
    };

    private string GetStrengthText() => passwordStrength switch
    {
        1 => "Weak - add more variety",
        2 => "Fair - getting better",
        3 => "Good - almost there",
        4 => "Strong - excellent!",
        _ => ""
    };

    // ===== Form Submission =====

    private async Task HandleRegistration()
    {
        if (currentStep != 3) return;

        isLoading = true;
        errorMessage = "";
        successMessage = "";
        StateHasChanged();

        try
        {
            // Validate passwords match
            if (password != confirmPassword)
            {
                errorMessage = "Passwords do not match. Please try again.";
                isLoading = false;
                return;
            }

            // Validate password strength
            if (password.Length < 8)
            {
                errorMessage = "Password must be at least 8 characters long.";
                isLoading = false;
                return;
            }

            // Validate phone number
            if (phoneNumber.Length != 11 || !phoneNumber.All(char.IsDigit))
            {
                errorMessage = "Phone number must be exactly 11 digits.";
                currentStep = 1;
                isLoading = false;
                return;
            }

            // Validate terms
            if (!acceptTerms)
            {
                errorMessage = "You must accept the Terms & Conditions and Privacy Policy.";
                isLoading = false;
                return;
            }

            // Split full name into first/last
            var nameParts = fullName.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            var firstName = nameParts.Length > 0 ? nameParts[0] : fullName.Trim();
            var lastName = nameParts.Length > 1 ? nameParts[1] : "";

            // API call
            var result = await ApiClient.RegisterAsync(new RegisterRequest
            {
                FirstName = firstName,
                LastName = lastName,
                Email = email,
                Password = password,
                Phone = phoneNumber,
                Address = streetAddress,
                City = selectedCity,
                PostalCode = postalCode,
                Country = selectedCountry,
                Role = UserRole.Customer
            });

            if (!result.Success)
            {
                errorMessage = result.Message;
                isLoading = false;
                return;
            }

            // Success
            successMessage = "Your account has been created successfully! Redirecting to login...";
            StateHasChanged();

            await Task.Delay(2000);
            NavigationManager.NavigateTo("/customer/login");
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred during registration. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
