        display: flex; justify-content: space-between;
        margin-top: 0.5rem; padding: 0 0.5rem;
        font-size: 0.6875rem;
    }

    /* ===== Messages ===== */
    .message {
        display: flex; gap: 0.75rem; padding: 1rem 1.25rem;
        border-radius: 14px; margin-bottom: 1.5rem; align-items: flex-start;
    }
    .message-success { background: #ecfdf5; border: 1px solid #a7f3d0; }
    .message-error { background: #fef2f2; border: 1px solid #fecaca; }
    .message-icon {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .message-icon.success { background: #d1fae5; color: #059669; }
    .message-icon.error { background: #fee2e2; color: #dc2626; }
    .message-title { font-size: 0.875rem; font-weight: 700; margin: 0; }
    .message-success .message-title { color: #065f46; }
    .message-error .message-title { color: #991b1b; }
    .message-text { font-size: 0.8125rem; margin: 0.125rem 0 0; }
