                            {
                                <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                <span>Creating Account...</span>
                            }
                            else
                            {
                                <span>Create Account</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            }
                        </button>
                    </div>
                </div>
            </form>

            <!-- Footer -->
            <div class="form-footer">
                <p>Already have an account?</p>
                <a href="/customer/login" class="login-link">
                    Sign In Instead
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </div>

    <!-- Bottom Links -->
    <div class="bottom-links">
        <a href="/landing" class="bottom-link">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Home
        </a>
        <span class="bottom-divider"></span>
        <a href="/support" class="bottom-link">Need Help?</a>
    </div>
</div>

<style>
    /* ===== Base Layout ===== */
    .register-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #f0f4ff 0%, #e8eeff 25%, #f5f0ff 50%, #f0f4ff 75%, #e8f4ff 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        position: relative;
        overflow: hidden;
    }

    /* Background Decorations */
    .bg-decoration { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
    .bg-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
    }
    .bg-blob-1 { width: 500px; height: 500px; background: #818cf8; top: -200px; right: -150px; }
    .bg-blob-2 { width: 400px; height: 400px; background: #60a5fa; bottom: -150px; left: -100px; }
    .bg-blob-3 { width: 300px; height: 300px; background: #a78bfa; top: 50%; left: 50%; transform: translate(-50%, -50%); }

    /* ===== Container ===== */
    .register-container {
        width: 100%;
        max-width: 1000px;
        display: flex;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 24px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.08), 0 0 0 1px rgba(255, 255, 255, 0.8);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    /* ===== Brand Panel (Left) ===== */
    .brand-panel {
        width: 340px;
        min-width: 340px;
        background: linear-gradient(170deg, #4338ca 0%, #3b82f6 50%, #6366f1 100%);
        padding: 2.5rem 2rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }
    .brand-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.12) 0%, transparent 60%),
                    radial-gradient(circle at 80% 80%, rgba(255,255,255,0.08) 0%, transparent 50%);
    }

    .brand-content { position: relative; z-index: 1; }
    .brand-logo {
        width: 56px; height: 56px;
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,255,255,0.2);
        margin-bottom: 1.25rem;
    }
    .brand-title {
        font-size: 1.75rem; font-weight: 800; color: white;
        letter-spacing: -0.02em; margin: 0;
    }
    .brand-subtitle {
        color: rgba(191, 219, 254, 0.9); font-size: 0.875rem;
        margin-top: 0.25rem; margin-bottom: 2rem;
    }

    .brand-features { display: flex; flex-direction: column; gap: 0.875rem; }
    .feature-item {
        display: flex; align-items: center; gap: 0.75rem;
        color: rgba(224, 231, 255, 0.9); font-size: 0.8125rem;
    }
    .feature-icon {
        width: 28px; height: 28px;
        background: rgba(255,255,255,0.12);
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .feature-icon svg { color: #93c5fd; }

    /* Brand Steps */
    .brand-steps {
        position: relative; z-index: 1;
        display: flex; flex-direction: column; gap: 1.75rem;
        padding-left: 1rem; margin-top: 2.5rem;
    }
    .step-line {
        position: absolute; left: calc(1rem + 13px); top: 28px; bottom: 28px;
        width: 2px; background: rgba(255,255,255,0.15); border-radius: 1px;
    }
    .step-line-fill {
        width: 100%; background: rgba(255,255,255,0.7); border-radius: 1px;
        transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .step-marker {
        display: flex; align-items: center; gap: 0.875rem;
        position: relative; z-index: 1;
    }
    .step-dot {
        width: 28px; height: 28px; border-radius: 50%;
        background: rgba(255,255,255,0.12); border: 2px solid rgba(255,255,255,0.2);
        display: flex; align-items: center; justify-content: center;
        font-size: 0.75rem; font-weight: 700; color: rgba(255,255,255,0.5);
        transition: all 0.3s ease;
    }
    .step-marker.active .step-dot {
        background: white; color: #4338ca; border-color: white;
        box-shadow: 0 0 0 4px rgba(255,255,255,0.2);
    }
    .step-marker.completed .step-dot {
        background: #34d399; color: white; border-color: #34d399;
    }
    .step-label {
        font-size: 0.8125rem; font-weight: 600;
        color: rgba(255,255,255,0.5);
        transition: color 0.3s ease;
    }
    .step-marker.active .step-label,
    .step-marker.completed .step-label { color: white; }

    /* ===== Form Panel (Right) ===== */
    .form-panel {
        flex: 1; padding: 2.5rem;
        display: flex; flex-direction: column;
        min-height: 580px;
    }

    /* Mobile Steps (hidden on desktop) */
    .mobile-steps { display: none; margin-bottom: 1.5rem; }
    .mobile-step-bar {
        display: flex; align-items: center; justify-content: center; gap: 0;
    }
    .mobile-step-dot {
        width: 28px; height: 28px; border-radius: 50%;
        background: #e5e7eb; color: #9ca3af;
