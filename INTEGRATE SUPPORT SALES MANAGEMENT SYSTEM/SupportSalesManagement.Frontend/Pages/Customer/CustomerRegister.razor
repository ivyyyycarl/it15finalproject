    .form-input.has-error { border-color: #fca5a5; }
    .form-input.has-error:focus { border-color: #ef4444; box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08); }

    .form-select.has-value { border-color: #a7f3d0; }

    .input-check {
        position: absolute; right: 14px;
        display: flex; align-items: center;
