    .step-hidden { display: none !important; }

    .step-header { margin-bottom: 1.75rem; }
    .step-title {
        font-size: 1.375rem; font-weight: 800; color: #1e1b4b;
        margin: 0; letter-spacing: -0.02em;
    }
    .step-description {
        font-size: 0.875rem; color: #6b7280;
        margin: 0.375rem 0 0;
    }

    /* ===== Form Fields ===== */
    .form-group { margin-bottom: 1.25rem; }
    .form-label {
        display: block; font-size: 0.8125rem; font-weight: 600;
        color: #374151; margin-bottom: 0.5rem;
    }
    .required { color: #ef4444; }

    .input-wrapper {
        position: relative; display: flex; align-items: center;
    }
    .input-icon {
        position: absolute; left: 14px; color: #9ca3af;
        display: flex; align-items: center; pointer-events: none;
        transition: color 0.2s ease; z-index: 1;
    }
    .form-input, .form-select {
        width: 100%; padding: 0.8125rem 0.875rem 0.8125rem 2.875rem;
        border: 2px solid #e5e7eb; border-radius: 14px;
        font-size: 0.9375rem; color: #111827;
        background: white;
        outline: none;
        transition: all 0.2s ease;
    }
    .form-input::placeholder { color: #c4c8cf; }
    .form-input:focus, .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.08);
    }
    .form-input:focus ~ .input-icon,
    .form-input:focus + .input-icon,
