    </div>
</div>

@code {
    private List<Ticket> tickets = new();
    private Ticket? selectedTicket;
    private bool isLoading = true;
    private bool showCreateForm = false;
    private bool isSubmitting = false;
    private int currentUserId = 0;
    private int currentCustomerId = 0;
    private string searchQuery = "";
    private string filterStatus = "";
    private string replyMessage = "";

    private string newTicketTitle = "";
    private string newTicketDescription = "";
    private string newTicketCategory = "General";
    private string newTicketPriority = "Medium";
    private string ticketNotification = "";
    private bool isTicketNotificationError = false;
    private string createTicketFeedback = "";
    private bool isCreateTicketError = false;
    private HubConnection? supportCallHub;
    private DotNetObjectReference<CustomerSupport>? supportCallDotNetRef;
    private string? supportCallId;
    private bool isSupportRealtimeReady;
    private bool isCallingAgent;
    private bool isWebRTCSupported;
    private bool isSupportCallActive;
    private bool supportCallError;
    private string supportCallMessage = "";
    private int onlineAgentCount;
    private int availableAgentCount;
    private List<Call> supportCallHistory = new();
    private Call? selectedSupportCall;

    private IEnumerable<Ticket> FilteredTickets => tickets
        .Where(t => string.IsNullOrWhiteSpace(searchQuery) ||
            (t.Title ?? string.Empty).Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.Description ?? string.Empty).Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            (t.TicketNumber ?? string.Empty).Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(t => string.IsNullOrWhiteSpace(filterStatus) || string.Equals(t.Status, filterStatus, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.CreatedAt);

    protected override async Task OnInitializedAsync()
    {
        var user = await ApiClient.GetCurrentUserAsync();
        if (user != null)
        {
            currentUserId = user.Id;
            var customer = await ApiClient.GetCustomerByUserIdAsync(currentUserId);
            
            if (customer == null)
            {
                // Try to get first available branch for auto-assignment
                var branches = await ApiClient.GetBranchesAsync();
                int? autoBranchId = branches?.FirstOrDefault()?.Id;

                var newCustomer = await ApiClient.CreateCustomerAsync(new CreateCustomerRequest
                {
                    FirstName = user.FirstName,
                    LastName = user.LastName,
                    Email = user.Email,
                    Phone = "",
                    UserId = user.Id,
                    CustomerType = "Individual",
                    BranchId = autoBranchId
                });
                if (newCustomer != null)
                {
                    customer = newCustomer;
                }
            }
            
            if (customer != null)
            {
                currentCustomerId = customer.Id;
                await LoadTickets();
                await LoadSupportCallHistoryAsync();
            }
        }

        await InitializeSupportCallRealtimeAsync();
        isLoading = false;
    }

    private async Task InitializeSupportCallRealtimeAsync()
    {
        if (currentUserId <= 0)
        {
            return;
        }

        supportCallDotNetRef = DotNetObjectReference.Create(this);

        var supportHubUri = new Uri(HttpClient.BaseAddress!, "hubs/support-call");

        supportCallHub = new HubConnectionBuilder()
            .WithUrl(supportHubUri)
            .WithAutomaticReconnect()
            .Build();

        supportCallHub.Reconnected += async _ =>
        {
            try
            {
                await supportCallHub.InvokeAsync("RegisterUser", currentUserId, "Customer", "Customer");
                isSupportRealtimeReady = await JSRuntime.InvokeAsync<bool>("supportCall.isSupported");
                supportCallError = false;
                supportCallMessage = "Realtime support connection restored.";
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                supportCallError = true;
                supportCallMessage = $"Realtime reconnect failed: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        };

        supportCallHub.Closed += async _ =>
        {
            isSupportRealtimeReady = false;
            if (isCallingAgent || isSupportCallActive)
            {
                supportCallError = true;
                supportCallMessage = "Support call connection was lost. Please try again.";
                isCallingAgent = false;
                isSupportCallActive = false;
            }

            await InvokeAsync(StateHasChanged);
        };

        supportCallHub.On<string, int, string>("SupportCallAccepted", async (callId, agentUserId, agentName) =>
        {
            if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            supportCallMessage = $"Connected to {agentName}. You can talk now.";
            supportCallError = false;
            isSupportCallActive = true;
            isCallingAgent = false;
            await InvokeAsync(StateHasChanged);

            try
            {
                await JSRuntime.InvokeVoidAsync("supportCall.initCall", callId, "customer-support-remote-audio", supportCallDotNetRef);
                var offerJson = await JSRuntime.InvokeAsync<string>("supportCall.createOffer", callId);
                await supportCallHub.InvokeAsync("SendOffer", callId, offerJson);
            }
            catch (Exception ex)
            {
                supportCallError = true;
                supportCallMessage = $"Unable to start voice stream: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        });

        supportCallHub.On<string, string>("SupportCallDeclined", async (callId, reason) =>
        {
            if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            supportCallError = true;
            supportCallMessage = string.IsNullOrWhiteSpace(reason) ? "No agent accepted your call." : reason;
            isCallingAgent = false;
            isSupportCallActive = false;
            await CleanupSupportCallAsync(callId, false);
            await LoadSupportCallHistoryAsync();
            await InvokeAsync(StateHasChanged);
        });

        supportCallHub.On<string, string>("ReceiveAnswer", async (callId, answerJson) =>
        {
            if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("supportCall.setRemoteAnswer", callId, answerJson);
        });

        supportCallHub.On<string, string>("ReceiveIceCandidate", async (callId, candidateJson) =>
        {
            if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("supportCall.addIceCandidate", callId, candidateJson);
        });

        supportCallHub.On<string, string>("SupportCallEnded", async (callId, reason) =>
        {
            if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            supportCallError = false;
            supportCallMessage = string.IsNullOrWhiteSpace(reason) ? "Call ended." : reason;
            isCallingAgent = false;
            isSupportCallActive = false;
            await CleanupSupportCallAsync(callId, false);
            await LoadSupportCallHistoryAsync();
            await InvokeAsync(StateHasChanged);
        });

        supportCallHub.On<int, int>("SupportAvailabilityChanged", async (onlineAgents, availableAgents) =>
        {
            onlineAgentCount = Math.Max(0, onlineAgents);
            availableAgentCount = Math.Max(0, availableAgents);
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await supportCallHub.StartAsync();
            await supportCallHub.InvokeAsync("RegisterUser", currentUserId, "Customer", "Customer");
            var availability = await supportCallHub.InvokeAsync<SupportAvailabilitySnapshot>("GetSupportAvailability");
            onlineAgentCount = Math.Max(0, availability?.OnlineAgents ?? 0);
            availableAgentCount = Math.Max(0, availability?.AvailableAgents ?? 0);
            var iceServers = await ApiClient.GetSupportIceServersAsync();
            if (iceServers is { Count: > 0 })
            {
                await JSRuntime.InvokeVoidAsync("supportCall.setIceServers", iceServers);
            }
            isWebRTCSupported = await JSRuntime.InvokeAsync<bool>("supportCall.isSupported");
            isSupportRealtimeReady = true; // SignalR connected
            
            if (!isWebRTCSupported)
            {
                supportCallMessage = "Dashboard connected. Note: Microphone/Voice is disabled on insecure HTTP.";
            }
            else
            {
                supportCallMessage = "Realtime connection ready.";
            }
        }
        catch (Exception ex)
        {
            isSupportRealtimeReady = false;
            supportCallError = true;
            supportCallMessage = $"Connection failed: {ex.Message}";
            if (!NavigationManager.Uri.StartsWith("https://", StringComparison.OrdinalIgnoreCase) && !NavigationManager.Uri.Contains("localhost"))
            {
                supportCallMessage += " (HTTPS is required for voice calls)";
            }
        }
    }

    private async Task StartSupportVoiceCallAsync()
    {
        if (isCallingAgent || isSupportCallActive)
        {
            return;
        }

        if (supportCallHub == null || supportCallHub.State != HubConnectionState.Connected || currentUserId <= 0)
        {
            supportCallError = true;
            supportCallMessage = "Realtime call service is unavailable. Please refresh and try again.";
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Start a live support call with an available agent?");
        if (!confirm)
        {
            return;
        }

        isCallingAgent = true;
        supportCallError = false;
        supportCallMessage = "Calling support agent...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var customerName = "Customer";
            var ticketId = selectedTicket?.Id;
            supportCallId = await supportCallHub.InvokeAsync<string>("StartSupportCall", currentUserId, customerName, ticketId);
        }
        catch (HubException ex)
        {
            isCallingAgent = false;
            supportCallError = true;
            supportCallMessage = ex.Message;
        }
        catch (Exception ex)
        {
            isCallingAgent = false;
            supportCallError = true;
            supportCallMessage = $"Unable to start support call: {ex.Message}";
        }
    }

    private async Task EndSupportVoiceCallAsync()
    {
        if (string.IsNullOrWhiteSpace(supportCallId))
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "End this live support call now?");
        if (!confirmed)
        {
            return;
        }

        if (supportCallHub != null && supportCallHub.State == HubConnectionState.Connected)
        {
            await supportCallHub.InvokeAsync("EndSupportCall", supportCallId, "Call ended by customer.");
        }

        await CleanupSupportCallAsync(supportCallId, true);
        supportCallMessage = "Call ended.";
        supportCallError = false;
        isCallingAgent = false;
        isSupportCallActive = false;
        await LoadSupportCallHistoryAsync();
    }

    [JSInvokable]
    public async Task OnIceCandidateGenerated(string callId, string candidateJson)
    {
        if (supportCallHub == null || supportCallHub.State != HubConnectionState.Connected)
        {
            return;
        }

        if (!string.Equals(callId, supportCallId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await supportCallHub.InvokeAsync("SendIceCandidate", callId, candidateJson);
    }

    private async Task CleanupSupportCallAsync(string? callIdToCleanup, bool clearId)
    {
        if (!string.IsNullOrWhiteSpace(callIdToCleanup))
        {
            await JSRuntime.InvokeVoidAsync("supportCall.endCall", callIdToCleanup);
        }

        if (clearId)
        {
            supportCallId = null;
        }
    }

    private async Task LoadTickets()
    {
        if (currentCustomerId > 0)
        {
            var result = await ApiClient.GetTicketsByCustomerAsync(currentCustomerId);
            if (result != null)
            {
                tickets = result;
            }
        }
    }

    private async Task LoadSupportCallHistoryAsync()
    {
        if (currentCustomerId <= 0)
        {
            supportCallHistory = new();
            return;
        }

        var calls = await ApiClient.GetCallsByCustomerAsync(currentCustomerId) ?? new();
        supportCallHistory = calls
            .Where(IsSupportVoiceCall)
            .OrderByDescending(c => c.StartTime)
            .Take(5)
            .ToList();
    }

    private void ViewSupportCall(Call call)
    {
        selectedSupportCall = call;
    }

    private static int? GetRelatedTicketId(Call call)
    {
        if (string.IsNullOrWhiteSpace(call.Notes))
        {
            return null;
        }

        const string marker = "Related ticket ID:";
        var idx = call.Notes.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (idx < 0)
        {
            return null;
        }

        var raw = call.Notes[(idx + marker.Length)..].Trim();
        var digits = new string(raw.TakeWhile(char.IsDigit).ToArray());
        return int.TryParse(digits, out var id) ? id : null;
    }

    private async Task OpenRelatedTicketAsync(int ticketId)
    {
        var ticket = await ApiClient.GetTicketAsync(ticketId);
        if (ticket != null)
        {
            selectedSupportCall = null;
            selectedTicket = ticket;
        }
    }

    private static bool IsSupportVoiceCall(Call call)
    {
        var subject = call.Subject ?? string.Empty;
        var notes = call.Notes ?? string.Empty;
        return subject.Contains("support voice", StringComparison.OrdinalIgnoreCase)
            || notes.Contains("voice follow-up", StringComparison.OrdinalIgnoreCase)
            || subject.Contains("support call", StringComparison.OrdinalIgnoreCase);
    }

    private async Task ViewTicket(Ticket ticket)
    {
        // Fetch full ticket details with comments
        var fullTicket = await ApiClient.GetTicketAsync(ticket.Id);
        if (fullTicket != null)
        {
            selectedTicket = fullTicket;
        }
        else
        {
            selectedTicket = ticket;
        }
    }

    private async Task CreateTicket()
    {
        ticketNotification = "";
        isTicketNotificationError = false;
        createTicketFeedback = "";
        isCreateTicketError = false;

        if (string.IsNullOrWhiteSpace(newTicketTitle) || string.IsNullOrWhiteSpace(newTicketDescription))
        {
            createTicketFeedback = "Please fill in all required fields.";
            isCreateTicketError = true;
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Submit this support ticket?");
        if (!confirmed)
        {
            return;
        }

        isSubmitting = true;
        createTicketFeedback = "Submitting your ticket...";
        try
        {
            if (currentCustomerId <= 0)
            {
                createTicketFeedback = "Customer profile is not ready yet. Please refresh the page and try again.";
                isCreateTicketError = true;
                return;
            }

            var request = new CreateTicketRequest
            {
                Title = newTicketTitle,
                Description = newTicketDescription,
                CustomerId = currentCustomerId,
                Category = newTicketCategory,
                Priority = newTicketPriority
            };

            var (result, errorMessage) = await ApiClient.CreateTicketWithErrorAsync(request);
            if (result != null)
            {
                showCreateForm = false;
                newTicketTitle = "";
                newTicketDescription = "";
                newTicketCategory = "General";
                newTicketPriority = "Medium";
                createTicketFeedback = "";

                // Optimistic UI update, then reload from API.
                tickets.Insert(0, result);
                ticketNotification = $"Ticket {result.TicketNumber} submitted successfully.";
                isTicketNotificationError = false;

                try
                {
                    await LoadTickets();
                }
                catch
                {
                    // Keep optimistic list/message even if refresh fails.
                }
            }
            else
            {
                createTicketFeedback = string.IsNullOrWhiteSpace(errorMessage)
                    ? "Failed to create ticket. Please try again."
                    : errorMessage;
                isCreateTicketError = true;
            }
        }
        catch (Exception ex)
        {
            createTicketFeedback = $"Error: {ex.Message}";
            isCreateTicketError = true;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SendReply()
    {
        if (selectedTicket == null || string.IsNullOrWhiteSpace(replyMessage)) return;

        var message = replyMessage.Trim();
        var request = new AddCommentRequest
        {
            Comment = message,
            IsInternal = false
        };

        var created = await ApiClient.AddTicketCommentWithResultAsync(selectedTicket.Id, request);
        if (created != null)
        {
            replyMessage = "";

            // Optimistic append so the sender sees the new chat immediately.
            selectedTicket.Comments ??= new List<TicketComment>();
            selectedTicket.Comments.Add(created);

            // Reload in background to keep full server state consistent.
            var updated = await ApiClient.GetTicketAsync(selectedTicket.Id);
            if (updated != null)
            {
                selectedTicket = updated;
            }
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", "Failed to send message. Please try again.");
        }
    }

    private async Task HandleReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(replyMessage))
        {
            await SendReply();
        }
    }

    private string GetStatusBarColor(string status) => status switch
    {
        "Open" => "bg-yellow-500",
        "InProgress" => "bg-blue-500",
        "PendingCustomer" => "bg-orange-500",
        "Resolved" => "bg-green-500",
        "Closed" => "bg-gray-400",
        "Reopened" => "bg-red-500",
        _ => "bg-gray-300"
    };

    private string GetStatusBadge(string status) => status switch
    {
        "Open" => "px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold rounded-full",
        "InProgress" => "px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full",
        "PendingCustomer" => "px-3 py-1 bg-orange-100 text-orange-800 text-xs font-bold rounded-full",
        "Resolved" => "px-3 py-1 bg-green-100 text-green-800 text-xs font-bold rounded-full",
        "Closed" => "px-3 py-1 bg-gray-100 text-gray-600 text-xs font-bold rounded-full",
        "Reopened" => "px-3 py-1 bg-red-100 text-red-800 text-xs font-bold rounded-full",
        _ => "px-3 py-1 bg-gray-100 text-gray-600 text-xs font-bold rounded-full"
    };

    private string GetPriorityBadge(string priority) => priority switch
    {
        "Critical" => "px-2 py-0.5 bg-red-100 text-red-700 text-[10px] font-bold rounded-full",
        "High" => "px-2 py-0.5 bg-orange-100 text-orange-700 text-[10px] font-bold rounded-full",
        "Medium" => "px-2 py-0.5 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-full",
        "Low" => "px-2 py-0.5 bg-gray-100 text-gray-600 text-[10px] font-bold rounded-full",
        _ => "px-2 py-0.5 bg-gray-100 text-gray-600 text-[10px] font-bold rounded-full"
    };

    private static string GetCallStatusBadgeClass(string status) => status switch
    {
        "Completed" => "bg-emerald-100 text-emerald-700",
        "InProgress" => "bg-blue-100 text-blue-700",
        "Missed" => "bg-rose-100 text-rose-700",
        "Cancelled" => "bg-gray-100 text-gray-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string GetCallStatusDotClass(string status) => status switch
    {
        "Completed" => "bg-emerald-500",
        "InProgress" => "bg-blue-500",
        "Missed" => "bg-rose-500",
        "Cancelled" => "bg-gray-400",
        _ => "bg-gray-400"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(supportCallId) && supportCallHub != null && supportCallHub.State == HubConnectionState.Connected)
            {
                await supportCallHub.InvokeAsync("EndSupportCall", supportCallId, "Call ended.");
            }
        }
        catch
        {
            // ignore dispose-time failures
        }

        if (!string.IsNullOrWhiteSpace(supportCallId))
        {
            await CleanupSupportCallAsync(supportCallId, true);
        }

        if (supportCallHub != null)
        {
            await supportCallHub.DisposeAsync();
        }

        supportCallDotNetRef?.Dispose();
    }

    private sealed class SupportAvailabilitySnapshot
    {
        public int OnlineAgents { get; set; }
        public int AvailableAgents { get; set; }
    }
}
