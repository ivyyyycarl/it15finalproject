@page "/customer/support"
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.SignalR
@inject NavigationManager NavigationManager
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

@layout CustomerLayout
@implements IAsyncDisposable

<PageTitle>Support Center - ClassicFit</PageTitle>

<div class="customer-theme min-h-screen bg-gradient-to-br from-[#f8fbff] via-[#f4f8ff] to-[#eef5ff] font-sans text-gray-900">
    <div class="w-full px-0 py-2">
        <div class="rounded-2xl border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-4 shadow-sm mb-3 max-w-5xl">
            <div class="flex items-center text-sm text-gray-500 mb-2">
                <a href="/customer/dashboard" class="hover:text-gray-900">Home</a>
                <span class="mx-2">&gt;</span>
                <span class="text-gray-900 font-medium">Support</span>
            </div>
            <h1 class="text-[21px] font-extrabold text-gray-900">Support Center</h1>
            <div class="mt-1.5 flex flex-wrap items-center justify-between gap-2">
                <p class="text-gray-600">Track your tickets or submit a new request.</p>
                <button @onclick="() => showCreateForm = true"
                        class="bg-blue-600 text-white px-3.5 py-2 rounded-lg text-sm font-bold hover:bg-blue-700 transition-colors shadow-md shadow-blue-200 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                    Create New Ticket
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(ticketNotification))
        {
            <div class="mb-6 rounded-xl border px-4 py-3 text-sm font-medium @(isTicketNotificationError ? "bg-red-50 border-red-200 text-red-700" : "bg-green-50 border-green-200 text-green-700")">
                @ticketNotification
            </div>
        }

        @if (isLoading)
        {
            <div class="flex justify-center py-20">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600"></div>
            </div>
        }
        else
        {
            <!-- Create Ticket Modal -->
            @if (showCreateForm)
            {
                <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" @onclick="() => showCreateForm = false">
                    <div class="bg-white rounded-2xl p-8 max-w-lg w-full shadow-2xl" @onclick:stopPropagation="true">
                        <h2 class="text-xl font-bold text-gray-900 mb-6">Create New Support Ticket</h2>

                        @if (!string.IsNullOrWhiteSpace(createTicketFeedback))
                        {
                            <div class="mb-4 rounded-lg border px-3 py-2 text-sm @(isCreateTicketError ? "bg-red-50 border-red-200 text-red-700" : "bg-blue-50 border-blue-200 text-blue-700")">
                                @createTicketFeedback
                            </div>
                        }
                        
                        <div class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Title</label>
                                <input type="text" @bind="newTicketTitle"
                                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none"
                                    placeholder="Brief summary of your issue" />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                                <select @bind="newTicketCategory"
                                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                                    <option value="General">General</option>
                                    <option value="Technical">Technical</option>
                                    <option value="Billing">Billing</option>
                                    <option value="Account">Account</option>
                                    <option value="Product">Product</option>
                                    <option value="Service">Service</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Priority</label>
                                <select @bind="newTicketPriority"
                                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none">
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                                <textarea @bind="newTicketDescription" rows="4"
                                    class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none resize-none"
                                    placeholder="Describe your issue in detail..."></textarea>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-6">
                            <button @onclick="() => showCreateForm = false" disabled="@isSubmitting"
                                class="px-5 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium">
                                Cancel
                            </button>
                            <button @onclick="CreateTicket" disabled="@isSubmitting"
                                class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium disabled:opacity-50 min-w-[120px]">
                                @(isSubmitting ? "Submitting..." : "Submit Ticket")
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Ticket Detail View -->
            @if (selectedTicket != null)
            {
                <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" @onclick="() => selectedTicket = null">
                    <div class="bg-white rounded-2xl max-w-2xl w-full shadow-2xl max-h-[80vh] flex flex-col" @onclick:stopPropagation="true">
                        <div class="p-6 border-b border-gray-100">
                            <div class="flex justify-between items-start">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="text-xs font-semibold text-gray-500 uppercase">@selectedTicket.Category</span>
                                        <span class="@GetStatusBadge(selectedTicket.Status)">@selectedTicket.Status</span>
                                        <span class="@GetPriorityBadge(selectedTicket.Priority)">@selectedTicket.Priority</span>
                                    </div>
                                    <h2 class="text-xl font-bold text-gray-900">@selectedTicket.Title</h2>
                                    <p class="text-sm text-gray-500 mt-1">Ticket #@selectedTicket.TicketNumber - Created @selectedTicket.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                    @if (selectedTicket.AssignedAgent != null)
                                    {
                                        <p class="text-sm text-blue-600 mt-1 flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                            Assigned to: @selectedTicket.AssignedAgent.FirstName @selectedTicket.AssignedAgent.LastName
                                        </p>
                                    }
                                    else if (!string.IsNullOrEmpty(selectedTicket.AssignedTo))
                                    {
                                        <p class="text-sm text-blue-600 mt-1 flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                            </svg>
                                            Assigned to: @selectedTicket.AssignedTo
                                        </p>
                                    }
                                </div>
                                <button @onclick="() => selectedTicket = null" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="flex-1 overflow-y-auto p-6 space-y-4">
                            <div class="bg-gray-50 rounded-xl p-4">
                                <p class="text-sm text-gray-700 leading-relaxed">@selectedTicket.Description</p>
                            </div>

                            @if ((selectedTicket.Comments?.Any() ?? false))
                            {
                                <h4 class="font-semibold text-gray-800 text-sm">Conversation</h4>
                                @foreach (var comment in (selectedTicket.Comments ?? new List<TicketComment>()).OrderBy(c => c.CreatedAt))
                                {
                                    <div class="@(comment.UserId != currentUserId ? "bg-blue-50 border-blue-100" : "bg-gray-50 border-gray-100") border rounded-xl p-4">
                                        <div class="flex justify-between items-center mb-2">
                                            <span class="text-xs font-semibold @(comment.UserId != currentUserId ? "text-blue-700" : "text-gray-700")">
                                                @(comment.User?.FirstName ?? (comment.UserId != currentUserId ? "Support Agent" : "You"))
                                            </span>
                                            <span class="text-xs text-gray-400">@comment.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                        </div>
                                        <p class="text-sm text-gray-700">@comment.Comment</p>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Reply Section -->
                        <div class="p-4 border-t border-gray-100">
                            <div class="flex gap-2">
                                <input type="text" @bind="replyMessage" @bind:event="oninput" @onkeydown="HandleReplyKeyDown"
                                    class="flex-1 border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none text-sm"
                                    placeholder="Type your message to the agent..." />
                                <button @onclick="SendReply" disabled="@(string.IsNullOrWhiteSpace(replyMessage))"
                                    class="px-4 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 font-medium text-sm">
                                    Send
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (selectedSupportCall != null)
            {
                <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" @onclick="() => selectedSupportCall = null">
                    <div class="bg-white rounded-2xl max-w-xl w-full shadow-2xl max-h-[80vh] overflow-y-auto" @onclick:stopPropagation="true">
                        <div class="p-6 border-b border-gray-100">
                            <div class="flex items-center justify-between">
                                <h2 class="text-xl font-bold text-gray-900">Support Call Details</h2>
                                <button @onclick="() => selectedSupportCall = null" class="text-gray-400 hover:text-gray-600">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="p-6 space-y-4 text-sm">
                            <div class="grid grid-cols-2 gap-3">
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Agent</p>
                                    <p class="font-semibold text-gray-900">@(string.IsNullOrWhiteSpace(selectedSupportCall.AgentName) ? "Support Agent" : selectedSupportCall.AgentName)</p>
                                </div>
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Status</p>
                                    <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold @GetCallStatusBadgeClass(selectedSupportCall.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full @GetCallStatusDotClass(selectedSupportCall.Status)"></span>
                                        @selectedSupportCall.Status
                                    </span>
                                </div>
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Started</p>
                                    <p class="font-semibold text-gray-900">@selectedSupportCall.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</p>
                                </div>
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Ended</p>
                                    <p class="font-semibold text-gray-900">@(selectedSupportCall.EndTime.HasValue ? selectedSupportCall.EndTime.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss") : "Ongoing / Not recorded")</p>
                                </div>
                            </div>

                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Duration</p>
                                <p class="font-semibold text-gray-900">@selectedSupportCall.DurationFormatted</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(selectedSupportCall.Subject))
                            {
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Subject</p>
                                    <p class="text-gray-800">@selectedSupportCall.Subject</p>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(selectedSupportCall.Outcome))
                            {
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Outcome</p>
                                    <p class="text-gray-800">@selectedSupportCall.Outcome</p>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(selectedSupportCall.Notes))
                            {
                                <div class="rounded-lg border border-gray-200 p-3">
                                    <p class="text-xs text-gray-500 font-semibold uppercase mb-1">Notes</p>
                                    <p class="text-gray-800 whitespace-pre-wrap">@selectedSupportCall.Notes</p>
                                </div>
                            }

                            @if (GetRelatedTicketId(selectedSupportCall) is int relatedTicketId)
                            {
                                <div class="pt-1">
                                    <button @onclick="() => OpenRelatedTicketAsync(relatedTicketId)"
                                            class="rounded-lg bg-blue-600 text-white px-4 py-2 text-sm font-semibold hover:bg-blue-700 transition-colors">
                                        View Related Ticket #@relatedTicketId
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <!-- Ticket List -->
                <div class="lg:col-span-2 space-y-4">
                    <!-- Search & Filter -->
                    <div class="flex gap-3">
                        <div class="relative flex-1">
                            <input type="text" @bind="searchQuery" @bind:event="oninput" placeholder="Search your tickets..."
                                class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none shadow-sm" />
                            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                        <select @bind="filterStatus"
                            class="border border-gray-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-blue-500 outline-none shadow-sm text-sm">
                            <option value="">All Status</option>
                            <option value="Open">Open</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    <!-- Ticket Stats -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2.5">
                        <div class="bg-gradient-to-br from-slate-50 to-white rounded-xl p-4 border border-slate-100 text-center shadow-sm">
                            <div class="text-lg mb-1">📊</div>
                            <p class="text-2xl font-bold text-slate-700">@tickets.Count</p>
                            <p class="text-xs text-slate-500">Total</p>
                        </div>
                        <div class="bg-gradient-to-br from-amber-50 to-white rounded-xl p-4 border border-amber-100 text-center shadow-sm">
                            <div class="text-lg mb-1">🟡</div>
                            <p class="text-2xl font-bold text-yellow-600">@tickets.Count(t => t.Status == "Open")</p>
                            <p class="text-xs text-gray-500">Open</p>
                        </div>
                        <div class="bg-gradient-to-br from-blue-50 to-white rounded-xl p-4 border border-blue-100 text-center shadow-sm">
                            <div class="text-lg mb-1">🔵</div>
                            <p class="text-2xl font-bold text-blue-600">@tickets.Count(t => t.Status == "InProgress")</p>
                            <p class="text-xs text-gray-500">In Progress</p>
                        </div>
                        <div class="bg-gradient-to-br from-emerald-50 to-white rounded-xl p-4 border border-green-100 text-center shadow-sm">
                            <div class="text-lg mb-1">✅</div>
                            <p class="text-2xl font-bold text-green-600">@tickets.Count(t => t.Status == "Resolved" || t.Status == "Closed")</p>
                            <p class="text-xs text-gray-500">Resolved</p>
                        </div>
                    </div>

                    <!-- Tickets -->
                    @if (FilteredTickets.Any())
                    {
                        @foreach (var ticket in FilteredTickets)
                        {
                            <div @onclick="() => ViewTicket(ticket)"
                                class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 hover:shadow-md transition-shadow relative overflow-hidden group cursor-pointer">
                                <div class="absolute top-0 left-0 w-1 h-full @GetStatusBarColor(ticket.Status)"></div>

                                <div class="flex justify-between items-start mb-4 pl-3">
                                    <div>
                                        <div class="flex items-center gap-2 mb-1">
                                            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">@ticket.Category</span>
                                            <span class="@GetPriorityBadge(ticket.Priority)">@ticket.Priority</span>
                                        </div>
                                        <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                                            @ticket.Title</h3>
                                    </div>
                                    <span class="@GetStatusBadge(ticket.Status)">@ticket.Status</span>
                                </div>

                                <p class="text-gray-600 text-sm mb-4 line-clamp-2 pl-3">@ticket.Description</p>

                                <div class="flex items-center justify-between text-xs text-gray-500 pt-4 border-t border-gray-100 pl-3">
                                    <div class="flex items-center gap-4">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" />
                                            </svg>
                                            @ticket.TicketNumber
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                            @ticket.CreatedAt.ToString("MMM dd, yyyy")
                                        </span>
                                        @if (ticket.AssignedAgent != null)
                                        {
                                            <span class="flex items-center gap-1 text-blue-600">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                                </svg>
                                                @ticket.AssignedAgent.FirstName
                                            </span>
                                        }
                                        @if ((ticket.Comments?.Any() ?? false))
                                        {
                                            <span class="flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                        d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                                                </svg>
                                                @(ticket.Comments?.Count ?? 0) replies
                                            </span>
                                        }
                                    </div>
                                    <span class="text-blue-600 font-semibold hover:underline">View Details</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="bg-white rounded-xl p-12 text-center shadow-sm border border-gray-200">
                            <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                            <p class="text-gray-500 mb-2">No tickets found.</p>
                            <button @onclick="() => showCreateForm = true" class="text-blue-600 font-semibold hover:underline">
                                Create your first support ticket
                            </button>
                        </div>
                    }
                </div>

                <!-- Sidebar -->
                <div class="space-y-6">
                    <audio id="customer-support-remote-audio" autoplay class="hidden"></audio>

                    <div class="bg-white rounded-2xl p-6 border border-blue-200 shadow-sm">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">Live Call Follow-Up</h3>
                        <p class="text-sm text-gray-600 mb-4">Call an available support agent to follow up your product or item order.</p>

                        @if (!string.IsNullOrWhiteSpace(supportCallMessage))
                        {
                            <div class="mb-3 rounded-lg border px-3 py-2 text-xs @(supportCallError ? "bg-red-50 border-red-200 text-red-700" : "bg-blue-50 border-blue-200 text-blue-700")">
                                @supportCallMessage
                            </div>
                        }

                        <div class="flex items-center gap-2 mb-3">
                            <span class="w-2 h-2 rounded-full @(isSupportCallActive ? "bg-emerald-500" : isCallingAgent ? "bg-amber-500" : "bg-gray-400")"></span>
                            <span class="text-xs font-semibold text-gray-600">
                                @(isSupportCallActive ? "Connected to agent" : isCallingAgent ? "Waiting for agent..." : "Idle")
                            </span>
                        </div>

                        <div class="mb-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
                            <div class="flex items-center justify-between gap-3">
                                <span class="text-[11px] font-semibold text-gray-600">Support Agent Availability</span>
                                <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold @(availableAgentCount > 0 ? "text-emerald-700" : "text-rose-700")">
                                    <span class="w-1.5 h-1.5 rounded-full @(availableAgentCount > 0 ? "bg-emerald-500" : "bg-rose-500")"></span>
                                    @(availableAgentCount > 0 ? "Available" : "Unavailable")
                                </span>
                            </div>
                            <p class="mt-1 text-[11px] text-gray-600">
                                @if (!isSupportRealtimeReady)
                                {
                                    <span class="text-rose-600 font-bold">@supportCallMessage</span>
                                }
                                else if (!isWebRTCSupported)
                                {
                                    <span class="text-amber-600 font-bold">Realtime Dashboard Online (Voice calls require HTTPS)</span>
                                }
                                else if (onlineAgentCount <= 0)
                                {
                                    <span>No agents online right now.</span>
                                }
                                else if (availableAgentCount <= 0)
                                {
                                    <span>@onlineAgentCount @(onlineAgentCount == 1 ? "agent is" : "agents are") online, but currently busy.</span>
                                }
                                else
                                {
                                    <span>@availableAgentCount @(availableAgentCount == 1 ? "agent is" : "agents are") available now.</span>
                                }
                            </p>
                        </div>

                        @if (!isSupportCallActive && !isCallingAgent)
                        {
                            <button @onclick="StartSupportVoiceCallAsync"
                                    class="w-full rounded-lg bg-blue-600 text-white px-4 py-2.5 text-sm font-semibold hover:bg-blue-700 transition-colors"
                                    disabled="@(!isSupportRealtimeReady || !isWebRTCSupported || availableAgentCount <= 0)">
                                Call Support Agent
                            </button>
                            @if (!isSupportRealtimeReady || !isWebRTCSupported || availableAgentCount <= 0)
                            {
                                <p class="text-[11px] text-gray-500 mt-2">
                                    @if (!isSupportRealtimeReady)
                                    {
                                        <span>@supportCallMessage</span>
                                    }
                                    else if (!isWebRTCSupported)
                                    {
                                        <span class="text-amber-600 font-semibold">Microphone access is blocked by your browser on HTTP. Voice calls require an HTTPS connection or specific browser configuration.</span>
                                    }
                                    else
                                    {
                                        <span>No available agents at the moment. Please try again shortly.</span>
                                    }
                                </p>
                            }
                        }
                        else
                        {
                            <button @onclick="EndSupportVoiceCallAsync"
                                    class="w-full rounded-lg bg-rose-600 text-white px-4 py-2.5 text-sm font-semibold hover:bg-rose-700 transition-colors">
                                End Call
                            </button>
                        }
                    </div>

                    <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="text-base font-bold text-gray-900">Recent Support Calls</h3>
                            <span class="text-xs font-semibold text-gray-500">Last 5</span>
                        </div>

                        @if (supportCallHistory.Count == 0)
                        {
                            <p class="text-sm text-gray-500">No support calls yet.</p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var call in supportCallHistory)
                                {
                                    <button @onclick="() => ViewSupportCall(call)"
                                            class="w-full text-left rounded-xl border border-gray-100 bg-gradient-to-r from-gray-50 to-white p-3 hover:shadow-sm transition-shadow">
                                        <div class="flex items-center justify-between gap-2">
                                            <p class="text-xs font-semibold text-gray-800 truncate">@(string.IsNullOrWhiteSpace(call.AgentName) ? "Support Agent" : call.AgentName)</p>
                                            <span class="text-[11px] text-gray-500">@call.StartTime.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                        </div>
                                        <div class="mt-1 flex items-center justify-between gap-2">
                                            <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold @GetCallStatusBadgeClass(call.Status)">
                                                <span class="w-1.5 h-1.5 rounded-full @GetCallStatusDotClass(call.Status)"></span>
                                                @call.Status
                                            </span>
                                            <span class="text-[11px] font-semibold text-gray-600">@call.DurationFormatted</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(call.Outcome))
                                        {
                                            <p class="mt-1 text-[11px] text-gray-500 truncate">Outcome: @call.Outcome</p>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Contact Info -->
                    <div class="rounded-2xl p-6 text-white shadow-lg" style="background: linear-gradient(135deg, #1B3A4B 0%, #80A1BA 100%);">
                        <h3 class="text-lg font-bold mb-4">Need Urgent Help?</h3>
                        <p class="text-indigo-100 text-sm mb-6">Our support team is available 24/7 for urgent inquiries.</p>

                        <div class="space-y-4">
