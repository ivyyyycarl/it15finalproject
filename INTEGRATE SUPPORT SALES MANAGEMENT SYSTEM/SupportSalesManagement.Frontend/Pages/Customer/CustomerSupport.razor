                    </div>

                    <!-- FAQ -->
                    <div class="bg-white rounded-2xl p-6 border border-gray-200 shadow-sm">
                        <h3 class="text-lg font-bold text-gray-900 mb-4">Common Questions</h3>
                        <div class="space-y-3">
