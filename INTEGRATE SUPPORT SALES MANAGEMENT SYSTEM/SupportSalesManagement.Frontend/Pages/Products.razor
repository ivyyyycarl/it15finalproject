@page "/products"
@inject ApiClient ApiClient
@implements IDisposable

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject AuthenticationService AuthService

<PageTitle>Products</PageTitle>

<div class="px-4 py-6 sm:px-0">
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="fixed top-4 right-4 z-50 p-4 rounded-lg shadow-lg text-white @(isSuccess ? "bg-green-600" : "bg-red-600") transition-all duration-300">
            <div class="flex items-center gap-2">
                <span>@statusMessage</span>
                <button @onclick="() => statusMessage = null" class="ml-2 text-white/80 hover:text-white">&times;</button>
            </div>
        </div>
    }

    <div class="mb-8">
        <div class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Products</h1>
                <p class="mt-1 text-sm text-gray-600">Manage product catalog and inventory</p>
            </div>
            <div class="flex space-x-3">
                <button @onclick="ShowLowStock"
                    class="bg-yellow-600 hover:bg-yellow-700 text-white font-medium py-2 px-4 rounded-md">
                    Low Stock Alert
                </button>
                @if (CanManageProducts)
                {
                    <button @onclick="ShowCreateModal"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md">
                        Add Product
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Search and Filter -->
    <div class="bg-white shadow rounded-lg mb-6 p-4">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-2">
                <label class="block text-sm font-medium text-gray-700 mb-1">Search Products</label>
                <input type="text" value="@searchTerm" @oninput="OnSearchInput" placeholder="Search by name, SKU, category..."
                    class="block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            </div>
            <div class="flex items-end">
                <button @onclick="SearchProducts"
                    class="bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md w-full">
                    Search
                </button>
            </div>
        </div>
    </div>

    <!-- Products List -->
    <div class="bg-white shadow rounded-lg">
        @if (isLoading)
        {
            <div class="p-8 text-center">
                <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600"></div>
                <p class="mt-2 text-gray-600">Loading products...</p>
            </div>
        }
        else if (filteredProducts == null || filteredProducts.Count == 0)
        {
            <div class="p-8 text-center">
                <p class="text-gray-600">No products found</p>
            </div>
        }
        else
        {
            <div class="overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <button @onclick='() => SetSort("name")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Product <span class="text-[10px]">@GetSortIndicator("name")</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <button @onclick='() => SetSort("sku")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    SKU <span class="text-[10px]">@GetSortIndicator("sku")</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <button @onclick='() => SetSort("category")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Category <span class="text-[10px]">@GetSortIndicator("category")</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <button @onclick='() => SetSort("price")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Price <span class="text-[10px]">@GetSortIndicator("price")</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                <button @onclick='() => SetSort("stock")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Stock <span class="text-[10px]">@GetSortIndicator("stock")</span>
                                </button>
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Stock Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var product in filteredProducts)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div>
                                        <div class="text-sm font-medium text-gray-900">@product.Name</div>
                                        <div class="text-sm text-gray-500 truncate max-w-xs">@product.Description</div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                    @product.SKU
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span
                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                        @product.Category
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 text-right">
                                    ₱@product.Price.ToString("F2")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <span
                                            class="text-sm font-medium @(product.StockQuantity <= 10 ? "text-red-600" : "text-gray-900")">
                                            @product.StockQuantity
                                        </span>
                                        @if (product.StockQuantity <= 10)
                                        {
                                            <svg class="w-4 h-4 text-red-500 ml-2" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                    d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                        }
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Out of Stock</span>
                                    }
                                    else if (product.StockQuantity <= 10)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">In Stock</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span
                                        class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(product.IsActive ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800")">
                                        @(product.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    @if (CanManageProducts)
                                    {
                                        <button @onclick="() => EditProduct(product)"
                                            class="text-indigo-600 hover:text-indigo-900">Edit</button>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400">Read-only</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
                <p class="text-sm text-gray-500">Showing @(filteredProducts.Any() ? (((currentPage - 1) * pageSize) + 1) : 0)-@Math.Min(currentPage * pageSize, totalProductCount) of @totalProductCount products · Page @currentPage/@totalPages</p>
                <div class="flex items-center gap-2">
                    <button @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                        Previous
                    </button>
                    <button @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                        Next
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Edit Product Modal -->
@if (showModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
            <div class="mt-3">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Edit Product</h3>

                <form @onsubmit="SaveProduct">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700">Product Name</label>
                            <input type="text" @bind="editingProduct.Name" required
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">Description</label>
                            <textarea @bind="editingProduct.Description" rows="3"
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"></textarea>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">SKU</label>
                            <input type="text" @bind="editingProduct.SKU" required
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">Category</label>
                            <select @bind="editingProduct.Category"
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                                <option value="TShirt">T-Shirt</option>
                                <option value="Dress">Dress</option>
                                <option value="Jacket">Jacket</option>
                                <option value="Sweater">Sweater</option>
                            </select>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">Price</label>
                            <input type="number" @bind="editingProduct.Price" step="0.01" min="0" required
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700">Stock Quantity</label>
                            <input type="number" @bind="editingProduct.StockQuantity" min="0"
                                class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
                        </div>

                        <div>
                            <label class="flex items-center">
                                <input type="checkbox" @bind="editingProduct.IsActive"
                                    class="rounded border-gray-300 text-indigo-600 shadow-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50" />
                                <span class="ml-2 text-sm text-gray-700">Active Product</span>
                            </label>
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end space-x-3">
                        <button type="button" @onclick="HideModal"
                            class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-medium py-2 px-4 rounded-md">
                            Cancel
                        </button>
                        <button type="submit" disabled="@isSaving"
                            class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md disabled:opacity-50">
                            @(isSaving ? "Saving..." : "Save")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Low Stock Alert Modal -->
@if (showLowStockModal)
{
    <div class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
        <div
            class="relative top-20 mx-auto p-5 border w-full max-w-4xl shadow-lg rounded-md bg-white max-h-screen overflow-y-auto">
            <div class="mt-3">
                <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Low Stock Alert</h3>

                @if (lowStockProducts == null || lowStockProducts.Count == 0)
                {
                    <div class="p-8 text-center">
                        <p class="text-green-600">All products have sufficient stock!</p>
                    </div>
                }
                else
                {
                    <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4 mb-4">
                        <p class="text-yellow-800">
                            <strong>@lowStockProducts.Count</strong> products are running low on stock (≤10 units).
                        </p>
                    </div>

                    <div class="overflow-hidden">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Product</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        SKU</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        Current Stock</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                        @(CanManageProducts ? "Actions" : "Access")</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var product in lowStockProducts)
                                {
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@product.Name</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@product.SKU</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="text-sm font-medium text-red-600">@product.StockQuantity</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                            @if (CanManageProducts)
                                            {
                                                <button @onclick="() => EditProductFromLowStock(product)"
                                                    class="text-indigo-600 hover:text-indigo-900">Update Stock</button>
                                            }
                                            else
                                            {
                                                <span class="text-slate-400">Read-only</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="mt-6 flex justify-end">
                    <button @onclick="HideLowStockModal"
                        class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-medium py-2 px-4 rounded-md">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Product> products = new();
    private List<Product> filteredProducts = new();
    private List<Product> lowStockProducts = new();
    private Product editingProduct = new();
    private string searchTerm = "";
    private bool isLoading = true;
    private bool showModal = false;
    private bool showLowStockModal = false;
    private bool isSaving = false;
    private string? statusMessage;
    private bool isSuccess;
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages = 1;
    private int totalProductCount = 0;
    private string sortBy = "name";
    private string sortDir = "asc";
    private CancellationTokenSource? _searchDebounceCts;
    private bool CanManageProducts =>
        AuthService.CurrentUser?.Role == UserRole.Admin ||
        AuthService.CurrentUser?.Role == UserRole.SuperAdmin;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        isLoading = true;
        try
        {
            var paged = await ApiClient.GetProductsPagedAsync(currentPage, pageSize, searchTerm, sortBy: sortBy, sortDir: sortDir);
            products = paged?.Items ?? new List<Product>();
            filteredProducts = products;
            totalProductCount = paged?.TotalCount ?? products.Count;
            totalPages = Math.Max(1, paged?.TotalPages ?? 1);
            lowStockProducts = products.Where(p => p.StockQuantity <= 10).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading products: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchProducts()
    {
        currentPage = 1;
        await LoadProducts();
    }

    private async Task SetSort(string field)
    {
        if (string.Equals(sortBy, field, StringComparison.OrdinalIgnoreCase))
        {
            sortDir = sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            sortBy = field;
            sortDir = "asc";
        }

        await SearchProducts();
    }

    private string GetSortIndicator(string field)
    {
        if (!string.Equals(sortBy, field, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return sortDir == "asc" ? "ASC" : "DESC";
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        await DebouncedSearchProductsAsync();
    }

    private async Task DebouncedSearchProductsAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            await SearchProducts();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await LoadProducts();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await LoadProducts();
    }

    private void ShowCreateModal()
    {
        if (!CanManageProducts)
        {
            return;
        }

        editingProduct = new Product { IsActive = true };
        showModal = true;
    }

    private void EditProduct(Product product)
    {
        if (!CanManageProducts)
        {
            return;
        }

        editingProduct = new Product
            {
                Id = product.Id,
                Name = product.Name,
                Description = product.Description,
                SKU = product.SKU,
                Category = product.Category,
                Price = product.Price,
                StockQuantity = product.StockQuantity,
                IsActive = product.IsActive
            };
        showModal = true;
    }

    private void EditProductFromLowStock(Product product)
    {
        if (!CanManageProducts)
        {
            return;
        }

        HideLowStockModal();
        EditProduct(product);
    }

    private void HideModal()
    {
        showModal = false;
        editingProduct = new Product();
    }

    private void ShowLowStock()
    {
        showLowStockModal = true;
    }

    private void HideLowStockModal()
    {
        showLowStockModal = false;
    }

    private async Task ShowStatus(string message, bool success)
    {
        statusMessage = message;
        isSuccess = success;
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = null;
        StateHasChanged();
    }

    private async Task SaveProduct()
    {
        if (!CanManageProducts)
        {
            return;
        }

        isSaving = true;
        try
        {
            // Note: This would need to be implemented in the API client
            // For now, we'll just reload the products
            await LoadProducts();
            HideModal();
            _ = ShowStatus("Product saved successfully!", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving product: {ex.Message}");
            _ = ShowStatus("Failed to save product. Please try again.", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
