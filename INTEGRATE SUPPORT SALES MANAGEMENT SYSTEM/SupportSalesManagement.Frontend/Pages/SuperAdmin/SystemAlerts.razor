@page "/superadmin/notifications/alerts"
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject ApiClient ApiClient
@implements IDisposable

<PageTitle>System Alerts - Super Admin</PageTitle>

<div class="space-y-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">System Alerts</h1>
        <p class="text-sm text-gray-500 mt-1">Monitor critical, warning, and informational system alerts.</p>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-24">
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mb-4"></div>
                <p class="text-gray-500">Loading alerts...</p>
            </div>
        </div>
    }
    else
    {
        <!-- Summary cards (click to filter) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <button @onclick='() => SetFilter("All")'
                    class="@GetSummaryCardClass("All") ui-uniform-card h-[158px] p-4 rounded-xl transition-all flex flex-col items-center justify-center text-center gap-1.5">
                <div class="w-10 h-10 rounded-xl bg-gray-100 text-gray-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                </div>
                <p class="text-sm font-semibold text-gray-500">Total Alerts</p>
                <p class="text-3xl font-extrabold text-gray-900 leading-none">@Alerts.Count</p>
                <p class="text-xs text-gray-500 leading-tight max-w-[170px]">All active alerts</p>
            </button>
            <button @onclick='() => SetFilter("Critical")'
                    class="@GetSummaryCardClass("Critical") ui-uniform-card h-[158px] p-4 rounded-xl transition-all flex flex-col items-center justify-center text-center gap-1.5">
                <div class="w-10 h-10 rounded-xl bg-red-100 text-red-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.9 4h13.8c1.5 0 2.5-1.7 1.7-3L13.7 4c-.8-1.3-2.7-1.3-3.5 0L3.3 16c-.8 1.3.2 3 1.7 3z" />
                    </svg>
                </div>
                <p class="text-sm font-semibold text-gray-500">Critical</p>
                <p class="text-3xl font-extrabold text-red-600 leading-none">@CriticalCount</p>
                <p class="text-xs text-gray-500 leading-tight max-w-[170px]">Needs immediate action</p>
            </button>
            <button @onclick='() => SetFilter("Warning")'
                    class="@GetSummaryCardClass("Warning") ui-uniform-card h-[158px] p-4 rounded-xl transition-all flex flex-col items-center justify-center text-center gap-1.5">
                <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <p class="text-sm font-semibold text-gray-500">Warning</p>
                <p class="text-3xl font-extrabold text-amber-600 leading-none">@WarningCount</p>
                <p class="text-xs text-gray-500 leading-tight max-w-[170px]">Monitor and resolve soon</p>
            </button>
            <button @onclick='() => SetFilter("Info")'
                    class="@GetSummaryCardClass("Info") ui-uniform-card h-[158px] p-4 rounded-xl transition-all flex flex-col items-center justify-center text-center gap-1.5">
                <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <p class="text-sm font-semibold text-gray-500">Info</p>
                <p class="text-3xl font-extrabold text-blue-600 leading-none">@InfoCount</p>
                <p class="text-xs text-gray-500 leading-tight max-w-[170px]">General system notices</p>
            </button>
        </div>

        <!-- Alert list -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            @if (!FilteredAlerts.Any())
            {
                <div class="p-12 text-center text-gray-500">
                    <svg class="w-12 h-12 mx-auto text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <p class="font-medium text-gray-700">No alerts</p>
                    <p class="text-sm">No alerts match the current filter.</p>
                </div>
            }
            else
            {
                <ul class="divide-y divide-gray-100">
                    @foreach (var alert in PagedFilteredAlerts)
                    {
                        <li class="p-4 flex items-start gap-4 hover:bg-gray-50/50 transition-colors">
                            <div class="shrink-0 mt-0.5 @GetIconBgClass(alert.Severity)">
                                @if (alert.Severity == "Critical")
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                }
                                else if (alert.Severity == "Warning")
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="font-semibold text-gray-900">@alert.Title</h3>
                                <p class="text-sm text-gray-600 mt-0.5">@alert.Description</p>
                                <p class="text-xs text-gray-400 mt-2">@GetTimeAgo(alert.CreatedAt)</p>
                            </div>
                            <span class="shrink-0 text-xs font-medium @GetSeverityBadgeClass(alert.Severity)">@alert.Severity</span>
                        </li>
                    }
                </ul>
            }
        </div>
        @if (FilteredAlerts.Any())
        {
            <div class="px-1 py-2 border-t border-gray-200 flex items-center justify-between">
                <p class="text-sm text-gray-600">
                    Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, FilteredAlerts.Count()) of @FilteredAlerts.Count() · Page @currentPage/@TotalPages
                </p>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                            class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                            class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                </div>
            </div>
        }
    }
</div>

@code {
    private string Filter = "All";
    private List<SystemAlert> Alerts = new();
    private bool isLoading = true;
    private System.Threading.Timer? refreshTimer;
    private int currentPage = 1;
    private const int pageSize = 15;

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertsAsync();
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await LoadAlertsAsync());
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadAlertsAsync()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var ordersTask = ApiClient.GetOrdersAsync();
            var ticketsTask = ApiClient.GetTicketsAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, ticketsTask, productsTask);

            var orders = await ordersTask ?? new List<Order>();
            var tickets = await ticketsTask ?? new List<Ticket>();
            var products = await productsTask ?? new List<Product>();

            var list = new List<SystemAlert>();

            // Pending orders -> Warning
            var pendingOrders = orders.Where(o => string.Equals(o.Status, "Pending", StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var o in pendingOrders)
            {
                list.Add(new SystemAlert
                {
                    Severity = "Warning",
                    Title = "Pending order",
                    Description = $"Order {o.OrderNumber} from {o.CustomerName} (₱{o.TotalAmount:N2}) is pending.",
                    CreatedAt = o.CreatedAt
                });
            }

            // Escalated/Critical tickets -> Error (Critical)
            var criticalTickets = tickets.Where(t =>
                string.Equals(t.Priority, "Critical", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(t.Status, "Escalated", StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var t in criticalTickets)
            {
                list.Add(new SystemAlert
                {
                    Severity = "Critical",
                    Title = "Critical / escalated ticket",
                    Description = $"{t.TicketNumber}: {t.Title} — {t.CustomerName} (Priority: {t.Priority}).",
                    CreatedAt = t.CreatedAt
                });
            }

            // Open tickets -> Info
            var openTickets = tickets.Where(t =>
                string.Equals(t.Status, "Open", StringComparison.OrdinalIgnoreCase)).ToList();
            foreach (var t in openTickets)
            {
                list.Add(new SystemAlert
                {
                    Severity = "Info",
                    Title = "Open ticket",
                    Description = $"{t.TicketNumber}: {t.Title} — {t.CustomerName}.",
                    CreatedAt = t.CreatedAt
                });
            }

            // Low stock (StockQuantity > 0 and <= 10) -> Warning
            var lowStock = products.Where(p => p.IsActive && p.StockQuantity > 0 && p.StockQuantity <= 10).ToList();
            foreach (var p in lowStock)
            {
                list.Add(new SystemAlert
                {
                    Severity = "Warning",
                    Title = "Low stock",
                    Description = $"{p.Name} has {p.StockQuantity} unit(s) remaining.",
                    CreatedAt = p.CreatedAt
                });
            }

            // Out of stock -> Error (Critical)
            var outOfStock = products.Where(p => p.IsActive && p.StockQuantity <= 0).ToList();
            foreach (var p in outOfStock)
            {
                list.Add(new SystemAlert
                {
                    Severity = "Critical",
                    Title = "Out of stock",
                    Description = $"{p.Name} is out of stock.",
                    CreatedAt = p.CreatedAt
                });
            }

            Alerts = list.OrderByDescending(a => a.CreatedAt).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading alerts: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private int CriticalCount => Alerts.Count(a => a.Severity == "Critical");
    private int WarningCount => Alerts.Count(a => a.Severity == "Warning");
    private int InfoCount => Alerts.Count(a => a.Severity == "Info");

    private IEnumerable<SystemAlert> FilteredAlerts => Filter switch
    {
        "Critical" => Alerts.Where(a => a.Severity == "Critical"),
        "Warning" => Alerts.Where(a => a.Severity == "Warning"),
        "Info" => Alerts.Where(a => a.Severity == "Info"),
        _ => Alerts
    };
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredAlerts.Count() / (double)pageSize));
    private IEnumerable<SystemAlert> PagedFilteredAlerts => FilteredAlerts
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private void SetFilter(string filter)
    {
        Filter = filter;
        currentPage = 1;
    }

    private string GetSummaryCardClass(string filter) => Filter == filter
        ? "bg-gradient-to-b from-blue-50 to-white border-blue-200 shadow-md"
        : "bg-gradient-to-b from-white to-gray-50 border-gray-100 shadow-sm hover:shadow-md hover:border-gray-200";

    private string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds} seconds ago";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} minute{((int)span.TotalMinutes != 1 ? "s" : "")} ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hour{((int)span.TotalHours != 1 ? "s" : "")} ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} day{((int)span.TotalDays != 1 ? "s" : "")} ago";
        return dateTime.ToString("MMM dd, yyyy");
    }

    private string GetIconBgClass(string severity) => severity switch
    {
        "Critical" => "p-2 rounded-lg bg-red-100 text-red-600",
        "Warning" => "p-2 rounded-lg bg-amber-100 text-amber-600",
        "Info" => "p-2 rounded-lg bg-blue-100 text-blue-600",
        _ => "p-2 rounded-lg bg-gray-100 text-gray-600"
    };

    private string GetSeverityBadgeClass(string severity) => severity switch
    {
        "Critical" => "text-red-600 bg-red-50 px-2 py-1 rounded",
        "Warning" => "text-amber-600 bg-amber-50 px-2 py-1 rounded",
        "Info" => "text-blue-600 bg-blue-50 px-2 py-1 rounded",
        _ => "text-gray-600 bg-gray-100 px-2 py-1 rounded"
    };

    public void Dispose() => refreshTimer?.Dispose();

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= TotalPages) return;
        currentPage++;
    }

    private class SystemAlert
    {
        public string Severity { get; set; } = string.Empty; // Critical, Warning, Info
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
}
