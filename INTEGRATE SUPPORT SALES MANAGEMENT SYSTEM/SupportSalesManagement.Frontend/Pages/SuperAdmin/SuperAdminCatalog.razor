@page "/superadmin/catalog"
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Catalog Management - Super Admin</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Catalog Management</h1>
            <p class="text-sm text-gray-500">Manage shirt products and inventory levels.</p>
        </div>
    </div>

    @if (loading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-red-600"></div>
        </div>
    }
    else
    {
        <!-- Summary stats -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-gradient-to-b from-blue-50 to-white rounded-xl shadow-sm border border-blue-100 p-4 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Products</p>
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900 mt-2">@totalCount</p>
            </div>
            <div class="bg-gradient-to-b from-emerald-50 to-white rounded-xl shadow-sm border border-emerald-100 p-4 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">In Stock</p>
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-emerald-600 mt-2">@inStockCount</p>
            </div>
            <div class="bg-gradient-to-b from-rose-50 to-white rounded-xl shadow-sm border border-rose-100 p-4 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Low Stock</p>
                    <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-rose-600 mt-2">@lowStockCount</p>
            </div>
            <div class="bg-gradient-to-b from-red-50 to-white rounded-xl shadow-sm border border-red-100 p-4 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Out of Stock</p>
                    <div class="w-8 h-8 rounded-lg bg-red-100 text-red-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-red-600 mt-2">@outOfStockCount</p>
            </div>
        </div>

        <div>
            <!-- Products Table -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden ui-surface-card">
                <div class="p-6 border-b border-gray-100 flex flex-wrap justify-between items-center gap-4">
                    <h3 class="text-lg font-bold text-gray-900">Products</h3>
                    <div class="flex gap-2 flex-wrap">
                        <input type="text" placeholder="Filter by name or SKU..."
                            class="text-sm border border-gray-300 rounded-lg px-3 py-2 w-48 focus:ring-2 focus:ring-red-500 focus:border-red-500"
                            value="@searchInput"
                            @oninput="OnSearchInput" />
                        <select class="text-sm border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-red-500 focus:border-red-500"
                            @bind="selectedCategory"
                            @bind:after="FilterProducts">
                            <option value="All">All</option>
                            <option value="T-Shirt">T-Shirt</option>
                            <option value="Dress">Dress</option>
                            <option value="Jacket">Jacket</option>
                            <option value="Sweater">Sweater</option>
                        </select>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-gray-50 text-gray-500 font-medium uppercase tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Product</th>
                                <th class="px-6 py-4">Category</th>
                                <th class="px-6 py-4 text-right">Price</th>
                                <th class="px-6 py-4">Stock</th>
                                <th class="px-6 py-4">Status</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @if (filteredProducts == null || !filteredProducts.Any())
                            {
                                <tr>
                                    <td colspan="6" class="px-6 py-4 text-center text-gray-500 italic">No products found.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var prod in PagedFilteredProducts)
                                {
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="font-bold text-gray-900">@prod.Name</div>
                                            <div class="text-[10px] text-gray-400">SKU: @prod.SKU</div>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700">@prod.Category</td>
                                        <td class="px-6 py-4 font-medium text-gray-900 text-right">₱@prod.Price.ToString("N2")</td>
                                        <td class="px-6 py-4">
                                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold @(prod.StockQuantity < 10 ? "bg-red-100 text-red-700" : "bg-green-100 text-green-700")">
                                                @prod.StockQuantity available
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            @if (prod.StockQuantity == 0)
                                            {
                                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700"><span class="w-2 h-2 rounded-full bg-red-600"></span>Out of Stock</span>
                                            }
                                            else if (prod.StockQuantity < 10)
                                            {
                                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-700"><span class="w-2 h-2 rounded-full bg-red-600"></span>Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700"><span class="w-2 h-2 rounded-full bg-emerald-600"></span>In Stock</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            @if (prod.IsActive)
                                            {
                                                <button type="button"
                                                    class="text-gray-400 hover:text-red-600 transition-colors"
                                                    title="Archive product"
                                                    @onclick="() => ArchiveProduct(prod)">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                            d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                                                    </svg>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button"
                                                    class="text-emerald-600 hover:text-emerald-700 text-xs font-semibold transition-colors"
                                                    title="Restore product"
                                                    @onclick="() => RestoreProduct(prod)">
                                                    Restore
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if ((filteredProducts?.Count ?? 0) > 0)
            {
                <div class="px-2 py-3 border-t border-gray-200 flex items-center justify-between">
                    <p class="text-sm text-gray-600">
                        Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, filteredProducts?.Count ?? 0) of @(filteredProducts?.Count ?? 0) · Page @currentPage/@TotalPages
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                                class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }

            <!-- Inventory Alert -->
            @if (lowStockCount > 0)
            {
                <div class="mt-6 bg-red-600 p-6 rounded-xl shadow-lg shadow-red-600/20 text-white max-w-md">
                    <h3 class="text-sm font-bold uppercase tracking-widest mb-2">Inventory Alert</h3>
                    <p class="text-xs text-red-100 leading-relaxed mb-4">@lowStockCount item(s) are currently below the safety threshold. Review stock levels immediately.</p>
                    <button type="button" class="py-2 px-4 bg-white/20 hover:bg-white/30 rounded-lg text-xs font-bold transition-colors"
                        @onclick="ScrollToTable">View Low Stock</button>
                </div>
            }
        </div>
    }
</div>

@code {
    private const int LowStockThreshold = 10;

    private List<Product>? allProducts;
    private List<Product> filteredProducts = new();
    private bool loading = true;
    private string searchText = "";
    private string searchInput = "";
    private string selectedCategory = "All";
    private CancellationTokenSource? _searchDebounceCts;
    private int currentPage = 1;
    private const int pageSize = 15;

    private int totalCount => allProducts?.Count ?? 0;
    private int inStockCount => allProducts?.Count(p => p.StockQuantity >= LowStockThreshold) ?? 0;
    private int lowStockCount => allProducts?.Count(p => p.StockQuantity > 0 && p.StockQuantity < LowStockThreshold) ?? 0;
    private int outOfStockCount => allProducts?.Count(p => p.StockQuantity == 0) ?? 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(filteredProducts.Count / (double)pageSize));
    private List<Product> PagedFilteredProducts => filteredProducts
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        loading = true;
        StateHasChanged();
        try
        {
            var list = await ApiClient.GetProductsAsync();
            allProducts = list ?? new List<Product>();
            FilterProducts();
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void FilterProducts()
    {
        if (allProducts == null)
        {
            filteredProducts = new List<Product>();
            return;
        }
        var query = allProducts.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim();
            query = query.Where(p =>
                (p.Name?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.SKU?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }
        if (selectedCategory != "All")
            query = query.Where(p => string.Equals(p.Category, selectedCategory, StringComparison.OrdinalIgnoreCase));
        filteredProducts = query.ToList();
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= TotalPages) return;
        currentPage++;
    }

    private async Task ArchiveProduct(Product product)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to archive '{product.Name}'?");
        if (!confirmed)
            return;
        try
        {
            var request = new UpdateProductRequest
            {
                Name = product.Name,
                Description = product.Description,
                Category = product.Category,
                Price = product.Price,
                StockQuantity = product.StockQuantity,
                ImageUrl = product.ImageUrl,
                IsActive = false
            };
            var result = await ApiClient.UpdateProductAsync(product.Id, request);
            if (result.Product != null)
                await LoadProducts();
            else
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to archive product: {result.Error}");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private async Task RestoreProduct(Product product)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Restore '{product.Name}' to active catalog?");
        if (!confirmed)
        {
            return;
        }

        try
        {
            var request = new UpdateProductRequest
            {
                Name = product.Name,
                Description = product.Description,
                Category = product.Category,
                Price = product.Price,
                StockQuantity = product.StockQuantity,
                ImageUrl = product.ImageUrl,
                IsActive = true
            };

            var result = await ApiClient.UpdateProductAsync(product.Id, request);
            if (result.Product != null)
            {
                await LoadProducts();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to restore product: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
    }

    private void ScrollToTable()
    {
        // Optional: scroll to table; no ref needed if we keep it simple
        StateHasChanged();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await DebouncedFilterProductsAsync();
    }

    private async Task DebouncedFilterProductsAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            searchText = searchInput;
            FilterProducts();
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
