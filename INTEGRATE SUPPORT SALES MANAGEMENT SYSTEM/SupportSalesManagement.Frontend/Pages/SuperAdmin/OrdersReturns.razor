@page "/superadmin/orders/returns"
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@inject SupportSalesManagement.Frontend.Services.ApiClient ApiClient
@using SupportSalesManagement.Frontend.Models

<PageTitle>Returns & Cancellations - Super Admin</PageTitle>

<div class="p-8">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Returns & Cancellations</h1>
        <p class="text-sm text-gray-500 mt-1">View cancelled and refunded orders from the system</p>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center items-center py-12">
            <div class="w-8 h-8 border-4 border-red-600 border-t-transparent rounded-full animate-spin"></div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div class="bg-white p-6 rounded-lg shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Cancelled Orders</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">@cancelledOrders.Count</p>
                    </div>
                    <div class="bg-red-100 p-3 rounded-full">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Refunded Orders</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">@refundedOrders.Count</p>
                    </div>
                    <div class="bg-yellow-100 p-3 rounded-full">
                        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                        </svg>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-gray-500">Total Lost Revenue</p>
                        <p class="text-2xl font-bold text-gray-900 mt-1">₱@totalLostRevenue.ToString("N2")</p>
                    </div>
                    <div class="bg-blue-100 p-3 rounded-full">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow">
            <div class="p-4 border-b border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900">Cancelled & Refunded Orders</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Order #</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        @if (allReturnOrders.Any())
                        {
                            @foreach (var order in allReturnOrders)
                            {
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@order.OrderNumber</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@(order.CustomerName ?? $"Customer #{order.CustomerId}")</td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">₱@order.TotalAmount.ToString("N2")</td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        @if (order.Status == "Cancelled")
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Refunded</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-sm text-gray-500">No cancelled or refunded orders found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Order> cancelledOrders = new();
    private List<Order> refundedOrders = new();
    private List<Order> allReturnOrders = new();
    private decimal totalLostRevenue = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var orders = await ApiClient.GetOrdersAsync();
            if (orders != null)
            {
                cancelledOrders = orders.Where(o => o.Status == "Cancelled").ToList();
                refundedOrders = orders.Where(o => o.Status == "Refunded").ToList();
                allReturnOrders = cancelledOrders.Concat(refundedOrders).OrderByDescending(o => o.OrderDate).ToList();
                totalLostRevenue = allReturnOrders.Sum(o => o.TotalAmount);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading returns: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
