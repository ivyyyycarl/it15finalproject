@page "/superadmin/orders/all"
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>All Orders - Super Admin</PageTitle>

<div class="space-y-4">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">All Orders</h1>
        <p class="text-sm text-gray-500 mt-1">View and manage all system orders</p>
    </div>

    @if (_loading)
    {
        <div class="flex items-center justify-center py-12">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-blue-600"></div>
        </div>
    }
    else
    {
        <!-- Summary stats cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <div class="bg-gradient-to-b from-blue-50 to-white p-4 rounded-xl shadow-sm border border-blue-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Orders</p>
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900 mt-2">@_totalOrders</p>
            </div>
            <div class="bg-gradient-to-b from-amber-50 to-white p-4 rounded-xl shadow-sm border border-amber-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Pending</p>
                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-amber-600 mt-2">@_pendingCount</p>
            </div>
            <div class="bg-gradient-to-b from-emerald-50 to-white p-4 rounded-xl shadow-sm border border-emerald-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Completed / Delivered</p>
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </div>
                </div>
                <p class="text-2xl font-bold text-emerald-600 mt-2">@_completedCount</p>
            </div>
            <div class="bg-gradient-to-b from-violet-50 to-white p-4 rounded-xl shadow-sm border border-violet-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-gray-500 uppercase tracking-wider">Total Revenue</p>
                    <div class="w-8 h-8 rounded-lg bg-violet-100 text-violet-600 flex items-center justify-center">
                        <span class="text-lg font-black leading-none">₱</span>
                    </div>
                </div>
                <p class="text-2xl font-bold text-gray-900 mt-2">₱@_totalRevenue.ToString("N2")</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white p-4 rounded-lg shadow mb-6 border border-gray-200 flex flex-wrap gap-4">
            <input type="text"
                   placeholder="Search by order # or customer..."
                   class="flex-1 min-w-[200px] px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                   value="@_searchInput"
                   @oninput="OnSearchInput" />
            <select class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                    @bind="_statusFilter"
                    @bind:after="FilterOrders">
                <option value="">All</option>
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Shipped">Shipped</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-lg shadow border border-gray-200">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order #</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var order in PagedFilteredOrders)
                        {
                            <tr class="hover:bg-gray-50">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">@order.OrderNumber</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.CustomerName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-right">₱@order.TotalAmount.ToString("N2")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @GetStatusClass(order.Status)">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                    <button type="button"
                                            class="text-blue-600 hover:text-blue-900"
                                            @onclick="() => ViewOrder(order.Id)">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!_filteredOrders.Any())
            {
                <div class="px-6 py-8 text-center text-gray-500">No orders match your filters.</div>
            }
            else
            {
                <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                    <p class="text-sm text-gray-600">
                        Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, _filteredOrders.Count) of @_filteredOrders.Count · Page @currentPage/@TotalPages
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                                class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Order> _allOrders = new();
    private List<Order> _filteredOrders = new();
    private string _searchText = "";
    private string _searchInput = "";
    private string _statusFilter = "";
    private CancellationTokenSource? _searchDebounceCts;
    private int currentPage = 1;
    private const int pageSize = 15;

    private int _totalOrders => _allOrders.Count;
    private int _pendingCount => _allOrders.Count(o => string.Equals(o.Status, "Pending", StringComparison.OrdinalIgnoreCase));
    private int _completedCount => _allOrders.Count(o =>
        string.Equals(o.Status, "Delivered", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(o.Status, "Completed", StringComparison.OrdinalIgnoreCase));
    private decimal _totalRevenue => _allOrders
        .Where(o => string.Equals(o.Status, "Delivered", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(o.Status, "Completed", StringComparison.OrdinalIgnoreCase))
        .Sum(o => o.TotalAmount);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredOrders.Count / (double)pageSize));
    private List<Order> PagedFilteredOrders => _filteredOrders
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiClient.GetOrdersAsync();
        _allOrders = result ?? new List<Order>();
        FilterOrders();
        _loading = false;
    }

    private void FilterOrders()
    {
        var query = _allOrders.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            query = query.Where(o =>
                (o.OrderNumber?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (o.CustomerName?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        if (!string.IsNullOrWhiteSpace(_statusFilter))
        {
            query = query.Where(o => string.Equals(o.Status, _statusFilter, StringComparison.OrdinalIgnoreCase));
        }

        _filteredOrders = query.ToList();
        currentPage = 1;
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= TotalPages) return;
        currentPage++;
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Delivered" => "bg-green-100 text-green-800",
            "Completed" => "bg-green-100 text-green-800",
            "Shipped" => "bg-blue-100 text-blue-800",
            "Processing" => "bg-blue-100 text-blue-800",
            "Pending" => "bg-yellow-100 text-yellow-800",
            "Cancelled" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private void ViewOrder(int orderId)
    {
        NavigationManager.NavigateTo($"/orders/{orderId}");
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchInput = e.Value?.ToString() ?? string.Empty;
        await DebouncedFilterOrdersAsync();
    }

    private async Task DebouncedFilterOrdersAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            _searchText = _searchInput;
            FilterOrders();
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
