@page "/superadmin/users"
@using SupportSalesManagement.Frontend.Models
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>User Management - System Administration</PageTitle>

<style>
    .um-root {
        --um-primary: #DC2626;
        --um-bg: #F8FAFC;
        --um-card-bg: #FFFFFF;
        --um-border: #E2E8F0;
        --um-text-main: #1E293B;
        --um-text-muted: #64748B;
        --um-row-hover: #F1F5F9;
    }

    .um-container {
        padding: 1rem 0.75rem 0.75rem;
        background: transparent;
        min-height: calc(100vh - 64px);
    }

    /* Header & Filters */
    .um-page-header {
        margin-bottom: 1rem;
    }
    .um-page-header h1 {
        font-size: 1.5rem;
        line-height: 1.2;
        font-weight: 800;
        color: var(--um-text-main);
        letter-spacing: -0.02em;
    }
    .um-page-header p {
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: var(--um-text-muted);
    }

    .um-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .um-search-box {
        position: relative;
        width: 320px;
    }
    .um-search-box input {
        width: 100%;
        padding: 0.625rem 1rem 0.625rem 2.5rem;
        background: white;
        border: 1px solid var(--um-border);
        border-radius: 0.75rem;
        font-size: 0.875rem;
        outline: none;
        transition: all 0.2s;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    .um-search-box input:focus {
        border-color: var(--um-primary);
        box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
    }
    .um-search-box svg {
        position: absolute;
        left: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--um-text-muted);
    }

    .um-controls {
        display: flex;
        gap: 0.75rem;
        align-items: center;
        margin-left: auto;
    }

    /* Table Design */
    .um-card {
        background: var(--um-card-bg);
        border: 1px solid var(--um-border);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .um-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .um-table th {
        padding: 1rem 1.5rem;
        background: #F1F5F9;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--um-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid var(--um-border);
    }

    .um-table tr {
        border-bottom: 1px solid #F1F5F9;
        transition: background 0.2s;
    }
    .um-table tr:last-child { border-bottom: none; }
    .um-table tr:hover { background: var(--um-row-hover); }

    .um-table td {
        padding: 1.25rem 1.5rem;
        vertical-align: middle;
    }

    /* Identity Cell */
    .um-identity {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .um-avatar {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.875rem;
        color: white;
        flex-shrink: 0;
    }
    .um-id-info .name {
        display: block;
        font-weight: 700;
        color: var(--um-text-main);
        font-size: 0.9375rem;
    }
    .um-id-info .uid {
        display: block;
        font-size: 0.75rem;
        color: var(--um-text-muted);
        font-family: monospace;
    }

    .um-email {
        color: var(--um-text-muted);
        font-size: 0.875rem;
    }

    /* Badges */
    .um-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .um-badge-role { border: 1px solid transparent; }
    .um-badge-role.superadmin { background: #FEF2F2; color: #DC2626; border-color: #FECACA; }
    .um-badge-role.admin { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
    .um-badge-role.supervisor { background: #F5F3FF; color: #6D28D9; border-color: #DDD6FE; }
    .um-badge-role.agent { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
    .um-badge-role.customer { background: #F9FAFB; color: #4B5563; border-color: #E5E7EB; }

    .um-badge-status { border: 1px solid transparent; }
    .um-badge-status {
        background: transparent;
        border: none;
        padding: 0;
        font-weight: 700;
        gap: 0.4rem;
    }
    .um-badge-status::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 9999px;
        display: inline-block;
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.7);
    }
    .um-badge-status.active { color: #16A34A; }
    .um-badge-status.active::before { background: #16A34A; }
    .um-badge-status.inactive { color: #DC2626; }
    .um-badge-status.inactive::before { background: #DC2626; }
    .um-badge-status.pending { color: #D97706; }
    .um-badge-status.pending::before { background: #D97706; }

    .um-badge-branch {
        background: transparent;
        color: #4338CA;
        border: none;
        padding: 0;
    }

    /* Actions Dropdown */
    .um-actions-wrap {
        position: relative;
        display: inline-block;
    }

    .um-btn-actions {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--um-text-muted);
        border: 1px solid var(--um-border);
        background: white;
        cursor: pointer;
        transition: all 0.2s;
    }
    .um-btn-actions:hover {
        background: #F8FAFC;
        border-color: #CBD5E1;
        color: var(--um-text-main);
    }

    .um-dropdown {
        position: absolute;
        right: 0;
        top: 100%;
        margin-top: 0.5rem;
        width: 180px;
        background: white;
        border: 1px solid var(--um-border);
        border-radius: 0.75rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        z-index: 50;
        padding: 0.5rem;
        display: none;
    }
    .um-actions-wrap:hover .um-dropdown, 
    .um-actions-wrap:focus-within .um-dropdown {
        display: block;
    }

    .um-dropdown-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0.75rem;
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--um-text-main);
        cursor: pointer;
        transition: background 0.2s;
    }
    .um-dropdown-item:hover { background: #F1F5F9; }
    .um-dropdown-item.danger { color: #DC2626; }
    .um-dropdown-item.danger:hover { background: #FEF2F2; }

    /* Empty state */
    .um-empty {
        padding: 4rem 2rem;
        text-align: center;
        color: var(--um-text-muted);
    }
</style>

<div class="um-container">
    <div class="um-page-header">
        <h1>User Management</h1>
        <p>Manage platform users, access roles, and account status.</p>
    </div>

    <header class="um-header">
        <div class="um-search-box">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input type="text" placeholder="Search users by name..." value="@searchInput" @oninput="OnSearchInput" />
        </div>
        <div class="um-controls">
            <button @onclick="OpenCreateUserModal" class="px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-bold hover:bg-red-700 transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Add User
            </button>
        </div>
    </header>

    <div class="um-card ui-surface-card">
        <table class="um-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Branch</th>
                    <th>Status</th>
                    <th>Last Login</th>
                    <th style="text-align: right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (filteredUsers != null && filteredUsers.Any())
                {
                    @foreach (var user in pagedFilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="um-identity">
                                    <div class="um-avatar" style="background: @GetAvatarColor(user.Role)">
                                        @user.FirstName[0]@user.LastName[0]
                                    </div>
                                    <div class="um-id-info">
                                        <span class="name">@user.Name</span>
                                        <span class="uid">USR-@user.Id.ToString("D3")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="um-email">@user.Email</span>
                            </td>
                            <td>
                                <span class="um-badge um-badge-role @user.Role.ToString().ToLower()">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                    @user.Role
                                </span>
                            </td>
                            <td>
                                <span class="um-badge um-badge-branch">
                                    @FormatBranchLabel(user)
                                </span>
                            </td>
                            <td>
                                <span class="um-badge um-badge-status @(user.IsActive ? "active" : "inactive")">
                                    @(user.IsActive ? "Active" : "Archived")
                                </span>
                            </td>
                            <td>
                                <span class="um-text-muted text-xs">@(user.LastLoginAt?.ToString("MMM dd, yyyy") ?? "Never")</span>
                            </td>
                            <td style="text-align: right">
                                <div class="um-actions-wrap">
                                    <button class="um-btn-actions">
                                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z"/></svg>
                                    </button>
                                    <div class="um-dropdown">
                                        <button @onclick="() => OpenViewModal(user)" class="um-dropdown-item">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            View Details
                                        </button>
                                        <button @onclick="() => OpenEditModal(user)" class="um-dropdown-item">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Edit User
                                        </button>
                                        <button @onclick="() => SendUserEmail(user.Email)" class="um-dropdown-item">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                            Send Email
                                        </button>
                                        <div style="height: 1px; background: #EEE; margin: 4px 0;"></div>
                                        <button @onclick="() => ArchiveUser(user)" class="um-dropdown-item danger">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            @(user.IsActive ? "Archive User" : "Restore User")
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else if (users == null)
                {
                    <tr>
                        <td colspan="7" class="um-empty">
                            <div class="animate-pulse flex flex-col items-center">
                                <div class="h-8 w-64 bg-slate-200 rounded mb-4"></div>
                                <div class="h-4 w-48 bg-slate-100 rounded"></div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="um-empty">
                            <div class="text-slate-300 mb-2">
                                <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                            </div>
                            <p class="font-bold text-lg">No users found</p>
                            <p class="text-sm">Try adjusting your search criteria</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (filteredUsers != null && filteredUsers.Any())
    {
        <div class="flex items-center justify-between px-2 py-3 border-t border-slate-200">
            <p class="text-sm text-slate-600">
                Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, filteredUsers.Count) of @filteredUsers.Count · Page @currentPage/@TotalPages
            </p>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                        class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                        class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
            </div>
        </div>
    }
</div>

<!-- Create/Edit User Modal (Modernized) -->
@if (showCreateModal || showEditModal)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full overflow-hidden animate-in fade-in zoom-in duration-200">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <h2 class="text-xl font-bold text-slate-800">@(showEditModal ? "Modify System User" : "Add New System User")</h2>
                <button @onclick="CloseModals" class="text-slate-400 hover:text-slate-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            
            <div class="p-6">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl text-sm text-red-600 flex items-start gap-3">
                        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">First Name</label>
                            <input @bind="userModel.FirstName" type="text" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all" placeholder="Enter first name" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">Last Name</label>
                            <input @bind="userModel.LastName" type="text" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all" placeholder="Enter last name" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">Email Address</label>
                        <input @bind="userModel.Email" type="email" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all" placeholder="name@company.com" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">Assign User Role</label>
                        <select @bind="userModel.Role" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all appearance-none cursor-pointer">
                            @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>

                    @if (!showEditModal && ShouldShowBranchSelector())
                    {
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">Branch Assignment</label>
                            <select @bind="userModel.BranchId" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all appearance-none cursor-pointer">
                                <option value="">Auto (creator branch: @creatorBranchLabel)</option>
                                @foreach (var branch in availableBranches.Where(b => b.IsActive))
                                {
                                    <option value="@branch.Id">@branch.Name (#@branch.Id)</option>
                                }
                            </select>
                            <p class="mt-1 text-[11px] text-slate-500">
                                Semi-automatic mode: branch is auto-filled from creator unless you explicitly choose one.
                            </p>
                        </div>
                    }

                    @if (!showEditModal)
                    {
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1">Secure Password</label>
                            <input @bind="userModel.Password" type="password" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-red-500/20 focus:border-red-500 outline-none transition-all" placeholder="••••••••" />
                        </div>
                    }
                </div>
            </div>

            <div class="p-6 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                <button @onclick="CloseModals" class="px-5 py-2.5 text-sm font-bold text-slate-600 hover:text-slate-800 transition-colors">
                    Discard
                </button>
                @if (showEditModal)
                {
                    <button @onclick="UpdateUser" disabled="@isSubmitting" class="px-6 py-2.5 bg-red-600 text-white rounded-xl text-sm font-bold hover:bg-red-700 disabled:opacity-50 transition-all shadow-lg shadow-red-100">
                        @(isSubmitting ? "Saving Changes..." : "Save Changes")
                    </button>
                }
                else
                {
                    <button @onclick="CreateUser" disabled="@isSubmitting" class="px-6 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-slate-800 disabled:opacity-50 transition-all shadow-lg shadow-slate-200">
                        @(isSubmitting ? "Finalizing Account..." : "Create Account")
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- View Details Modal -->
@if (showViewModal && selectedUser != null)
{
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-200">
            <div class="p-8 text-center bg-slate-50 relative">
                <button @onclick="CloseModals" class="absolute right-4 top-4 text-slate-400 hover:text-slate-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
                
                <div class="w-24 h-24 rounded-full mx-auto mb-4 flex items-center justify-center text-3xl font-bold text-white shadow-xl shadow-slate-200" style="background: @GetAvatarColor(selectedUser.Role)">
                    @selectedUser.FirstName[0]@selectedUser.LastName[0]
                </div>
                <h2 class="text-2xl font-bold text-slate-800">@selectedUser.Name</h2>
                <div class="flex items-center justify-center gap-2 mt-2">
                    <span class="um-badge um-badge-role @selectedUser.Role.ToString().ToLower()">@selectedUser.Role</span>
                    <span class="um-badge um-badge-status @(selectedUser.IsActive ? "active" : "inactive")">@(selectedUser.IsActive ? "Active" : "Archived")</span>
                </div>
            </div>

            <div class="p-6 space-y-4">
                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Internal ID</span>
                    <span class="text-sm font-mono text-slate-700">USR-@selectedUser.Id.ToString("D3")</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Email Address</span>
                    <span class="text-sm text-slate-700">@selectedUser.Email</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Joined System</span>
                    <span class="text-sm text-slate-700">@selectedUser.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Branch</span>
                    <span class="text-sm text-slate-700">@FormatBranchLabel(selectedUser)</span>
                </div>
                <div class="flex justify-between items-center p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-xs font-bold text-slate-500 uppercase">Last Login</span>
                    <span class="text-sm text-slate-700">@(selectedUser.LastLoginAt?.ToString("MMM dd, yyyy HH:mm") ?? "Never")</span>
                </div>
            </div>

            <div class="p-6 border-t border-slate-100 flex justify-center bg-slate-50">
                <button @onclick="CloseModals" class="w-full py-3 bg-slate-900 text-white rounded-xl font-bold hover:bg-slate-800 transition-all shadow-lg shadow-slate-200">
                    Close Details
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<User>? users;
    private string searchTerm = "";
    private string searchInput = "";
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showViewModal = false;
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;
    
    // Unified model for create/edit
    private CreateUserRequest userModel = new() { Role = UserRole.Agent };
    private User? selectedUser;
    private CancellationTokenSource? _searchDebounceCts;
    private int currentPage = 1;
    private const int pageSize = 15;
    private List<BranchModel> availableBranches = new();
    private int? creatorBranchId;
    private string creatorBranchLabel = "Unassigned";

    private List<User>? filteredUsers => users?.Where(u => 
        string.IsNullOrEmpty(searchTerm) || 
        u.FirstName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
        u.LastName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
        u.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
    ).ToList();
    private List<User> pagedFilteredUsers => (filteredUsers ?? new List<User>())
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((filteredUsers?.Count ?? 0) / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        await LoadAutomationBranchContextAsync();
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        users = await ApiClient.GetSuperAdminUsersAsync();
        currentPage = 1;
    }

    private static string FormatBranchLabel(User? user)
    {
        if (user is null || user.BranchId is null || user.BranchId <= 0)
        {
            return "Unassigned";
        }

        var branchName = string.IsNullOrWhiteSpace(user.BranchName) ? null : user.BranchName.Trim();
        return branchName is null
            ? $"#{user.BranchId}"
            : $"{branchName} (#{user.BranchId})";
    }

    private string GetAvatarColor(UserRole role)
    {
        return role switch
        {
            UserRole.SuperAdmin => "linear-gradient(135deg, #DC2626 0%, #EF4444 100%)",
            UserRole.Admin => "linear-gradient(135deg, #2563EB 0%, #3B82F6 100%)",
            UserRole.Supervisor => "linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%)",
            UserRole.Agent => "linear-gradient(135deg, #059669 0%, #10B981 100%)",
            UserRole.Customer => "linear-gradient(135deg, #6B7280 0%, #9CA3AF 100%)",
            _ => "linear-gradient(135deg, #334155 0%, #64748B 100%)"
        };
    }

    private void OpenCreateUserModal()
    {
        errorMessage = string.Empty;
        userModel = new CreateUserRequest { Role = UserRole.Agent, BranchId = creatorBranchId };
        showCreateModal = true;
        showEditModal = false;
        showViewModal = false;
    }

    private void OpenEditModal(User user)
    {
        selectedUser = user;
        errorMessage = string.Empty;
        userModel = new CreateUserRequest 
        { 
            FirstName = user.FirstName, 
            LastName = user.LastName, 
            Email = user.Email, 
            Role = user.Role 
        };
        showEditModal = true;
        showCreateModal = false;
        showViewModal = false;
    }

    private void OpenViewModal(User user)
    {
        selectedUser = user;
        showViewModal = true;
        showEditModal = false;
        showCreateModal = false;
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showEditModal = false;
        showViewModal = false;
        selectedUser = null;
        errorMessage = string.Empty;
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(userModel.FirstName) || string.IsNullOrWhiteSpace(userModel.LastName) ||
            string.IsNullOrWhiteSpace(userModel.Email) || string.IsNullOrWhiteSpace(userModel.Password))
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }
        if (userModel.Role == UserRole.Customer)
        {
            userModel.BranchId = null;
        }
        else if ((userModel.BranchId is null || userModel.BranchId <= 0) && (creatorBranchId is null || creatorBranchId <= 0))
        {
            errorMessage = "Select a branch before creating Admin, Supervisor, or Agent accounts.";
            return;
        }

        var selectedBranchLabel = GetCreateBranchLabel();
        var createConfirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Create user account for {userModel.FirstName} {userModel.LastName} ({userModel.Role}) in branch {selectedBranchLabel}?");
        if (!createConfirmed)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var success = await ApiClient.CreateUserAsync(userModel);
            if (success)
            {
                await LoadUsers();
                CloseModals();
            }
            else
            {
                errorMessage = "Failed to create user. The email may already be in use.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"System Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task UpdateUser()
    {
        if (selectedUser == null) return;
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Save profile changes for {selectedUser.Name}?");
        if (!confirmed)
        {
            return;
        }

        isSubmitting = true;
        try
        {
            var updateDto = new UpdateUserDto
            {
                FirstName = userModel.FirstName,
                LastName = userModel.LastName,
                Email = userModel.Email,
                Role = userModel.Role
            };

            var updated = await ApiClient.UpdateUserAsync(selectedUser.Id, updateDto);
            if (updated != null)
            {
                await LoadUsers();
                CloseModals();
            }
            else
            {
                errorMessage = "Failed to update user profile.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Update Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task SendUserEmail(string email)
    {
        await JSRuntime.InvokeVoidAsync("open", $"mailto:{email}", "_blank");
    }

    private async Task ArchiveUser(User user)
    {
        var makeActive = !user.IsActive;
        var action = makeActive ? "restore" : "archive";
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to {action} {user.Name}? This will change their system access status.");
        
        if (confirmed)
        {
            var updated = await ApiClient.UpdateUserAsync(user.Id, new UpdateUserDto { IsActive = makeActive });
            if (updated != null)
            {
                await LoadUsers();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to {action} user.");
            }
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await DebouncedApplySearchAsync();
    }

    private async Task DebouncedApplySearchAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            searchTerm = searchInput;
            currentPage = 1;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= TotalPages) return;
        currentPage++;
    }

    private bool ShouldShowBranchSelector()
    {
        return userModel.Role is UserRole.Admin or UserRole.Supervisor or UserRole.Agent;
    }

    private string GetCreateBranchLabel()
    {
        if (userModel.BranchId is int explicitBranchId && explicitBranchId > 0)
        {
            var explicitBranch = availableBranches.FirstOrDefault(b => b.Id == explicitBranchId);
            return explicitBranch is null
                ? $"#{explicitBranchId}"
                : $"{explicitBranch.Name} (#{explicitBranchId})";
        }

        return creatorBranchLabel;
    }

    private async Task LoadAutomationBranchContextAsync()
    {
        try
        {
            var currentUser = await ApiClient.GetCurrentUserAsync();
            creatorBranchId = currentUser?.BranchId;
            creatorBranchLabel = FormatBranchLabel(currentUser);
        }
        catch
        {
            creatorBranchId = null;
            creatorBranchLabel = "Unassigned";
        }

        try
        {
            availableBranches = await ApiClient.GetBranchesAsync() ?? new List<BranchModel>();
        }
        catch
        {
            availableBranches = new List<BranchModel>();
        }
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
