@page "/superadmin/reports/financial"
@layout SuperAdminLayout
@attribute [Authorize(Roles = "SuperAdmin")]
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<PageTitle>Financial Reports - Super Admin</PageTitle>

<div class="space-y-4">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900">Financial Reports</h1>
        <div class="flex gap-3">
            <button type="button"
                    @onclick="ExportToPdf"
                    class="bg-white border border-gray-100 text-gray-700 font-medium py-2 px-4 rounded-xl shadow-sm hover:bg-gray-50 transition-colors flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export to PDF
            </button>
            <button type="button"
                    @onclick="PrintReport"
                    class="bg-white border border-gray-100 text-gray-700 font-medium py-2 px-4 rounded-xl shadow-sm hover:bg-gray-50 transition-colors flex items-center">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex items-center justify-center py-24">
            <div class="flex flex-col items-center">
                <div class="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mb-4"></div>
                <p class="text-gray-500">Loading financial data...</p>
            </div>
        </div>
    }
    else
    {
        <!-- Financial Summary Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <div class="bg-gradient-to-b from-violet-50 to-white p-5 rounded-xl shadow-sm border border-violet-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-gray-500">Total Revenue</p>
                    <div class="w-8 h-8 rounded-lg bg-violet-100 text-violet-600 flex items-center justify-center"><span class="text-lg font-black leading-none">₱</span></div>
                </div>
                <p class="text-2xl font-bold text-violet-700 mt-2">₱@totalRevenue.ToString("N2")</p>
            </div>
            <div class="bg-gradient-to-b from-blue-50 to-white p-5 rounded-xl shadow-sm border border-blue-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-gray-500">Average Order Value</p>
                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 1v8"/></svg></div>
                </div>
                <p class="text-2xl font-bold text-blue-700 mt-2">₱@averageOrderValue.ToString("N2")</p>
            </div>
            <div class="bg-gradient-to-b from-emerald-50 to-white p-5 rounded-xl shadow-sm border border-emerald-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-gray-500">Total Orders</p>
                    <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg></div>
                </div>
                <p class="text-2xl font-bold text-emerald-700 mt-2">@totalOrders</p>
            </div>
            <div class="bg-gradient-to-b from-amber-50 to-white p-5 rounded-xl shadow-sm border border-amber-100 ui-uniform-card">
                <div class="flex items-center justify-between">
                    <p class="text-sm font-medium text-gray-500">Total Products</p>
                    <div class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/></svg></div>
                </div>
                <p class="text-2xl font-bold text-amber-700 mt-2">@totalProducts</p>
            </div>
        </div>

        <!-- Revenue by Status -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 mb-8 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-900">Revenue by Order Status</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-100">
                        <tr>
                            <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Status</th>
                            <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Count</th>
                            <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Revenue (₱)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var group in PagedRevenueByStatus)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="px-6 py-4">
                                    <span class="inline-flex px-2 py-1 text-xs font-medium rounded-full @GetStatusClass(group.Status)">@group.Status</span>
                                </td>
                                <td class="px-6 py-4 text-right text-gray-900">@group.Count</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">₱@group.Revenue.ToString("N2")</td>
                            </tr>
                        }
                        @if (revenueByStatus.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="px-6 py-8 text-center text-gray-500">No orders yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (revenueByStatus.Count > 0)
            {
                <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                    <p class="text-sm text-gray-600">
                        Showing @(((statusPage - 1) * statusPageSize) + 1)-@Math.Min(statusPage * statusPageSize, revenueByStatus.Count) of @revenueByStatus.Count · Page @statusPage/@StatusTotalPages
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousStatusPage" disabled="@(statusPage <= 1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextStatusPage" disabled="@(statusPage >= StatusTotalPages)"
                                class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }
        </div>

        <!-- Recent Orders -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-900">Recent Orders</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50 border-b border-gray-100">
                        <tr>
                            <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Order #</th>
                            <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Customer</th>
                            <th class="text-right text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Amount (₱)</th>
                            <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Status</th>
                            <th class="text-left text-xs font-medium text-gray-500 uppercase tracking-wider px-6 py-3">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var order in PagedRecentOrders)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="px-6 py-4 font-medium text-gray-900">@order.OrderNumber</td>
                                <td class="px-6 py-4 text-gray-700">@order.CustomerName</td>
                                <td class="px-6 py-4 text-right font-medium text-gray-900">₱@order.TotalAmount.ToString("N2")</td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex px-2 py-1 text-xs font-medium rounded-full @GetStatusClass(order.Status)">@order.Status</span>
                                </td>
                                <td class="px-6 py-4 text-gray-600">@order.OrderDate.ToString("MMM d, yyyy")</td>
                            </tr>
                        }
                        @if (recentOrders.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-6 py-8 text-center text-gray-500">No orders yet.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (recentOrders.Count > 0)
            {
                <div class="px-6 py-4 border-t border-gray-200 flex items-center justify-between">
                    <p class="text-sm text-gray-600">
                        Showing @(((ordersPage - 1) * ordersPageSize) + 1)-@Math.Min(ordersPage * ordersPageSize, recentOrders.Count) of @recentOrders.Count · Page @ordersPage/@OrdersTotalPages
                    </p>
                    <div class="flex items-center gap-2">
                        <button type="button" @onclick="PreviousOrdersPage" disabled="@(ordersPage <= 1)"
                                class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm font-semibold text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                        <button type="button" @onclick="NextOrdersPage" disabled="@(ordersPage >= OrdersTotalPages)"
                                class="px-3 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private decimal totalRevenue;
    private decimal averageOrderValue;
    private int totalOrders;
    private int totalProducts;
    private List<Order> recentOrders = new();
    private List<(string Status, int Count, decimal Revenue)> revenueByStatus = new();
    private int ordersPage = 1;
    private int statusPage = 1;
    private const int ordersPageSize = 15;
    private const int statusPageSize = 15;
    private int OrdersTotalPages => Math.Max(1, (int)Math.Ceiling(recentOrders.Count / (double)ordersPageSize));
    private int StatusTotalPages => Math.Max(1, (int)Math.Ceiling(revenueByStatus.Count / (double)statusPageSize));
    private List<Order> PagedRecentOrders => recentOrders.Skip((ordersPage - 1) * ordersPageSize).Take(ordersPageSize).ToList();
    private List<(string Status, int Count, decimal Revenue)> PagedRevenueByStatus => revenueByStatus.Skip((statusPage - 1) * statusPageSize).Take(statusPageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var ordersTask = ApiClient.GetOrdersAsync();
            var ticketsTask = ApiClient.GetTicketsAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, ticketsTask, productsTask);

            var orders = await ordersTask ?? new List<Order>();
            var products = await productsTask ?? new List<Product>();

            totalOrders = orders.Count;
            totalRevenue = orders.Sum(o => o.TotalAmount);
            averageOrderValue = totalOrders > 0 ? totalRevenue / totalOrders : 0;
            totalProducts = products.Count;

            recentOrders = orders
                .OrderByDescending(o => o.OrderDate)
                .ThenByDescending(o => o.CreatedAt)
                .ToList();

            revenueByStatus = orders
                .GroupBy(o => string.IsNullOrWhiteSpace(o.Status) ? "Unknown" : o.Status)
                .Select(g => (Status: g.Key, Count: g.Count(), Revenue: g.Sum(o => o.TotalAmount)))
                .OrderByDescending(x => x.Revenue)
                .ToList();
            ordersPage = 1;
            statusPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading financial data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private static string GetStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "pending" => "bg-yellow-100 text-yellow-800",
            "processing" => "bg-blue-100 text-blue-800",
            "completed" => "bg-green-100 text-green-800",
            "cancelled" or "canceled" => "bg-red-100 text-red-800",
            "shipped" => "bg-indigo-100 text-indigo-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private async Task ExportToPdf()
    {
        await JSRuntime.InvokeVoidAsync("exportToPdf", "Financial Report");
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("printCurrentPage", "Financial Report");
    }

    private void PreviousOrdersPage()
    {
        if (ordersPage <= 1) return;
        ordersPage--;
    }

    private void NextOrdersPage()
    {
        if (ordersPage >= OrdersTotalPages) return;
        ordersPage++;
    }

    private void PreviousStatusPage()
    {
        if (statusPage <= 1) return;
        statusPage--;
    }

    private void NextStatusPage()
    {
        if (statusPage >= StatusTotalPages) return;
        statusPage++;
    }
}
