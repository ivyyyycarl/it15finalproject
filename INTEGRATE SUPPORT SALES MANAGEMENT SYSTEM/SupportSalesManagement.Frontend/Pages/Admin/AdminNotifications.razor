@page "/admin/notifications"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>System Notifications - ClassicFit Pro</PageTitle>

<div class="px-6 py-8">
    <!-- Header -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-6 py-4 flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">System Notifications</h1>
            <p class="text-sm text-gray-500 mt-1">Monitor high-level alerts and administrative activities</p>
            @if (lastRefreshTime.HasValue)
            {
                <p class="text-xs text-gray-400 mt-1">Last refreshed: @GetTimeAgo(lastRefreshTime.Value)</p>
            }
        </div>
        <div class="flex items-center gap-4">
            <button @onclick="MarkAllRead" class="text-sm font-bold text-blue-600 hover:text-blue-700">
                Mark all as read
            </button>
            <div class="flex bg-gray-100 p-1 rounded-lg">
                <button @onclick='() => Filter = "All"' 
                    class="px-4 py-1.5 rounded-md text-sm font-bold transition-all @(Filter == "All" ? "bg-white text-blue-600 shadow-sm" : "text-gray-500 hover:text-gray-700")">
                    All
                </button>
                <button @onclick='() => Filter = "Unread"'
                    class="px-4 py-1.5 rounded-md text-sm font-bold transition-all @(Filter == "Unread" ? "bg-white text-blue-600 shadow-sm" : "text-gray-500 hover:text-gray-700")">
                    Unread
                </button>
                <button @onclick='() => Filter = "Critical"'
                    class="px-4 py-1.5 rounded-md text-sm font-bold transition-all @(Filter == "Critical" ? "bg-white text-red-600 shadow-sm" : "text-gray-500 hover:text-gray-700")">
                    Critical
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Feed -->
    <div class="max-w-5xl mx-auto space-y-4">
        @if (!FilteredNotifications.Any())
        {
            <div class="text-center py-24 bg-white rounded-2xl border border-gray-100 shadow-sm">
                <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900">Zero System Alerts</h3>
                <p class="text-gray-500">The system is running smoothly with no pending alerts.</p>
            </div>
        }
        else
        {
            @foreach (var note in FilteredNotifications)
            {
                <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:border-blue-200 hover:shadow-md transition-all group relative border-l-4 @GetBorderClass(note.Type) @(note.IsRead ? "opacity-75" : "")">
                    <div class="flex items-start gap-4">
                        <div class="pt-1">
                            @if(note.Type == "System") { <div class="p-2.5 bg-red-50 rounded-lg text-red-600 border border-red-100"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg></div> }
                            else if (note.Type == "Security") { <div class="p-2.5 bg-indigo-50 rounded-lg text-indigo-600 border border-indigo-100"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg></div> }
                            else if (note.Type == "User") { <div class="p-2.5 bg-green-50 rounded-lg text-green-600 border border-green-100"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" /></svg></div> }
                            else { <div class="p-2.5 bg-blue-50 rounded-lg text-blue-600 border border-blue-100"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div> }
                        </div>
                        <div class="flex-1">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h3 class="font-bold text-gray-900 leading-none mb-1">@note.Title</h3>
                                    <span class="text-xs font-semibold px-2 py-0.5 rounded @GetBadgeClass(note.Priority)">@note.Priority</span>
                                </div>
                                <div class="flex flex-col items-end">
                                    <span class="text-xs text-gray-400 font-medium">@note.TimeAgo</span>
                                    @if (!note.IsRead)
                                    {
                                        <button @onclick="() => MarkRead(note)" class="text-xs font-bold text-blue-600 hover:text-blue-700 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                            Clear Alert
                                        </button>
                                    }
                                </div>
                            </div>
                            <p class="text-sm text-gray-600 mt-2 max-w-3xl">@note.Message</p>
                            
                            @if(note.Type == "User")
                            {
                                <div class="mt-4 flex gap-2">
                                    <button class="text-xs font-bold bg-blue-600 text-white px-3 py-1.5 rounded-lg hover:bg-blue-700 transition-colors shadow-sm">Approve Access</button>
                                    <button class="text-xs font-bold bg-white border border-gray-200 text-gray-700 px-3 py-1.5 rounded-lg hover:bg-gray-50 transition-colors">View Details</button>
                                </div>
                            }
                        </div>
                        @if (!note.IsRead) { <div class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.5)] animate-pulse mt-3 mr-1"></div> }
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: .5; }
    }
</style>

@code {
    private string Filter = "All";
    private List<AdminNotification> Notifications = new();
    private System.Threading.Timer? refreshTimer;
    private DateTime? lastRefreshTime;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        
        // Auto-refresh every 30 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await LoadNotifications();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task LoadNotifications()
    {
        try
        {
            // Load real data
            var ordersTask = ApiClient.GetOrdersAsync();
            var ticketsTask = ApiClient.GetTicketsAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, ticketsTask, productsTask);

            var orders = await ordersTask ?? new List<Order>();
            var tickets = await ticketsTask ?? new List<Ticket>();
            var products = await productsTask ?? new List<Product>();

            var newNotifications = new List<AdminNotification>();
            int notificationId = 1;

            // Generate notifications from orders (pending orders)
            var pendingOrders = orders.Where(o => o.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(o => o.OrderDate)
                .Take(5);
            
            foreach (var order in pendingOrders)
            {
                newNotifications.Add(new AdminNotification
                {
                    Id = notificationId++,
                    Type = "System",
                    Title = "New Order",
                    Message = $"Order #{order.OrderNumber} from {order.CustomerName} is pending approval. Amount: ₱{order.TotalAmount:N2}",
                    TimeAgo = GetTimeAgo(order.OrderDate),
                    IsRead = false,
                    Priority = "High",
                    CreatedAt = order.OrderDate
                });
            }

            // Generate notifications from tickets (open/escalated)
            var openTickets = tickets.Where(t => 
                t.Status.Equals("Open", StringComparison.OrdinalIgnoreCase) || 
                t.Status.Equals("New", StringComparison.OrdinalIgnoreCase) ||
                t.Status.Equals("Escalated", StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(t => t.CreatedAt)
                .Take(5);
            
            foreach (var ticket in openTickets)
            {
                var priority = ticket.Priority.Equals("Critical", StringComparison.OrdinalIgnoreCase) ? "Critical" :
                              ticket.Priority.Equals("High", StringComparison.OrdinalIgnoreCase) ? "High" :
                              ticket.Status.Equals("Escalated", StringComparison.OrdinalIgnoreCase) ? "High" : "Medium";
                
                newNotifications.Add(new AdminNotification
                {
                    Id = notificationId++,
                    Type = "System",
                    Title = "Support Ticket",
                    Message = $"Ticket #{ticket.TicketNumber}: {ticket.Title} - Status: {ticket.Status}",
                    TimeAgo = GetTimeAgo(ticket.CreatedAt),
                    IsRead = false,
                    Priority = priority,
                    CreatedAt = ticket.CreatedAt
                });
            }

            // Generate notifications from products (low stock)
            var lowStockProducts = products.Where(p => p.StockQuantity <= 10 && p.StockQuantity > 0)
                .OrderBy(p => p.StockQuantity)
                .Take(5);
            
            foreach (var product in lowStockProducts)
            {
                var priority = product.StockQuantity == 0 ? "Critical" : "High";
                newNotifications.Add(new AdminNotification
                {
                    Id = notificationId++,
                    Type = "System",
                    Title = "Inventory Alert",
                    Message = $"Product '{product.Name}' (SKU: {product.SKU}) is running low. Current stock: {product.StockQuantity} units",
                    TimeAgo = GetTimeAgo(product.CreatedAt),
                    IsRead = false,
                    Priority = priority,
                    CreatedAt = product.CreatedAt
                });
            }

            // Out of stock products (Critical priority)
            var outOfStockProducts = products.Where(p => p.StockQuantity <= 0)
                .Take(5);
            
            foreach (var product in outOfStockProducts)
            {
                newNotifications.Add(new AdminNotification
                {
                    Id = notificationId++,
                    Type = "System",
                    Title = "Out of Stock Alert",
                    Message = $"Product '{product.Name}' (SKU: {product.SKU}) is out of stock. Immediate restocking required.",
                    TimeAgo = GetTimeAgo(product.CreatedAt),
                    IsRead = false,
                    Priority = "Critical",
                    CreatedAt = product.CreatedAt
                });
            }

            Notifications = newNotifications.OrderByDescending(n => n.CreatedAt).ToList();
            lastRefreshTime = DateTime.Now;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
        }
    }

    private IEnumerable<AdminNotification> FilteredNotifications => Filter switch
    {
        "Unread" => Notifications.Where(n => !n.IsRead),
        "Critical" => Notifications.Where(n => n.Priority == "Critical"),
        _ => Notifications
    };

    private void MarkRead(AdminNotification note) => note.IsRead = true;
    private void MarkAllRead() { foreach (var note in Notifications) note.IsRead = true; }

    private string GetBorderClass(string type) => type switch
    {
        "System" => "border-red-500",
        "Security" => "border-indigo-500",
        "User" => "border-green-500",
        _ => "border-blue-500"
    };

    private string GetBadgeClass(string priority) => priority switch
    {
        "Critical" => "bg-red-100 text-red-700",
        "High" => "bg-orange-100 text-orange-700",
        "Medium" => "bg-blue-100 text-blue-700",
        _ => "bg-gray-100 text-gray-700"
    };

    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;

        if (timeSpan.TotalMinutes < 1)
            return "Just now";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes}m ago";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours}h ago";
        if (timeSpan.TotalDays < 7)
            return $"{(int)timeSpan.TotalDays}d ago";
        
        return dateTime.ToString("MMM dd");
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    public class AdminNotification
    {
        public int Id { get; set; }
        public string Type { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
        public string TimeAgo { get; set; } = string.Empty;
        public bool IsRead { get; set; }
        public string Priority { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
    }
}
