@page "/admin/audit-logs"
@layout AdminLayout
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Audit Logs - SupportFlow</PageTitle>

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Audit Logs</h1>
            <p class="text-gray-600 mt-1">System activity and security logs</p>
        </div>
        <div class="flex space-x-3">
            <button @onclick="ExportLogs" class="btn btn-secondary">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export Logs
            </button>
            <button @onclick="ClearLogs" class="btn btn-danger">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Clear Logs
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(exportMessage))
    {
        <div class="p-4 bg-green-50 border border-green-200 rounded-lg text-sm text-green-800 font-medium">
            @exportMessage
        </div>
    }

    <!-- Filters -->
    <div class="card p-6">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-700">Date Range</label>
                <select @bind="selectedDateRange" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" @onselectedIndexChanged="FilterLogs">
                    <option value="today">Today</option>
                    <option value="week">Last 7 Days</option>
                    <option value="month">Last 30 Days</option>
                    <option value="all">All Time</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">Action Type</label>
                <select @bind="selectedAction" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" @onselectedIndexChanged="FilterLogs">
                    <option value="">All Actions</option>
                    <option value="login">Login</option>
                    <option value="logout">Logout</option>
                    <option value="create">Create</option>
                    <option value="update">Update</option>
                    <option value="delete">Delete</option>
                    <option value="export">Export</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700">User</label>
                <select @bind="selectedUser" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500" @onselectedIndexChanged="FilterLogs">
                    <option value="">All Users</option>
                    @foreach (var email in allLogs.Select(l => l.UserEmail).Where(e => !string.IsNullOrEmpty(e)).Distinct())
                    {
                        <option value="@email">@email</option>
                    }
                </select>
            </div>
            <div class="flex items-end">
                <button @onclick="FilterLogs" class="w-full px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors">
                    Apply Filters
                </button>
            </div>
        </div>
    </div>

    <!-- Log Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="stat-card">
            <div class="flex items-center">
                <div class="p-3 bg-blue-100 rounded-lg">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Total Logs</p>
                    <p class="text-2xl font-bold text-gray-900">1,247</p>
                    <p class="text-xs text-blue-600">Last 24 hours</p>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="flex items-center">
                <div class="p-3 bg-green-100 rounded-lg">
                    <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Success</p>
                    <p class="text-2xl font-bold text-gray-900">1,089</p>
                    <p class="text-xs text-green-600">87.3% success rate</p>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="flex items-center">
                <div class="p-3 bg-yellow-100 rounded-lg">
                    <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Warnings</p>
                    <p class="text-2xl font-bold text-gray-900">142</p>
                    <p class="text-xs text-yellow-600">Needs attention</p>
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="flex items-center">
                <div class="p-3 bg-red-100 rounded-lg">
                    <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm font-medium text-gray-600">Errors</p>
                    <p class="text-2xl font-bold text-gray-900">16</p>
                    <p class="text-xs text-red-600">Critical issues</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-semibold text-gray-900">Recent Activity</h3>
            <div class="flex items-center space-x-2">
                <span class="text-sm text-gray-500">Showing @filteredLogs.Count of @allLogs.Count entries</span>
                <button @onclick="RefreshLogs" class="text-blue-600 hover:text-blue-700">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Timestamp</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Details</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var log in pagedLogs)
                    {
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @log.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div class="w-6 h-6 bg-blue-500 rounded-full flex items-center justify-center mr-2">
                                        <span class="text-white text-xs font-medium">@log.UserEmail?.FirstOrDefault()</span>
                                    </div>
                                    <span class="text-sm text-gray-900">@log.UserEmail</span>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                    @log.Action
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @log.Description
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @log.Details
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (filteredLogs.Any())
        {
            <div class="mt-4 flex items-center justify-between">
                <span class="text-sm text-gray-500">Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, filteredLogs.Count) of @filteredLogs.Count · Page @currentPage/@totalPages</span>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= totalPages)" class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<AuditLog> allLogs = new();
    private List<AuditLog> filteredLogs = new();
    private string selectedDateRange = "week";
    private string selectedAction = "";
    private string selectedUser = "";
    private string exportMessage = "";
    private int currentPage = 1;
    private const int pageSize = 25;
    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredLogs.Count / (double)pageSize));
    private List<AuditLog> pagedLogs => filteredLogs
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAuditLogs();
    }

    private async Task LoadAuditLogs()
    {
        allLogs = await ApiClient.GetAuditLogsAsync() ?? new List<AuditLog>();
        FilterLogs();
    }

    private void FilterLogs()
    {
        filteredLogs = allLogs.Where(log =>
            (selectedDateRange == "all" ||
             (selectedDateRange == "today" && log.Timestamp.Date == DateTime.Today) ||
             (selectedDateRange == "week" && log.Timestamp >= DateTime.Now.AddDays(-7)) ||
             (selectedDateRange == "month" && log.Timestamp >= DateTime.Now.AddDays(-30))) &&
            (string.IsNullOrEmpty(selectedAction) || log.Action.Equals(selectedAction, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(selectedUser) || log.UserEmail.Contains(selectedUser, StringComparison.OrdinalIgnoreCase))
        ).OrderByDescending(l => l.Timestamp).ToList();
        currentPage = 1;
    }

    private async Task ExportLogs()
    {
        exportMessage = $"Export completed: {filteredLogs.Count} log entries ready. ({DateTime.Now:HH:mm:ss})";
        StateHasChanged();
        await Task.Delay(3000);
        exportMessage = "";
        StateHasChanged();
    }

    private void ClearLogs()
    {
        allLogs.Clear();
        filteredLogs.Clear();
        currentPage = 1;
        StateHasChanged();
    }

    private async Task RefreshLogs()
    {
        await LoadAuditLogs();
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
    }
}
