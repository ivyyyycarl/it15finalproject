@page "/admin/users"
@page "/admin/users/roles"
@page "/admin/users/deactivate"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>User Management - ClassicFit Pro</PageTitle>

<div class="space-y-6 p-6 lg:p-8 max-w-[1600px] mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl lg:text-3xl font-bold text-slate-800 tracking-tight">User Management</h1>
            <p class="text-slate-500 mt-1 text-sm lg:text-base">Manage user accounts, roles, and access permissions</p>
        </div>
        <button @onclick="ShowCreateUserModal"
            class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-xl shadow-sm flex items-center transition-colors">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add User
        </button>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="bg-emerald-50 border border-emerald-200 rounded-xl p-4 flex items-start gap-3 animate-fade-in">
            <svg class="w-5 h-5 text-emerald-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
                <p class="text-sm font-semibold text-emerald-800">Account Created Successfully</p>
                <p class="text-sm text-emerald-700 mt-0.5">@successMessage</p>
            </div>
            <button @onclick='() => { successMessage = null; StateHasChanged(); }' class="ml-auto text-emerald-400 hover:text-emerald-600">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    <!-- View Tabs -->
    <div class="flex items-center gap-6 border-b border-slate-200 mb-6">
        <button
            class="pb-3 px-1 font-semibold text-sm transition-all relative @(ActiveTab == "All" ? "text-indigo-600" : "text-slate-500 hover:text-slate-700")"
            @onclick='() => SetTab("All")'>
            All Users
            @if (ActiveTab == "All")
            {
                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 rounded-t-full"></span>
            }
        </button>
        <button
            class="pb-3 px-1 font-semibold text-sm transition-all relative @(ActiveTab == "Roles" ? "text-indigo-600" : "text-slate-500 hover:text-slate-700")"
            @onclick='() => SetTab("Roles")'>
            Assign Roles
            @if (ActiveTab == "Roles")
            {
                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 rounded-t-full"></span>
            }
        </button>
        <button
            class="pb-3 px-1 font-semibold text-sm transition-all relative @(ActiveTab == "Deactivate" ? "text-indigo-600" : "text-slate-500 hover:text-slate-700")"
            @onclick='() => SetTab("Deactivate")'>
            Deactivate Accounts
            @if (ActiveTab == "Deactivate")
            {
                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 rounded-t-full"></span>
            }
        </button>
    </div>

    <!-- Stats Overview -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        <div class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Total Users</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@totalUserCount</h3>
                </div>
                <div class="p-2.5 bg-indigo-50 rounded-xl text-indigo-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Active</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@totalUserCount</h3>
                </div>
                <div class="p-2.5 bg-emerald-50 rounded-xl text-emerald-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Admins</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@users.Count(u => u.Role == UserRole.Admin)</h3>
                </div>
                <div class="p-2.5 bg-purple-50 rounded-xl text-purple-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Agents</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@users.Count(u => u.Role == UserRole.Agent)</h3>
                </div>
                <div class="p-2.5 bg-amber-50 rounded-xl text-amber-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- User Table -->
    <div class="bg-white rounded-xl lg:rounded-2xl shadow-sm border border-slate-100 p-6">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-6">
            <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="relative flex-1 md:w-64">
                    <input value="@searchQuery" @oninput="OnSearchInput" type="text"
                        class="pl-10 pr-4 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 w-full bg-slate-50/50"
                        placeholder="Search users...">
                    <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-slate-400" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
                <select @bind="selectedRoleEnum" @bind:after="FilterUsers"
                    class="px-3 py-2.5 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500/30 focus:border-indigo-500 bg-slate-50/50">
                    <option value="">All Roles</option>
                    <option value="@UserRole.Admin">Admin</option>
                    <option value="@UserRole.Agent">Agent</option>
                    <option value="@UserRole.Supervisor">Supervisor</option>
                    <option value="@UserRole.Customer">Customer</option>
                </select>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            <button @onclick='() => SetSort("name")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                User <span class="text-[10px]">@GetSortIndicator("name")</span>
                            </button>
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            <button @onclick='() => SetSort("role")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                Role <span class="text-[10px]">@GetSortIndicator("role")</span>
                            </button>
                        </th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            Branch</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            Status</th>
                        <th class="px-6 py-3 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            <button @onclick='() => SetSort("createdAt")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                Created <span class="text-[10px]">@GetSortIndicator("createdAt")</span>
                            </button>
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-semibold text-slate-600 uppercase tracking-wider">
                            Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var user in filteredUsers)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center">
                                    <div
                                        class="w-10 h-10 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center shadow-sm">
                                        <span
                                            class="text-white font-bold text-sm">@user.FirstName?.FirstOrDefault()@user.LastName?.FirstOrDefault()</span>
                                    </div>
                                    <div class="ml-4">
                                        <div class="text-sm font-semibold text-gray-900">@user.FirstName @user.LastName
                                        </div>
                                        <div class="text-sm text-gray-500">@user.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span
                                    class="px-2.5 py-1 text-xs font-bold leading-5 rounded-full 
                                    @(user.Role == UserRole.Admin ? "bg-purple-100 text-purple-800" : 
                                      user.Role == UserRole.Agent ? "bg-blue-100 text-blue-800" : 
                                      user.Role == UserRole.Supervisor ? "bg-yellow-100 text-yellow-800" : "bg-gray-100 text-gray-800")">
                                    @user.Role
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span class="inline-flex items-center px-2.5 py-1 text-xs font-semibold rounded-full border border-indigo-100 bg-indigo-50 text-indigo-700">
                                    @FormatBranchLabel(user)
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <span
                                    class="px-2.5 py-1 text-xs font-bold leading-5 bg-green-100 text-green-800 rounded-full">
                                    Active
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                @user.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                @if (ActiveTab == "Deactivate")
                                {
                                    <button @onclick="() => DeleteUser(user)"
                                        class="text-red-600 hover:text-red-900 bg-red-50 hover:bg-red-100 px-3 py-1 rounded-md transition-colors">
                                        Deactivate
                                    </button>
                                }
                                else if (ActiveTab == "Roles")
                                {
                                    <button @onclick="() => EditUser(user)"
                                        class="text-indigo-600 hover:text-indigo-900 bg-indigo-50 hover:bg-indigo-100 px-3 py-1 rounded-md transition-colors">
                                        Change Role
                                    </button>
                                }
                                else
                                {
                                    <div class="flex justify-end space-x-2">
                                        <button @onclick="() => EditUser(user)"
                                            class="text-blue-600 hover:text-blue-900">Edit</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-4 flex items-center justify-between">
            <p class="text-sm text-slate-500">Showing @(filteredUsers.Any() ? (((currentPage - 1) * pageSize) + 1) : 0)-@Math.Min(currentPage * pageSize, totalUserCount) of @totalUserCount users · Page @currentPage/@totalPages</p>
            <div class="flex items-center gap-2">
                <button @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                    class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    Previous
                </button>
                <button @onclick="NextPage" disabled="@(currentPage >= totalPages)"
                    class="px-3 py-1.5 rounded-lg border border-slate-200 text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                    Next
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Create/Edit User Modal -->
@if (showUserModal)
{
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-white rounded-xl shadow-xl p-6 w-full max-w-md transform transition-all">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-bold text-gray-900">
                    @(editingUser != null ? "Edit User" : "Create New User")
                </h3>
                <button @onclick="HideUserModal" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="space-y-4">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="p-3 bg-red-50 border border-red-200 rounded-lg flex items-start gap-3">
                        <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-sm text-red-600 font-medium">@errorMessage</span>
                    </div>
                }

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                        <input @bind="userForm.FirstName" type="text" required
                            class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                        <input @bind="userForm.LastName" type="text" required
                            class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input @bind="userForm.Email" type="email" required
                        class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                    @if (editingUser != null)
                    {
                        <select @bind="userForm.Role"
                            class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                            <option value="@UserRole.Agent">Agent</option>
                            <option value="@UserRole.Supervisor">Supervisor</option>
                            <option value="@UserRole.Admin">Admin</option>
                            <option value="@UserRole.Customer">Customer</option>
                            <option value="@UserRole.SuperAdmin">SuperAdmin</option>
                        </select>
                    }
                    else
                    {
                        <select @bind="userForm.Role"
                            class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                            @foreach (var role in allowedRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <p class="text-[10px] text-gray-400 mt-1 flex items-center">
                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            Available roles based on your permissions. Email notification will be sent.
                        </p>
                    }
                </div>

                @if (editingUser == null)
                {
                    <div class="rounded-lg border border-indigo-100 bg-indigo-50/60 px-3 py-2 text-xs text-indigo-700">
                        <span class="font-semibold">Branch auto-assignment:</span> @GetCreateBranchLabel()
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
                        <input @bind="userForm.Password" type="password" required
                            class="block w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 transition-colors">
                    </div>
                }

                <div class="flex justify-end space-x-3 pt-6">
                    <button type="button" @onclick="HideUserModal"
                        class="px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 font-medium transition-colors">
                        Cancel
                    </button>
                    <button type="button" @onclick="SaveUser" disabled="@isSaving"
                        class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium shadow-sm transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2">
                        @if (isSaving)
                        {
                            <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none"
                                viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4">
                                </circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                            <span>@(editingUser != null ? "Updating..." : "Creating...")</span>
                        }
                        else
                        {
                            <span>@(editingUser != null ? "Update User" : "Create User")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? currentUser;
    private List<User> users = new();
    private List<User> filteredUsers = new();
    private string searchQuery = "";
    private UserRole? selectedRoleEnum;
    private bool showUserModal = false;
    private User? editingUser;
    private User userForm = new();
    private string ActiveTab = "All";
    private string? errorMessage;
    private string? successMessage;
    private bool isSaving = false;
    private List<UserRole> allowedRoles = new();
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalPages = 1;
    private int totalUserCount = 0;
    private string sortBy = "name";
    private string sortDir = "asc";
    private CancellationTokenSource? _searchDebounceCts;

    protected override async Task OnInitializedAsync()
    {
        currentUser = AuthService.CurrentUser;
        await LoadUsers();
    }

    protected override void OnParametersSet()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();

        if (relativePath.Contains("roles"))
        {
            SetTab("Roles", false);
        }
        else if (relativePath.Contains("deactivate"))
        {
            SetTab("Deactivate", false);
        }
        else
        {
            if (ActiveTab == "Roles" || ActiveTab == "Deactivate")
            {
                SetTab("All", false);
            }
        }
    }

    private void SetTab(string tab, bool updateUrl = true)
    {
        ActiveTab = tab;
        _ = FilterUsers(); // Re-apply server-side filter based on tab

        if (updateUrl)
        {
            if (tab == "Roles") NavigationManager.NavigateTo("/admin/users/roles");
            else if (tab == "Deactivate") NavigationManager.NavigateTo("/admin/users/deactivate");
            else NavigationManager.NavigateTo("/admin/users");
        }
    }

    private async Task LoadUsers()
    {
        var result = await ApiClient.GetUsersPagedAsync(currentPage, pageSize, searchQuery, selectedRoleEnum, true, sortBy, sortDir);
        users = result?.Items ?? new List<User>();
        filteredUsers = users;
        totalUserCount = result?.TotalCount ?? users.Count;
        totalPages = Math.Max(1, result?.TotalPages ?? 1);
    }

    private async Task FilterUsers()
    {
        currentPage = 1;
        await LoadUsers();
    }

    private async Task SetSort(string field)
    {
        if (string.Equals(sortBy, field, StringComparison.OrdinalIgnoreCase))
        {
            sortDir = sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            sortBy = field;
            sortDir = "asc";
        }

        await FilterUsers();
    }

    private string GetSortIndicator(string field)
    {
        if (!string.Equals(sortBy, field, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return sortDir == "asc" ? "ASC" : "DESC";
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        await DebouncedFilterUsersAsync();
    }

    private async Task DebouncedFilterUsersAsync()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(400, token);
            if (token.IsCancellationRequested) return;
            await FilterUsers();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
        await LoadUsers();
    }

    private async Task NextPage()
    {
        if (currentPage >= totalPages) return;
        currentPage++;
        await LoadUsers();
    }

    private void ShowCreateUserModal()
    {
        editingUser = null;
        userForm = new User();
        errorMessage = null;
        userForm.BranchId = currentUser?.BranchId;
        userForm.BranchName = currentUser?.BranchName;

        // Build allowed roles based on hierarchy:
        // SuperAdmin -> Admin, Admin -> Supervisor/Agent, Supervisor -> Agent
        allowedRoles = new List<UserRole>();
        if (currentUser?.Role == UserRole.SuperAdmin)
        {
            allowedRoles.Add(UserRole.Admin);
            userForm.Role = UserRole.Admin;
        }
        else if (currentUser?.Role == UserRole.Admin)
        {
            allowedRoles.Add(UserRole.Supervisor);
            allowedRoles.Add(UserRole.Agent);
            userForm.Role = UserRole.Supervisor;
        }
        else
        {
            allowedRoles.Add(UserRole.Agent);
            userForm.Role = UserRole.Agent;
        }

        showUserModal = true;
        StateHasChanged();
    }

    private void EditUser(User user)
    {
        editingUser = user;
        userForm = new User
            {
                Id = user.Id,
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email,
                Role = user.Role,
                IsActive = user.IsActive
            };
        errorMessage = null;
        showUserModal = true;
    }

    private void HideUserModal()
    {
        showUserModal = false;
        editingUser = null;
        userForm = new User();
    }

    private async Task SaveUser()
    {
        Console.WriteLine($"[DEBUG] SaveUser called. Editing: {editingUser != null}");

        // Manual validation since we switched to @onclick
        if (string.IsNullOrWhiteSpace(userForm.FirstName) ||
        string.IsNullOrWhiteSpace(userForm.LastName) ||
        string.IsNullOrWhiteSpace(userForm.Email) ||
        (editingUser == null && string.IsNullOrWhiteSpace(userForm.Password)))
        {
            Console.WriteLine("[DEBUG] Validation failed: Some fields are empty.");
            errorMessage = "Please fill in all required fields.";
            StateHasChanged();
            return;
        }

        errorMessage = null;
        isSaving = true;
        StateHasChanged();
        try
        {
            Console.WriteLine($"[DEBUG] Sending request for role: {userForm.Role}");
            if (editingUser != null)
            {
                // Update existing user
                var updateDto = new UpdateUserDto
                    {
                        FirstName = userForm.FirstName,
                        LastName = userForm.LastName,
                        Email = userForm.Email,
                        Role = userForm.Role,
                        IsActive = userForm.IsActive
                    };

                var result = await ApiClient.UpdateUserAsync(editingUser.Id, updateDto);
                if (result != null)
                {
                    await LoadUsers();
                    HideUserModal();
                }
                else
                {
                    errorMessage = "Failed to update user. Please check your permissions or if the email is already in use.";
                }
            }
            else
            {
                if ((userForm.Role == UserRole.Supervisor || userForm.Role == UserRole.Agent || userForm.Role == UserRole.Admin)
                    && (userForm.BranchId is null || userForm.BranchId <= 0))
                {
                    errorMessage = "Your account does not have a branch assigned yet. Assign your branch first before creating staff users.";
                    isSaving = false;
                    StateHasChanged();
                    return;
                }

                var targetBranchLabel = GetCreateBranchLabel();
                var createConfirmed = await JSRuntime.InvokeAsync<bool>(
                    "confirm",
                    $"Create this {userForm.Role} account and assign branch {targetBranchLabel}?");
                if (!createConfirmed)
                {
                    isSaving = false;
                    StateHasChanged();
                    return;
                }

                var createDto = new CreateUserDto
                    {
                        FirstName = userForm.FirstName,
                        LastName = userForm.LastName,
                        Email = userForm.Email,
                        Password = userForm.Password,
                        Role = userForm.Role,
                        BranchId = userForm.BranchId
                    };

                var result = await ApiClient.CreateUserAsync(createDto);
                if (result != null)
                {
                    await LoadUsers();
                    HideUserModal();
                    successMessage = $"Account created for {createDto.FirstName} {createDto.LastName}. An email notification with login credentials has been sent to {createDto.Email}.";
                    StateHasChanged();
                    _ = Task.Delay(8000).ContinueWith(_ => { successMessage = null; InvokeAsync(StateHasChanged); });
                }
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"[DEBUG] API Error: {ex.Message}");
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
            Console.WriteLine($"[DEBUG] Unexpected Error: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteUser(User user)
    {
        if (await ApiClient.DeleteUserAsync(user.Id))
        {
            await LoadUsers();
        }
    }

    private static string FormatBranchLabel(User? user)
    {
        if (user is null || user.BranchId is null || user.BranchId <= 0)
        {
            return "Unassigned";
        }

        var branchName = string.IsNullOrWhiteSpace(user.BranchName) ? null : user.BranchName.Trim();
        return branchName is null
            ? $"#{user.BranchId}"
            : $"{branchName} (#{user.BranchId})";
    }

    private string GetCreateBranchLabel()
    {
        if (userForm.BranchId is null || userForm.BranchId <= 0)
        {
            return "Unassigned";
        }

        var branchName = string.IsNullOrWhiteSpace(userForm.BranchName) ? null : userForm.BranchName.Trim();
        return branchName is null
            ? $"#{userForm.BranchId}"
            : $"{branchName} (#{userForm.BranchId})";
    }

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
