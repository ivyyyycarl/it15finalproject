@page "/terms-and-conditions"
@layout Shared.AuthLayout

<PageTitle>Terms and Conditions - ClassicFit</PageTitle>

<div class="min-h-screen bg-slate-50 py-8 px-4">
    <div class="mx-auto max-w-4xl rounded-2xl border border-slate-200 bg-white p-6 md:p-8 shadow-sm">
        <div class="mb-6">
            <h1 class="text-2xl md:text-3xl font-bold text-slate-900">Terms and Conditions</h1>
            <p class="mt-2 text-sm text-slate-600">
                ClassicFit Apparel Fashion: Sales &amp; Support Workspace
            </p>
            <p class="text-xs text-slate-500">Effective date: @DateTime.Today.ToString("MMMM dd, yyyy")</p>
        </div>

        <div class="space-y-5 text-sm text-slate-700 leading-6">
            <section>
                <h2 class="text-base font-semibold text-slate-900">1. Acceptance of Terms</h2>
                <p>
                    By creating an account and using this system, you agree to follow these Terms and Conditions and all applicable laws and regulations.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">2. Account Responsibility</h2>
                <p>
                    You are responsible for maintaining the confidentiality of your account credentials and for all activities performed under your account.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">3. Acceptable Use</h2>
                <p>
                    You agree not to misuse the platform, attempt unauthorized access, disrupt system operations, or upload harmful content.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">4. Data and Privacy</h2>
                <p>
                    We process and store data required to operate sales, support, subscription, and branch management features. Access is role- and branch-scoped.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">5. Subscription and Billing</h2>
                <p>
                    Feature access depends on your active subscription plan. Missed or failed payments may limit or suspend access until the account is settled.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">6. Service Availability</h2>
                <p>
                    We aim for reliable availability but do not guarantee uninterrupted service at all times due to maintenance or external factors.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">7. Changes to Terms</h2>
                <p>
                    These terms may be updated from time to time. Continued use of the system after updates means you accept the revised terms.
                </p>
            </section>

            <section>
                <h2 class="text-base font-semibold text-slate-900">8. Contact</h2>
                <p>
                    For questions about these terms, contact
                    <a href="mailto:classicfitapparel.fashion@gmail.com" class="text-blue-600 hover:text-blue-700">classicfitapparel.fashion@gmail.com</a>.
                </p>
            </section>
        </div>

        <div class="mt-8">
            <a href="/register" class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800">
                Back to Registration
            </a>
        </div>
    </div>
</div>
