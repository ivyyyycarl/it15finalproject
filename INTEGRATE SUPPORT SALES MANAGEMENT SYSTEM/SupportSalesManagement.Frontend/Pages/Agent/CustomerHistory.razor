@page "/agent/customer-history/{customerId:int}"
@layout AgentLayout
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager

<PageTitle>Customer History - SupportFlow</PageTitle>

@if (customer != null)
{
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex items-center justify-between">
            <div class="flex items-center">
                <button @onclick="@(() => NavigationManager.NavigateTo("/agent/call-handling"))" class="mr-4 text-gray-600 hover:text-gray-900">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <div>
                    <h1 class="text-3xl font-bold text-gray-900">Customer History</h1>
                    <p class="text-gray-600 mt-1">@customer.FirstName @customer.LastName - Interaction Timeline</p>
                </div>
            </div>
            <div class="flex space-x-3">
                <button @onclick="StartCall" class="btn btn-primary">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    Start Call
                </button>
            </div>
        </div>

        <!-- Customer Profile Summary -->
        <div class="card p-6">
            <div class="flex items-start space-x-6">
                <div class="w-20 h-20 bg-blue-500 rounded-full flex items-center justify-center">
                    <span class="text-white text-2xl font-medium">@customer.FirstName?.FirstOrDefault()@customer.LastName?.FirstOrDefault()</span>
                </div>
                <div class="flex-1">
                    <h2 class="text-2xl font-bold text-gray-900">@customer.FirstName @customer.LastName</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-4">
                        <div>
                            <p class="text-sm text-gray-600">Email</p>
                            <p class="font-medium">@customer.Email</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Phone</p>
                            <p class="font-medium">@customer.Phone</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Company</p>
                            <p class="font-medium">@customer.Company</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">Customer Type</p>
                            <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                @customer.CustomerType
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Interaction Timeline -->
        <div class="card p-6">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">Interaction Timeline</h3>
            
            <div class="space-y-6">
                <!-- Calls -->
                <div>
                    <h4 class="text-md font-medium text-gray-700 mb-3 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        Phone Calls
                    </h4>
                    <div class="space-y-3">
                        @foreach (var call in callHistory)
                        {
                            <div class="border-l-4 border-green-500 pl-4 py-3 bg-green-50 rounded-r-lg">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">Phone Call</p>
                                        <p class="text-xs text-gray-500">@call.StartTime.ToString("MMM dd, yyyy HH:mm") - Duration: @call.Duration</p>
                                        @if (!string.IsNullOrEmpty(call.Notes))
                                        {
                                            <p class="text-sm text-gray-600 mt-1">@call.Notes</p>
                                        }
                                    </div>
                                    <span class="px-2 py-1 text-xs font-medium bg-green-100 text-green-800 rounded-full">
                                        @call.Status
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Tickets -->
                <div>
                    <h4 class="text-md font-medium text-gray-700 mb-3 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Support Tickets
                    </h4>
                    <div class="space-y-3">
                        @foreach (var ticket in ticketHistory)
                        {
                            <div class="border-l-4 border-blue-500 pl-4 py-3 bg-blue-50 rounded-r-lg">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">@ticket.Title</p>
                                        <p class="text-xs text-gray-500">Created: @ticket.CreatedAt.ToString("MMM dd, yyyy HH:mm")</p>
                                        <p class="text-sm text-gray-600 mt-1">@ticket.Description</p>
                                        <div class="mt-2">
                                            <span class="px-2 py-1 text-xs font-medium bg-blue-100 text-blue-800 rounded-full">
                                                @ticket.Status
                                            </span>
                                            <span class="px-2 py-1 text-xs font-medium bg-yellow-100 text-yellow-800 rounded-full ml-1">
                                                @ticket.Priority
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Orders -->
                <div>
                    <h4 class="text-md font-medium text-gray-700 mb-3 flex items-center">
                        <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        Orders
                    </h4>
                    <div class="space-y-3">
                        @foreach (var order in orderHistory)
                        {
                            <div class="border-l-4 border-purple-500 pl-4 py-3 bg-purple-50 rounded-r-lg">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">@order.OrderNumber</p>
                                        <p class="text-xs text-gray-500">Order Date: @order.OrderDate.ToString("MMM dd, yyyy")</p>
                                        <p class="text-sm text-gray-600 mt-1">Total: ₱@order.TotalAmount.ToString("N2")</p>
                                        @if (!string.IsNullOrEmpty(order.Notes))
                                        {
                                            <p class="text-sm text-gray-600 mt-1">@order.Notes</p>
                                        }
                                        <div class="mt-2">
                                            <span class="px-2 py-1 text-xs font-medium bg-purple-100 text-purple-800 rounded-full">
                                                @order.Status
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics Summary -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="card p-6 text-center">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900">@callHistory.Count</h3>
                <p class="text-sm text-gray-600">Total Calls</p>
            </div>

            <div class="card p-6 text-center">
                <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900">@ticketHistory.Count</h3>
                <p class="text-sm text-gray-600">Support Tickets</p>
            </div>

            <div class="card p-6 text-center">
                <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900">@orderHistory.Count</h3>
                <p class="text-sm text-gray-600">Orders Placed</p>
            </div>
        </div>
    </div>
}
else
{
    <div class="min-h-screen flex items-center justify-center bg-gray-50">
        <div class="text-center">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <h3 class="text-lg font-medium text-gray-900 mb-2">Customer Not Found</h3>
            <p class="text-gray-600 mb-4">The requested customer could not be found.</p>
            <button @onclick="@(() => NavigationManager.NavigateTo("/agent/call-handling"))" class="btn btn-primary">
                Back to Call Handling
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private Customer? customer;
    private List<CallLog> callHistory = new();
    private List<Ticket> ticketHistory = new();
    private List<Order> orderHistory = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomerData();
    }

    private async Task LoadCustomerData()
    {
        customer = await ApiClient.GetCustomerAsync(CustomerId);

        if (customer != null)
        {
            await LoadInteractionHistory();
        }
    }

    private async Task LoadInteractionHistory()
    {
        callHistory = (await ApiClient.GetCallsByCustomerAsync(CustomerId))?.Select(c => new CallLog
        {
            Id = c.Id,
            CustomerName = c.CustomerName,
            StartTime = c.StartTime,
            Duration = c.DurationFormatted,
            Notes = c.Notes ?? "",
            Status = c.Status
        }).ToList() ?? new List<CallLog>();

        ticketHistory = await ApiClient.GetTicketsByCustomerAsync(CustomerId) ?? new List<Ticket>();

        orderHistory = await ApiClient.GetOrdersByCustomerAsync(CustomerId) ?? new List<Order>();
    }

    private void StartCall()
    {
        NavigationManager.NavigateTo($"/agent/call-handling?customerId={CustomerId}");
    }

    public class CallLog
    {
        public long Id { get; set; }
        public string CustomerName { get; set; } = string.Empty;
        public DateTime StartTime { get; set; }
        public string Duration { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }
}
