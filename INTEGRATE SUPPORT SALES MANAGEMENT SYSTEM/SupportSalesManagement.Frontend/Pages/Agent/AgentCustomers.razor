@page "/agent/customers"
@page "/agent/customers/timeline"
@layout AgentLayout
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Customers | Agent Workspace</PageTitle>

@{
    currentView = GetCurrentView();
}

<div class="h-[calc(100vh-theme(spacing.16))] flex flex-col bg-gray-50 dark:bg-[#151521]" style="font-family: Inter, sans-serif; font-size: 12px;">
    <!-- Top Bar -->
    <div class="bg-white dark:bg-[#1E1E2D] border-b border-gray-200 dark:border-gray-700 px-6 py-4 flex items-center justify-between shrink-0">
        <div>
            <h1 class="text-[21px] font-bold text-[#1E1E2D] dark:text-white">Customer Directory</h1>
            <p class="text-[12px] text-gray-500 dark:text-gray-400">Manage profiles and view interaction history</p>
        </div>
        <div class="flex bg-gray-100 dark:bg-[#2A2A35] p-1 rounded-lg">
             <button @onclick='() => NavigateTo("search")' 
                class="px-4 py-2 rounded-md text-sm font-bold transition-all @(currentView == "search" ? "bg-white dark:bg-[#32323F] text-[var(--color-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                Search Profiles
            </button>
            <button @onclick='() => NavigateTo("timeline")'
                class="px-4 py-2 rounded-md text-sm font-bold transition-all @(currentView == "timeline" ? "bg-white dark:bg-[#32323F] text-[var(--color-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                Global Timeline
            </button>
        </div>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-hidden relative p-6">
        @if (currentView == "search")
        {
            <div class="flex flex-col h-full space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="rounded-xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-4 shadow-sm">
                        <div class="flex items-center justify-between mb-1">
                            <p class="text-xs font-bold uppercase tracking-wider text-blue-600">Total Customers</p>
                            <span class="text-base">👥</span>
                        </div>
                        <p class="text-2xl font-extrabold text-[#1E1E2D]">@AllCustomers.Count</p>
                    </div>
                    <div class="rounded-xl border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white p-4 shadow-sm">
                        <div class="flex items-center justify-between mb-1">
                            <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">Active</p>
                            <span class="text-base">✅</span>
                        </div>
                        <p class="text-2xl font-extrabold text-emerald-700">@AllCustomers.Count(c => c.IsActive)</p>
                    </div>
                    <div class="rounded-xl border border-violet-100 bg-gradient-to-br from-violet-50 to-white p-4 shadow-sm">
                        <div class="flex items-center justify-between mb-1">
                            <p class="text-xs font-bold uppercase tracking-wider text-violet-700">Business Accounts</p>
                            <span class="text-base">🏢</span>
                        </div>
                        <p class="text-2xl font-extrabold text-violet-700">@AllCustomers.Count(c => (c.CustomerType ?? "").Equals("Business", StringComparison.OrdinalIgnoreCase))</p>
                    </div>
                </div>

                 <!-- Search Bar -->
                 <div class="bg-white dark:bg-[#1E1E2D] p-4 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 flex gap-4">
                     <div class="relative flex-1">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                        </span>
                        <input type="text" value="@searchInput" @oninput="OnSearchInput" placeholder="Search by name, email, or company..." 
                            class="block w-full pl-10 pr-3 py-2.5 bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-lg focus:ring-2 focus:ring-[var(--color-primary)] text-gray-900 dark:text-white" />
                     </div>
                 </div>

                 <!-- Customer List -->
                 <div class="bg-white dark:bg-[#1E1E2D] rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden flex-1 overflow-y-auto">
                    <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
                        <thead class="bg-gradient-to-r from-gray-50 to-blue-50/40 dark:bg-[#25252b]">
                            <tr>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Customer</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Contact</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Type</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Branch</th>
                                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
                                <th class="px-6 py-4 text-right text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                            @if (IsLoading)
                            {
                                <tr><td colspan="6" class="px-6 py-10 text-center"><div class="flex justify-center"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--color-primary)]"></div></div></td></tr>
                            }
                            else if (!FilteredCustomers.Any())
                            {
                                <tr><td colspan="6" class="px-6 py-10 text-center text-gray-500 dark:text-gray-400">No customers found matching your search.</td></tr>
                            }
                            else
                            {
                                @foreach (var customer in PagedFilteredCustomers)
                                {
                                    <tr class="hover:bg-blue-50/30 dark:hover:bg-white/5 transition-colors group">
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="flex items-center">
                                                <div class="h-10 w-10 rounded-full bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-[var(--color-primary)] font-bold text-sm">
                                                    @customer.FirstName.FirstOrDefault()@customer.LastName.FirstOrDefault()
                                                </div>
                                                <div class="ml-4">
                                                    <div class="text-sm font-bold text-[#1E1E2D] dark:text-white">@customer.FirstName @customer.LastName</div>
                                                    <div class="text-xs text-gray-500 dark:text-gray-400">@customer.Company</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <div class="text-sm text-gray-600 dark:text-gray-300">@customer.Email</div>
                                            <div class="text-xs text-gray-400">@customer.Phone</div>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="px-2.5 py-1 inline-flex items-center gap-1.5 text-xs leading-5 font-bold rounded-lg bg-blue-50 text-[var(--color-primary)] dark:bg-blue-900/20 dark:text-blue-300 border border-blue-100 dark:border-blue-900/30">
                                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                                @customer.CustomerType
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="px-2.5 py-1 inline-flex items-center gap-1.5 text-xs leading-5 font-semibold rounded-lg bg-violet-50 text-violet-700 border border-violet-100 dark:bg-violet-900/20 dark:text-violet-300 dark:border-violet-900/30">
                                                @GetCustomerBranchLabel(customer)
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                             <span class="px-2.5 py-1 inline-flex items-center gap-1.5 text-xs leading-5 font-bold rounded-lg @(customer.IsActive ? "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300" : "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300")">
                                                <span class="w-1.5 h-1.5 rounded-full @(customer.IsActive ? "bg-green-500" : "bg-gray-400")"></span>
                                                @(customer.IsActive ? "Active" : "Inactive")
                                             </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                            <button @onclick="() => ViewProfile(customer.Id)" class="px-2.5 py-1 rounded-lg border border-blue-100 bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold transition-colors">
                                                View Profile
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                 </div>
                 @if (FilteredCustomersList.Any())
                 {
                     <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between bg-white dark:bg-[#1E1E2D] rounded-b-xl">
                         <p class="text-sm text-gray-500 dark:text-gray-400">
                             Showing @(((customerCurrentPage - 1) * customerPageSize) + 1)-@Math.Min(customerCurrentPage * customerPageSize, FilteredCustomersList.Count) of @FilteredCustomersList.Count · Page @customerCurrentPage/@CustomerTotalPages
                         </p>
                         <div class="flex items-center gap-2">
                             <button type="button" @onclick="PreviousCustomerPage" disabled="@(customerCurrentPage <= 1)"
                                     class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                             <button type="button" @onclick="NextCustomerPage" disabled="@(customerCurrentPage >= CustomerTotalPages)"
                                     class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                         </div>
                     </div>
                 }
            </div>
        }
        else if (currentView == "timeline")
        {
            <div class="flex flex-col h-full overflow-hidden">
                <div class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 flex-1 overflow-y-auto">
                    <h2 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-6">Recent Customer Activity (Global Feed)</h2>
                    @if (!timelineItems.Any())
                    {
                        <p class="text-gray-500 text-center py-8">No recent activity found.</p>
                    }
                    else
                    {
                        <div class="space-y-4">
                            @foreach (var item in timelineItems)
                            {
                                <div class="flex items-start gap-4 p-4 bg-gradient-to-r from-gray-50 to-blue-50/30 dark:bg-[#25252b] rounded-xl border border-gray-100 dark:border-gray-700">
                                    <div class="flex items-center justify-center w-10 h-10 rounded-full bg-white dark:bg-[#1E1E2D] shadow shrink-0">
                                        @if(item.Type == "Order") { <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg> }
                                        else { <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg> }
                                    </div>
                                    <div class="flex-1">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="font-bold text-[#1E1E2D] dark:text-white">@item.Title</span>
                                            <span class="text-xs text-gray-400">@item.Date.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <p class="text-sm text-gray-500 dark:text-gray-400">
                                            <span class="font-medium text-[var(--color-primary)]">@item.CustomerName</span> — @item.Description
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services

@code {
    private List<Customer> AllCustomers = new();
    private List<TimelineEntry> timelineItems = new();
    private string SearchQuery = "";
    private string searchInput = "";
    private bool IsLoading = true;
    private string currentView = "search";
    private readonly Debouncer _searchDebouncer = new();
    private int customerCurrentPage = 1;
    private const int customerPageSize = 15;
    private Dictionary<int, string> customerBranchLabels = new();
    
    private string GetCurrentView()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
        if (relativePath.Contains("timeline")) return "timeline";
        return "search";
    }

    private void NavigateTo(string view)
    {
        currentView = view;
        if (view == "search") NavigationManager.NavigateTo("/agent/customers");
        else NavigationManager.NavigateTo($"/agent/customers/{view}");
    }

    private IEnumerable<Customer> FilteredCustomers => AllCustomers
        .Where(c => string.IsNullOrEmpty(SearchQuery) 
                    || c.FirstName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) 
                    || c.LastName.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
                    || c.Email.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
                    || (c.Company != null && c.Company.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)));
    private List<Customer> FilteredCustomersList => FilteredCustomers.ToList();
    private int CustomerTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCustomersList.Count / (double)customerPageSize));
    private List<Customer> PagedFilteredCustomers => FilteredCustomersList
        .Skip((customerCurrentPage - 1) * customerPageSize)
        .Take(customerPageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        currentView = GetCurrentView();
        await LoadCustomers();
        await LoadTimeline();
    }

    private async Task LoadCustomers()
    {
        IsLoading = true;
        try
        {
            var customers = await ApiClient.GetCustomersAsync();
            AllCustomers = customers ?? new List<Customer>();
            await BuildCustomerBranchMapAsync();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task BuildCustomerBranchMapAsync()
    {
        customerBranchLabels = new Dictionary<int, string>();

        try
        {
            var users = await ApiClient.GetUsersAsync();
            if (users == null)
            {
                return;
            }

            var usersById = users.ToDictionary(u => u.Id);
            foreach (var customer in AllCustomers)
            {
                if (customer.UserId is int userId && usersById.TryGetValue(userId, out var user))
                {
                    customerBranchLabels[customer.Id] = FormatBranchLabel(user.BranchId, user.BranchName);
                }
            }
        }
        catch
        {
        }
    }

    private string GetCustomerBranchLabel(Customer customer)
    {
        return customerBranchLabels.TryGetValue(customer.Id, out var label) ? label : "Unassigned";
    }

    private static string FormatBranchLabel(int? branchId, string? branchName)
    {
        if (branchId is null || branchId <= 0)
        {
            return "Unassigned";
        }

        var normalizedName = string.IsNullOrWhiteSpace(branchName) ? null : branchName.Trim();
        return normalizedName is null ? $"#{branchId}" : $"{normalizedName} (#{branchId})";
    }

    private async Task LoadTimeline()
    {
        var items = new List<TimelineEntry>();
        var customerMap = AllCustomers.ToDictionary(c => c.Id, c => $"{c.FirstName} {c.LastName}");

        var orders = await ApiClient.GetOrdersAsync();
        if (orders != null)
        {
            foreach (var o in orders.OrderByDescending(o => o.OrderDate).Take(10))
            {
                items.Add(new TimelineEntry
                {
                    Type = "Order",
                    Title = $"Order #{o.OrderNumber}",
                    CustomerName = customerMap.GetValueOrDefault(o.CustomerId, $"Customer #{o.CustomerId}"),
                    Description = $"₱{o.TotalAmount:N2} — {o.Status}",
                    Date = o.OrderDate
                });
            }
        }

        var tickets = await ApiClient.GetTicketsAsync();
        if (tickets != null)
        {
            foreach (var t in tickets.OrderByDescending(t => t.CreatedAt).Take(10))
            {
                items.Add(new TimelineEntry
                {
                    Type = "Ticket",
                    Title = t.Title,
                    CustomerName = !string.IsNullOrEmpty(t.CustomerName) ? t.CustomerName : customerMap.GetValueOrDefault(t.CustomerId, $"Customer #{t.CustomerId}"),
                    Description = $"{t.Priority} — {t.Status}",
                    Date = t.CreatedAt
                });
            }
        }

        timelineItems = items.OrderByDescending(i => i.Date).Take(15).ToList();
    }

    private void ViewProfile(int id) => NavigationManager.NavigateTo($"/agent/customer-history/{id}");

    private class TimelineEntry
    {
        public string Type { get; set; } = "";
        public string Title { get; set; } = "";
        public string CustomerName { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime Date { get; set; }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await _searchDebouncer.DebounceAsync(async () =>
        {
            SearchQuery = searchInput;
            customerCurrentPage = 1;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void PreviousCustomerPage()
    {
        if (customerCurrentPage <= 1) return;
        customerCurrentPage--;
    }

    private void NextCustomerPage()
    {
        if (customerCurrentPage >= CustomerTotalPages) return;
        customerCurrentPage++;
    }

    public void Dispose()
    {
        _searchDebouncer.Dispose();
    }
}
