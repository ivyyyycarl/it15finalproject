@page "/agent/dashboard"
@layout AgentLayout

@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@using System.Globalization
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Agent Workspace - ClassicFit</PageTitle>

<div class="ag-container" style="font-family: Inter, sans-serif; font-size: 12px;">

    <!-- ===== HEADER ===== -->
    <div class="ag-header">
        <div>
            <div class="ag-title-row">
                <div class="ag-avatar-dot @(CurrentStatus == "Available" ? "dot-green" : "dot-amber")"></div>
                <h1 class="ag-title">Agent Workspace</h1>
                <span class="ag-role-badge">Support Agent</span>
            </div>
            <p class="ag-subtitle">Your tickets, performance &amp; activity at a glance</p>
        </div>
        <div class="ag-header-actions">
            <div class="ag-status-toggle">
                <button class="ag-status-btn @(CurrentStatus == "Available" ? "status-active" : "")" @onclick='() => SetStatus("Available")'>
                    <span class="status-dot dot-green"></span> Available
                </button>
                <button class="ag-status-btn @(CurrentStatus == "Busy" ? "status-busy" : "")" @onclick='() => SetStatus("Busy")'>
                    <span class="status-dot dot-amber"></span> Busy
                </button>
            </div>
            <button class="ag-refresh-btn" @onclick="RefreshData">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                Refresh
            </button>
        </div>
    </div>

    <!-- ===== STAT CARDS ===== -->
    <div class="ag-sc-grid">

        <!-- Open Tickets -->
        <div class="ag-sc-card">
            <div class="ag-sc-top">
                <div>
                    <p class="ag-sc-label">My Open Tickets</p>
                    <p class="ag-sc-value">@myStats.OpenTickets</p>
                    @if (myStats.UrgentTickets > 0)
                    {
                        <div class="ag-sc-change change-down">
                            <svg viewBox="0 0 12 12" class="ag-sc-arrow"><path d="M1 3 L6 9 L11 3" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
                            <span>@myStats.UrgentTickets urgent</span>
                        </div>
                    }
                    else
                    {
                        <div class="ag-sc-change change-up"><span>All priorities normal</span></div>
                    }
                </div>
                <div class="ag-sc-icon ag-sc-icon-blue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                </div>
            </div>
            <svg class="ag-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
                <defs><linearGradient id="ag-g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3"/><stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/></linearGradient></defs>
                <path d="M0 30 C30 28 50 24 80 20 C110 16 140 22 170 15 C185 11 195 8 200 6" fill="none" stroke="#3b82f6" stroke-width="1.5"/>
                <path d="M0 30 C30 28 50 24 80 20 C110 16 140 22 170 15 C185 11 195 8 200 6 L200 40 L0 40 Z" fill="url(#ag-g1)"/>
            </svg>
        </div>

        <!-- Resolution Rate -->
        <div class="ag-sc-card">
            <div class="ag-sc-top">
                <div>
                    <p class="ag-sc-label">Resolution Rate</p>
                    <p class="ag-sc-value">@myStats.ResolutionRate.ToString("F1")%</p>
                    <div class="ag-sc-change @(myStats.ResolutionRate >= 70 ? "change-up" : "change-down")">
                        <span>@(myStats.ResolutionRate >= 70 ? "On target" : "Needs improvement")</span>
                    </div>
                </div>
                <div class="ag-sc-icon ag-sc-icon-emerald">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
            <svg class="ag-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
                <defs><linearGradient id="ag-g2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#10b981" stop-opacity="0.3"/><stop offset="100%" stop-color="#10b981" stop-opacity="0"/></linearGradient></defs>
                <path d="M0 35 C40 30 70 25 100 18 C130 12 160 10 200 5" fill="none" stroke="#10b981" stroke-width="1.5"/>
                <path d="M0 35 C40 30 70 25 100 18 C130 12 160 10 200 5 L200 40 L0 40 Z" fill="url(#ag-g2)"/>
            </svg>
        </div>

        <!-- Resolved Today -->
        <div class="ag-sc-card">
            <div class="ag-sc-top">
                <div>
                    <p class="ag-sc-label">Resolved Today</p>
                    <p class="ag-sc-value">@myStats.TicketsResolvedToday</p>
                    <div class="ag-sc-change change-up"><span>tickets closed</span></div>
                </div>
                <div class="ag-sc-icon ag-sc-icon-violet">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
            </div>
            <svg class="ag-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
                <defs><linearGradient id="ag-g3" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.3"/><stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/></linearGradient></defs>
                <path d="M0 38 C50 35 80 28 120 20 C150 14 175 12 200 8" fill="none" stroke="#8b5cf6" stroke-width="1.5"/>
                <path d="M0 38 C50 35 80 28 120 20 C150 14 175 12 200 8 L200 40 L0 40 Z" fill="url(#ag-g3)"/>
            </svg>
        </div>

        <!-- Sales Today -->
        <div class="ag-sc-card ag-sc-card-accent">
            <div class="ag-sc-top">
                <div>
                    <p class="ag-sc-label" style="color:rgba(255,255,255,0.75)">Sales Today</p>
                    <p class="ag-sc-value" style="color:#fff">₱@myStats.SalesTotalToday.ToString("N0")</p>
                    <div class="ag-sc-change" style="color:rgba(255,255,255,0.8)">
                        <span>@myStats.TodayOrders orders today</span>
                    </div>
                </div>
                <div class="ag-sc-icon" style="background:rgba(255,255,255,0.2); color:#fff">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>
            <svg class="ag-sparkline" viewBox="0 0 200 40" preserveAspectRatio="none">
                <path d="M0 35 C40 30 70 22 110 15 C140 10 170 8 200 4" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.5"/>
                <path d="M0 35 C40 30 70 22 110 15 C140 10 170 8 200 4 L200 40 L0 40 Z" fill="rgba(255,255,255,0.15)"/>
            </svg>
        </div>
    </div>

    <!-- ===== ANALYTICS ROW ===== -->
    <div class="ag-an-row">

        <!-- Ticket Pipeline -->
        <div class="ag-panel-card ag-an-left">
            <div class="ag-panel-header">
                <div>
                    <h2 class="ag-panel-title">Ticket Pipeline</h2>
                    <p class="ag-panel-sub">Your assigned ticket stages</p>
                </div>
                <a href="/agent/tickets" class="ag-view-all">View All →</a>
            </div>
            <div class="ag-pipeline">
                @{
                    var openT = myStats.OpenTickets;
                    var urgentT = myStats.UrgentTickets;
                    var resolvedT = myStats.TicketsResolvedToday;
                    var pendingT = myStats.PendingOrders;
                    var totalT = myStats.TotalTickets;
                }
                <div class="ag-pipe-stage">
                    <div class="ag-pipe-label"><span class="ag-pipe-dot dot-blue"></span>Open</div>
                    <div class="ag-pipe-bar-wrap"><div class="ag-pipe-bar" style="width:@(totalT > 0 ? Math.Min(100, openT * 100 / totalT) : 0)%; background:#3b82f6"></div></div>
                    <span class="ag-pipe-count">@openT</span>
                </div>
                <div class="ag-pipe-stage">
                    <div class="ag-pipe-label"><span class="ag-pipe-dot dot-amber"></span>Urgent / High</div>
                    <div class="ag-pipe-bar-wrap"><div class="ag-pipe-bar" style="width:@(totalT > 0 ? Math.Min(100, urgentT * 100 / totalT) : 0)%; background:#f59e0b"></div></div>
                    <span class="ag-pipe-count">@urgentT</span>
                </div>
                <div class="ag-pipe-stage">
                    <div class="ag-pipe-label"><span class="ag-pipe-dot dot-green"></span>Resolved Today</div>
                    <div class="ag-pipe-bar-wrap"><div class="ag-pipe-bar" style="width:@(totalT > 0 ? Math.Min(100, resolvedT * 100 / totalT) : 0)%; background:#10b981"></div></div>
                    <span class="ag-pipe-count">@resolvedT</span>
                </div>
                <div class="ag-pipe-stage">
                    <div class="ag-pipe-label"><span class="ag-pipe-dot dot-violet"></span>Pending Orders</div>
                    <div class="ag-pipe-bar-wrap"><div class="ag-pipe-bar" style="width:@(myStats.TotalOrders > 0 ? Math.Min(100, pendingT * 100 / myStats.TotalOrders) : 0)%; background:#8b5cf6"></div></div>
                    <span class="ag-pipe-count">@pendingT</span>
                </div>
            </div>
            <div class="ag-pipe-summary">
                <div class="ag-pipe-stat"><span class="ag-pipe-num">@myStats.TotalTickets</span><span class="ag-pipe-name">Total Tickets</span></div>
                <div class="ag-pipe-stat"><span class="ag-pipe-num">@myStats.TotalOrders</span><span class="ag-pipe-name">Total Orders</span></div>
                <div class="ag-pipe-stat"><span class="ag-pipe-num">@myStats.ResolutionRate.ToString("F0")%</span><span class="ag-pipe-name">Resolution Rate</span></div>
                <div class="ag-pipe-stat"><span class="ag-pipe-num">@myStats.OrderCompletionRate.ToString("F0")%</span><span class="ag-pipe-name">Order Completion</span></div>
            </div>
        </div>

        <!-- Right panels -->
        <div class="ag-an-right">

            <!-- Work Mix Donut -->
            <div class="ag-panel-card">
                <div class="ag-panel-header">
                    <h2 class="ag-panel-title">Today's Work Mix</h2>
                </div>
                @if (TotalWorkMix > 0)
                {
                    <div class="ag-donut-wrap">
                        <div class="ag-donut-ring">
                            <div class="ag-donut-circle" style="@($"background: {WorkMixDonutGradient};")"></div>
                            <div class="ag-donut-hole">
                                <span class="ag-donut-num">@TotalWorkMix</span>
                                <span class="ag-donut-lab">items</span>
                            </div>
                        </div>
                        <div class="ag-donut-legend">
                            @for (var i = 0; i < workMixSlices.Count; i++)
                            {
                                var item = workMixSlices[i];
                                <div class="ag-donut-item">
                                    <span class="ag-donut-dot" style="background:@GetWorkMixColor(i)"></span>
                                    <span class="ag-donut-item-label">@item.Label</span>
                                    <span class="ag-donut-item-val">@item.Value</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <p class="ag-empty-text">No activity today yet.</p>
                }
            </div>

            <!-- Performance Goals -->
            <div class="ag-panel-card">
                <div class="ag-panel-header">
                    <h2 class="ag-panel-title">Performance Goals</h2>
                </div>
                <div class="ag-goals">
                    <div class="ag-goal-item">
                        <div class="ag-goal-header"><span>Resolution Rate</span><span class="ag-goal-pct @(myStats.ResolutionRate >= 70 ? "pct-green" : "pct-amber")">@myStats.ResolutionRate.ToString("F0")%</span></div>
                        <div class="ag-goal-bar-wrap"><div class="ag-goal-bar @(myStats.ResolutionRate >= 70 ? "bar-green" : "bar-amber")" style="width:@Math.Min(100,myStats.ResolutionRate)%"></div></div>
                    </div>
                    <div class="ag-goal-item">
                        <div class="ag-goal-header"><span>Order Completion</span><span class="ag-goal-pct @(myStats.OrderCompletionRate >= 70 ? "pct-green" : "pct-amber")">@myStats.OrderCompletionRate.ToString("F0")%</span></div>
                        <div class="ag-goal-bar-wrap"><div class="ag-goal-bar @(myStats.OrderCompletionRate >= 70 ? "bar-green" : "bar-amber")" style="width:@Math.Min(100,myStats.OrderCompletionRate)%"></div></div>
                    </div>
                    <div class="ag-goal-item">
                        <div class="ag-goal-header"><span>Tickets Closed Today</span><span class="ag-goal-pct pct-blue">@myStats.TicketsResolvedToday</span></div>
                        <div class="ag-goal-bar-wrap"><div class="ag-goal-bar bar-blue" style="width:@Math.Min(100, myStats.TicketsResolvedToday * 10)%"></div></div>
                    </div>
                    <div class="ag-goal-item">
                        <div class="ag-goal-header"><span>Sales Conversion</span><span class="ag-goal-pct pct-violet">@myStats.ConversionRate.ToString("P0")</span></div>
                        <div class="ag-goal-bar-wrap"><div class="ag-goal-bar bar-violet" style="width:@Math.Min(100,(double)myStats.ConversionRate*100)%"></div></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ===== MID GRID ===== -->
    <div class="ag-mid-grid">

        <!-- Active Tickets -->
        <div class="ag-panel-card ag-mid-tickets">
            <div class="ag-panel-header">
                <h2 class="ag-panel-title">My Active Tickets</h2>
                <a href="/agent/tickets" class="ag-view-all">View All →</a>
            </div>
            @if (realTickets.Any())
            {
                <div class="ag-ticket-list">
                    @foreach (var ticket in pagedRealTickets)
                    {
                        <div class="ag-ticket-row">
                            <div class="ag-ticket-priority @GetPriorityBgClass(ticket.Priority)">
                                @if (ticket.Priority == "High" || ticket.Priority == "Critical")
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>
                                }
                            </div>
                            <div class="ag-ticket-body">
                                <p class="ag-ticket-title">@ticket.Title</p>
                                <p class="ag-ticket-meta">@(string.IsNullOrEmpty(ticket.CustomerName) ? $"Customer #{ticket.CustomerId}" : ticket.CustomerName) · <span class="ag-ticket-num">#@ticket.TicketNumber</span></p>
                            </div>
                            <span class="ag-ticket-status">@ticket.Status</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="ag-empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <p>No active tickets — great job!</p>
                </div>
            }
            @if (realTickets.Any())
            {
                <div style="display:flex; align-items:center; justify-content:space-between; margin-top:.7rem;">
                    <span class="ag-pager-meta">Showing @ticketsStartIndex-@ticketsEndIndex of @realTickets.Count · Page @ticketsPage/@ticketsTotalPages</span>
                    <div class="ag-pager">
                        <button type="button" @onclick="PreviousTicketsPage" disabled="@(ticketsPage <= 1)" class="ag-pager-btn">Previous</button>
                        <button type="button" @onclick="NextTicketsPage" disabled="@(ticketsPage >= ticketsTotalPages)" class="ag-pager-btn">Next</button>
                    </div>
                </div>
            }
        </div>

        <!-- Recent Activity -->
        <div class="ag-panel-card ag-mid-activity">
            <div class="ag-panel-header">
                <h2 class="ag-panel-title">Recent Activity</h2>
            </div>
            @if (recentActivity.Any())
            {
                <div class="ag-activity-list">
                    @foreach (var item in pagedRecentActivity)
                    {
                        <div class="ag-activity-item">
                            <div class="ag-activity-dot @(item.Type == "Order" ? "dot-blue" : "dot-violet")"></div>
                            <div class="ag-activity-body">
                                <p class="ag-activity-desc">@item.Description</p>
                                <p class="ag-activity-detail">@item.Detail</p>
                            </div>
                            <span class="ag-activity-time">@GetTimeAgo(item.Date)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="ag-empty-text">No recent activity yet.</p>
            }
            @if (recentActivity.Any())
            {
                <div style="display:flex; align-items:center; justify-content:space-between; margin-top:.7rem;">
                    <span class="ag-pager-meta">Showing @activityStartIndex-@activityEndIndex of @recentActivity.Count · Page @activityPage/@activityTotalPages</span>
                    <div class="ag-pager">
                        <button type="button" @onclick="PreviousActivityPage" disabled="@(activityPage <= 1)" class="ag-pager-btn">Previous</button>
                        <button type="button" @onclick="NextActivityPage" disabled="@(activityPage >= activityTotalPages)" class="ag-pager-btn">Next</button>
                    </div>
                </div>
            }
        </div>

        <!-- Alerts & Quick Actions -->
        <div class="ag-mid-side">

            <!-- Alerts -->
            <div class="ag-panel-card">
                <div class="ag-panel-header"><h2 class="ag-panel-title">Alerts</h2></div>
                <div class="ag-alerts">
                    @if (myStats.UrgentTickets > 0)
                    {
                        <div class="ag-alert ag-alert-red">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            <span>@myStats.UrgentTickets urgent ticket(s) need attention</span>
                        </div>
                    }
                    @if (myStats.PendingOrders > 0)
                    {
                        <div class="ag-alert ag-alert-amber">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            <span>@myStats.PendingOrders pending order(s) awaiting action</span>
                        </div>
                    }
                    @if (myStats.LowStockCount > 0)
                    {
                        <div class="ag-alert ag-alert-blue">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>@myStats.LowStockCount product(s) running low on stock</span>
                        </div>
                    }
                    @if (myStats.UrgentTickets == 0 && myStats.PendingOrders == 0 && myStats.LowStockCount == 0)
                    {
                        <div class="ag-alert ag-alert-green">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <span>All clear! No alerts at this time.</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="ag-panel-card">
                <div class="ag-panel-header"><h2 class="ag-panel-title">Quick Actions</h2></div>
                <div class="ag-quick-grid">
                    <a href="/agent/tickets" class="ag-quick-card ag-quick-blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                        <span>New Ticket</span>
                    </a>
                    <a href="/agent/orders/history" class="ag-quick-card ag-quick-violet">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <span>Orders</span>
                    </a>
                    <a href="/agent/calls/log" class="ag-quick-card ag-quick-emerald">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span>Log Call</span>
                    </a>
                    <a href="/agent/customers" class="ag-quick-card ag-quick-gray">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        <span>Customers</span>
                    </a>
                </div>
            </div>

        </div>
    </div>

</div>

<style>
    /* Container */
    .ag-container { padding:1.5rem; max-width:1560px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem; }
    @@media(min-width:1024px){ .ag-container { padding:2rem; gap:1.75rem; } }

    /* Header */
    .ag-header { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:1rem; }
    .ag-title-row { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; }
    .ag-avatar-dot { width:.75rem; height:.75rem; border-radius:50%; animation:ag-pulse 2s infinite; }
    .ag-title { font-size:21px; font-weight:800; color:#0f172a; letter-spacing:-.025em; margin:0; }
    @@media(min-width:1024px){ .ag-title { font-size:21px; } }
