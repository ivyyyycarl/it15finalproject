@code {
    private AgentStats myStats = new();
    private List<SupportSalesManagement.Frontend.Models.Ticket> realTickets = new();
    private List<ActivityItem> recentActivity = new();
    private List<Order> allOrders = new();
    private List<Ticket> allTickets = new();
    private List<ChartPoint> activityTrendData = new();
    private List<ChartPoint> ticketStatusData = new();
    private List<MetricSlice> workMixSlices = new();
    private readonly string[] workMixColors = { "#3B82F6", "#8B5CF6", "#F59E0B", "#10B981" };
    private string CurrentStatus = "Available";
    private System.Threading.Timer? refreshTimer;
    private int TotalWorkMix => workMixSlices.Sum(x => x.Value);
    private string WorkMixDonutGradient => BuildWorkMixDonutGradient();
    private int ticketsPage = 1;
    private int activityPage = 1;
    private const int ticketsPageSize = 6;
    private const int activityPageSize = 7;
    private int ticketsTotalPages => Math.Max(1, (int)Math.Ceiling(realTickets.Count / (double)ticketsPageSize));
    private int activityTotalPages => Math.Max(1, (int)Math.Ceiling(recentActivity.Count / (double)activityPageSize));
    private List<Ticket> pagedRealTickets => realTickets.Skip((ticketsPage - 1) * ticketsPageSize).Take(ticketsPageSize).ToList();
    private List<ActivityItem> pagedRecentActivity => recentActivity.Skip((activityPage - 1) * activityPageSize).Take(activityPageSize).ToList();
    private int ticketsStartIndex => realTickets.Count == 0 ? 0 : ((ticketsPage - 1) * ticketsPageSize) + 1;
    private int ticketsEndIndex => realTickets.Count == 0 ? 0 : Math.Min(ticketsPage * ticketsPageSize, realTickets.Count);
    private int activityStartIndex => recentActivity.Count == 0 ? 0 : ((activityPage - 1) * activityPageSize) + 1;
    private int activityEndIndex => recentActivity.Count == 0 ? 0 : Math.Min(activityPage * activityPageSize, recentActivity.Count);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();

        // Auto-refresh every 60 seconds
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await LoadDashboardData();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var ordersTask = ApiClient.GetOrdersAsync();
            var ticketsTask = ApiClient.GetTicketsAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, ticketsTask, productsTask);

            var orders = await ordersTask ?? new();
            var tickets = await ticketsTask ?? new();
            var products = await productsTask ?? new();
            allOrders = orders;
            allTickets = tickets;

            // Open tickets (not resolved/closed)
            var openTickets = tickets.Where(t => t.Status != "Resolved" && t.Status != "Closed").ToList();
            var urgentTickets = openTickets.Where(t => t.Priority == "High" || t.Priority == "Critical" || t.Priority == "Urgent").ToList();
            var resolvedTickets = tickets.Where(t => t.Status == "Resolved" || t.Status == "Closed").ToList();

            // Orders today
            var today = DateTime.Today;
            var todayOrders = orders.Where(o => o.OrderDate.Date == today || o.CreatedAt.Date == today).ToList();
            var pendingOrders = orders.Where(o => o.Status == "Pending").ToList();
            var completedOrders = orders.Where(o => o.Status == "Delivered" || o.Status == "Completed").ToList();

            // Low stock products
            var lowStockProducts = products.Where(p => p.IsActive && p.StockQuantity > 0 && p.StockQuantity <= 10).ToList();

            // Resolution rate
            double resolutionRate = tickets.Count > 0 ? (double)resolvedTickets.Count / tickets.Count * 100 : 0;
            // Order completion rate
            double orderCompletionRate = orders.Count > 0 ? (double)completedOrders.Count / orders.Count * 100 : 0;

            // CSAT score based on resolution rate (simulated)
            double csatScore = resolutionRate > 0 ? Math.Min(5.0, resolutionRate / 20.0) : 0;

            // Conversion rate
            double conversionRate = orders.Count > 0 ? (double)completedOrders.Count / orders.Count : 0;

            myStats = new AgentStats
            {
                OpenTickets = openTickets.Count,
                UrgentTickets = urgentTickets.Count,
                CSATScore = csatScore,
                TicketsResolvedToday = resolvedTickets.Count(t => t.CreatedAt.Date == today),
                SalesTotalToday = todayOrders.Sum(o => o.TotalAmount),
                ConversionRate = conversionRate,
                ResolutionRate = resolutionRate,
                OrderCompletionRate = orderCompletionRate,
                TotalOrders = orders.Count,
                TotalTickets = tickets.Count,
                PendingOrders = pendingOrders.Count,
                LowStockCount = lowStockProducts.Count,
                TodayOrders = todayOrders.Count
            };

            workMixSlices = new List<MetricSlice>
            {
                new() { Label = "Resolved Tickets", Value = myStats.TicketsResolvedToday },
                new() { Label = "Pending Orders", Value = myStats.PendingOrders },
                new() { Label = "Urgent Tickets", Value = myStats.UrgentTickets },
                new() { Label = "Orders Today", Value = myStats.TodayOrders }
            }.Where(x => x.Value > 0).ToList();

            // Real tickets for display
            realTickets = openTickets.OrderByDescending(t => t.Priority == "Critical" || t.Priority == "Urgent")
                                     .ThenByDescending(t => t.CreatedAt)
                                     .ToList();
            ticketsPage = 1;

            // Build recent activity from real orders and tickets
            recentActivity = new List<ActivityItem>();

            foreach (var order in orders.OrderByDescending(o => o.CreatedAt).Take(5))
            {
                recentActivity.Add(new ActivityItem
                {
                    Type = "Order",
                    Description = $"Order #{order.OrderNumber} - {order.Status}",
                    Detail = $"{(string.IsNullOrEmpty(order.CustomerName) ? $"Customer #{order.CustomerId}" : order.CustomerName)} • ₱{order.TotalAmount:N2}",
                    Date = order.CreatedAt
                });
            }

            foreach (var ticket in tickets.OrderByDescending(t => t.CreatedAt).Take(5))
            {
                recentActivity.Add(new ActivityItem
                {
                    Type = "Ticket",
                    Description = $"Ticket #{ticket.TicketNumber} - {ticket.Status}",
                    Detail = $"{(string.IsNullOrEmpty(ticket.CustomerName) ? $"Customer #{ticket.CustomerId}" : ticket.CustomerName)} • {ticket.Title}",
                    Date = ticket.CreatedAt
                });
            }

            recentActivity = recentActivity.OrderByDescending(a => a.Date).ToList();
            activityPage = 1;
            BuildCharts();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private void BuildCharts()
    {
        var days = Enumerable.Range(0, 7)
            .Select(i => DateTime.Today.AddDays(-6 + i))
            .ToList();

        activityTrendData = days
            .Select(d => new ChartPoint
            {
                Label = d.ToString("ddd"),
                Value = allTickets.Count(t => t.CreatedAt.Date == d.Date) +
                        allOrders.Count(o => o.OrderDate.Date == d.Date || o.CreatedAt.Date == d.Date)
            })
            .ToList();

        ticketStatusData = allTickets
            .GroupBy(t => string.IsNullOrWhiteSpace(t.Status) ? "Unknown" : t.Status)
            .Select(g => new ChartPoint
            {
                Label = g.Key,
                Value = g.Count()
            })
            .OrderByDescending(p => p.Value)
            .Take(6)
            .ToList();
    }

    private void SetStatus(string status)
    {
        CurrentStatus = status;
        StateHasChanged();
    }

    private async Task RefreshData()
    {
        await LoadDashboardData();
        StateHasChanged();
    }

    private string GetPriorityBgClass(string priority) => priority switch
    {
        "Critical" or "Urgent" or "High" => "bg-[var(--erp-danger)]",
        "Medium" or "Normal" => "bg-[var(--color-primary)]",
        _ => "bg-gray-500"
    };

    private string GetPriorityTextClass(string priority) => priority switch
    {
        "Critical" or "Urgent" or "High" => "text-[var(--erp-danger)]",
        "Medium" or "Normal" => "text-[var(--color-primary)]",
        _ => "text-gray-500"
    };

    private string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return date.ToString("MMM dd");
    }

    private string GetWorkMixColor(int index) => workMixColors[index % workMixColors.Length];

    private double GetWorkMixPercent(int value)
    {
        if (TotalWorkMix == 0)
        {
            return 0;
        }

        return (double)value / TotalWorkMix * 100d;
    }

    private string BuildWorkMixDonutGradient()
    {
        if (!workMixSlices.Any() || TotalWorkMix == 0)
        {
            return "conic-gradient(#374151 0deg 360deg)";
        }

        var current = 0d;
        var segments = new List<string>();

        for (var i = 0; i < workMixSlices.Count; i++)
        {
            var value = workMixSlices[i].Value;
            var degrees = (double)value / TotalWorkMix * 360d;
            var start = current;
            var end = current + degrees;
            var color = GetWorkMixColor(i);

            segments.Add(
                $"{color} {start.ToString("0.##", CultureInfo.InvariantCulture)}deg {end.ToString("0.##", CultureInfo.InvariantCulture)}deg");
            current = end;
        }

        return $"conic-gradient({string.Join(", ", segments)})";
    }

    private void PreviousTicketsPage()
    {
        if (ticketsPage <= 1) return;
        ticketsPage--;
    }

    private void NextTicketsPage()
    {
        if (ticketsPage >= ticketsTotalPages) return;
        ticketsPage++;
    }

    private void PreviousActivityPage()
    {
        if (activityPage <= 1) return;
        activityPage--;
    }

    private void NextActivityPage()
    {
        if (activityPage >= activityTotalPages) return;
        activityPage++;
    }

