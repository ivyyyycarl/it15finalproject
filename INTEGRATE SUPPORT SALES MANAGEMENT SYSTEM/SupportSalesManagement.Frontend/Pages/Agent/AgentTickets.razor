@page "/agent/tickets"
@page "/agent/tickets/assigned"
@page "/agent/tickets/escalated"
@page "/agent/tickets/unassigned"
@layout AgentLayout
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@using SupportSalesManagement.Frontend.Models
@using CustomerModel = SupportSalesManagement.Frontend.Models.Customer
@using SupportSalesManagement.Frontend.Services

<PageTitle>Ticket Management | Agent Workspace</PageTitle>

<div class="px-6 py-6" style="font-family: Inter, sans-serif; font-size: 12px;">
    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-[21px] font-bold text-[#1E1E2D] dark:text-white">Support Tickets</h1>
            <p class="text-[12px] text-gray-500 dark:text-gray-400">Manage and resolve customer inquiries</p>
        </div>
        <button @onclick='() => NavigationManager.NavigateTo("/tickets/create")'
            class="bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold py-2.5 px-5 rounded-xl shadow-lg shadow-blue-500/20 flex items-center gap-2 transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Create Ticket
        </button>
    </div>

    <!-- Summary + Filters -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
        <div class="rounded-xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-4 shadow-sm ui-stat-card">
            <div class="flex items-center justify-between mb-1">
                <p class="text-xs font-bold uppercase tracking-wider text-blue-600">Total Tickets</p>
                <span class="text-base">🎫</span>
            </div>
            <p class="text-2xl font-extrabold text-[#1E1E2D]">@AllTickets.Count</p>
        </div>
        <div class="rounded-xl border border-amber-100 bg-gradient-to-br from-amber-50 to-white p-4 shadow-sm ui-stat-card">
            <div class="flex items-center justify-between mb-1">
                <p class="text-xs font-bold uppercase tracking-wider text-amber-700">Open / In Progress</p>
                <span class="text-base">🛠️</span>
            </div>
            <p class="text-2xl font-extrabold text-amber-700">@AllTickets.Count(t => t.Status == "Open" || t.Status == "In Progress")</p>
        </div>
        <div class="rounded-xl border border-rose-100 bg-gradient-to-br from-rose-50 to-white p-4 shadow-sm ui-stat-card">
            <div class="flex items-center justify-between mb-1">
                <p class="text-xs font-bold uppercase tracking-wider text-rose-700">Escalated</p>
                <span class="text-base">⚠️</span>
            </div>
            <p class="text-2xl font-extrabold text-rose-700">@AllTickets.Count(t => t.Status == "Escalated")</p>
        </div>
    </div>

    <!-- Filters & Stats -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div class="md:col-span-3 bg-white dark:bg-[#1E1E2D] p-4 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 flex flex-wrap gap-4 items-center ui-surface-card">
            <div class="flex-1 min-w-[200px] relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </span>
                <input type="text" value="@searchInput" @oninput="OnSearchInput" placeholder="Search tickets..."
                    class="block w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-[#2A2A35] border-transparent dark:border-gray-700 rounded-lg focus:bg-white dark:focus:bg-[#32323F] focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all text-gray-900 dark:text-white placeholder-gray-400" />
            </div>
            
            <select @bind="StatusFilter" @bind:after="OnFilterChanged"
                class="bg-gray-50 dark:bg-[#2A2A35] border-transparent dark:border-gray-700 rounded-lg px-4 py-2 text-gray-700 dark:text-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all">
                <option value="All">All Statuses</option>
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Resolved">Resolved</option>
                <option value="Closed">Closed</option>
                 <option value="Escalated">Escalated</option>
            </select>
            
            <select @bind="PriorityFilter" @bind:after="OnFilterChanged"
                class="bg-gray-50 dark:bg-[#2A2A35] border-transparent dark:border-gray-700 rounded-lg px-4 py-2 text-gray-700 dark:text-gray-300 focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all">
                <option value="All">All Priorities</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
                 <option value="Urgent">Urgent</option>
            </select>
        </div>

        <!-- Quick Stat -->
        <div class="bg-gradient-to-br from-indigo-50 to-white dark:bg-[var(--color-primary)]/20 p-4 rounded-xl border border-indigo-100 dark:border-[var(--color-primary)]/20 flex items-center justify-between shadow-sm ui-surface-card">
            <div>
                <p class="text-xs font-bold text-indigo-700 uppercase tracking-wider">My Open Cases</p>
                <p class="text-2xl font-black text-[#1E1E2D] dark:text-white">@FilteredTickets.Count(t => t.Status != "Closed" && t.Status != "Resolved")</p>
            </div>
             <div class="h-10 w-10 rounded-full bg-indigo-600 flex items-center justify-center text-white">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
            </div>
        </div>
    </div>

    <!-- View Tabs -->
    <div class="flex items-center gap-6 border-b border-gray-200 dark:border-gray-700 mb-6">
        <button
            class="pb-3 px-1 font-bold text-sm transition-all relative @(ActiveTab == "Assigned" ? "text-[var(--color-primary)]" : "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200")"
            @onclick="@(() => SetTab("Assigned"))">
            My Assigned Tickets
            @if(ActiveTab == "Assigned") { <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[var(--color-primary)] rounded-t-full"></span> }
        </button>
        <button
            class="pb-3 px-1 font-bold text-sm transition-all relative @(ActiveTab == "Unassigned" ? "text-[var(--color-primary)]" : "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200")"
            @onclick="@(() => SetTab("Unassigned"))">
            Unassigned Queue
            @if(ActiveTab == "Unassigned") { <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[var(--color-primary)] rounded-t-full"></span> }
        </button>
         <button
            class="pb-3 px-1 font-bold text-sm transition-all relative @(ActiveTab == "All" ? "text-[var(--color-primary)]" : "text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200")"
            @onclick="@(() => SetTab("All"))">
            All Tickets
            @if(ActiveTab == "All") { <span class="absolute bottom-0 left-0 w-full h-0.5 bg-[var(--color-primary)] rounded-t-full"></span> }
        </button>
    </div>

    <!-- Ticket List -->
    <div class="bg-white dark:bg-[#1E1E2D] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden ui-surface-card">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-100 dark:divide-gray-700">
                <thead class="bg-slate-100 dark:bg-[#25252b] border-b border-gray-200 dark:border-gray-700">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Ticket Details</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Customer</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Priority</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-left text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Created</th>
                        <th class="px-6 py-4 text-right text-xs font-black text-slate-800 dark:text-slate-200 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-12 text-center">
                                <div class="flex justify-center">
                                    <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--color-primary)]"></div>
                                </div>
                                <p class="mt-2 text-sm text-gray-500">Loading tickets...</p>
                            </td>
                        </tr>
                    }
                    else if (!FilteredTickets.Any())
                    {
                         <tr>
                            <td colspan="6" class="px-6 py-12 text-center text-gray-500 dark:text-gray-400">
                                <svg class="w-12 h-12 mx-auto mb-3 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                <p class="font-medium">No tickets found matching your criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in PagedFilteredTickets)
                        {
                            <tr class="hover:bg-blue-50/30 dark:hover:bg-white/5 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-[#1E1E2D] dark:text-white group-hover:text-[var(--color-primary)] transition-colors mb-1">@ticket.Title</span>
                                        <span class="text-sm text-gray-500 dark:text-gray-400 line-clamp-1">@ticket.Description</span>
                                        <span class="text-xs font-mono text-gray-400 mt-1">#@ticket.TicketNumber</span>
                                    </div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-bold text-[#1E1E2D] dark:text-white">@(string.IsNullOrEmpty(ticket.CustomerName) ? GetCustomerName(ticket.CustomerId) : ticket.CustomerName)</div>
                                    @if (!string.IsNullOrEmpty(ticket.Customer?.Email))
                                    {
                                        <div class="text-xs text-gray-500 dark:text-gray-400">@ticket.Customer.Email</div>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold @GetPriorityClass(ticket.Priority)">
                                        <span class="w-1.5 h-1.5 rounded-full @GetPriorityDotClass(ticket.Priority)"></span>
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold @GetStatusClass(ticket.Status)">
                                        <span class="w-1.5 h-1.5 rounded-full @GetStatusDotClass(ticket.Status)"></span>
                                        @ticket.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
                                    @ticket.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                                    <button @onclick="() => ViewTicket(ticket.Id)" 
                                        class="px-2.5 py-1 rounded-lg border border-blue-100 bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold mr-2 transition-colors">View</button>
                                    @if (ActiveTab == "Unassigned")
                                    {
                                        <button @onclick="() => AssignToMe(ticket)" 
                                            class="px-2.5 py-1 rounded-lg border border-emerald-100 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 font-bold mr-2 transition-colors">Pick Up</button>
                                    }
                                    @if (ticket.Status != "Resolved" && ticket.Status != "Closed" && ticket.AssignedAgentId == CurrentAgentId)
                                    {
                                        <button @onclick="() => EscalateTicket(ticket)" 
                                            class="px-2.5 py-1 rounded-lg border border-rose-100 bg-rose-50 text-rose-700 hover:bg-rose-100 font-bold transition-colors">Escalate</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (!isLoading && FilteredTicketsList.Any())
        {
            <div class="px-6 py-4 border-t border-gray-100 dark:border-gray-700 bg-white/80 dark:bg-transparent flex items-center justify-between">
                <p class="text-sm text-gray-500 dark:text-gray-400">
                    Showing @(((currentPage - 1) * pageSize) + 1)-@Math.Min(currentPage * pageSize, FilteredTicketsList.Count) of @FilteredTicketsList.Count · Page @currentPage/@TotalPages
                </p>
                <div class="flex items-center gap-2">
                    <button type="button" @onclick="PreviousPage" disabled="@(currentPage <= 1)"
                            class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                    <button type="button" @onclick="NextPage" disabled="@(currentPage >= TotalPages)"
                            class="px-3 py-1.5 rounded-lg border border-gray-200 bg-white text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Ticket> AllTickets = new();
    private Dictionary<int, string> customerNames = new();
    private string SearchQuery = "";
    private string searchInput = "";
    private string StatusFilter = "All";
    private string PriorityFilter = "All";
    private string ActiveTab = "Assigned";
    private bool isLoading = true;
    private readonly Debouncer _searchDebouncer = new();
    private int currentPage = 1;
    private const int pageSize = 20;

    private int CurrentAgentId = 0;

    private IEnumerable<Ticket> FilteredTickets => AllTickets
        .Where(t => ActiveTab switch {
            "Assigned" => t.AssignedAgentId == CurrentAgentId,
            "Unassigned" => t.AssignedAgentId == null,
            _ => true
        })
        .Where(t => StatusFilter == "All" || t.Status == StatusFilter)
        .Where(t => PriorityFilter == "All" || t.Priority == PriorityFilter)
        .Where(t => string.IsNullOrEmpty(SearchQuery)
            || t.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || t.Description.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)
            || (t.TicketNumber?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            || (t.CustomerName?.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ?? false)
            || GetCustomerName(t.CustomerId).Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));
    private List<Ticket> FilteredTicketsList => FilteredTickets.ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTicketsList.Count / (double)pageSize));
    private List<Ticket> PagedFilteredTickets => FilteredTicketsList
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Get current agent ID from auth
        var user = await ApiClient.GetCurrentUserAsync();
        if (user != null) CurrentAgentId = user.Id;
        
        // Load customers for name lookup
        var customers = await ApiClient.GetCustomersAsync();
        if (customers != null)
        {
            customerNames = customers.ToDictionary(c => c.Id, c => $"{c.FirstName} {c.LastName}");
        }
        
        await LoadTickets();
    }

    private string GetCustomerName(int customerId)
    {
        return customerNames.GetValueOrDefault(customerId, $"Customer #{customerId}");
    }

    protected override void OnParametersSet()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();

        if (relativePath.Contains("escalated"))
        {
            ActiveTab = "All";
            StatusFilter = "Escalated";
            PriorityFilter = "All";
        }
        else if (relativePath.Contains("unassigned"))
        {
            ActiveTab = "Unassigned";
            if (StatusFilter == "Escalated")
            {
                StatusFilter = "All";
            }
            PriorityFilter = "All";
        }
        else if (relativePath.Contains("assigned"))
        {
            ActiveTab = "Assigned";
            if (StatusFilter == "Escalated")
            {
                StatusFilter = "All";
            }
            PriorityFilter = "All";
        }
        else
        {
            ActiveTab = "All";
            if (StatusFilter == "Escalated")
            {
                StatusFilter = "All";
            }
        }

        currentPage = 1;
    }

    private void SetTab(string tab)
    {
        ActiveTab = tab;

        if(tab == "Unassigned") 
        {
             StatusFilter = "All";
        }
        else if (tab == "Assigned" && StatusFilter == "Escalated")
        {
            StatusFilter = "All";
        }
        else if (tab == "All" && StatusFilter == "Escalated")
        {
            StatusFilter = "All";
        }

        currentPage = 1;

        var targetRoute = tab switch
        {
            "Assigned" => "/agent/tickets/assigned",
            "Unassigned" => "/agent/tickets/unassigned",
            _ => "/agent/tickets"
        };
        NavigationManager.NavigateTo(targetRoute);
    }

    private void OnFilterChanged()
    {
        currentPage = 1;
    }

    private async Task LoadTickets()
    {
        isLoading = true;
        try
        {
            var tickets = await ApiClient.GetTicketsAsync();
            if (tickets != null)
            {
                AllTickets = tickets;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tickets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AssignToMe(Ticket ticket)
    {
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Assign ticket {ticket.TicketNumber} to yourself?");
        if (!confirm) return;

        await ApiClient.AssignTicketAsync(ticket.Id, CurrentAgentId);
        // Optimistic update
        ticket.AssignedAgentId = CurrentAgentId;
        // Or reload
        // await LoadTickets();
    }
    
    private void ViewTicket(int ticketId)
    {
        NavigationManager.NavigateTo($"/tickets/{ticketId}");
    }

    private async Task EscalateTicket(Ticket ticket)
    {
        try
        {
            var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Escalate ticket {ticket.TicketNumber}?");
            if (!confirm) return;

            var success = await ApiClient.EscalateTicketAsync(ticket.Id);
            if (success)
            {
                // Reload tickets to reflect the status change
                await LoadTickets();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error escalating ticket: {ex.Message}");
        }
    }

    private string GetPriorityClass(string priority) => priority switch
    {
        "Urgent" or "Critical" => "bg-[var(--erp-danger)]/10 text-[var(--erp-danger)]",
        "High" => "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300",
        "Medium" => "bg-[var(--erp-warning)]/10 text-[var(--erp-warning-dark)]",
        "Low" => "bg-[var(--color-success)]/10 text-[var(--color-success-dark)]",
        _ => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
    };

    private string GetStatusClass(string status) => status switch
    {
        "Open" => "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300",
        "In Progress" => "bg-purple-100 text-purple-800 dark:bg-purple-900/30 dark:text-purple-300",
        "Resolved" => "bg-[var(--color-success)]/10 text-[var(--color-success-dark)]",
        "Escalated" => "bg-[var(--erp-danger)]/10 text-[var(--erp-danger)]",
        _ => "bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300"
    };

    private string GetStatusDotClass(string status) => status switch
    {
        "Open" => "bg-blue-500",
        "In Progress" => "bg-purple-500",
        "Resolved" => "bg-emerald-500",
        "Escalated" => "bg-rose-500",
        "Closed" => "bg-gray-500",
        _ => "bg-gray-500"
    };

    private string GetPriorityDotClass(string priority) => priority switch
    {
        "Urgent" or "Critical" => "bg-rose-500",
        "High" => "bg-orange-500",
        "Medium" => "bg-amber-500",
        "Low" => "bg-emerald-500",
        _ => "bg-gray-500"
    };

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchInput = e.Value?.ToString() ?? string.Empty;
        await _searchDebouncer.DebounceAsync(async () =>
        {
            SearchQuery = searchInput;
            currentPage = 1;
            await InvokeAsync(StateHasChanged);
        });
    }

    private void PreviousPage()
    {
        if (currentPage <= 1) return;
        currentPage--;
    }

    private void NextPage()
    {
        if (currentPage >= TotalPages) return;
        currentPage++;
    }

    public void Dispose()
    {
        _searchDebouncer.Dispose();
    }
}
