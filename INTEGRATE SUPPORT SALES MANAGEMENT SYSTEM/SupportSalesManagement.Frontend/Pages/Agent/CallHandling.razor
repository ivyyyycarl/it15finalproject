    private bool IsSupportVoiceCall(Call call)
    {
        return (call.Type?.Contains("support", StringComparison.OrdinalIgnoreCase) ?? false)
               || (call.Type?.Contains("voice", StringComparison.OrdinalIgnoreCase) ?? false)
               || (call.Subject?.Contains("voice", StringComparison.OrdinalIgnoreCase) ?? false)
               || (call.Notes?.Contains("support call", StringComparison.OrdinalIgnoreCase) ?? false);
    }

