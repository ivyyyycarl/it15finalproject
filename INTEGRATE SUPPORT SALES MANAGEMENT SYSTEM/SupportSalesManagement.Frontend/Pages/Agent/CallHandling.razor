    public async ValueTask DisposeAsync()
    {
        callTimer?.Stop();
        callTimer?.Dispose();
        if (!string.IsNullOrWhiteSpace(activeSupportCallId))
        {
            try
            {
                if (supportCallHub != null && supportCallHub.State == HubConnectionState.Connected)
                {
                    await supportCallHub.InvokeAsync("EndSupportCall", activeSupportCallId, "Call ended.");
                }
            }
            catch
            {
                // ignore dispose errors
            }

            await JSRuntime.InvokeVoidAsync("supportCall.endCall", activeSupportCallId);
        }

        if (supportCallHub != null)
        {
            await supportCallHub.DisposeAsync();
        }

        supportCallDotNetRef?.Dispose();
    }

    private void PreviousCallPage()
    {
        if (callCurrentPage <= 1) return;
        callCurrentPage--;
    }

    private void NextCallPage()
    {
        if (callCurrentPage >= CallTotalPages) return;
        callCurrentPage++;
    }

