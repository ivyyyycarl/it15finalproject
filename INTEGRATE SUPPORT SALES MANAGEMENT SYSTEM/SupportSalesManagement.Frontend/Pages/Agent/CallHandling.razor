@page "/agent/calls"
@page "/agent/calls/log"
@page "/agent/calls/history"
@layout AgentLayout
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject AuthenticationService AuthService
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.SignalR
@using System.Timers
@using System.Text.RegularExpressions
@implements IAsyncDisposable

<PageTitle>Call Handling | Agent Workspace</PageTitle>

@{
    var currentView = GetCurrentView();
}

<div class="h-[calc(100vh-theme(spacing.16))] flex flex-col bg-gray-50 dark:bg-[#151521]" style="font-family: Inter, sans-serif; font-size: 12px;">
    <!-- Top Bar -->
    <div class="bg-white dark:bg-[#1E1E2D] border-b border-gray-200 dark:border-gray-700 px-4 md:px-6 py-4 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between shrink-0">
        <div class="min-w-0">
            <h1 class="text-[21px] font-bold text-[#1E1E2D] dark:text-white">Call Center</h1>
            <p class="text-[12px] text-gray-500 dark:text-gray-400">Manage incoming calls and interaction logs</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-gray-100 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-700">
                <span class="inline-flex w-2.5 h-2.5 rounded-full @(activeCallId > 0 ? (isPaused ? "bg-amber-400" : "bg-green-500") : "bg-gray-400")"></span>
                <span class="text-xs font-bold @(activeCallId > 0 ? (isPaused ? "text-amber-700 dark:text-amber-300" : "text-green-700 dark:text-green-300") : "text-gray-600 dark:text-gray-300")">
                    @ActiveStateText
                </span>
                @if (activeCallId > 0)
                {
                    <span class="text-xs font-mono text-gray-500 dark:text-gray-400">@callDuration</span>
                }
            </div>
            <div class="inline-flex items-center gap-2 px-3 py-2 rounded-lg bg-indigo-50 border border-indigo-100">
                <span class="inline-flex w-2 h-2 rounded-full @(waitingCustomerCount > 0 ? "bg-indigo-500" : "bg-gray-400")"></span>
                <span class="text-xs font-bold text-indigo-700">Waiting: @waitingCustomerCount</span>
                <span class="text-[11px] text-indigo-500">Online customers: @onlineCustomerCount</span>
                <span class="text-[11px] text-indigo-500">Active: @activeSupportCallsCount</span>
            </div>
            <div class="flex bg-gray-100 dark:bg-[#2A2A35] p-1 rounded-lg">
             <button @onclick='() => NavigateTo("log")' 
                class="px-4 py-2 rounded-md text-sm font-bold transition-all @(currentView == "log" ? "bg-white dark:bg-[#32323F] text-[var(--color-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                Active Call
            </button>
            <button @onclick='() => NavigateTo("history")'
                class="px-4 py-2 rounded-md text-sm font-bold transition-all @(currentView == "history" ? "bg-white dark:bg-[#32323F] text-[var(--color-primary)] shadow-sm" : "text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200")">
                Call History (@callHistory.Count)
            </button>
            </div>
        </div>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-hidden relative">
        @if (currentView == "log")
        {
             <div class="p-4 md:p-6 h-full grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_20rem] gap-4 md:gap-6">
                <!-- Left: Active Call Control -->
                <div class="flex-1 flex flex-col space-y-6 overflow-y-auto">
                    
                    <!-- Success/Error Messages -->
                    @if (!string.IsNullOrEmpty(statusMessage))
                    {
                        <div class="@(isError ? "bg-red-50 dark:bg-red-900/20 border-red-200 dark:border-red-800 text-red-700 dark:text-red-300" : "bg-green-50 dark:bg-green-900/20 border-green-200 dark:border-green-800 text-green-700 dark:text-green-300") border rounded-xl px-4 py-3 text-sm font-medium flex items-center justify-between">
                            <span>@statusMessage</span>
                            <button @onclick='() => statusMessage = ""' class="ml-2 opacity-60 hover:opacity-100">&times;</button>
                        </div>
                    }

                    <audio id="agent-support-remote-audio" autoplay class="hidden"></audio>

                    @if (incomingSupportCall != null && !isSupportVoiceCallActive)
                    {
                        <div class="rounded-xl border border-indigo-200 bg-gradient-to-r from-indigo-50 to-white p-4 shadow-sm">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-indigo-700">Incoming Customer Call</p>
                                    <p class="text-sm font-semibold text-[#1E1E2D] mt-1">@incomingSupportCall.CustomerName is requesting a follow-up call.</p>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button @onclick="AcceptIncomingSupportCallAsync" class="px-3 py-2 rounded-lg bg-emerald-600 text-white text-sm font-semibold hover:bg-emerald-700 transition-colors">
                                        Accept
                                    </button>
                                    <button @onclick="DeclineIncomingSupportCallAsync" class="px-3 py-2 rounded-lg bg-rose-600 text-white text-sm font-semibold hover:bg-rose-700 transition-colors">
                                        Decline
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (isSupportVoiceCallActive)
                    {
                        <div class="rounded-xl border border-emerald-200 bg-gradient-to-r from-emerald-50 to-white p-4 shadow-sm">
                            <div class="flex items-center justify-between">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-emerald-700">Live Customer Voice Call</p>
                                    <p class="text-sm font-semibold text-[#1E1E2D] mt-1">Connected with @activeSupportCustomerName</p>
                                </div>
                                <button @onclick="EndActiveSupportCallAsync" class="px-3 py-2 rounded-lg bg-rose-600 text-white text-sm font-semibold hover:bg-rose-700 transition-colors">
                                    End Voice Call
                                </button>
                            </div>
                        </div>
                    }

                    <!-- Call Status Card -->
                    <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-6 shadow-sm border-l-4 @(activeCallId > 0 ? "border-green-500" : "border-gray-300 dark:border-gray-600")">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-3">
                                @if(activeCallId > 0) {
                                    <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                                } else {
                                     <div class="w-3 h-3 bg-gray-400 rounded-full"></div>
                                }
                                <h2 class="text-lg font-bold text-[#1E1E2D] dark:text-white">@(activeCallId > 0 ? $"Active Call #{activeCallId}" : "No Active Call")</h2>
                            </div>
                            <span class="font-mono text-xl font-bold text-gray-700 dark:text-gray-300">@callDuration</span>
                        </div>
                        
                        <!-- Customer Search (when no active call) -->
                        @if (activeCallId == 0)
                        {
                            <div class="mb-4">
                                <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-2">Select Customer</label>
                                <select @bind="selectedCustomerId" @bind:after="OnSelectedCustomerChanged" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] text-gray-900 dark:text-white">
                                    <option value="0">-- Choose a Customer --</option>
                                    @if (allCustomers != null)
                                    {
                                        @foreach (var c in allCustomers)
                                        {
                                            <option value="@c.Id">@c.FirstName @c.LastName (@c.Email)</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="block text-sm font-semibold text-gray-600 dark:text-gray-300 mb-2">Call Type</label>
                                <select @bind="callType" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-[var(--color-primary)] text-gray-900 dark:text-white">
                                    <option value="Inbound">Inbound</option>
                                    <option value="Outbound">Outbound</option>
                                    <option value="FollowUp">Follow-Up</option>
                                </select>
                            </div>
                        }

                        <div class="flex flex-col sm:flex-row gap-3">
                            @if (activeCallId == 0)
                            {
                                <button @onclick="StartNewCall" disabled="@(!CanStartCall)" 
                                    class="flex-1 bg-green-500 hover:bg-green-600 text-white font-bold py-3 rounded-xl shadow-lg shadow-green-500/20 transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                                     @(isProcessing ? "Starting..." : "Start Call")
                                </button>
                            }
                            else
                            {
                                <button @onclick="PauseCall" class="flex-1 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 font-bold py-3 rounded-xl transition-all">
                                    @(isPaused ? "Resume" : "Hold Call")
                                </button>
                                <button @onclick="EndCall" disabled="@(!CanEndCall)"
                                    class="flex-1 bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-xl shadow-lg shadow-red-500/20 transition-all disabled:opacity-50">
                                    @(isProcessing ? "Saving..." : "End Interaction")
                                </button>
                            }
                        </div>
                        @if (activeCallId == 0 && selectedCustomerId == 0)
                        {
                            <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">Select a customer first, then start the call.</p>
                        }
                    </div>

                    <!-- Customer Info (shown when call is active) -->
                    @if (selectedCustomer != null && activeCallId > 0)
                    {
                        <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                             <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-[var(--color-primary)] font-bold text-xl">
                                    @selectedCustomer.FirstName?.FirstOrDefault()
                                </div>
                                <div>
                                    <h3 class="font-bold text-lg text-[#1E1E2D] dark:text-white">@selectedCustomer.FirstName @selectedCustomer.LastName</h3>
                                    <p class="text-sm text-gray-500 dark:text-gray-400">@selectedCustomer.Email</p>
                                </div>
                                <div class="ml-auto">
                                    <span class="px-3 py-1 bg-blue-50 text-[var(--color-primary)] rounded-lg text-xs font-bold border border-blue-100 dark:bg-blue-900/10 dark:border-blue-800">
                                        @(selectedCustomer.CustomerType ?? "Customer")
                                    </span>
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-2 gap-4 text-sm mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
                                <div>
                                    <span class="block text-gray-500 dark:text-gray-400 text-xs">Phone Number</span>
                                    <span class="font-medium text-[#1E1E2D] dark:text-white">@selectedCustomer.Phone</span>
                                </div>
                                <div>
                                    <span class="block text-gray-500 dark:text-gray-400 text-xs">Company</span>
                                    <span class="font-medium text-[#1E1E2D] dark:text-white">@(selectedCustomer.Company ?? "N/A")</span>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Call Subject -->
                    <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white mb-3">Call Subject</h3>
                        <input type="text" @bind="callSubject" disabled="@(activeCallId == 0)"
                            class="w-full bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-3 focus:ring-2 focus:ring-[var(--color-primary)] outline-none text-gray-700 dark:text-gray-200"
                            placeholder="Brief subject of the call..." />
                    </div>

                    <!-- Notes Area -->
                     <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700 flex-1 flex flex-col">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white mb-3">Interaction Notes</h3>
                        <textarea @bind="callNotes" disabled="@(activeCallId == 0)" 
                            class="flex-1 w-full bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-xl p-4 focus:ring-2 focus:ring-[var(--color-primary)] outline-none resize-none text-gray-700 dark:text-gray-200"
                            placeholder="Type details about the conversation here..."></textarea>
                     </div>

                     <!-- Outcome (visible during active call) -->
                     @if (activeCallId > 0)
                     {
                         <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
                        <h3 class="font-bold text-[#1E1E2D] dark:text-white mb-3">Call Outcome</h3>
                             <select @bind="callOutcome" class="w-full bg-gray-50 dark:bg-[#2A2A35] border border-gray-200 dark:border-gray-600 rounded-xl px-4 py-3 focus:ring-2 focus:ring-[var(--color-primary)] text-gray-900 dark:text-white">
                                 <option value="">-- Select Outcome --</option>
                                 <option value="Resolved">Resolved</option>
                                 <option value="Follow-Up Required">Follow-Up Required</option>
                                 <option value="Ticket Created">Ticket Created</option>
                                 <option value="Order Placed">Order Placed</option>
                                 <option value="Escalated">Escalated</option>
                                 <option value="No Action">No Action Needed</option>
                             </select>
                            @if (string.IsNullOrWhiteSpace(callOutcome))
                            {
                                <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Choose an outcome to enable call completion.</p>
                            }
                         </div>
                     }
                </div>

                <!-- Right: Quick Actions & Context -->
                <div class="xl:w-80 flex flex-col space-y-4">
                     <!-- Quick Actions -->
                    <div class="bg-white dark:bg-[#1E1E2D] rounded-xl p-4 shadow-sm border border-gray-100 dark:border-gray-700">
                        <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Quick Actions</h4>
                        <div class="space-y-2">
                             <button @onclick="CreateTicketFromCall" disabled="@(activeCallId == 0)" class="w-full text-left px-4 py-3 rounded-lg bg-gray-50 dark:bg-[#2A2A35] hover:bg-gray-100 dark:hover:bg-[#32323F] transition-colors flex items-center justify-between group disabled:opacity-50">
                                <span class="font-medium text-[#1E1E2D] dark:text-white">Create Ticket</span>
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" /></svg>
                             </button>
                             <button @onclick="OpenCustomerProfile" disabled="@(activeCallId == 0 || selectedCustomer is null)" class="w-full text-left px-4 py-3 rounded-lg bg-gray-50 dark:bg-[#2A2A35] hover:bg-gray-100 dark:hover:bg-[#32323F] transition-colors flex items-center justify-between group disabled:opacity-50">
                                <span class="font-medium text-[#1E1E2D] dark:text-white">Open Customer Profile</span>
                                <svg class="w-5 h-5 text-gray-400 group-hover:text-[var(--color-primary)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12H9m12 0A9 9 0 1112 3a9 9 0 019 9z" /></svg>
                             </button>
                        </div>
                    </div>

                    <!-- Recent Context (Linked Tickets) -->
                     <div class="bg-blue-50 dark:bg-blue-900/10 rounded-xl p-4 border border-blue-100 dark:border-blue-900/20 flex-1 overflow-y-auto">
                        <h4 class="text-xs font-bold text-blue-800 dark:text-blue-300 uppercase tracking-wider mb-3">Customer Open Tickets</h4>
                        @if (selectedCustomer != null && selectedCustomerOpenTickets.Any())
                        {
                            <div class="space-y-2">
                                @foreach(var ticket in selectedCustomerOpenTickets) {
                                    <div class="bg-white dark:bg-[#1E1E2D] p-3 rounded-lg border border-blue-100 dark:border-blue-900/30 hover:shadow-sm cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/agent/tickets")'>
                                        <div class="text-sm font-bold text-[#1E1E2D] dark:text-white line-clamp-1">@ticket.Title</div>
                                        <div class="flex justify-between mt-1">
                                            <span class="text-xs text-gray-500">@ticket.TicketNumber</span>
                                            <span class="text-xs font-bold @(ticket.Priority == "High" || ticket.Priority == "Critical" ? "text-red-500" : "text-gray-500")">@ticket.Priority</span>
                                        </div>
                                        <div class="mt-1">
                                            <span class="text-xs px-2 py-0.5 rounded-full @GetTicketStatusClass(ticket.Status)">@ticket.Status</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                             <div class="text-center py-8 text-blue-400 dark:text-blue-500/50 text-sm">
                                 @(selectedCustomer != null ? "No open tickets for this customer." : "Select a customer to see tickets.")
                             </div>
                        }
                     </div>

                    <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Recent Customer Voice Calls</h4>
                            <span class="text-[11px] text-gray-500">Last 5</span>
                        </div>

                        @if (!RecentSupportVoiceCalls.Any())
                        {
                            <p class="text-xs text-gray-500">No recent support voice calls.</p>
                        }
                        else
                        {
                            <div class="space-y-2">
                                @foreach (var call in RecentSupportVoiceCalls)
                                {
                                    <button @onclick="() => ViewSupportVoiceCallDetails(call)"
                                            class="w-full text-left rounded-lg border border-gray-100 bg-gradient-to-r from-gray-50 to-white p-3 hover:shadow-sm transition-shadow">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs font-semibold text-gray-800 truncate">@call.CustomerName</span>
                                            <span class="text-[11px] text-gray-500">@call.StartTime.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                        </div>
                                        <div class="mt-1 flex items-center justify-between gap-2">
                                            <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold @GetSupportCallStatusBadgeClass(call.Status)">
                                                <span class="w-1.5 h-1.5 rounded-full @GetSupportCallStatusDotClass(call.Status)"></span>
                                                @call.Status
                                            </span>
                                            <span class="text-[11px] font-semibold text-gray-600">@call.DurationFormatted</span>
                                        </div>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
             </div>
        }
        else if (currentView == "history")
        {
             <div class="p-6 h-full overflow-y-auto">
                 @if (isLoadingHistory)
                 {
                     <div class="flex justify-center py-12">
                         <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-[var(--color-primary)]"></div>
                     </div>
                 }
                 else if (!callHistory.Any())
                 {
                     <div class="text-center py-16">
                         <svg class="w-16 h-16 mx-auto text-gray-300 dark:text-gray-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                         </svg>
                         <h3 class="text-lg font-bold text-gray-500 dark:text-gray-400">No Call History Yet</h3>
                         <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">Call records will appear here after you handle calls.</p>
                     </div>
                 }
                 else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
                        <div class="rounded-xl p-4 border border-blue-100 bg-gradient-to-br from-blue-50 to-white shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs uppercase tracking-wider text-blue-600 font-bold">Total Calls</p>
                                <span class="text-base">📞</span>
                            </div>
                            <p class="text-2xl font-extrabold text-[#1E1E2D] mt-1">@callHistory.Count</p>
                        </div>
                        <div class="rounded-xl p-4 border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs uppercase tracking-wider text-emerald-700 font-bold">Completed</p>
                                <span class="text-base">✅</span>
                            </div>
                            <p class="text-2xl font-extrabold text-emerald-700 mt-1">@CompletedCallCount</p>
                        </div>
                        <div class="rounded-xl p-4 border border-rose-100 bg-gradient-to-br from-rose-50 to-white shadow-sm">
                            <div class="flex items-center justify-between">
                                <p class="text-xs uppercase tracking-wider text-rose-700 font-bold">Escalated</p>
                                <span class="text-base">⚠️</span>
                            </div>
                            <p class="text-2xl font-extrabold text-rose-700 mt-1">@EscalatedCallCount</p>
                        </div>
                    </div>

                    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-4 mb-4">
                        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_12rem_12rem] gap-3">
                            <input type="text"
                                   @bind="historySearch"
                                   @bind:event="oninput"
                                   @bind:after="OnHistoryFiltersChanged"
                                   class="w-full rounded-xl border border-gray-300 px-4 py-2.5 text-sm outline-none focus:border-blue-400"
                                   placeholder="Search customer, subject, outcome, call ID..." />
                            <select @bind="historyStatusFilter"
                                    @bind:after="OnHistoryFiltersChanged"
                                    class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                                <option value="All">All Status</option>
                                <option value="Completed">Completed</option>
                                <option value="InProgress">In Progress</option>
                                <option value="Missed">Missed</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Scheduled">Scheduled</option>
                            </select>
                            <select @bind="historyTypeFilter"
                                    @bind:after="OnHistoryFiltersChanged"
                                    class="w-full rounded-xl border border-gray-300 px-3 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                                <option value="All">All Types</option>
                                <option value="Inbound">Inbound</option>
                                <option value="Outbound">Outbound</option>
                                <option value="FollowUp">Follow-Up</option>
                            </select>
                        </div>
                    </div>

                    @if (!FilteredCallHistory.Any())
                    {
                        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-10 text-center">
                            <div class="text-3xl mb-2">🔎</div>
                            <h3 class="text-base font-bold text-gray-800">No matching call logs</h3>
                            <p class="text-sm text-gray-500 mt-1">Try changing the search text or filters.</p>
                        </div>
                    }
                    else
                    {
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                            <table class="min-w-full divide-y divide-gray-100">
                                <thead class="bg-gradient-to-r from-gray-50 to-blue-50/40">
                                <tr>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">ID</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date/Time</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Customer</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Type</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Duration</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Subject</th>
                                    <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Outcome</th>
                                    <th class="px-6 py-4 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Action</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                @foreach(var call in PagedCallHistory)
                                {
                                    <tr class="hover:bg-blue-50/30 transition-colors cursor-pointer"
                                        title="View call details"
                                        @onclick="() => ViewSupportVoiceCallDetails(call)">
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">#@call.Id</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">@call.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-[#1E1E2D]">@call.CustomerName</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold @GetCallTypeClass(call.Type)">@FormatCallType(call.Type)</span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 font-mono">@call.DurationFormatted</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                             <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold @GetCallStatusClass(call.Status)">
                                                <span class="w-1.5 h-1.5 rounded-full @GetCallStatusDotClass(call.Status)"></span>
                                                @call.Status
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 max-w-xs truncate">
                                            @(call.Subject ?? "-")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                            @(call.Outcome ?? "-")
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-right">
                                            <button type="button"
                                                    @onclick="() => ViewSupportVoiceCallDetails(call)"
                                                    @onclick:stopPropagation="true"
                                                    class="inline-flex items-center gap-1.5 rounded-lg border border-blue-100 bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700 hover:bg-blue-100 transition-colors">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5s8.268 2.943 9.542 7c-1.274 4.057-5.065 7-9.542 7s-8.268-2.943-9.542-7z" />
                                                </svg>
                                                View Details
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            </table>
                        </div>
                    }

                     @if (FilteredCallHistory.Any())
                     {
                         <div class="px-6 py-4 bg-white rounded-xl border border-gray-200 shadow-sm mt-4 flex items-center justify-between">
                             <p class="text-sm text-gray-500">
                                 Showing @(((callCurrentPage - 1) * callPageSize) + 1)-@Math.Min(callCurrentPage * callPageSize, FilteredCallHistory.Count) of @FilteredCallHistory.Count · Page @callCurrentPage/@CallTotalPages
                             </p>
                             <div class="flex items-center gap-2">
                                 <button type="button" @onclick="PreviousCallPage" disabled="@(callCurrentPage <= 1)"
                                         class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
                                 <button type="button" @onclick="NextCallPage" disabled="@(callCurrentPage >= CallTotalPages)"
                                         class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
                             </div>
                         </div>
                     }
                 }
             </div>
        }

        @if (selectedSupportVoiceCall != null)
        {
            <div class="absolute inset-0 z-50 bg-black/50 flex items-center justify-center p-4" @onclick="CloseSupportVoiceCallDetails">
                <div class="bg-white rounded-2xl w-full max-w-2xl max-h-[85vh] overflow-y-auto shadow-2xl" @onclick:stopPropagation="true">
                    <div class="p-5 border-b border-gray-100 flex items-center justify-between">
                        <h3 class="text-base font-bold text-[#1E1E2D]">Support Voice Call Details</h3>
                        <button @onclick="CloseSupportVoiceCallDetails" class="text-gray-400 hover:text-gray-600 text-lg leading-none">&times;</button>
                    </div>
                    <div class="p-5 space-y-3 text-sm">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Customer</p>
                                <p class="font-semibold text-gray-900">@selectedSupportVoiceCall.CustomerName</p>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Agent</p>
                                <p class="font-semibold text-gray-900">@GetAgentDisplayName(selectedSupportVoiceCall)</p>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Status</p>
                                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg text-[11px] font-semibold @GetSupportCallStatusBadgeClass(selectedSupportVoiceCall.Status)">
                                    <span class="w-1.5 h-1.5 rounded-full @GetSupportCallStatusDotClass(selectedSupportVoiceCall.Status)"></span>
                                    @selectedSupportVoiceCall.Status
                                </span>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Duration</p>
                                <p class="font-semibold text-gray-900">@selectedSupportVoiceCall.DurationFormatted</p>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Started</p>
                                <p class="font-semibold text-gray-900">@selectedSupportVoiceCall.StartTime.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss")</p>
                            </div>
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Ended</p>
                                <p class="font-semibold text-gray-900">@(selectedSupportVoiceCall.EndTime.HasValue ? selectedSupportVoiceCall.EndTime.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm:ss") : "Ongoing / Not recorded")</p>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(selectedSupportVoiceCall.Subject))
                        {
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Subject</p>
                                <p class="text-gray-800">@selectedSupportVoiceCall.Subject</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedSupportVoiceCall.Outcome))
                        {
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Outcome</p>
                                <p class="text-gray-800">@selectedSupportVoiceCall.Outcome</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(selectedSupportVoiceCall.Notes))
                        {
                            <div class="rounded-lg border border-gray-200 p-3">
                                <p class="text-[11px] uppercase text-gray-500 font-semibold mb-1">Notes</p>
                                <p class="text-gray-800 whitespace-pre-wrap">@selectedSupportVoiceCall.Notes</p>
                            </div>
                        }

                        @if (GetRelatedTicketId(selectedSupportVoiceCall) is int relatedTicketId)
                        {
                            <div class="pt-1">
                                <button @onclick="() => OpenRelatedTicketAsync(relatedTicketId)"
                                        class="rounded-lg bg-blue-600 text-white px-4 py-2 text-sm font-semibold hover:bg-blue-700 transition-colors">
                                    Open Related Ticket #@relatedTicketId
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // State
    private int activeCallId = 0;
    private DateTime activeCallStartTime;
    private bool isPaused = false;
    private Customer? selectedCustomer;
    private int selectedCustomerId = 0;
    private string callType = "Inbound";
    private string callDuration = "00:00:00";
    private string callNotes = "";
    private string callSubject = "";
    private string callOutcome = "";
    private string statusMessage = "";
    private bool isError = false;
    private bool isProcessing = false;
    private bool isLoadingHistory = false;
    private Timer? callTimer;

    // Data
    private List<Call> callHistory = new();
    private List<Customer> allCustomers = new();
    private List<Ticket> selectedCustomerOpenTickets = new();
    private int currentAgentId = 0;
    private bool CanStartCall => selectedCustomerId > 0 && !isProcessing;
    private bool CanEndCall => activeCallId > 0 && !isProcessing && !string.IsNullOrWhiteSpace(callOutcome);
    private string ActiveStateText => activeCallId > 0 ? (isPaused ? "On Hold" : "Live") : "Idle";
    private int CompletedCallCount => callHistory.Count(c => c.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase));
    private int EscalatedCallCount => callHistory.Count(c => !string.IsNullOrWhiteSpace(c.Outcome) && c.Outcome.Equals("Escalated", StringComparison.OrdinalIgnoreCase));
    private int callCurrentPage = 1;
    private const int callPageSize = 12;
    private string historySearch = string.Empty;
    private string historyStatusFilter = "All";
    private string historyTypeFilter = "All";
    private List<Call> FilteredCallHistory => callHistory
        .Where(c =>
            (historyStatusFilter == "All" || c.Status.Equals(historyStatusFilter, StringComparison.OrdinalIgnoreCase)) &&
            (historyTypeFilter == "All" || c.Type.Equals(historyTypeFilter, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(historySearch) ||
             (c.CustomerName?.Contains(historySearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.Subject?.Contains(historySearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (c.Outcome?.Contains(historySearch, StringComparison.OrdinalIgnoreCase) ?? false) ||
             c.Id.ToString().Contains(historySearch, StringComparison.OrdinalIgnoreCase)))
        .OrderByDescending(c => c.StartTime)
        .ToList();
    private int CallTotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCallHistory.Count / (double)callPageSize));
    private List<Call> PagedCallHistory => FilteredCallHistory.Skip((callCurrentPage - 1) * callPageSize).Take(callPageSize).ToList();
    private HubConnection? supportCallHub;
    private DotNetObjectReference<CallHandling>? supportCallDotNetRef;
    private IncomingSupportCall? incomingSupportCall;
    private string? activeSupportCallId;
    private string activeSupportCustomerName = "Customer";
    private string activeAgentDisplayName = "Agent";
    private bool isSupportVoiceCallActive;
    private int waitingCustomerCount;
    private int onlineCustomerCount;
    private int activeSupportCallsCount;
    private Call? selectedSupportVoiceCall;
    private List<Call> RecentSupportVoiceCalls => callHistory
        .Where(IsSupportVoiceCall)
        .OrderByDescending(c => c.StartTime)
        .Take(5)
        .ToList();

    private void OnHistoryFiltersChanged()
    {
        callCurrentPage = 1;
    }

    private string GetCurrentView()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLower();
        if (relativePath.Contains("history")) return "history";
        return "log";
    }

    private void NavigateTo(string view)
    {
        NavigationManager.NavigateTo($"/agent/calls/{view}");
    }

    protected override async Task OnInitializedAsync()
    {
        if (TryRedirectToHttpsForVoice())
        {
            return;
        }

        // Get current agent ID
        var user = await ApiClient.GetCurrentUserAsync();
        if (user != null)
        {
            currentAgentId = user.Id;
            activeAgentDisplayName = $"{user.FirstName} {user.LastName}".Trim();
        }

        // Load customers for dropdown
        allCustomers = (await ApiClient.GetCustomersAsync()) ?? new();

        // Load call history
        await LoadCallHistory();

        await InitializeSupportVoiceHubAsync();
    }

    private async Task InitializeSupportVoiceHubAsync()
    {
        if (currentAgentId <= 0)
        {
            return;
        }

        supportCallDotNetRef = DotNetObjectReference.Create(this);

        var supportHubUri = new Uri(HttpClient.BaseAddress!, "hubs/support-call");

        supportCallHub = new HubConnectionBuilder()
            .WithUrl(supportHubUri)
            .WithAutomaticReconnect()
            .Build();

        supportCallHub.Reconnected += async _ =>
        {
            try
            {
                await supportCallHub.InvokeAsync("RegisterUser", currentAgentId, "Agent", activeAgentDisplayName);
                statusMessage = "Support voice connection restored.";
                isError = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                statusMessage = $"Support voice reconnect failed: {ex.Message}";
                isError = true;
                await InvokeAsync(StateHasChanged);
            }
        };

        supportCallHub.Closed += async _ =>
        {
            if (isSupportVoiceCallActive)
            {
                isSupportVoiceCallActive = false;
                activeSupportCallId = null;
                activeSupportCustomerName = "Customer";
                statusMessage = "Support voice connection lost.";
                isError = true;
            }

            await InvokeAsync(StateHasChanged);
        };

        supportCallHub.On<string, int, string, int?>("IncomingSupportCall", async (callId, customerUserId, customerName, ticketId) =>
        {
            if (isSupportVoiceCallActive)
            {
                return;
            }

            incomingSupportCall = new IncomingSupportCall
            {
                CallId = callId,
                CustomerUserId = customerUserId,
                CustomerName = customerName,
                TicketId = ticketId
            };
            statusMessage = $"Incoming support call from {customerName}.";
            isError = false;
            await InvokeAsync(StateHasChanged);
        });

        supportCallHub.On<int, int, int>("SupportQueueChanged", async (waitingCustomers, onlineCustomers, activeCalls) =>
        {
            waitingCustomerCount = Math.Max(0, waitingCustomers);
            onlineCustomerCount = Math.Max(0, onlineCustomers);
            activeSupportCallsCount = Math.Max(0, activeCalls);
            await InvokeAsync(StateHasChanged);
        });

        supportCallHub.On<string>("SupportCallHandled", async (callId) =>
        {
            if (incomingSupportCall != null && incomingSupportCall.CallId == callId)
            {
                incomingSupportCall = null;
                await InvokeAsync(StateHasChanged);
            }
        });

        supportCallHub.On<string, string>("ReceiveOffer", async (callId, offerJson) =>
        {
            if (!string.Equals(callId, activeSupportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("supportCall.initCall", callId, "agent-support-remote-audio", supportCallDotNetRef);
            var answerJson = await JSRuntime.InvokeAsync<string>("supportCall.createAnswer", callId, offerJson);
            await supportCallHub.InvokeAsync("SendAnswer", callId, answerJson);
        });

        supportCallHub.On<string, string>("ReceiveIceCandidate", async (callId, candidateJson) =>
        {
            if (!string.Equals(callId, activeSupportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("supportCall.addIceCandidate", callId, candidateJson);
        });

        supportCallHub.On<string, string>("SupportCallEnded", async (callId, reason) =>
        {
            if (!string.Equals(callId, activeSupportCallId, StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            await JSRuntime.InvokeVoidAsync("supportCall.endCall", callId);
            isSupportVoiceCallActive = false;
            activeSupportCallId = null;
            activeSupportCustomerName = "Customer";
            statusMessage = string.IsNullOrWhiteSpace(reason) ? "Support voice call ended." : reason;
            isError = false;
            await LoadCallHistory();
            await InvokeAsync(StateHasChanged);
        });

        try
        {
            await supportCallHub.StartAsync();
            await supportCallHub.InvokeAsync("RegisterUser", currentAgentId, "Agent", activeAgentDisplayName);
            var queue = await supportCallHub.InvokeAsync<SupportQueueSnapshot>("GetSupportQueue");
            waitingCustomerCount = Math.Max(0, queue?.WaitingCustomers ?? 0);
            onlineCustomerCount = Math.Max(0, queue?.OnlineCustomers ?? 0);
            activeSupportCallsCount = Math.Max(0, queue?.ActiveCalls ?? 0);
            var iceServers = await ApiClient.GetSupportIceServersAsync();
            if (iceServers is { Count: > 0 })
            {
                await JSRuntime.InvokeVoidAsync("supportCall.setIceServers", iceServers);
            }
            
            var isWebRtcSupported = await JSRuntime.InvokeAsync<bool>("supportCall.isSupported");
            if (!isWebRtcSupported)
            {
                isError = true;
                statusMessage = IsInsecureHttpSession()
                    ? "Live Voice Calling requires HTTPS. This page is redirecting to https:// now. If it does not load, open the secure site URL manually."
                    : "Live Voice Calling is not available in this browser/device.";
            }
        }
        catch (Exception ex)
        {
            isError = true;
            statusMessage = $"Voice connection failed (are you using HTTPS?): {ex.Message}";
        }
    }

    private bool TryRedirectToHttpsForVoice()
    {
        if (!IsInsecureHttpSession())
        {
            return false;
        }

        if (!Uri.TryCreate(NavigationManager.Uri, UriKind.Absolute, out var currentUri))
        {
            return false;
        }

        var secureBuilder = new UriBuilder(currentUri)
        {
            Scheme = Uri.UriSchemeHttps,
            Port = currentUri.Port == 80 ? 443 : currentUri.Port
        };

        NavigationManager.NavigateTo(secureBuilder.Uri.ToString(), forceLoad: true);
        return true;
    }

    private bool IsInsecureHttpSession()
    {
        if (!Uri.TryCreate(NavigationManager.Uri, UriKind.Absolute, out var currentUri))
        {
            return false;
        }

        if (!string.Equals(currentUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        // Local dev can stay on HTTP for testing.
        if (currentUri.IsLoopback || string.Equals(currentUri.Host, "localhost", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private async Task AcceptIncomingSupportCallAsync()
    {
        if (incomingSupportCall == null || supportCallHub == null || supportCallHub.State != HubConnectionState.Connected)
        {
            return;
        }

        var acceptConfirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Accept support voice call from {incomingSupportCall.CustomerName}?");
        if (!acceptConfirmed)
        {
            return;
        }

        try
        {
            activeSupportCallId = incomingSupportCall.CallId;
            activeSupportCustomerName = incomingSupportCall.CustomerName;
            isSupportVoiceCallActive = true;

            await supportCallHub.InvokeAsync("AcceptSupportCall", incomingSupportCall.CallId, currentAgentId, activeAgentDisplayName);
            incomingSupportCall = null;
            statusMessage = $"Connected voice call with {activeSupportCustomerName}.";
            isError = false;
        }
        catch (HubException ex)
        {
            isSupportVoiceCallActive = false;
            activeSupportCallId = null;
            statusMessage = ex.Message;
            isError = true;
        }
        catch (Exception ex)
        {
            isSupportVoiceCallActive = false;
            activeSupportCallId = null;
            statusMessage = $"Unable to accept support call: {ex.Message}";
            isError = true;
        }
    }

    private async Task DeclineIncomingSupportCallAsync()
    {
        if (incomingSupportCall == null || supportCallHub == null || supportCallHub.State != HubConnectionState.Connected)
        {
            return;
        }

        var declineConfirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            $"Decline support voice call from {incomingSupportCall.CustomerName}?");
        if (!declineConfirmed)
        {
            return;
        }

        await supportCallHub.InvokeAsync("DeclineSupportCall", incomingSupportCall.CallId, "Agent is unavailable. Please try again.");
        incomingSupportCall = null;
        await LoadCallHistory();
    }

    private async Task EndActiveSupportCallAsync()
    {
        if (string.IsNullOrWhiteSpace(activeSupportCallId))
        {
            return;
        }

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "End this active customer voice call?");
        if (!confirmed)
        {
            return;
        }

        if (supportCallHub != null && supportCallHub.State == HubConnectionState.Connected)
        {
            await supportCallHub.InvokeAsync("EndSupportCall", activeSupportCallId, "Call ended by agent.");
        }

        await JSRuntime.InvokeVoidAsync("supportCall.endCall", activeSupportCallId);
        isSupportVoiceCallActive = false;
        activeSupportCallId = null;
        activeSupportCustomerName = "Customer";
        await LoadCallHistory();
    }

    [JSInvokable]
    public async Task OnIceCandidateGenerated(string callId, string candidateJson)
    {
        if (supportCallHub == null || supportCallHub.State != HubConnectionState.Connected)
        {
            return;
        }

        if (!string.Equals(callId, activeSupportCallId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        await supportCallHub.InvokeAsync("SendIceCandidate", callId, candidateJson);
    }

    private async Task LoadCallHistory()
    {
        isLoadingHistory = true;
        try
        {
            if (currentAgentId > 0)
            {
                callHistory = (await ApiClient.GetCallsByAgentAsync(currentAgentId)) ?? new();
            }
            else
            {
                callHistory = (await ApiClient.GetCallsAsync()) ?? new();
            }
            // Sort by most recent first
            callHistory = callHistory.OrderByDescending(c => c.StartTime).ToList();
            callCurrentPage = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading call history: {ex.Message}");
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task LoadCustomerTickets(int customerId)
    {
        try
        {
            var allTickets = await ApiClient.GetTicketsAsync();
            selectedCustomerOpenTickets = allTickets?
                .Where(t => t.CustomerId == customerId && t.Status != "Resolved" && t.Status != "Closed")
                .ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customer tickets: {ex.Message}");
        }
    }

    private async Task OnSelectedCustomerChanged()
    {
        selectedCustomer = allCustomers.FirstOrDefault(c => c.Id == selectedCustomerId);

        if (selectedCustomerId > 0)
        {
            await LoadCustomerTickets(selectedCustomerId);
        }
        else
        {
            selectedCustomerOpenTickets.Clear();
        }
    }

    private async Task StartNewCall()
    {
        if (selectedCustomerId == 0 || currentAgentId == 0) return;

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Start this call now?");
        if (!confirm) return;

        isProcessing = true;
        statusMessage = "";

        try
        {
            // Find the selected customer
            selectedCustomer = allCustomers.FirstOrDefault(c => c.Id == selectedCustomerId);

            // Create call record in the database via API
            var request = new CreateCallRequest
            {
                CustomerId = selectedCustomerId,
                AgentId = currentAgentId,
                Type = callType,
                Subject = callSubject
            };

            var createdCall = await ApiClient.CreateCallAsync(request);

            if (createdCall != null)
            {
                activeCallId = createdCall.Id;
                activeCallStartTime = DateTime.Now;

                // Start the call on the server (sets status to InProgress)
                await ApiClient.StartCallAsync(activeCallId);

                // Start local timer for display
                callTimer = new Timer(1000);
                callTimer.Elapsed += UpdateCallDuration;
                callTimer.Start();

                // Load customer's open tickets
                await LoadCustomerTickets(selectedCustomerId);

                statusMessage = $"Call #{activeCallId} started successfully.";
                isError = false;
            }
            else
            {
                statusMessage = "Failed to create call record. Please try again.";
                isError = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error starting call: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void UpdateCallDuration(object? sender, ElapsedEventArgs e)
    {
        if (activeCallId > 0)
        {
            var ts = DateTime.Now - activeCallStartTime;
            callDuration = ts.ToString(@"hh\:mm\:ss");
            InvokeAsync(StateHasChanged);
        }
    }

    private void PauseCall()
    {
        if (activeCallId > 0)
        {
            isPaused = !isPaused;
            if (isPaused) callTimer?.Stop(); else callTimer?.Start();
        }
    }

    private async Task EndCall()
    {
        if (activeCallId == 0) return;

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "End and save this call interaction?");
        if (!confirm) return;

        isProcessing = true;
        try
        {
            // Update call with notes, subject, and outcome
            var updateRequest = new UpdateCallRequest
            {
                Notes = callNotes,
                Subject = callSubject,
                Outcome = callOutcome,
                Status = "Completed",
                EndTime = DateTime.UtcNow,
                IsEscalated = callOutcome == "Escalated"
            };

            await ApiClient.UpdateCallAsync(activeCallId, updateRequest);

            // End call on the server
            await ApiClient.EndCallAsync(activeCallId);

            statusMessage = $"Call #{activeCallId} ended and saved successfully.";
            isError = false;

            // Reset state
            activeCallId = 0;
            isPaused = false;
            callTimer?.Stop();
            callTimer?.Dispose();
            callTimer = null;
            selectedCustomer = null;
            selectedCustomerId = 0;
            callDuration = "00:00:00";
            callNotes = "";
            callSubject = "";
            callOutcome = "";
            selectedCustomerOpenTickets.Clear();

            // Refresh history
            await LoadCallHistory();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error ending call: {ex.Message}";
            isError = true;
        }
        finally
        {
            isProcessing = false;
        }
    }
    
    // Quick Actions - Create ticket linked to current call
    private void CreateTicketFromCall()
    {
        if (activeCallId > 0 && selectedCustomer != null)
        {
