    private string GetAgentDisplayName(Call call)
    {
        if (call.AgentId == currentAgentId && !string.IsNullOrWhiteSpace(activeAgentDisplayName))
        {
            return activeAgentDisplayName;
        }

        return call.AgentId > 0 ? $"Agent #{call.AgentId}" : "Support Agent";
    }

    private int? GetRelatedTicketId(Call call)
    {
        if (string.IsNullOrWhiteSpace(call.Notes))
        {
            return null;
        }

        var ticketPattern = Regex.Match(call.Notes, @"ticket\s*#?\s*(\d+)", RegexOptions.IgnoreCase);
        if (ticketPattern.Success && int.TryParse(ticketPattern.Groups[1].Value, out var ticketId))
        {
            return ticketId;
        }

        return null;
    }

    private Task OpenRelatedTicketAsync(int ticketId)
    {
        selectedSupportVoiceCall = null;
        NavigationManager.NavigateTo($"/agent/tickets?ticketId={ticketId}");
        return Task.CompletedTask;
    }

