    private async Task ConfirmAndNavigateToTicketAsync()
    {
        if (selectedCustomer == null || activeCallId == 0) return;
        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Create a ticket from this active call?");
        if (!confirm) return;
        NavigationManager.NavigateTo($"/tickets/create?customerId={selectedCustomer.Id}&callId={activeCallId}");
    }

