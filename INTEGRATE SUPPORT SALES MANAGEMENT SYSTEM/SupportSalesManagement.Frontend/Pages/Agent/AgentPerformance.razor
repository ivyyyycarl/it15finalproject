@page "/agent/performance"
@layout AgentLayout
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@using System.Globalization
@inject IJSRuntime JSRuntime
@inject ApiClient ApiClient

<PageTitle>My Performance | Agent Workspace</PageTitle>

<div class="h-[calc(100vh-theme(spacing.16))] flex flex-col bg-gray-50 dark:bg-[#151521] overflow-hidden" style="font-family: Inter, sans-serif; font-size: 12px;">
    <!-- Header -->
    <div
        class="bg-white dark:bg-[#1E1E2D] border-b border-gray-200 dark:border-gray-700 px-6 py-4 flex items-center justify-between shrink-0 gap-4">
        <div>
            <h1 class="text-[21px] font-bold text-[#1E1E2D] dark:text-white">Performance Metrics</h1>
            <p class="text-[12px] text-gray-500 dark:text-gray-400">Track your daily progress and quality scores</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap justify-end">
            <label class="text-xs text-gray-600">From</label>
            <input type="date" @bind="FromDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateRangeChanged" class="px-2.5 py-2 rounded-lg border border-gray-300 text-xs bg-white" />
            <label class="text-xs text-gray-600">To</label>
            <input type="date" @bind="ToDate" @bind:format="yyyy-MM-dd" @bind:after="OnDateRangeChanged" class="px-2.5 py-2 rounded-lg border border-gray-300 text-xs bg-white" />
            <button @onclick="ExportReport"
                class="flex items-center gap-2 bg-[var(--color-primary)] hover:bg-[var(--color-primary-dark)] text-white font-bold py-2 px-4 rounded-lg shadow-lg shadow-blue-500/20 transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export Report
            </button>
        </div>
    </div>

    <!-- Content -->
    <div class="flex-1 overflow-y-auto p-6">
        @if (Stats == null)
        {
            <div class="flex justify-center items-center h-64">
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-[var(--color-primary)]"></div>
            </div>
        }
        else
        {
            <!-- KPI Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
                <!-- Tickets Handled -->
                <div
                    class="p-6 rounded-xl shadow-sm border border-blue-100 bg-gradient-to-br from-blue-50 to-white hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-blue-50 dark:bg-blue-900/20 rounded-xl text-blue-600 dark:text-blue-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        
                    </div>
                    <h3 class="text-3xl font-bold text-[#1E1E2D] dark:text-white mb-1">@Stats.TicketsHandledToday</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Tickets Resolved Today</p>
                </div>

                <!-- CSAT -->
                <div
                    class="p-6 rounded-xl shadow-sm border border-amber-100 bg-gradient-to-br from-amber-50 to-white hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-yellow-50 dark:bg-yellow-900/20 rounded-xl text-yellow-600 dark:text-yellow-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363 1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        
                    </div>
                    <h3 class="text-3xl font-bold text-[#1E1E2D] dark:text-white mb-1">
                        @Stats.CustomerSatisfaction.ToString("0.0")</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Customer Satisfaction</p>
                </div>

                <!-- AHT -->
                <div
                    class="p-6 rounded-xl shadow-sm border border-violet-100 bg-gradient-to-br from-violet-50 to-white hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-3 bg-purple-50 dark:bg-purple-900/20 rounded-xl text-purple-600 dark:text-purple-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        
                    </div>
                    <h3 class="text-3xl font-bold text-[#1E1E2D] dark:text-white mb-1">@Stats.AverageResponseTime</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Avg Handle Time</p>
                </div>

                <!-- Conversion -->
                <div
                    class="p-6 rounded-xl shadow-sm border border-emerald-100 bg-gradient-to-br from-emerald-50 to-white hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div
                            class="p-3 bg-emerald-50 dark:bg-emerald-900/20 rounded-xl text-emerald-600 dark:text-emerald-400">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        
                    </div>
                    <h3 class="text-3xl font-bold text-[#1E1E2D] dark:text-white mb-1">@((Stats.SalesConversionRate *
                    100).ToString("0"))%</h3>
                    <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">Sales Conversion</p>
                </div>
            </div>

            <!-- Analytics Charts -->
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                <div class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-1">Daily Activity Trend</h3>
                    <p class="text-xs text-gray-500 mb-3">@FromDate.ToString("MMM dd, yyyy") to @ToDate.ToString("MMM dd, yyyy")</p>
                    <ApexChart TItem="ChartPoint" Height="300">
                        <ApexPointSeries TItem="ChartPoint"
                                         Items="ActivityTrendData"
                                         Name="Total Activities"
                                         SeriesType="SeriesType.Area"
                                         XValue="@(p => p.Label)"
                                         YValue="@(p => p.Value)"
                                         Color="#3B82F6" />
                    </ApexChart>
                </div>

                <div class="bg-white dark:bg-[#1E1E2D] p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                    <h3 class="text-lg font-bold text-[#1E1E2D] dark:text-white mb-4">Ticket Status Distribution</h3>
                    @if (TicketStatusData.Any())
                    {
                        <div class="flex flex-col sm:flex-row items-center gap-6">
                            <div class="relative w-44 h-44 shrink-0">
                                <div class="w-44 h-44 rounded-full" style="@($"background: {TicketStatusDonutGradient};")"></div>
                                <div class="absolute inset-8 rounded-full bg-white dark:bg-[#1E1E2D] border border-gray-100 dark:border-gray-700 flex flex-col items-center justify-center">
                                    <span class="text-2xl font-bold text-[#1E1E2D] dark:text-white">@TotalTicketStatuses</span>
                                    <span class="text-xs text-gray-500 dark:text-gray-400">Tickets</span>
                                </div>
                            </div>

                            <div class="w-full space-y-2">
                                @for (var i = 0; i < TicketStatusData.Count; i++)
                                {
                                    var item = TicketStatusData[i];
                                    <div class="flex items-center justify-between text-sm">
                                        <div class="flex items-center gap-2">
                                            <span class="w-3 h-3 rounded-full" style="@($"background-color: {GetDonutColor(i)};")"></span>
                                            <span class="text-gray-700 dark:text-gray-300">@item.Label</span>
                                        </div>
                                        <span class="text-gray-500 dark:text-gray-400">@item.Value (@GetStatusPercent(item.Value).ToString("0")%)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="h-[300px] flex items-center justify-center text-sm text-gray-500 dark:text-gray-400">
                            No ticket status data available.
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private SupportSalesManagement.Frontend.Models.AgentPerformance? Stats;
    private List<ChartPoint> ActivityTrendData = new();
    private List<ChartPoint> TicketStatusData = new();
    private List<Ticket> _agentTickets = new();
    private List<Call> _agentCalls = new();
    private List<Order> _agentOrders = new();
    private DateTime FromDate = DateTime.Today.AddDays(-6);
    private DateTime ToDate = DateTime.Today;
    private readonly string[] DonutColors = { "#8B5CF6", "#3B82F6", "#10B981", "#F59E0B", "#EF4444", "#6B7280" };
    private int TotalTicketStatuses => TicketStatusData.Sum(x => x.Value);
    private string TicketStatusDonutGradient => BuildTicketStatusDonutGradient();

    protected override async Task OnInitializedAsync()
    {
        var user = await ApiClient.GetCurrentUserAsync();
        if (user != null)
        {
            var summaryTask = ApiClient.GetCallSummaryAsync(user.Id);
            var ticketsTask = ApiClient.GetTicketsAsync();
            var callsTask = ApiClient.GetCallsByAgentAsync(user.Id);
            var ordersTask = ApiClient.GetOrdersAsync();

            await Task.WhenAll(summaryTask, ticketsTask, callsTask, ordersTask);

            var summary = await summaryTask;
            var tickets = await ticketsTask ?? new List<Ticket>();
            var calls = await callsTask ?? new List<Call>();
            var orders = await ordersTask ?? new List<Order>();

            _agentTickets = tickets.Where(t => t.AssignedAgentId == user.Id).ToList();
            _agentCalls = calls;
            _agentOrders = orders.Where(o => o.AgentId == user.Id || o.AssignedAgentId == user.Id).ToList();

            var resolvedTickets = _agentTickets.Count(t =>
                t.Status.Equals("Resolved", StringComparison.OrdinalIgnoreCase)
                || t.Status.Equals("Closed", StringComparison.OrdinalIgnoreCase));

            var completedOrders = _agentOrders.Count(o =>
                o.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase)
                || o.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase));

            var resolutionRate = _agentTickets.Count > 0
                ? (decimal)resolvedTickets / _agentTickets.Count
                : 0m;

            BuildCharts(_agentTickets, _agentCalls, _agentOrders);

            Stats = new SupportSalesManagement.Frontend.Models.AgentPerformance
                {
                    Name = $"{user.FirstName} {user.LastName}",
                    TicketsHandledToday = resolvedTickets,
                    CustomerSatisfaction = Math.Round(resolutionRate * 5m, 1),
                    AverageResponseTime = summary?.AverageDuration ?? "N/A",
                    SalesConversionRate = _agentOrders.Count > 0
                        ? (decimal)completedOrders / _agentOrders.Count
                        : 0m,
                    CallsToday = calls.Count(c => c.StartTime.Date == DateTime.Today),
                    AverageCallDuration = summary?.AverageDuration ?? "N/A",
                    ResolutionRate = resolutionRate
                };
        }
        else
        {
            Stats = new SupportSalesManagement.Frontend.Models.AgentPerformance
                {
                    Name = "Unknown Agent",
                    AverageResponseTime = "N/A"
                };

            ActivityTrendData = new List<ChartPoint>();
            TicketStatusData = new List<ChartPoint>();
        }
    }

    private void BuildCharts(List<Ticket> agentTickets, List<Call> calls, List<Order> agentOrders)
    {
        if (FromDate > ToDate)
        {
            (FromDate, ToDate) = (ToDate, FromDate);
        }

        var totalDays = (ToDate.Date - FromDate.Date).Days + 1;
        var days = Enumerable.Range(0, Math.Max(1, totalDays))
            .Select(i => FromDate.Date.AddDays(i))
            .ToList();

        ActivityTrendData = days.Select(day => new ChartPoint
        {
            Label = day.ToString("MM/dd"),
            Value = agentTickets.Count(t => t.CreatedAt.Date == day.Date)
                + calls.Count(c => c.StartTime.Date == day.Date)
                + agentOrders.Count(o => o.CreatedAt.Date == day.Date || o.OrderDate.Date == day.Date)
        }).ToList();

        TicketStatusData = agentTickets
            .GroupBy(t => string.IsNullOrWhiteSpace(t.Status) ? "Unknown" : t.Status)
            .Select(g => new ChartPoint
            {
                Label = g.Key,
                Value = g.Count()
            })
            .OrderByDescending(p => p.Value)
            .Take(6)
            .ToList();
    }

    private string GetDonutColor(int index) => DonutColors[index % DonutColors.Length];

    private double GetStatusPercent(int value)
    {
        if (TotalTicketStatuses == 0)
        {
            return 0;
        }

        return (double)value / TotalTicketStatuses * 100d;
    }

    private string BuildTicketStatusDonutGradient()
    {
        if (!TicketStatusData.Any() || TotalTicketStatuses == 0)
        {
            return "conic-gradient(#E5E7EB 0deg 360deg)";
        }

        var current = 0d;
        var segments = new List<string>();

        for (var i = 0; i < TicketStatusData.Count; i++)
        {
            var value = TicketStatusData[i].Value;
            var degrees = (double)value / TotalTicketStatuses * 360d;
            var start = current;
            var end = current + degrees;
            var color = GetDonutColor(i);

            segments.Add(
                $"{color} {start.ToString("0.##", CultureInfo.InvariantCulture)}deg {end.ToString("0.##", CultureInfo.InvariantCulture)}deg");
            current = end;
        }

        return $"conic-gradient({string.Join(", ", segments)})";
    }

    private async Task ExportReport()
    {
        await JSRuntime.InvokeVoidAsync("exportToPdf", "Agent Performance Report");
    }

    private Task OnDateRangeChanged()
    {
        BuildCharts(_agentTickets, _agentCalls, _agentOrders);
        return Task.CompletedTask;
    }

    private class ChartPoint
    {
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
    }
}
