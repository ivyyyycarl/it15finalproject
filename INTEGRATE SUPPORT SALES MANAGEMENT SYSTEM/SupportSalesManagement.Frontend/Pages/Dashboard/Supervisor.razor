    protected override async Task OnInitializedAsync()
    {
        NavigationManager.NavigateTo("/supervisor/dashboard", replace: true);
        await Task.CompletedTask;
    }

    private async void HandleDataChanged(string entityType, string action)
    {
        await InvokeAsync(async () =>
        {
            // Update specific data depending on what changed
            if (entityType == "Ticket" || entityType == "Call" || entityType == "Order")
            {
                await LoadSupervisorData();
            }

            if (entityType == "Product" || entityType == "Inventory")
            {
                await LoadERPData();
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SignalRService.OnDataChanged -= HandleDataChanged;
    }

    private async Task LoadSupervisorData()
    {
        try
        {
            var ticketsTask = ApiClient.GetTicketsAsync();
            var callsTask = ApiClient.GetCallsAsync();
            var usersTask = ApiClient.GetUsersAsync();

            await Task.WhenAll(ticketsTask, callsTask, usersTask);

            var tickets = ticketsTask.Result ?? new List<Ticket>();
            var calls = callsTask.Result ?? new List<Call>();
            var users = usersTask.Result ?? new List<User>();

            agentUsers = users.Where(u => u.Role == UserRole.Agent || u.Role == UserRole.Supervisor).ToList();
            var todayCalls = calls.Where(c => c.StartTime.Date == DateTime.Today).ToList();

            allTickets = tickets;
            escalatedTickets = tickets.Where(t => t.Status == "Escalated" || t.Priority == "Urgent").ToList();

            stats = new SupervisorStats
                {
                    TotalAgents = agentUsers.Count,
                    ActiveAgents = agentUsers.Count(u => u.IsActive),
                    TotalTickets = tickets.Count,
                    OpenTickets = tickets.Count(t => t.Status != "Closed" && t.Status != "Resolved"),
                    EscalatedTickets = escalatedTickets.Count,
                    OverdueTickets = tickets.Count(t => t.Priority == "Urgent" && t.Status != "Closed" && t.Status != "Resolved"),
                    TotalCallsToday = todayCalls.Count,
                    TeamAverageHandlingTime = 0,
                    TeamCustomerSatisfaction = 0,
                    TeamSalesConversion = 0
                };

            agents = agentUsers.Select(u => new AgentPerformance
                {
                    Id = u.Id,
                    Name = $"{u.FirstName} {u.LastName}",
                    Email = u.Email,
                    Status = u.IsActive ? "Available" : "Offline",
                    ActiveTickets = tickets.Count(t => t.AssignedAgentId == u.Id && t.Status != "Closed" && t.Status != "Resolved"),
                    TicketsHandledToday = tickets.Count(t => t.AssignedAgentId == u.Id && t.CreatedAt.Date == DateTime.Today),
                    TotalTicketsHandled = tickets.Count(t => t.AssignedAgentId == u.Id),
                    CallsToday = todayCalls.Count(c => c.AgentId == u.Id),
                    LastActivityTime = u.LastLoginAt ?? u.CreatedAt
                }).ToList();

            var recentItems = new List<CustomerTimeline.TimelineItem>();
            foreach (var t in tickets.OrderByDescending(t => t.CreatedAt).Take(3))
            {
                recentItems.Add(new CustomerTimeline.TimelineItem
                    {
                        Id = t.Id,
                        Type = "Ticket",
                        Title = $"{t.CustomerName}",
                        Description = t.Subject ?? t.Title,
                        Timestamp = t.CreatedAt,
                        Status = t.Status
                    });
            }
            foreach (var c in calls.OrderByDescending(c => c.StartTime).Take(3))
            {
                recentItems.Add(new CustomerTimeline.TimelineItem
                    {
                        Id = c.Id,
                        Type = "Call",
                        Title = c.CustomerName,
                        Description = c.Subject ?? "Phone call",
                        Timestamp = c.StartTime,
                        Status = c.Status
                    });
            }
            recentActivity = recentItems.OrderByDescending(i => i.Timestamp).Take(5).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading supervisor data: {ex.Message}");
            agents = new List<AgentPerformance>();
            agentUsers = new List<User>();
            allTickets = new List<Ticket>();
            escalatedTickets = new List<Ticket>();
            recentActivity = new List<CustomerTimeline.TimelineItem>();
        }
    }

    private async Task LoadERPData()
    {
        try
        {
            var inventoryTask = InventoryService.GetStatsAsync();
            var ordersTask = ApiClient.GetOrdersAsync();
            var productsTask = ApiClient.GetProductsAsync();

            await Task.WhenAll(ordersTask, productsTask);

            var orders = ordersTask.Result ?? new List<Order>();
            var products = productsTask.Result ?? new List<Product>();

            todaysSales = orders
                .Where(o => o.OrderDate.Date == DateTime.Today)
                .Sum(o => o.TotalAmount);

            totalInventoryValue = products.Sum(p => p.Price * p.StockQuantity);

            try
            {
                inventoryStats = await inventoryTask;
            }
            catch
            {
                inventoryStats = new InventoryStatsDto
                    {
                        TotalItems = products.Count,
                        LowStockCount = products.Count(p => p.StockQuantity < 10),
                        IncomingUnits = 0,
                        TotalValue = totalInventoryValue
                    };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ERP data: {ex.Message}");
            inventoryStats = new InventoryStatsDto();
            todaysSales = 0m;
            totalInventoryValue = 0m;
        }
    }

    private async Task RefreshData()
    {
        SalesTrend = await DashboardService.GetSalesTrendAsync();
        await LoadSupervisorData();
        await LoadERPData();
        StateHasChanged();
    }

