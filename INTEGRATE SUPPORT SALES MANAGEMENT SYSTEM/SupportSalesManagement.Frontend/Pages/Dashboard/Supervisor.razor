    private string TimeAgo(DateTime date)
    {
        var span = DateTime.Now - date;
        if (span.TotalMinutes < 60) return $"{Math.Ceiling(span.TotalMinutes)} min ago";
        if (span.TotalHours < 24) return $"{Math.Ceiling(span.TotalHours)} hr ago";
        return $"{Math.Ceiling(span.TotalDays)} days ago";
    }

    // Filtering Methods
    private IEnumerable<AgentPerformance> GetFilteredAgents()
    {
        return agentFilter switch
        {
            "available" => agents.Where(a => a.Status == "Available"),
            "busy" => agents.Where(a => a.Status == "Busy" || a.Status == "On Call"),
            "offline" => agents.Where(a => a.Status == "Offline"),
            _ => agents
        };
    }

    private IEnumerable<Ticket> GetFilteredTickets()
    {
        return ticketFilter switch
        {
            "open" => allTickets.Where(t => t.Status == "Open"),
            "in-progress" => allTickets.Where(t => t.Status == "In Progress"),
            "escalated" => allTickets.Where(t => t.Status == "Escalated"),
            _ => allTickets
        };
    }

    // Helper Methods
    private string GetTicketStatusClass(string status)
    {
        return status switch
        {
            "Open" => "text-green-600 bg-green-500/10",
            "In Progress" => "text-blue-600 bg-blue-500/10",
            "Escalated" => "text-red-600 bg-red-500/10",
            _ => "text-gray-600 bg-gray-500/10"
        };
    }
