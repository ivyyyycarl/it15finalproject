@page "/dashboard/supervisor"
@layout SupervisorLayout
@attribute [Authorize(Roles = "Supervisor,Admin")]

@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Pages.Dashboard.Components
@using SupportSalesManagement.Frontend.Pages.Customer.Components
@inject ApiClient ApiClient
@inject NavigationManager NavigationManager
@inject IInventoryService InventoryService
@inject IFinanceService FinanceService
@inject IDashboardService DashboardService
@inject SignalRService SignalRService
@implements IDisposable

<PageTitle>Supervisor Dashboard - Nexus CRM</PageTitle>

<div class="space-y-6 p-6 lg:p-8 max-w-[1600px] mx-auto">
    <!-- Header with Quick Actions -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl lg:text-3xl font-bold text-slate-800 tracking-tight">Supervisor Dashboard</h1>
            <p class="text-slate-500 mt-1 text-sm lg:text-base">Welcome back — here’s what’s happening today.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <button @onclick="RefreshData"
                class="px-4 py-2.5 bg-white border border-slate-200 text-slate-700 font-medium rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center shadow-sm text-sm">
                <svg class="w-4 h-4 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                Refresh
            </button>
            <button
                class="px-4 py-2.5 bg-white border border-slate-200 text-slate-700 font-medium rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center shadow-sm text-sm">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                </svg>
                Export Data
            </button>
        </div>
    </div>

    <!-- Main Stats Row - 4 Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        <!-- Active Agents -->
        <div
            class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Active Agents</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@stats.TotalAgents</h3>
                    <p class="text-sm font-medium text-emerald-600 mt-2">@stats.ActiveAgents online</p>
                </div>
                <div class="p-2.5 bg-indigo-50 rounded-xl text-indigo-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Open Tickets -->
        <div
            class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Open Tickets</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@stats.OpenTickets</h3>
                    <p class="text-sm font-medium text-amber-600 mt-2">Active tickets</p>
                </div>
                <div class="p-2.5 bg-amber-50 rounded-xl text-amber-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Calls Today -->
        <div
            class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Calls Today</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">@stats.TotalCallsToday</h3>
                    <p class="text-sm font-medium text-slate-500 mt-2">Total handled</p>
                </div>
                <div class="p-2.5 bg-sky-50 rounded-xl text-sky-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Sales Today -->
        <div
            class="bg-white rounded-xl lg:rounded-2xl p-5 lg:p-6 shadow-sm border border-slate-100 hover:shadow-md hover:border-slate-200 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-slate-500 text-sm font-medium">Sales (Today)</p>
                    <h3 class="text-2xl lg:text-3xl font-bold text-slate-900 mt-1">$@todaysSales.ToString("N0")</h3>
                    <p class="text-sm font-medium text-emerald-600 mt-2">Revenue total</p>
                </div>
                <div class="p-2.5 bg-emerald-50 rounded-xl text-emerald-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid: Balanced View -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Sales Overview Chart -->
        <div class="bg-white rounded-2xl p-5 lg:p-6 shadow-sm border border-gray-100 flex flex-col">
            <div class="flex items-center justify-between mb-4 lg:mb-6">
                <h3 class="text-lg lg:text-xl font-bold text-gray-900">Sales Overview</h3>
                <span class="text-[10px] font-bold text-indigo-500 bg-indigo-50 px-2 py-1 rounded uppercase tracking-wider">Trends</span>
            </div>
            <div class="flex-1 min-h-[300px] w-full bg-gray-50/30 rounded-xl border border-dashed border-gray-200 p-2 overflow-hidden">
                <ApexChart TItem="TimeSeriesData" Title="">
                    <ApexPointSeries TItem="TimeSeriesData" Items="SalesTrend" Name="Sales Volume"
                        SeriesType="SeriesType.Area" XValue="@(e => e.Date.ToString("MMM dd"))"
                        YValue="@(e => e.Value)" Color="#3B82F6" />
                </ApexChart>
            </div>
        </div>

        <!-- Team Activity Feed -->
        <div class="bg-white rounded-2xl p-5 lg:p-6 shadow-sm border border-gray-100 flex flex-col">
            <div class="flex items-center justify-between mb-4 lg:mb-6">
                <h3 class="text-lg lg:text-xl font-bold text-gray-900">Team Activity</h3>
                <div class="flex items-center gap-1.5">
                    @if (SignalRService.IsConnected)
                    {
                                <span class="relative flex h-2 w-2">
                                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                                </span>
                                <span class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">Live</span>
                    }
                    else
                    {
                                <span class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Offline</span>
                    }
                </div>
            </div>
            <div class="space-y-4 lg:space-y-5 flex-1 overflow-y-auto max-h-[400px] pr-2 custom-scrollbar">
                @if (recentActivity == null || !recentActivity.Any())
                {
                            <div class="flex flex-col items-center justify-center h-full text-slate-400 py-12">
                                <svg class="w-12 h-12 mb-2 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <p class="text-sm">No recent activity</p>
                            </div>
                }
                else
                {
                    @foreach (var activity in recentActivity.Take(8))
                    {
                                        <div class="flex gap-3 lg:gap-4 items-start group">
                                            <div class="flex-shrink-0 relative">
                                                <div class="w-10 h-10 rounded-full bg-slate-100 border-2 border-white shadow-sm flex items-center justify-center group-hover:bg-white transition-colors">
                                    @if (activity.Type == "Order")
                                    {
                                                    <span class="text-lg">🛒</span>
                                    }
                                    else if (activity.Type == "Call")
                                    {
                                                    <span class="text-lg">📞</span>
                                    }
                                    else
                                    {
                                                    <span class="text-lg">🎫</span>
                                    }
                                                </div>
                                            </div>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm font-semibold text-slate-800 truncate group-hover:text-indigo-600 transition-colors">@activity.Title</p>
                                                <p class="text-xs text-slate-500 mt-0.5 line-clamp-1">@activity.Description</p>
                                                <p class="text-[10px] text-slate-400 mt-1 uppercase font-medium">@TimeAgo(activity.Timestamp)</p>
                                            </div>
                                        </div>
                    }
                }
            </div>
        </div>

        <!-- Inventory Status -->
        <div class="bg-white rounded-2xl p-5 lg:p-6 shadow-sm border border-gray-100 flex flex-col">
            <div class="flex items-center justify-between mb-4 lg:mb-6">
                <h3 class="text-lg lg:text-xl font-bold text-gray-900">Inventory Status</h3>
                <a href="/inventory" class="text-[10px] font-bold text-indigo-500 hover:text-indigo-600 uppercase tracking-wider">Manage</a>
            </div>

            @if (inventoryStats != null)
            {
                        <div class="space-y-4 flex-1">
                            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 hover:bg-white hover:shadow-md hover:border-indigo-100 transition-all cursor-default group">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                            </svg>
                                        </div>
                                        <span class="text-sm font-medium text-slate-600">Total Products</span>
                                    </div>
                                    <span class="text-xl font-bold text-slate-900">@inventoryStats.TotalItems</span>
                                </div>
                            </div>

                            <div class="p-4 bg-amber-50/50 rounded-2xl border border-amber-100 hover:bg-white hover:shadow-md hover:border-amber-200 transition-all cursor-default group">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-amber-100 rounded-lg text-amber-600 group-hover:bg-amber-500 group-hover:text-white transition-all">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                            </svg>
                                        </div>
                                        <span class="text-sm font-medium text-amber-700">Low Stock</span>
                                    </div>
                                    <span class="text-xl font-bold text-amber-600">@inventoryStats.LowStockCount</span>
                                </div>
                                <div class="mt-2 text-[10px] text-amber-500 font-bold uppercase tracking-widest pl-1">Requires Attention</div>
                            </div>

                            <div class="p-4 bg-emerald-50/50 rounded-2xl border border-emerald-100 hover:bg-white hover:shadow-md hover:border-emerald-200 transition-all cursor-default group">
                                <div class="flex justify-between items-center">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-emerald-100 rounded-lg text-emerald-600 group-hover:bg-emerald-500 group-hover:text-white transition-all">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                            </svg>
                                        </div>
                                        <span class="text-sm font-medium text-emerald-700">Stock Value</span>
                                    </div>
                                    <span class="text-xl font-bold text-emerald-600">$@totalInventoryValue.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
            }
            else
            {
                        <div class="animate-pulse space-y-4">
                            <div class="h-16 bg-slate-100 rounded-2xl"></div>
                            <div class="h-16 bg-slate-100 rounded-2xl"></div>
                            <div class="h-16 bg-slate-100 rounded-2xl"></div>
                        </div>
            }
        </div>
    </div>

    <!-- LEGACY / DETAILED VIEWS (Preserved below fold) -->
    <div class="pt-8 border-t border-gray-200">
        <h2 class="text-lg font-bold text-gray-500 uppercase tracking-wider mb-6">Detailed Management Views</h2>

        <!-- Detailed Layout Grid (Existing Code) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Left Column: Agent Performance Cards (Scrollable) -->
            <div class="lg:col-span-2 space-y-8">
                <!-- Agents Section -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xl font-bold text-[#1E1E2D]">Agent Performance</h3>
                        <div class="flex items-center space-x-2">
                            <select @bind="agentFilter"
                                class="text-sm border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:ring-2 focus:ring-[#1E1E2D]">
                                <option value="all">All Agents</option>
                                <option value="available">Available</option>
                                <option value="busy">Busy</option>
                                <option value="offline">Offline</option>
                            </select>
                        </div>
                    </div>
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[600px] overflow-y-auto pr-2 custom-scrollbar">
                        @foreach (var agent in GetFilteredAgents())
                        {
                                    <AgentPerformanceCard Agent="agent" OnViewDetails="HandleViewAgentDetails"
                                        OnAssignTicket="HandleAssignTicket" />
                        }
                    </div>
                </div>

                <!-- All Tickets Section -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-xl font-bold text-[#1E1E2D]">Team Ticket Queue</h3>
                        <div class="flex items-center space-x-3">
                            <select @bind="ticketFilter"
                                class="text-sm border-gray-200 rounded-lg px-3 py-2 bg-gray-50 focus:ring-2 focus:ring-[#1E1E2D]">
                                <option value="all">All Tickets</option>
                                <option value="open">Open</option>
                                <option value="in-progress">In Progress</option>
                                <option value="escalated">Escalated</option>
                            </select>
                            <a href="/tickets" class="text-[#1E1E2D] hover:text-[#2563EB] text-sm font-bold">View
                                All</a>
                        </div>
                    </div>
                    <!-- Ticket List Container with height restriction -->
                    <div class="space-y-3 max-h-[400px] overflow-y-auto pr-2">
                        @foreach (var ticket in GetFilteredTickets())
                        {
                                    <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 hover:shadow-md transition-all cursor-pointer group"
                            @onclick="() => ViewTicket(ticket.Id)">
                                        <div class="flex items-start justify-between">
                                            <div class="flex-1">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span
                                                        class="@GetTicketStatusClass(ticket.Status) px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-sm">
                                                @ticket.Status
                                                    </span>
                                                    <h4
                                                        class="text-sm font-bold text-gray-900 group-hover:text-[#1E1E2D] transition-colors">
                                                @ticket.Subject</h4>
                                                </div>
                                                <p class="text-xs text-gray-500">
                                                    <span class="font-medium text-gray-700">@ticket.CustomerName</span> • Agent:
                                                    <span class="text-[#1E1E2D]">@ticket.AssignedTo</span>
                                                </p>
                                            </div>
                                            <div class="flex items-center space-x-3">
                                                <div class="text-right">
                                                    <span class="block text-[10px] text-gray-400 font-medium">PRIORITY</span>
                                                    <span
                                                        class="@(ticket.Priority == "Urgent" ? "text-red-600" : "text-gray-600") text-xs font-bold">@ticket.Priority</span>
                                                </div>
                                        @if (ticket.Priority == "Urgent" || ticket.Priority == "High")
                                        {
                                                            <button @onclick:stopPropagation="true" @onclick="() => OpenEscalateModal(ticket)"
                                                                class="p-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-500 hover:text-white transition-all"
                                                                title="Escalate">
                                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                                                </svg>
                                                            </button>
                                        }
                                            </div>
                                        </div>
                                    </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: ERP & Alerts -->
            <div class="space-y-8">
                <!-- Escalated Tickets Alert Area -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-bold">Priority Alerts</h3>
                        <span class="text-[10px] font-bold text-amber-500 bg-amber-50 px-2 py-1 rounded uppercase">Real-Time</span>
                    </div>
                    <div class="space-y-4">
                        <div class="flex justify-between items-center p-3.5 bg-indigo-50/50 rounded-xl border border-indigo-100">
                            <div class="flex flex-col">
                                <span class="text-xs text-slate-500 font-medium">Overdue Tickets</span>
                                <span class="text-lg font-bold text-indigo-600">@stats.OverdueTickets</span>
                            </div>
                            <div class="p-2 bg-white rounded-lg shadow-sm">
                                <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                            </div>
                        </div>
                        <div class="flex justify-between items-center p-3.5 bg-red-50/50 rounded-xl border border-red-100">
                            <div class="flex flex-col">
                                <span class="text-xs text-slate-500 font-medium">Escalated</span>
                                <span class="text-lg font-bold text-red-600">@stats.EscalatedTickets</span>
                            </div>
                            <div class="p-2 bg-white rounded-lg shadow-sm">
                                <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Escalated Tickets Alert -->
                @if (escalatedTickets.Any())
                {
                            <div class="bg-[#FFF5F5] rounded-2xl border border-red-100 p-6">
                                <div class="flex items-center justify-between mb-4">
                                    <h3 class="text-lg font-bold text-red-900">Escalations</h3>
                                    <span class="px-2 py-1 bg-red-100 text-red-700 text-xs font-bold rounded-lg mb-1">
                                @escalatedTickets.Count Urgent
                                    </span>
                                </div>
                                <div class="space-y-3">
                            @foreach (var ticket in escalatedTickets.Take(3))
                            {
                                                <div class="bg-white border border-red-100 rounded-xl p-3 shadow-sm">
                                                    <p class="text-sm font-bold text-gray-900 truncate">@ticket.Subject</p>
                                                    <div class="flex justify-between items-center mt-2">
                                                        <p class="text-xs text-gray-500">@ticket.AssignedTo</p>
                                                        <button @onclick="() => OpenEscalateModal(ticket)"
                                                            class="text-xs font-bold text-red-600 hover:underline">
                                                            Review
                                                        </button>
                                                    </div>
                                                </div>
                            }
                                </div>
                            </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal Components -->
<EscalateTicketModal IsVisible="showEscalateModal" SelectedTicket="selectedTicketForEscalation"
    OnClose="() => showEscalateModal = false" OnTicketEscalated="HandleTicketEscalated" />

<PerformanceReportModal IsVisible="showPerformanceReport" OnClose="() => showPerformanceReport = false"
    OnReportGenerated="HandleReportGenerated" Agents="agentUsers" />

@code {
    // Modal States
    private bool showEscalateModal = false;
    private bool showPerformanceReport = false;
    private Ticket? selectedTicketForEscalation;

    // Filters
