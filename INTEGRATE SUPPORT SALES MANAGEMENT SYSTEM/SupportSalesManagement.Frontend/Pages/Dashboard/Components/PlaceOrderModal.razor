@* Place Order Modal Component with ERP Integration *@
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient
@inject IInventoryService InventoryService
@inject IFinanceService FinanceService

@if (IsVisible)
{
    <div class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between sticky top-0 bg-white z-10">
                <h2 class="text-2xl font-bold text-gray-900">Place Order</h2>
                <button @onclick="Close" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-6 space-y-6">
                @if (SelectedCustomer != null)
                {
                    <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center">
                                <span
                                    class="text-white font-semibold">@SelectedCustomer.FirstName[0]@SelectedCustomer.LastName[0]</span>
                            </div>
                            <div>
                                <p class="font-medium text-gray-900">@SelectedCustomer.FirstName @SelectedCustomer.LastName</p>
                                <p class="text-sm text-gray-600">@SelectedCustomer.Email</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Product Filters -->
                <div class="bg-gray-50 rounded-lg p-4 space-y-4">
                    <h3 class="font-semibold text-gray-900">Filter Products</h3>

                    <div class="grid grid-cols-3 gap-4">
                        <!-- Size Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Size</label>
                            <select @bind="filterSize" @bind:event="oninput" @onchange="FilterProducts"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="">All Sizes</option>
                                <option value="XS">XS</option>
                                <option value="S">S</option>
                                <option value="M">M</option>
                                <option value="L">L</option>
                                <option value="XL">XL</option>
                                <option value="XXL">XXL</option>
                            </select>
                        </div>

                        <!-- Color Filter -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Color</label>
                            <select @bind="filterColor" @bind:event="oninput" @onchange="FilterProducts"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <option value="">All Colors</option>
                                <option value="Black">Black</option>
                                <option value="White">White</option>
                                <option value="Blue">Blue</option>
                                <option value="Red">Red</option>
                                <option value="Green">Green</option>
                                <option value="Navy">Navy</option>
                            </select>
                        </div>

                        <!-- Price Range -->
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">Max Price: ₱@maxPrice</label>
                            <input type="range" @bind="maxPrice" @bind:event="oninput" @onchange="FilterProducts" min="0"
                                max="100" step="5"
                                class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer" />
                        </div>
                    </div>
                </div>

                <!-- Product Grid -->
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-semibold text-gray-900">Available Products (@filteredProducts.Count)</h3>
                        @if (isLoadingProducts)
                        {
                            <span class="text-sm text-gray-500">Loading...</span>
                        }
                    </div>

                    @if (filteredProducts.Any())
                    {
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-h-96 overflow-y-auto">
                            @foreach (var product in filteredProducts)
                            {
                                <div class="@(selectedProduct?.Id == product.Id ? "border-2 border-blue-500 bg-blue-50" : "border border-gray-200") rounded-lg p-4 cursor-pointer hover:shadow-md transition-all"
                                    @onclick="() => SelectProduct(product)">
                                    <div class="aspect-square bg-gray-100 rounded-lg mb-3 flex items-center justify-center">
                                        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                                        </svg>
                                    </div>
                                    <h4 class="font-medium text-gray-900 text-sm mb-1">@product.Name</h4>
                                    <div class="flex items-center justify-between text-sm">
                                        <span class="text-gray-600">@product.Size - @product.Color</span>
                                    </div>
                                    <div class="flex items-center justify-between mt-2">
                                        <span class="font-bold text-blue-600">₱@product.Price.ToString("F2")</span>
                                        <span
                                            class="@(product.Stock > 10 ? "text-green-600" : product.Stock > 0 ? "text-orange-600" : "text-red-600") text-xs font-medium">
                                            @(product.Stock > 0 ? $"{product.Stock} in stock" : "Out of stock")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-12 text-gray-500">
                            <svg class="w-16 h-16 mx-auto mb-4 text-gray-300" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                            </svg>
                            <p>No products match your filters</p>
                        </div>
                    }
                </div>

                <!-- Selected Product & Quantity -->
                @if (selectedProduct != null)
                {
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                        <div class="flex items-center justify-between mb-3">
                            <div>
                                <h4 class="font-semibold text-gray-900">Selected: @selectedProduct.Name</h4>
                                <p class="text-sm text-gray-600">@selectedProduct.Size - @selectedProduct.Color</p>
                            </div>
                            <div class="text-right">
                                <p class="text-2xl font-bold text-blue-600">₱@selectedProduct.Price.ToString("F2")</p>
                            </div>
                        </div>

                        <div class="flex items-center space-x-4">
                            <label class="text-sm font-medium text-gray-700">Quantity:</label>
                            <div class="flex items-center space-x-2">
                                <button @onclick="DecreaseQuantity" type="button"
                                    class="w-8 h-8 bg-white border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-50">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                    </svg>
                                </button>
                                <input type="number" @bind="orderQuantity" min="1" max="@selectedProduct.Stock"
                                    class="w-20 text-center px-3 py-2 border border-gray-300 rounded-lg" />
                                <button @onclick="IncreaseQuantity" type="button"
                                    class="w-8 h-8 bg-white border border-gray-300 rounded-lg flex items-center justify-center hover:bg-gray-50">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 4v16m8-8H4" />
                                    </svg>
                                </button>
                            </div>
                            <div class="ml-auto text-right">
                                <p class="text-sm text-gray-600">Total</p>
                                <p class="text-xl font-bold text-gray-900">₱@((selectedProduct.Price *
                            orderQuantity).ToString("F2"))</p>
                            </div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded">
                        @errorMessage
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end space-x-3 sticky bottom-0">
                <button @onclick="Close"
                    class="px-5 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 font-medium transition-colors">
                    Cancel
                </button>
                <button @onclick="PlaceOrder" disabled="@(selectedProduct == null || isSubmitting)"
                    class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center">
                    @if (isSubmitting)
                    {
                        <svg class="animate-spin h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none"
                            viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                            </path>
                        </svg>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Place Order</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Customer? SelectedCustomer { get; set; }
    [Parameter] public long? RelatedCallId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnOrderPlaced { get; set; }

    private List<ProductDto> allProducts = new();
    private List<ProductDto> filteredProducts = new();
    private ProductDto? selectedProduct;
    private int orderQuantity = 1;

    // Filters
    private string filterSize = "";
    private string filterColor = "";
    private int maxPrice = 100;

    private string errorMessage = "";
    private bool isLoadingProducts = false;
    private bool isSubmitting = false;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !allProducts.Any())
        {
            await LoadProducts();
        }
    }

    private async Task LoadProducts()
    {
        isLoadingProducts = true;
        try
        {
            var products = await ApiClient.GetActiveProductsAsync();
            allProducts = (products ?? new List<Product>()).Select(p => new ProductDto
            {
                Id = p.Id.ToString(),
                Name = p.Name,
                Size = "",
                Color = "",
                Price = p.Price,
                Stock = p.StockQuantity,
                ImageUrl = p.ImageUrl ?? ""
            }).ToList();

            FilterProducts();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading products: {ex.Message}";
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private void FilterProducts()
    {
        filteredProducts = allProducts
        .Where(p => p.Stock > 0) // Only show in-stock items
        .Where(p => string.IsNullOrEmpty(filterSize) || p.Size == filterSize)
        .Where(p => string.IsNullOrEmpty(filterColor) || p.Color == filterColor)
        .Where(p => p.Price <= maxPrice)
        .ToList();
    }

    private void SelectProduct(ProductDto product)
    {
        selectedProduct = product;
        orderQuantity = 1;
        errorMessage = "";
    }

    private void IncreaseQuantity()
    {
        if (selectedProduct != null && orderQuantity < selectedProduct.Stock)
        {
            orderQuantity++;
        }
    }

    private void DecreaseQuantity()
    {
        if (orderQuantity > 1)
        {
            orderQuantity--;
        }
    }

    private async Task PlaceOrder()
    {
        errorMessage = "";

        if (SelectedCustomer == null)
        {
            errorMessage = "Please select a customer first.";
            return;
        }

        if (selectedProduct == null)
        {
            errorMessage = "Please select a product.";
            return;
        }

        if (orderQuantity > selectedProduct.Stock)
        {
            errorMessage = $"Only {selectedProduct.Stock} units available.";
            return;
        }

        isSubmitting = true;

        try
        {
            var orderRequest = new CreateOrderRequest
                {
                    CustomerId = SelectedCustomer.Id,
                    OrderDetails = new List<CreateOrderDetailRequest>
                    {
                        new CreateOrderDetailRequest
                        {
                            ProductId = int.TryParse(selectedProduct.Id, out var pid) ? pid : 0,
                            Quantity = orderQuantity,
                            UnitPrice = selectedProduct.Price
                        }
                    },
                    TotalAmount = selectedProduct.Price * orderQuantity,
                    Notes = $"Order placed by agent for customer {SelectedCustomer.FirstName} {SelectedCustomer.LastName}"
                };
            var (order, apiErrorMessage) = await ApiClient.CreateOrderWithResultAsync(orderRequest);
            if (order != null)
            {
                await OnOrderPlaced.InvokeAsync();
                ResetForm();
                await Close();
            }
            else
            {
                errorMessage = $"Error placing order: {apiErrorMessage ?? "Unknown error"}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error placing order: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Close()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        selectedProduct = null;
        orderQuantity = 1;
        filterSize = "";
        filterColor = "";
        maxPrice = 100;
        errorMessage = "";
    }
}
