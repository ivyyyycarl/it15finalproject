@* Call Log Modal Component *@
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Services
@inject ApiClient ApiClient

@if (IsVisible)
{
    <div class="fixed inset-0 bg-gray-900 bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full">
            <!-- Header -->
            <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between">
                <h2 class="text-2xl font-bold text-gray-900">Log Call</h2>
                <button @onclick="Close" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Body -->
            <div class="px-6 py-6 space-y-5">
                @if (SelectedCustomer != null)
                {
                    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 bg-green-600 rounded-full flex items-center justify-center">
                                <span
                                    class="text-white font-semibold">@SelectedCustomer.FirstName[0]@SelectedCustomer.LastName[0]</span>
                            </div>
                            <div>
                                <p class="font-medium text-gray-900">@SelectedCustomer.FirstName @SelectedCustomer.LastName</p>
                                <p class="text-sm text-gray-600">@SelectedCustomer.Phone</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Call Date/Time -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Call Date</label>
                        <input type="date" @bind="callDate"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Call Time</label>
                        <input type="time" @bind="callTime"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                    </div>
                </div>

                <!-- Duration -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Duration (minutes)</label>
                    <input type="number" @bind="duration" min="1" max="300"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                        placeholder="Enter call duration" />
                </div>

                <!-- Call Reason -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Call Reason</label>
                    <select @bind="callReason"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        <option value="">Select a reason</option>
                        <option value="Product Inquiry">Product Inquiry</option>
                        <option value="Order Status">Order Status</option>
                        <option value="Technical Support">Technical Support</option>
                        <option value="Complaint">Complaint</option>
                        <option value="Returns">Returns</option>
                        <option value="General">General</option>
                    </select>
                </div>

                <!-- Notes -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Call Notes</label>
                    <textarea @bind="callNotes" rows="5"
                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
                        placeholder="Summary of the call conversation..."></textarea>
                </div>

                <!-- Link to Ticket -->
                <div class="flex items-center space-x-2">
                    <input type="checkbox" id="createTicket" @bind="createTicketFromCall"
                        class="w-4 h-4 text-blue-600 rounded focus:ring-blue-500" />
                    <label for="createTicket" class="text-sm font-medium text-gray-700">
                        Create support ticket from this call
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="bg-red-50 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded">
                        @errorMessage
                    </div>
                }
            </div>

            <!-- Footer -->
            <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-end space-x-3">
                <button @onclick="Close"
                    class="px-5 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 font-medium transition-colors">
                    Cancel
                </button>
                <button @onclick="LogCall" disabled="@isSubmitting"
                    class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium transition-colors disabled:opacity-50 flex items-center">
                    @if (isSubmitting)
                    {
                        <svg class="animate-spin h-5 w-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none"
                            viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor"
                                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                            </path>
                        </svg>
                        <span>Logging...</span>
                    }
                    else
                    {
                        <span>Log Call</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Customer? SelectedCustomer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnCallLogged { get; set; }

    private DateTime callDate = DateTime.Today;
    private TimeOnly callTime = TimeOnly.FromDateTime(DateTime.Now);
    private int duration = 5;
    private string callReason = "";
    private string callNotes = "";
    private bool createTicketFromCall = false;
    private string errorMessage = "";
    private bool isSubmitting = false;

    private async Task LogCall()
    {
        errorMessage = "";

        // Validation
        if (SelectedCustomer == null)
        {
            errorMessage = "Please select a customer first.";
            return;
        }

        if (duration < 1)
        {
            errorMessage = "Please enter a valid duration.";
            return;
        }

        if (string.IsNullOrWhiteSpace(callReason))
        {
            errorMessage = "Please select a call reason.";
            return;
        }

        isSubmitting = true;

        try
        {
            var currentUser = await ApiClient.GetCurrentUserAsync();
            var request = new CreateCallRequest
                {
                    CustomerId = SelectedCustomer.Id,
                    AgentId = currentUser?.Id ?? 0,
                    Type = "Outbound",
                    Subject = callReason,
                    Notes = callNotes
                };

            var createdCall = await ApiClient.CreateCallAsync(request);
            if (createdCall == null)
                throw new Exception("Failed to log call. Please try again.");

            await OnCallLogged.InvokeAsync();
            ResetForm();
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error logging call: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task Close()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        callDate = DateTime.Today;
        callTime = TimeOnly.FromDateTime(DateTime.Now);
        duration = 5;
        callReason = "";
        callNotes = "";
        createTicketFromCall = false;
        errorMessage = "";
    }
}
