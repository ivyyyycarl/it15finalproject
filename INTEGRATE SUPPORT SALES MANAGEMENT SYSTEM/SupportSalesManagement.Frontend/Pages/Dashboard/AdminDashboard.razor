    .mid-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; align-items:stretch; }
    @@media (max-width:1200px) { .mid-grid { grid-template-columns:1fr; } }
    @@media (max-width:1440px) and (min-width:1201px) { .mid-grid { grid-template-columns:repeat(2,1fr); } }
    .mid-grid > * { height:100%; }
    .panel-card { background:white; border:1px solid var(--card-border-color, #e2e8f0); border-radius:var(--card-radius, 1rem); box-shadow:var(--card-shadow, 0 1px 4px rgba(0,0,0,.05)); overflow:hidden; height:100%; min-height:var(--card-min-height-md, 210px); }
    .panel-header { display:flex; align-items:center; justify-content:space-between; padding:1.125rem 1.25rem .75rem; border-bottom:1px solid #f8fafc; }
    .panel-title { font-size:.9375rem; font-weight:700; color:#1e293b; margin:0; }
    .panel-link { font-size:.75rem; font-weight:600; color:#4338ca; text-decoration:none; }
