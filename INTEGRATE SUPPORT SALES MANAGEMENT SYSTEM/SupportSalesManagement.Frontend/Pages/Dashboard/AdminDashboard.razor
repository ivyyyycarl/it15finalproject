@page "/dashboard/admin"
@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@using SupportSalesManagement.Frontend.Services
@using SupportSalesManagement.Frontend.Models
@using SupportSalesManagement.Frontend.Pages.Dashboard.Components
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@attribute [Authorize(Roles = "Admin")]
@inject IInventoryService InventoryService
@inject IFinanceService FinanceService
@inject IDashboardService DashboardService
@inject ApiClient _apiClient
@inject NavigationManager NavigationManager

<PageTitle>Admin Command Center - ClassicFit</PageTitle>

@if (loadError != null)

{
        <div class="mx-6 mt-6 p-5 bg-red-50 border border-red-200 rounded-2xl flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-bold text-red-900">Dashboard Error</h3>
                <p class="text-sm text-red-700 mt-0.5">@loadError</p>
            </div>
            <button @onclick="() => loadError = null" class="text-red-400 hover:text-red-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
        </div>
}

<div class="dash-container">

    <!-- ============================================================ -->
    <!-- HEADER                                                        -->
    <!-- ============================================================ -->
    <div class="dash-header">
        <div class="dash-header-left">
            <div class="dash-header-title-row">
                <h1 class="dash-title">Admin Command Center</h1>
                <span class="dash-role-badge">Admin</span>
            </div>
            <p class="dash-subtitle">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                <span class="dash-subtitle-sep">|</span>
                Daily oversight of sales, inventory, support, and team performance
            </p>
        </div>
        <div class="dash-header-actions">
            <button @onclick="RefreshData" class="dash-btn-secondary" disabled="@isLoading">
                <svg class="w-4 h-4 @(isLoading ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Refresh</span>
            </button>
            @if (canViewAdminAnalytics)
            {
                <a href="/admin/reports" class="dash-btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Reports</span>
                </a>
            }
        </div>
    </div>

    <!-- ===== STAT CARDS ===== -->
    <div class="sc-grid">
        <a href="/admin/reports/sales" class="sc-card sc-card-link">
            <div class="sc-top">
                <div><p class="sc-label">Total Revenue</p><p class="sc-val">&#8369;@allTimeRevenue.ToString("N0")</p>
                    <span class="sc-chg @(revenueMonthChangePercent >= 0 ? "sc-up" : "sc-dn")">
                        <svg viewBox="0 0 10 10" width="10">
                            <path d="@(revenueMonthChangePercent >= 0 ? "M1 8L5 2L9 8" : "M1 2L5 8L9 2")" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                        </svg>
                        @Math.Abs(revenueMonthChangePercent).ToString("N1")% vs last month
                    </span>
                </div>
                <div class="sc-icon sc-icon-g"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
            </div>
            <svg class="sc-spark" viewBox="0 0 200 44" preserveAspectRatio="none"><defs><linearGradient id="g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#10b981" stop-opacity=".35"/><stop offset="100%" stop-color="#10b981" stop-opacity="0"/></linearGradient></defs><path d="M0 34C30 30 50 26 80 20C110 14 140 16 170 8C185 4 195 3 200 2" fill="none" stroke="#10b981" stroke-width="2"/><path d="M0 34C30 30 50 26 80 20C110 14 140 16 170 8C185 4 195 3 200 2L200 44L0 44Z" fill="url(#g1)"/></svg>
        </a>
        <a href="/admin/orders" class="sc-card sc-card-link">
            <div class="sc-top">
                <div>
                    <p class="sc-label">Total Orders</p>
                    <p class="sc-val">@totalOrders</p>
                    <span class="sc-chg @(ordersMonthChangePercent >= 0 ? "sc-up" : "sc-dn")">
                        <svg viewBox="0 0 10 10" width="10">
                            <path d="@(ordersMonthChangePercent >= 0 ? "M1 8L5 2L9 8" : "M1 2L5 8L9 2")" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/>
                        </svg>
                        @Math.Abs(ordersMonthChangePercent).ToString("N1")% vs last month
                    </span>
                    <div class="sc-subchips">
                        <a href="/admin/orders?focus=refunds#refund-requests" class="sc-chip sc-chip-rose">Refund Requests: @pendingRefundRequests.Count</a>
                    </div>
                </div>
                <div class="sc-icon sc-icon-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg></div>
            </div>
            <svg class="sc-spark" viewBox="0 0 200 44" preserveAspectRatio="none"><defs><linearGradient id="g2" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#3b82f6" stop-opacity=".35"/><stop offset="100%" stop-color="#3b82f6" stop-opacity="0"/></linearGradient></defs><path d="M0 36C30 32 60 28 90 22C120 16 140 20 170 12C185 8 195 5 200 4" fill="none" stroke="#3b82f6" stroke-width="2"/><path d="M0 36C30 32 60 28 90 22C120 16 140 20 170 12C185 8 195 5 200 4L200 44L0 44Z" fill="url(#g2)"/></svg>
        </a>
        <a href="/admin/escalations" class="sc-card sc-card-link">
            <div class="sc-top">
                <div><p class="sc-label">Support Tickets</p><p class="sc-val">@totalTickets</p>
                    @if (escalatedTickets > 0){<span class="sc-chg sc-dn"><svg viewBox="0 0 10 10" width="10"><path d="M1 2L5 8L9 2" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>@escalatedTickets escalated</span>}
                    else{<span class="sc-chg sc-up"><svg viewBox="0 0 10 10" width="10"><path d="M1 8L5 2L9 8" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>All on track</span>}
                </div>
                <div class="sc-icon sc-icon-v"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg></div>
            </div>
            <svg class="sc-spark" viewBox="0 0 200 44" preserveAspectRatio="none"><defs><linearGradient id="g3" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#8b5cf6" stop-opacity=".35"/><stop offset="100%" stop-color="#8b5cf6" stop-opacity="0"/></linearGradient></defs><path d="M0 30C30 26 50 30 80 22C110 14 130 18 160 10C175 6 190 4 200 3" fill="none" stroke="#8b5cf6" stroke-width="2"/><path d="M0 30C30 26 50 30 80 22C110 14 130 18 160 10C175 6 190 4 200 3L200 44L0 44Z" fill="url(#g3)"/></svg>
        </a>
        <a href="/admin/inventory" class="sc-card sc-card-link">
            <div class="sc-top">
                <div><p class="sc-label">Inventory Items</p><p class="sc-val">@totalProducts</p>
                    @if(lowStockCount > 0){<span class="sc-chg sc-dn"><svg viewBox="0 0 10 10" width="10"><path d="M1 2L5 8L9 2" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>@lowStockCount low stock</span>}
                    else{<span class="sc-chg sc-up"><svg viewBox="0 0 10 10" width="10"><path d="M1 8L5 2L9 8" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>Well stocked</span>}
                </div>
                <div class="sc-icon sc-icon-a"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg></div>
            </div>
            <svg class="sc-spark" viewBox="0 0 200 44" preserveAspectRatio="none"><defs><linearGradient id="g4" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#f59e0b" stop-opacity=".35"/><stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/></linearGradient></defs><path d="M0 38C30 36 50 32 80 26C100 22 120 24 150 16C170 10 185 6 200 4" fill="none" stroke="#f59e0b" stroke-width="2"/><path d="M0 38C30 36 50 32 80 26C100 22 120 24 150 16C170 10 185 6 200 4L200 44L0 44Z" fill="url(#g4)"/></svg>
        </a>
    </div>

    <!-- ===== ANALYTICS ROW ===== -->
    @if (canViewAdminAnalytics)
    {
    <div class="an-row">
        <!-- Overview Area Chart -->
        <div class="an-chart-card">
            <div class="an-chart-head">
                <div><h3 class="an-chart-title">Revenue Overview</h3><p class="an-chart-sub">Monthly performance · current year</p></div>
                <div class="an-tabs">
                    <button class="an-tab @(selectedChartMetric == "revenue" ? "an-tab-on" : string.Empty)" type="button" @onclick='() => SetChartMetric("revenue")'>Revenue</button>
                    <button class="an-tab @(selectedChartMetric == "orders" ? "an-tab-on" : string.Empty)" type="button" @onclick='() => SetChartMetric("orders")'>Orders</button>
                    <button class="an-tab @(selectedChartMetric == "profit" ? "an-tab-on" : string.Empty)" type="button" @onclick='() => SetChartMetric("profit")'>Profit</button>
                </div>
            </div>
            <div class="an-chart-body">
                <div class="an-ylabels">
                    <span>@FormatChartAxisValue(chartSeriesMax)</span>
                    <span>@FormatChartAxisValue(chartSeriesMax * 0.75m)</span>
                    <span>@FormatChartAxisValue(chartSeriesMax * 0.50m)</span>
                    <span>@FormatChartAxisValue(chartSeriesMax * 0.25m)</span>
                    <span>@FormatChartAxisValue(0)</span>
                </div>
                <div class="an-chartarea">
                    <svg viewBox="0 0 600 180" preserveAspectRatio="none" style="width:100%;height:180px;display:block">
                        <defs><linearGradient id="ag" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="@chartSeriesColor" stop-opacity=".4"/><stop offset="100%" stop-color="@chartSeriesColor" stop-opacity=".03"/></linearGradient></defs>
                        <line x1="0" y1="0" x2="600" y2="0" stroke="#f1f5f9" stroke-width="1"/>
                        <line x1="0" y1="45" x2="600" y2="45" stroke="#f1f5f9" stroke-width="1"/>
                        <line x1="0" y1="90" x2="600" y2="90" stroke="#f1f5f9" stroke-width="1"/>
                        <line x1="0" y1="135" x2="600" y2="135" stroke="#f1f5f9" stroke-width="1"/>
                        <path d="@chartAreaPath" fill="url(#ag)"/>
                        <path d="@chartLinePath" fill="none" stroke="@chartSeriesColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <div class="an-xlabels"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span><span>Oct</span><span>Nov</span><span>Dec</span></div>
                </div>
            </div>
        </div>
        <!-- Right side panels -->
        <div class="an-right">
            <!-- Order Status Donut -->
            <div class="side-box">
                <h4 class="side-box-title">Order Status</h4>
                <p class="side-box-sub">Current distribution</p>
                <div class="donut-row">
                    <svg viewBox="0 0 100 100" style="width:90px;height:90px;flex-shrink:0">
                        <circle cx="50" cy="50" r="38" fill="none" stroke="#f1f5f9" stroke-width="14"/>
                        <circle cx="50" cy="50" r="38" fill="none" stroke="#f59e0b" stroke-width="14" stroke-dasharray="@(SafePercent(pendingOrders,totalOrders) != "0" ? (double.Parse(SafePercent(pendingOrders,totalOrders)) * 2.39).ToString("F1") : "0") 239" stroke-dashoffset="0" transform="rotate(-90 50 50)"/>
                        <circle cx="50" cy="50" r="38" fill="none" stroke="#3b82f6" stroke-width="14" stroke-dasharray="@(SafePercent(processingOrders,totalOrders) != "0" ? (double.Parse(SafePercent(processingOrders,totalOrders)) * 2.39).ToString("F1") : "0") 239" stroke-dashoffset="-@((double.Parse(SafePercent(pendingOrders,Math.Max(1,totalOrders))) * 2.39).ToString("F1"))" transform="rotate(-90 50 50)"/>
                        <circle cx="50" cy="50" r="38" fill="none" stroke="#10b981" stroke-width="14" stroke-dasharray="@(SafePercent(shippedOrders,totalOrders) != "0" ? (double.Parse(SafePercent(shippedOrders,totalOrders)) * 2.39).ToString("F1") : "0") 239" stroke-dashoffset="-@(((double.Parse(SafePercent(pendingOrders,Math.Max(1,totalOrders))) + double.Parse(SafePercent(processingOrders,Math.Max(1,totalOrders)))) * 2.39).ToString("F1"))" transform="rotate(-90 50 50)"/>
                        <circle cx="50" cy="50" r="38" fill="none" stroke="#ef4444" stroke-width="14" stroke-dasharray="@(SafePercent(cancelledOrders,totalOrders) != "0" ? (double.Parse(SafePercent(cancelledOrders,totalOrders)) * 2.39).ToString("F1") : "0") 239" stroke-dashoffset="-@(((double.Parse(SafePercent(pendingOrders,Math.Max(1,totalOrders))) + double.Parse(SafePercent(processingOrders,Math.Max(1,totalOrders))) + double.Parse(SafePercent(shippedOrders,Math.Max(1,totalOrders)))) * 2.39).ToString("F1"))" transform="rotate(-90 50 50)"/>
                        <text x="50" y="47" text-anchor="middle" font-size="12" font-weight="800" fill="#1e293b">@totalOrders</text>
                        <text x="50" y="59" text-anchor="middle" font-size="6.5" fill="#94a3b8">orders</text>
                    </svg>
                    <div class="donut-legend">
                        <div class="dl-row"><span class="dl-dot" style="background:#f59e0b"></span><span class="dl-name">Pending</span><span class="dl-val">@pendingOrders</span></div>
                        <div class="dl-row"><span class="dl-dot" style="background:#3b82f6"></span><span class="dl-name">Processing</span><span class="dl-val">@processingOrders</span></div>
                        <div class="dl-row"><span class="dl-dot" style="background:#10b981"></span><span class="dl-name">Shipped</span><span class="dl-val">@shippedOrders</span></div>
                        <div class="dl-row"><span class="dl-dot" style="background:#ef4444"></span><span class="dl-name">Cancelled</span><span class="dl-val">@cancelledOrders</span></div>
                    </div>
                </div>
            </div>
            <!-- Monthly Goals -->
            <div class="side-box">
                <h4 class="side-box-title">Monthly Goals</h4>
                <p class="side-box-sub">Progress toward targets</p>
                <div class="goals-stack">
                    <div class="goal-row">
                        <div class="gr-head"><span>Revenue Target</span><span class="gr-pct" style="color:#10b981">@(Math.Min(100,(int)(allTimeRevenue/6000m)))%</span></div>
                        <div class="gr-bg"><div class="gr-fill" style="width:@(Math.Min(100,(int)(allTimeRevenue/6000m)))%;background:linear-gradient(90deg,#34d399,#10b981)"></div></div>
                    </div>
                    <div class="goal-row">
                        <div class="gr-head"><span>Orders Fulfilled</span><span class="gr-pct" style="color:#3b82f6">@(Math.Min(100,(int)((double)shippedOrders/Math.Max(1,totalOrders)*100)))%</span></div>
                        <div class="gr-bg"><div class="gr-fill" style="width:@(Math.Min(100,(int)((double)shippedOrders/Math.Max(1,totalOrders)*100)))%;background:linear-gradient(90deg,#60a5fa,#3b82f6)"></div></div>
                    </div>
                    <div class="goal-row">
                        <div class="gr-head"><span>Ticket Resolution</span><span class="gr-pct" style="color:#8b5cf6">@(totalTickets>0?Math.Min(100,(int)((double)(resolvedTickets+closedTickets)/totalTickets*100)):0)%</span></div>
                        <div class="gr-bg"><div class="gr-fill" style="width:@(totalTickets>0?Math.Min(100,(int)((double)(resolvedTickets+closedTickets)/totalTickets*100)):0)%;background:linear-gradient(90deg,#a78bfa,#8b5cf6)"></div></div>
                    </div>
                    <div class="goal-row">
                        <div class="gr-head"><span>Stock Availability</span><span class="gr-pct" style="color:#f59e0b">@(totalProducts>0?Math.Min(100,(int)((double)(totalProducts-outOfStockCount)/Math.Max(1,totalProducts)*100)):100)%</span></div>
                        <div class="gr-bg"><div class="gr-fill" style="width:@(totalProducts>0?Math.Min(100,(int)((double)(totalProducts-outOfStockCount)/Math.Max(1,totalProducts)*100)):100)%;background:linear-gradient(90deg,#fbbf24,#f59e0b)"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- ===== MID ROW: Top Products + Ticket Pipeline + Recent Orders ===== -->
    <div class="mid-grid">
        <!-- Top Products with mini bars -->
        <div class="panel-card">
            <div class="panel-header"><h3 class="panel-title">Inventory &amp; Stock Alerts</h3><a href="/admin/inventory" class="panel-link">View All</a></div>
            <div class="panel-list">
                @if (lowStockProducts != null && lowStockProducts.Any())
                {
                    @foreach (var p in pagedLowStockProducts)
                    {
                        <div class="prd-row">
                            <div class="prd-icon @(p.StockQuantity==0?"prd-ico-r":"prd-ico-a")">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                            </div>
                            <div class="prd-info"><p class="prd-name">@p.Name</p><p class="prd-cat">@p.Category</p></div>
                            <div class="prd-bar-wrap">
                                <div class="prd-bar-bg"><div class="prd-bar-fill" style="width:@(Math.Min(100,(int)((double)p.StockQuantity/Math.Max(1,50)*100)))%;background:@(p.StockQuantity==0?"#ef4444":p.StockQuantity<5?"#f59e0b":"#10b981")"></div></div>
                                <span class="prd-qty @(p.StockQuantity==0?"prd-qty-r":"prd-qty-a")">@(p.StockQuantity==0?"Out":"@p.StockQuantity left")</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="panel-empty">All products are well-stocked ✓</div>
                }
            </div>
            @if (lowStockProducts != null && lowStockProducts.Any())
            {
                <div style="display:flex; align-items:center; justify-content:space-between; padding:.5rem 1.25rem .9rem;">
                    <span style="font-size:.7rem; color:#94a3b8;">Showing @lowStockStartIndex-@lowStockEndIndex of @lowStockProducts.Count · Page @lowStockPage/@lowStockTotalPages</span>
                    <div style="display:flex; gap:.4rem;">
                        <button type="button" @onclick="PreviousLowStockPage" disabled="@(lowStockPage <= 1)" class="dash-btn-secondary" style="padding:.25rem .65rem; font-size:.7rem;">Previous</button>
                        <button type="button" @onclick="NextLowStockPage" disabled="@(lowStockPage >= lowStockTotalPages)" class="dash-btn-secondary" style="padding:.25rem .65rem; font-size:.7rem;">Next</button>
                    </div>
                </div>
            }
        </div>

        <!-- Ticket Pipeline -->
        <div class="panel-card">
            <div class="panel-header"><h3 class="panel-title">Support Pipeline</h3><a href="/admin/escalations" class="panel-link">View All</a></div>
            <div style="padding:1rem 1.25rem">
                <div class="pipe-stages">
                    <div class="pipe-stage"><div class="pipe-num" style="color:#f59e0b;border-color:#fde68a">@openTickets</div><div class="pipe-lbl">Open</div></div>
                    <div class="pipe-arrow">›</div>
                    <div class="pipe-stage"><div class="pipe-num" style="color:#3b82f6;border-color:#bfdbfe">@inProgressTickets</div><div class="pipe-lbl">In Progress</div></div>
                    <div class="pipe-arrow">›</div>
                    <div class="pipe-stage"><div class="pipe-num" style="color:#ef4444;border-color:#fecaca">@escalatedTickets</div><div class="pipe-lbl">Escalated</div></div>
                    <div class="pipe-arrow">›</div>
                    <div class="pipe-stage"><div class="pipe-num" style="color:#10b981;border-color:#a7f3d0">@resolvedTickets</div><div class="pipe-lbl">Resolved</div></div>
                    <div class="pipe-arrow">›</div>
                    <div class="pipe-stage"><div class="pipe-num" style="color:#94a3b8;border-color:#e2e8f0">@closedTickets</div><div class="pipe-lbl">Closed</div></div>
                </div>
                @if (totalTickets > 0)
                {
                    <div class="pipe-bar">
                        <div style="width:@(SafePercent(openTickets,totalTickets))%;background:#f59e0b;height:6px;border-radius:3px 0 0 3px"></div>
                        <div style="width:@(SafePercent(inProgressTickets,totalTickets))%;background:#3b82f6;height:6px"></div>
                        <div style="width:@(SafePercent(escalatedTickets,totalTickets))%;background:#ef4444;height:6px"></div>
                        <div style="width:@(SafePercent(resolvedTickets,totalTickets))%;background:#10b981;height:6px"></div>
                        <div style="width:@(SafePercent(closedTickets,totalTickets))%;background:#e2e8f0;height:6px;border-radius:0 3px 3px 0"></div>
                    </div>
                }
                <div style="margin-top:1rem;display:flex;flex-direction:column;gap:0.5rem">
                    <div class="tkt-stat-row"><span class="tkt-dot" style="background:#f59e0b"></span><span class="tkt-lbl">Total Tickets</span><span class="tkt-val">@totalTickets</span></div>
                    <div class="tkt-stat-row"><span class="tkt-dot" style="background:#ef4444"></span><span class="tkt-lbl">Escalated (Urgent)</span><span class="tkt-val tkt-alert">@escalatedTickets</span></div>
                    <div class="tkt-stat-row"><span class="tkt-dot" style="background:#10b981"></span><span class="tkt-lbl">Resolution Rate</span><span class="tkt-val">@(totalTickets>0?((resolvedTickets+closedTickets)*100/Math.Max(1,totalTickets)):0)%</span></div>
                    <div class="tkt-stat-row"><span class="tkt-dot" style="background:#8b5cf6"></span><span class="tkt-lbl">Today's Revenue</span><span class="tkt-val" style="color:#059669">&#8369;@totalRevenue.ToString("N0")</span></div>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="panel-card">
            <div class="panel-header"><h3 class="panel-title">Recent Orders</h3><a href="/admin/orders" class="panel-link">View All</a></div>
            <div class="panel-list">
                @if (recentOrders != null && recentOrders.Any())
                {
                    @foreach (var o in pagedRecentOrders)
                    {
                        <div class="panel-item">
                            <div class="panel-item-left">
                                <div class="panel-item-icon @GetOrderStatusIconClass(o.Status)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                                </div>
                                <div><p class="panel-item-title">@o.OrderNumber</p><p class="panel-item-sub">@o.OrderDate.ToString("MMM dd") · ₱@o.TotalAmount.ToString("N0")</p></div>
                            </div>
                            <span class="status-badge @GetOrderStatusClass(o.Status)">@o.Status</span>
                        </div>
                    }
                }
                else { <div class="panel-empty">No recent orders</div> }
            </div>
            @if (recentOrders != null && recentOrders.Any())
            {
                <div style="display:flex; align-items:center; justify-content:space-between; padding:.5rem 1.25rem .9rem;">
                    <span style="font-size:.7rem; color:#94a3b8;">Showing @ordersStartIndex-@ordersEndIndex of @recentOrders.Count · Page @ordersPage/@ordersTotalPages</span>
                    <div style="display:flex; gap:.4rem;">
                        <button type="button" @onclick="PreviousOrdersPage" disabled="@(ordersPage <= 1)" class="dash-btn-secondary" style="padding:.25rem .65rem; font-size:.7rem;">Previous</button>
                        <button type="button" @onclick="NextOrdersPage" disabled="@(ordersPage >= ordersTotalPages)" class="dash-btn-secondary" style="padding:.25rem .65rem; font-size:.7rem;">Next</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ===== REFUND REQUESTS ===== -->
    <div class="panel-card">
        <div class="panel-header">
            <h3 class="panel-title">Pending Refund Requests</h3>
            <a href="/admin/orders?focus=refunds#refund-requests" class="panel-link">Open Refund Table</a>
        </div>
        <div class="panel-list">
            @if (pendingRefundRequests.Any())
            {
                @foreach (var request in pendingRefundRequests.Take(8))
                {
                    <div class="panel-item">
                        <div class="panel-item-left">
                            <div class="panel-item-icon panel-icon-red">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
                                </svg>
                            </div>
                            <div>
                                <p class="panel-item-title">@request.OrderNumber · ₱@request.TotalAmount.ToString("N2")</p>
                                <p class="panel-item-sub">@request.RequestedByName · @request.CreatedAt.ToString("MMM dd, HH:mm")</p>
                                @if (!string.IsNullOrWhiteSpace(request.Reason))
                                {
                                    <p class="panel-item-sub">Reason: @request.Reason</p>
                                }
                            </div>
                        </div>
                        <a href="/admin/orders?focus=refunds#refund-requests" class="dash-btn-secondary" style="padding:.25rem .65rem; font-size:.7rem;">Request for Refund</a>
                    </div>
                }
            }
            else
            {
                <div class="panel-empty">No pending refund requests</div>
            }
        </div>
    </div>

    <!-- ===== MANAGEMENT TOOLS ===== -->
    <div class="section-header"><h2 class="section-title">Management Tools</h2><p class="section-desc">Quick access to core admin functions</p></div>
    <div class="mgmt-grid">
        <a href="/admin/users" class="mgmt-card mgmt-card-indigo">
            <div class="mgmt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg></div>
            <div class="mgmt-body"><h3 class="mgmt-title">User Management</h3><p class="mgmt-desc">Supervisors, Agents &amp; roles</p></div>
            <div class="mgmt-stat">@totalStaff users</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mgmt-arrow"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/admin/inventory" class="mgmt-card mgmt-card-amber">
            <div class="mgmt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg></div>
            <div class="mgmt-body"><h3 class="mgmt-title">Product &amp; Catalog</h3><p class="mgmt-desc">Dress, Shirt, Jacket &amp; pricing</p></div>
            <div class="mgmt-stat">@totalProducts items</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mgmt-arrow"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/admin/orders" class="mgmt-card mgmt-card-blue">
            <div class="mgmt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg></div>
            <div class="mgmt-body"><h3 class="mgmt-title">Order Management</h3><p class="mgmt-desc">Approve/reject, handle returns</p></div>
            <div class="mgmt-stat">@pendingOrders pending</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mgmt-arrow"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/admin/escalations" class="mgmt-card mgmt-card-red">
            <div class="mgmt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg></div>
            <div class="mgmt-body"><h3 class="mgmt-title">Ticket Oversight</h3><p class="mgmt-desc">Monitor escalations, reassign</p></div>
            <div class="mgmt-stat mgmt-stat-alert">@escalatedTickets escalated</div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mgmt-arrow"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
    </div>

    <!-- Role Boundary Notice -->
    <div class="role-notice">
        <svg class="w-4 h-4 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        <span>Admins can create Supervisors and manage Agents. Full control over products, inventory, and finances. Super Admin access is restricted.</span>
    </div>

</div>

<style>
    /* ===== Container ===== */
    .dash-container { padding:1.5rem; max-width:1560px; margin:0 auto; display:flex; flex-direction:column; gap:1.5rem; }
    @@media (min-width:1024px) { .dash-container { padding:2rem; gap:1.75rem; } }

    /* ===== Header ===== */
    .dash-header { display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:1rem; }
