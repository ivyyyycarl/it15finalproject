    .sc-up { color:#10b981; } .sc-dn { color:#ef4444; }
    .sc-subchips { margin-top:.45rem; display:flex; flex-wrap:wrap; gap:.35rem; }
    .sc-chip { display:inline-flex; align-items:center; padding:.15rem .5rem; border-radius:999px; font-size:.65rem; font-weight:700; text-decoration:none; }
    .sc-chip-rose { background:#fff1f2; color:#be123c; border:1px solid #fecdd3; }
    .sc-chip-rose:hover { background:#ffe4e6; color:#9f1239; }
    .sc-icon { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sc-icon-g { background:#ecfdf5; color:#059669; } .sc-icon-b { background:#eff6ff; color:#2563eb; }
    .sc-icon-v { background:#f5f3ff; color:#7c3aed; } .sc-icon-a { background:#fffbeb; color:#d97706; }
    .sc-spark { width:calc(100% + 2.5rem); margin:0 -1.25rem; height:50px; display:block; }

    /* ===== Analytics Row ===== */
    .an-row { display:grid; grid-template-columns:1fr 320px; gap:1rem; align-items:stretch; }
    @@media (max-width:1200px) { .an-row { grid-template-columns:1fr; } }
