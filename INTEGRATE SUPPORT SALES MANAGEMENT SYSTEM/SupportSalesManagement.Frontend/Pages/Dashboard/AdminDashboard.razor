    .dash-btn-secondary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.75rem; font-size:0.8125rem; font-weight:600; background:white; color:#475569; border:1px solid #e2e8f0; cursor:pointer; transition:all 0.15s; text-decoration:none; }
    .dash-btn-secondary:hover { background:#f8fafc; border-color:#cbd5e1; color:#1e293b; }
    .dash-btn-secondary:disabled { opacity:0.5; cursor:not-allowed; }
    .dash-btn-primary { display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.75rem; font-size:0.8125rem; font-weight:600; background:#4338ca; color:white; border:1px solid #4338ca; cursor:pointer; transition:all 0.15s; text-decoration:none; }
    .dash-btn-primary:hover { background:#3730a3; }

    /* ===== Stat Cards ===== */
    .sc-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; align-items:stretch; }
    @@media (max-width:1280px) { .sc-grid { grid-template-columns:repeat(2,1fr); } }
    @@media (max-width:640px) { .sc-grid { grid-template-columns:1fr; } }
    .sc-grid > * { height:100%; }
    .sc-card { background:white; border:1px solid var(--card-border-color, #e2e8f0); border-radius:var(--card-radius, 1rem); padding:1.25rem 1.25rem 0; display:flex; flex-direction:column; box-shadow:var(--card-shadow, 0 1px 4px rgba(0,0,0,.05)); transition:all .2s; overflow:hidden; min-height:var(--card-min-height-sm, 170px); height:100%; }
    .sc-card:hover { border-color:#e2e8f0; box-shadow:var(--card-shadow-hover, 0 8px 18px rgba(0,0,0,.09)); transform:translateY(-2px); }
    .sc-card-link { text-decoration:none; color:inherit; }
