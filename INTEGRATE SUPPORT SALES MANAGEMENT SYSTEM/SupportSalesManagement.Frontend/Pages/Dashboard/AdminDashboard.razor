    .an-right { display:flex; flex-direction:column; gap:1rem; }
    .side-box { background:white; border:1px solid var(--card-border-color, #e2e8f0); border-radius:var(--card-radius, 1rem); padding:1.25rem; box-shadow:var(--card-shadow, 0 1px 4px rgba(0,0,0,.05)); min-height:var(--card-min-height-sm, 170px); }
