@code {
    private string? loadError;
    private bool canViewAdminAnalytics;

    private bool isLoading = true;



    // ===== KPI Metrics =====

    // Tickets

    private int totalTickets = 0;

    private int openTickets = 0;

    private int inProgressTickets = 0;

    private int resolvedTickets = 0;

    private int escalatedTickets = 0;

    private int closedTickets = 0;



    // Orders

    private int totalOrders = 0;

    private int pendingOrders = 0;

    private int processingOrders = 0;

    private int shippedOrders = 0;

    private int cancelledOrders = 0;



    // Financial

    private decimal totalRevenue = 0;

    private decimal weeklyRevenue = 0;

    private decimal allTimeRevenue = 0;

    private decimal cancelledValue = 0;

    private decimal revenueChangePercent = 0;
    private decimal revenueMonthChangePercent = 0;
    private decimal ordersMonthChangePercent = 0;



    // Inventory

    private int totalProducts = 0;

    private int lowStockCount = 0;

    private int outOfStockCount = 0;



    // Team

    private int totalStaff = 0;

    private int supervisorCount = 0;

    private int agentCount = 0;



    // System

    private string erpSyncStatus = "Checking...";

    private int recentAuditLogCount = 0;



    // Data lists

    private List<Order>? recentOrders;

    private List<Product>? lowStockProducts;

    private List<AuditLog>? recentAuditLogs;
    private List<PendingRefundRequest> pendingRefundRequests = new();
    private int lowStockPage = 1;
    private int ordersPage = 1;
    private int auditPage = 1;
    private const int lowStockPageSize = 7;
    private const int ordersPageSize = 7;
    private const int auditPageSize = 6;
    private int lowStockTotalPages => Math.Max(1, (int)Math.Ceiling((lowStockProducts?.Count ?? 0) / (double)lowStockPageSize));
    private int ordersTotalPages => Math.Max(1, (int)Math.Ceiling((recentOrders?.Count ?? 0) / (double)ordersPageSize));
    private int auditTotalPages => Math.Max(1, (int)Math.Ceiling((recentAuditLogs?.Count ?? 0) / (double)auditPageSize));
    private List<Product> pagedLowStockProducts => (lowStockProducts ?? new())
        .Skip((lowStockPage - 1) * lowStockPageSize)
        .Take(lowStockPageSize)
        .ToList();
    private List<Order> pagedRecentOrders => (recentOrders ?? new())
        .Skip((ordersPage - 1) * ordersPageSize)
        .Take(ordersPageSize)
        .ToList();
    private List<AuditLog> pagedRecentAuditLogs => (recentAuditLogs ?? new())
        .Skip((auditPage - 1) * auditPageSize)
        .Take(auditPageSize)
        .ToList();
    private int lowStockStartIndex => (lowStockProducts?.Count ?? 0) == 0 ? 0 : ((lowStockPage - 1) * lowStockPageSize) + 1;
    private int lowStockEndIndex => (lowStockProducts?.Count ?? 0) == 0 ? 0 : Math.Min(lowStockPage * lowStockPageSize, lowStockProducts!.Count);
    private int ordersStartIndex => (recentOrders?.Count ?? 0) == 0 ? 0 : ((ordersPage - 1) * ordersPageSize) + 1;
    private int ordersEndIndex => (recentOrders?.Count ?? 0) == 0 ? 0 : Math.Min(ordersPage * ordersPageSize, recentOrders!.Count);
    private int auditStartIndex => (recentAuditLogs?.Count ?? 0) == 0 ? 0 : ((auditPage - 1) * auditPageSize) + 1;
    private int auditEndIndex => (recentAuditLogs?.Count ?? 0) == 0 ? 0 : Math.Min(auditPage * auditPageSize, recentAuditLogs!.Count);
    private string selectedChartMetric = "revenue";
    private List<decimal> monthlyRevenueSeries = Enumerable.Repeat(0m, 12).ToList();
    private List<decimal> monthlyOrdersSeries = Enumerable.Repeat(0m, 12).ToList();
    private List<decimal> monthlyProfitSeries = Enumerable.Repeat(0m, 12).ToList();
    private decimal chartSeriesMax = 1m;
    private string chartLinePath = "M0 170 L600 170";
    private string chartAreaPath = "M0 170 L600 170 L600 180 L0 180 Z";
    private string chartSeriesColor = "#10b981";



    protected override async Task OnInitializedAsync()

    {

        await LoadDashboardData();

    }



    private async Task LoadDashboardData()

    {

        isLoading = true;

        try

        {

            // Fetch all data in parallel

            var productsTask = _apiClient.GetProductsAsync();

            var ordersTask = _apiClient.GetOrdersAsync();

            var ticketsTask = _apiClient.GetTicketsAsync();

            var usersTask = _apiClient.GetUsersAsync();

            var auditLogsTask = _apiClient.GetAuditLogsAsync();
            var pendingRefundsTask = _apiClient.GetPendingRefundRequestsAsync();

            var erpSyncTask = DashboardService.GetErpSyncStatusAsync();
            var moduleAccessTask = _apiClient.GetModuleAccessConfigAsync();
            var subscriptionTask = _apiClient.GetMySubscriptionAsync();



            await Task.WhenAll(productsTask, ordersTask, ticketsTask, usersTask, auditLogsTask, pendingRefundsTask, erpSyncTask, moduleAccessTask, subscriptionTask);



            var products = await productsTask;

            var orders = await ordersTask;

            var tickets = await ticketsTask;

            var users = await usersTask;

            var auditLogs = await auditLogsTask;
            pendingRefundRequests = (await pendingRefundsTask) ?? new List<PendingRefundRequest>();

            erpSyncStatus = await erpSyncTask;
            var moduleAccessConfig = await moduleAccessTask;
            var tenantSubscription = await subscriptionTask;
            canViewAdminAnalytics = ResolveAdminAnalyticsVisibility(moduleAccessConfig, tenantSubscription);



            // ===== Process Tickets =====

            if (tickets != null)

            {

                totalTickets = tickets.Count;

                openTickets = tickets.Count(t => t.Status.Equals("Open", StringComparison.OrdinalIgnoreCase) || t.Status.Equals("New", StringComparison.OrdinalIgnoreCase));

                inProgressTickets = tickets.Count(t => t.Status.Equals("InProgress", StringComparison.OrdinalIgnoreCase) || t.Status.Equals("In Progress", StringComparison.OrdinalIgnoreCase));

                resolvedTickets = tickets.Count(t => t.Status.Equals("Resolved", StringComparison.OrdinalIgnoreCase));

                escalatedTickets = tickets.Count(t => t.Status.Equals("Escalated", StringComparison.OrdinalIgnoreCase) || t.Priority.Equals("High", StringComparison.OrdinalIgnoreCase) || t.Priority.Equals("Critical", StringComparison.OrdinalIgnoreCase));

                closedTickets = tickets.Count(t => t.Status.Equals("Closed", StringComparison.OrdinalIgnoreCase));

            }



            // ===== Process Orders =====

            if (orders != null)

            {

                totalOrders = orders.Count;

                pendingOrders = orders.Count(o => o.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase));

                processingOrders = orders.Count(o => o.Status.Equals("Processing", StringComparison.OrdinalIgnoreCase));

                shippedOrders = orders.Count(o => o.Status.Equals("Shipped", StringComparison.OrdinalIgnoreCase) || o.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) || o.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase));

                cancelledOrders = orders.Count(o => o.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || o.Status.Equals("Returned", StringComparison.OrdinalIgnoreCase));



                // Revenue calculations

                var today = DateTime.Today;

                var weekAgo = today.AddDays(-7);

                var yesterday = today.AddDays(-1);



                var activeOrders = orders.Where(o => !o.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();

                totalRevenue = activeOrders.Where(o => o.OrderDate.Date == today).Sum(o => o.TotalAmount);

                weeklyRevenue = activeOrders.Where(o => o.OrderDate.Date >= weekAgo).Sum(o => o.TotalAmount);

                allTimeRevenue = activeOrders.Sum(o => o.TotalAmount);

                cancelledValue = orders.Where(o => o.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || o.Status.Equals("Returned", StringComparison.OrdinalIgnoreCase)).Sum(o => o.TotalAmount);



                var yesterdayRevenue = activeOrders.Where(o => o.OrderDate.Date == yesterday).Sum(o => o.TotalAmount);

                revenueChangePercent = yesterdayRevenue > 0 ? ((totalRevenue - yesterdayRevenue) / yesterdayRevenue) * 100 : 0;

                var monthStart = new DateTime(today.Year, today.Month, 1);
                var prevMonthStart = monthStart.AddMonths(-1);

                var thisMonthRevenue = activeOrders.Where(o => o.OrderDate >= monthStart).Sum(o => o.TotalAmount);
                var prevMonthRevenue = activeOrders.Where(o => o.OrderDate >= prevMonthStart && o.OrderDate < monthStart).Sum(o => o.TotalAmount);
                revenueMonthChangePercent = CalculatePercentChange(thisMonthRevenue, prevMonthRevenue);

                var thisMonthOrders = orders.Count(o => o.OrderDate >= monthStart);
                var prevMonthOrders = orders.Count(o => o.OrderDate >= prevMonthStart && o.OrderDate < monthStart);
                ordersMonthChangePercent = CalculatePercentChange(thisMonthOrders, prevMonthOrders);

                BuildMonthlyChartSeries(orders, activeOrders, today.Year);
                ApplySelectedChartSeries();



                // Recent orders (sorted by date)

                recentOrders = orders.OrderByDescending(o => o.OrderDate).ToList();
                ordersPage = 1;

            }



            // ===== Process Products =====

            if (products != null)

            {

                totalProducts = products.Count;

                lowStockCount = products.Count(p => p.StockQuantity > 0 && p.StockQuantity <= 10);

                outOfStockCount = products.Count(p => p.StockQuantity == 0);

                lowStockProducts = products.Where(p => p.StockQuantity <= 10).OrderBy(p => p.StockQuantity).ToList();
                lowStockPage = 1;

            }



            // ===== Process Users =====

            if (users != null)

            {

                totalStaff = users.Count;

                supervisorCount = users.Count(u => u.Role == UserRole.Supervisor);

                agentCount = users.Count(u => u.Role == UserRole.Agent);

            }



            // ===== Process Audit Logs =====

            if (auditLogs != null)

            {

                recentAuditLogs = auditLogs.OrderByDescending(a => a.Timestamp).ToList();
                auditPage = 1;

                recentAuditLogCount = auditLogs.Count;

            }

        }

        catch (Exception ex)

        {

            loadError = $"Error loading dashboard data: {ex.Message}";

            Console.WriteLine(loadError);

        }

        finally

        {

            isLoading = false;

        }

    }



    private async Task RefreshData()

    {

        await LoadDashboardData();

        StateHasChanged();

    }



    // ===== Helpers =====



    private string SafePercent(int part, int whole)

    {

        if (whole <= 0) return "0";

        return ((double)part / whole * 100).ToString("F1");

    }



    private string GetOrderStatusClass(string status) => status?.ToLower() switch

    {

        "pending" => "status-pending",

        "processing" => "status-processing",

        "shipped" or "completed" or "delivered" => "status-shipped",

        "cancelled" or "returned" => "status-cancelled",

        _ => "status-pending"

    };



    private string GetOrderStatusIconClass(string status) => status?.ToLower() switch

    {

        "pending" => "panel-icon-amber",

        "processing" => "panel-icon-blue",

        "shipped" or "completed" or "delivered" => "panel-icon-emerald",

        "cancelled" or "returned" => "panel-icon-red",

        _ => "panel-icon-blue"

    };

    private decimal CalculatePercentChange(decimal currentValue, decimal previousValue)
    {
        if (previousValue <= 0)
        {
            return currentValue > 0 ? 100m : 0m;
        }

        return ((currentValue - previousValue) / previousValue) * 100m;
    }

    private decimal CalculatePercentChange(int currentValue, int previousValue)
        => CalculatePercentChange((decimal)currentValue, previousValue);

    private void BuildMonthlyChartSeries(List<Order> orders, List<Order> activeOrders, int year)
    {
        monthlyRevenueSeries = Enumerable
            .Range(1, 12)
            .Select(month => activeOrders
                .Where(o => o.OrderDate.Year == year && o.OrderDate.Month == month)
                .Sum(o => o.TotalAmount))
            .ToList();

        monthlyOrdersSeries = Enumerable
            .Range(1, 12)
            .Select(month => (decimal)orders.Count(o => o.OrderDate.Year == year && o.OrderDate.Month == month))
            .ToList();

        monthlyProfitSeries = Enumerable
            .Range(1, 12)
            .Select(month => activeOrders
                .Where(o => o.OrderDate.Year == year && o.OrderDate.Month == month)
                .Sum(o => o.TotalAmount))
            .ToList();
    }

    private void SetChartMetric(string metric)
    {
        selectedChartMetric = metric;
        ApplySelectedChartSeries();
    }

    private void ApplySelectedChartSeries()
    {
        List<decimal> selectedSeries;
        switch (selectedChartMetric)
        {
            case "orders":
                selectedSeries = monthlyOrdersSeries;
                chartSeriesColor = "#3b82f6";
                break;
            case "profit":
                selectedSeries = monthlyProfitSeries;
                chartSeriesColor = "#8b5cf6";
                break;
            default:
                selectedSeries = monthlyRevenueSeries;
                chartSeriesColor = "#10b981";
                break;
        }

        var maxValue = selectedSeries.DefaultIfEmpty(0m).Max();
        chartSeriesMax = RoundUpChartMax(maxValue);

        var coordinates = new List<(double X, double Y)>();
        for (var i = 0; i < selectedSeries.Count; i++)
        {
            var x = i * (600d / 11d);
            var ratio = chartSeriesMax <= 0 ? 0 : (double)(selectedSeries[i] / chartSeriesMax);
            var y = 165d - (ratio * 155d);
            y = Math.Clamp(y, 8d, 165d);
            coordinates.Add((x, y));
        }

        if (!coordinates.Any())
        {
            chartLinePath = "M0 170 L600 170";
            chartAreaPath = "M0 170 L600 170 L600 180 L0 180 Z";
            return;
        }

        var linePath = string.Join(" ",
            coordinates.Select((p, idx) =>
                $"{(idx == 0 ? "M" : "L")}{p.X.ToString("0.##", CultureInfo.InvariantCulture)} {p.Y.ToString("0.##", CultureInfo.InvariantCulture)}"));

        chartLinePath = linePath;
        chartAreaPath = $"{linePath} L600 180 L0 180 Z";
    }

    private decimal RoundUpChartMax(decimal value)
    {
        if (value <= 0) return 1000m;
        var unit = value < 10000m ? 500m : 1000m;
        return Math.Ceiling(value / unit) * unit;
    }

    private string FormatCompactPeso(decimal value)
    {
        if (value >= 1_000_000m)
        {
            return $"₱{(value / 1_000_000m).ToString("0.#", CultureInfo.InvariantCulture)}M";
        }

        if (value >= 1000m)
        {
            return $"₱{(value / 1000m).ToString("0.#", CultureInfo.InvariantCulture)}k";
        }

        return $"₱{value.ToString("0", CultureInfo.InvariantCulture)}";
    }

    private string FormatChartAxisValue(decimal value)
    {
        if (selectedChartMetric == "orders")
        {
            if (value >= 1000m)
            {
                return $"{(value / 1000m).ToString("0.#", CultureInfo.InvariantCulture)}k";
            }

            return Math.Round(value).ToString("0", CultureInfo.InvariantCulture);
        }

        return FormatCompactPeso(value);
    }

    private void PreviousLowStockPage()
    {
        if (lowStockPage <= 1) return;
        lowStockPage--;
    }

    private void NextLowStockPage()
    {
        if (lowStockPage >= lowStockTotalPages) return;
        lowStockPage++;
    }

    private void PreviousOrdersPage()
    {
        if (ordersPage <= 1) return;
        ordersPage--;
    }

    private void NextOrdersPage()
    {
        if (ordersPage >= ordersTotalPages) return;
        ordersPage++;
    }

    private void PreviousAuditPage()
    {
        if (auditPage <= 1) return;
        auditPage--;
    }

    private void NextAuditPage()
    {
        if (auditPage >= auditTotalPages) return;
        auditPage++;
    }

    private static bool ResolveAdminAnalyticsVisibility(
        ModuleAccessConfig? moduleAccessConfig,
        TenantSubscriptionModel? tenantSubscription)
    {
        var analyticsModule = moduleAccessConfig?.Modules.FirstOrDefault(m =>
            string.Equals(m.ModuleKey, "reports", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(m.ModuleKey, "analytics", StringComparison.OrdinalIgnoreCase));

        if (analyticsModule == null || !analyticsModule.IsEnabled || !analyticsModule.RoleAccess.Admin)
        {
            return false;
        }

        return ModuleVisibilityHelper.IsAllowedBySubscription("reports", tenantSubscription);
    }
