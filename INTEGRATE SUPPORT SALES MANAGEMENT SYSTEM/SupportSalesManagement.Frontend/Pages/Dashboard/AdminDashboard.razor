    .an-tab:hover { color:#475569; }
    .an-tab-on { background:white; color:#1e293b; box-shadow:0 1px 3px rgba(0,0,0,.08); }
    .an-chart-body { display:flex; gap:.5rem; align-items:stretch; }
    .an-ylabels { display:flex; flex-direction:column; justify-content:space-between; font-size:.6875rem; color:#cbd5e1; text-align:right; width:36px; flex-shrink:0; padding-bottom:1.5rem; }
