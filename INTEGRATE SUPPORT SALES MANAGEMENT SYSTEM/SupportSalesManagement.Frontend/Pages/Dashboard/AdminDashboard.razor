    .panel-item-icon { width:28px; height:28px; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .panel-item-title { font-size:.825rem; font-weight:600; color:#1e293b; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .panel-item-sub { font-size:.73rem; color:#94a3b8; margin:0; }
