    @@media (min-width:1024px) { .dash-title { font-size:1.75rem; } }
    .dash-role-badge { padding:0.25rem 0.75rem; border-radius:999px; font-size:0.6875rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; background:linear-gradient(135deg,#eef2ff,#e0e7ff); color:#4338ca; border:1px solid #c7d2fe; }
    .dash-subtitle { display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap; font-size:0.8125rem; color:#64748b; margin-top:0.375rem; }
