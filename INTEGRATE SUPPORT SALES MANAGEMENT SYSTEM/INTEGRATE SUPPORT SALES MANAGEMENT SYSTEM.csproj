<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
  <TargetFramework>net8.0</TargetFramework>
  <Nullable>enable</Nullable>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>ClassicFitApp</AssemblyName>
  <RootNamespace>INTEGRATE_SUPPORT_SALES_MANAGEMENT_SYSTEM</RootNamespace>
  <DefaultItemExcludes>$(DefaultItemExcludes);SupportSalesManagement.Frontend/**;_temp_buildDebug/**;_temp_build_verify/**;_verify_build2/**;_authfix_obj/**;_authfix_out/**;publish_output/**</DefaultItemExcludes>
  <DefaultWebContentItemExcludes>$(DefaultWebContentItemExcludes);_temp_buildDebug/**;_temp_build_verify/**;_verify_build2/**;_authfix_obj/**;_authfix_out/**;publish_output/**</DefaultWebContentItemExcludes>
  <EnableFrontendAssetSync>true</EnableFrontendAssetSync>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Stripe.net" Version="50.3.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.2" />
  </ItemGroup>

  <!-- Exclude SupportSalesManagement.Frontend from compilation -->
  <ItemGroup>
    <Compile Remove="SupportSalesManagement.Frontend\**\*.cs" />
    <Compile Remove="SupportSalesManagement.Frontend\**\*.razor" />
    <Compile Remove="_temp_build_verify\**\*.cs;_verify_build2\**\*.cs;_authfix_obj\**\*.cs;_authfix_out\**\*.cs" />
    <EmbeddedResource Remove="SupportSalesManagement.Frontend\**" />
    <EmbeddedResource Remove="_temp_build_verify\**;_verify_build2\**;_authfix_obj\**;_authfix_out\**" />
    <None Remove="SupportSalesManagement.Frontend\**" />
    <None Remove="_temp_build_verify\**;_verify_build2\**;_authfix_obj\**;_authfix_out\**" />
    <Content Remove="_temp_build_verify\**;_verify_build2\**;_authfix_obj\**;_authfix_out\**" />
  </ItemGroup>

  <Target Name="SyncFrontendAssetsBeforeBuild"
          BeforeTargets="Build"
          Condition="'$(EnableFrontendAssetSync)' == 'true' AND Exists('scripts\sync-frontend-assets.ps1')">
    <Message Importance="High" Text="Syncing Blazor frontend assets into backend wwwroot..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\sync-frontend-assets.ps1&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

</Project>
